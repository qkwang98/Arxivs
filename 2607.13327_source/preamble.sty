\def\makeupcase#1{\uppercase{#1}}
\def\firstupper{\expandafter\makeupcase}

\newcounter{thm}
\newcommand*{\newtheoremBis}[2]{
	\newtheorem{@-#1}[thm]{\firstupper#2}
	\newtheorem*{@-#1*}{\firstupper#2}
	\newenvironment{#1}[2]{\begin{@-#1}[##1]\ifthenelse{\isempty{##2}}{}{\label{#1:##2}}}{\end{@-#1}}
	\newenvironment{#1*}[1]{\begin{@-#1*}[##1]}{\end{@-#1*}}
}

\newtheoremstyle{thm-}{}{}{\itshape}{}{}{}{.5em}
{\makebox[0em][r]{\thmnumber{#2 --\hspace{.5em}}}\bfseries\thmname{#1}\thmnote{ (#3)}.}
\newtheoremstyle{dfn-}{}{}{\normalshape}{}{}{}{.5em}
{\makebox[0em][r]{\thmnumber{#2 --\hspace{.5em}}}\bfseries\thmname{#1}\thmnote{ (#3)}.}
\newtheoremstyle{rmk-}{}{}{\normalshape}{}{}{}{.5em}
{\makebox[0em][r]{\thmnumber{#2 --\hspace{.5em}}}\itshape\thmname{#1}\thmnote{ (#3)}.}

\theoremstyle{thm-}
\newtheoremBis{thm}{theorem}
\newtheoremBis{prop}{proposition}
\newtheoremBis{lem}{lemma}
\newtheoremBis{cor}{corollary}
\newtheoremBis{fact}{fact}

\theoremstyle{dfn-}
\newtheoremBis{dfn}{definition}
\newtheoremBis{exo}{exercise}

\theoremstyle{rmk-}
\newtheoremBis{rmq}{remark}
\newtheoremBis{notation}{notation}
\newtheoremBis{exmp}{example}
\newtheoremBis{quest}{question}

\renewenvironment{proof}[1]{\par
	\pushQED{\qed}%
	\normalfont \topsep6\p@\@plus6\p@\relax
	\trivlist
	\item[\hskip\labelsep
	\itshape
	Proof\@addpunct{.}]\@ifnextchar\proofstep{~\\}{}
}{%
	\popQED\endtrivlist\@endpefalse
}
\newenvironment{proof*}[1]{\par
	\pushQED{\qed}%
	\normalfont \topsep6\p@\@plus6\p@\relax
	\trivlist
	\item[\hskip\labelsep
	\itshape
	Proof\ifstrempty{#1}{}{ #1}\@addpunct{.}]\@ifnextchar\proofstep{~\\}{}
}{%
	\popQED\endtrivlist\@endpefalse
}

\newcommand*{\proofstep}[1]{\textbf{#1.}\hspace{1em}}

\newenvironment{block}[1]{\emph{#1.}}{}

\titleformat{\section}[block]{\normalfont\large\scshape}{\makebox[0em][r]{\S~\thesection~--~}}{0em}{}
\titleformat{\subsection}[block]{\normalfont\scshape}{\makebox[0em][r]{\S~\thesubsection~--~}}{0em}{}
\titleformat{\subsubsection}{\normalfont}{\makebox[0em][r]{\S~\thesubsubsection~--~}}{0em}{\uline}

\renewcommand{\eqref}[1]{\textup{\eqreftagform@{\ref{#1}}}}
\let\eqreftagform@\tagform@
\def\tagform@#1{%
	\maketag@@@{\makebox[1sp][l]{\hspace{1.5em}(\ignorespaces#1\unskip\@@italiccorr)}}%
}

