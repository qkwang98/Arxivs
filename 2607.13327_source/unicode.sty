\RequirePackage{newunicodechar}

\DeclareRobustCommand{\newuchar}[2]{\@namedef{u8:\detokenize{#1}}{#2}}
\DeclareRobustCommand{\newmathchar}[2]{\relax\newunicodechar{#1}{#2}}

\newmathchar{×}{\times}
\newmathchar{φ}{\varphi}
\newmathchar{ψ}{\psi}
\newmathchar{→}{\to}
\newmathchar{↠}{\twoheadrightarrow}
\newmathchar{↪}{\hookrightarrow}
\newmathchar{⇉}{\rightrightarrows}
\newmathchar{⇒}{\implies}
\newmathchar{⇔}{\iff}
\newmathchar{∀}{\forall}
\newmathchar{∃}{\exists}
\newmathchar{∈}{\in}
\newmathchar{∧}{\land}
\newmathchar{∨}{\lor}
\newmathchar{≠}{\neq}
\newmathchar{⊆}{\subseteq}
