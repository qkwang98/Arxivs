%% ---- Bibliography ----
\usepackage[style=alphabetic, maxbibnames=99, maxalphanames=4, minalphanames=4, doi=true]{biblatex}
\appto\bibsetup{\emergencystretch=3em\hbadness=10000}
\DeclareSourcemap{
  \maps[datatype=bibtex]{
    \map{
      \step[fieldset=issn, null]
      \step[fieldset=isbn, null]
    }
  }
}
% Remove quotation marks and force italics for all titles
\DeclareFieldFormat{title}{\mkbibitalic{#1}}
\DeclareFieldFormat[article,inbook,incollection,inproceedings,patent,thesis,unpublished]{title}{\mkbibitalic{#1}}
% 2. Set journal names and book titles (the "containers") to Roman (upright)
\DeclareFieldFormat{journaltitle}{#1}
\DeclareFieldFormat{issuetitle}{#1}
\DeclareFieldFormat{booktitle}{#1}
\DeclareFieldFormat{maintitle}{#1}
\DeclareFieldFormat{postnote}{#1}

%% ---- Layout ----
\setlength{\parindent}{0pt}



%%plain style (italic body): theorem, prop, lemma, corollary ---
\usepackage{aliascnt}
\newtheorem{theorem}{Theorem}[section]

\newaliascnt{prop}{theorem}
\newtheorem{prop}[prop]{Proposition}
\aliascntresetthe{prop}

\newaliascnt{lemma}{theorem}
\newtheorem{lemma}[lemma]{Lemma}
\aliascntresetthe{lemma}

\newaliascnt{corollary}{theorem}
\newtheorem{corollary}[corollary]{Corollary}
\aliascntresetthe{corollary}

%% -starred (unnumbered) variants 
\newtheorem*{theorem*}{Theorem}
\newtheorem*{prop*}{Proposition}
\newtheorem*{corollary*}{Corollary}

%% definition style (upright body): definition, example, notation, remark ---
\theoremstyle{definition}

\newaliascnt{definition}{theorem}
\newtheorem{definition}[definition]{Definition}
\aliascntresetthe{definition}

\newaliascnt{example}{theorem}
\newtheorem{example}[example]{\sc Example}
\aliascntresetthe{example}

\newaliascnt{notation}{theorem}
\newtheorem{notation}[notation]{Notation}
\aliascntresetthe{notation}

\newaliascnt{remark}{theorem}
\newtheorem{remark}[remark]{\sc Remark}
\aliascntresetthe{remark}


%% equation numbering shared with the theorem counter 
\numberwithin{equation}{theorem}


