\newcommand{\corner}[1]{\mathpalette\corner@aux{#1}}
\newcommand{\corner@aux}[2]{%
  \raisebox{0.3ex}{$\m@th#1\ulcorner$}\mkern-3mu #2 \mkern-3mu\raisebox{0.3ex}{$\m@th#1\urcorner$}%
}
