%%%%%%%%%%%%%%%%%%%%%% Bibliography %%%%%%%%%%%%%%%%%%%%%%
\usepackage[style=alphabetic, maxbibnames=99, maxalphanames=4, minalphanames=4, doi=true]{biblatex}
\addbibresource{biblio.bib}
\appto\bibsetup{\emergencystretch=3em\hbadness=10000}%%% Avoids overfull in bibliography
\setcounter{biburlnumpenalty}{9000}
\setcounter{biburlucpenalty}{9000}
\setcounter{biburllcpenalty}{9000}
\DeclareSourcemap{
  \maps[datatype=bibtex]{
    \map{
      \step[fieldset=issn, null]
      \step[fieldset=isbn, null]
    }
  }
}
%%%%%%% Adds an indent for subsection in the TOC
\makeatletter
\def\l@subsection{\@tocline{2}{0pt}{2.5pc}{5pc}{}}


\renewcommand{\subsubsection}{%This lines make subsubsections appear bold, instead of italic
  \@startsection{subsubsection}{3}%
  \z@{.5\linespacing\@plus.7\linespacing}{-.5em}% <--- Negative value for horizontal space
  {\normalfont\bfseries}%
}
\makeatother
% All titles italic; container names upright; strip the "p." from postnotes.
\DeclareFieldFormat{title}{\mkbibitalic{#1}}
\DeclareFieldFormat[article,inbook,incollection,inproceedings,patent,thesis,unpublished]{title}{\mkbibitalic{#1}}
\DeclareFieldFormat{journaltitle}{#1}
\DeclareFieldFormat{issuetitle}{#1}
\DeclareFieldFormat{booktitle}{#1}
\DeclareFieldFormat{maintitle}{#1}
\DeclareFieldFormat{postnote}{#1}

\setlength{\parindent}{0pt}

%%%%%%%%%%%%%%%%%%%%%% Theorem environments %%%%%%%%%%%%%%%%%%%%%%
%% aliascnt gives each environment its own counter (aliased to `theorem`,
%% so numbering stays shared and sequential) which lets cleveref detect
%% the type correctly on recent TeX Live kernels.

\newtheorem{theorem}{Theorem}[section]
\newtheorem*{theorem*}{Theorem}
\numberwithin{equation}{theorem}

\newaliascnt{lemma}{theorem}
\newtheorem{lemma}[lemma]{Lemma}
\aliascntresetthe{lemma}

\newaliascnt{prop}{theorem}
\newtheorem{prop}[prop]{Proposition}
\aliascntresetthe{prop}
\newtheorem*{prop*}{Proposition}

\newaliascnt{corollary}{theorem}
\newtheorem{corollary}[corollary]{Corollary}
\aliascntresetthe{corollary}

\theoremstyle{definition}
\newaliascnt{definition}{theorem}
\newtheorem{definition}[definition]{Definition}
\aliascntresetthe{definition}

\newaliascnt{example}{theorem}
\newtheorem{example}[example]{\sc Example}
\aliascntresetthe{example}

\newaliascnt{notation}{theorem}
\newtheorem{notation}[notation]{Notation}
\aliascntresetthe{notation}

\newaliascnt{remark}{theorem}
\newtheorem{remark}[remark]{\sc Remark}
\aliascntresetthe{remark}

\theoremstyle{remark}
\newaliascnt{convention}{theorem}
\newtheorem{convention}[convention]{Convention}
\aliascntresetthe{convention}

\crefname{theorem}{Theorem}{Theorems}
\crefname{lemma}{Lemma}{Lemmas}
\crefname{prop}{Proposition}{Propositions}
\crefname{corollary}{Corollary}{Corollaries}
\crefname{definition}{Definition}{Definitions}
\crefname{example}{Example}{Examples}
\crefname{notation}{Notation}{Notations}
\crefname{remark}{Remark}{Remarks}
\crefname{convention}{Convention}{Conventions}
\crefname{equation}{}{}

