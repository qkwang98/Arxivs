@article{Mason:2008,
	abstract = {We study the graded space ℋ($\rho$) of holomorphic vector-valued modular forms of integral weight associated to a 2-dimensional irreducible representation $\rho$ of SL(2,ℤ). When $\rho$(T) is unitary, a complete description of ℋ($\rho$) is given: the Poincar{\'e} series is calculated and it is shown that ℋ($\rho$) is a free module of rank 2 over the ring of (classical) holomorphic modular forms on SL(2,ℤ).},
	author = {Mason, Geoffrey},
