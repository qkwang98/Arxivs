@incollection{Merkurjev-equivariantKtheory,
author="Merkurjev, Alexander S.",
editor="Friedlander, Eric M.
and Grayson, Daniel R.",
title="Equivariant {K}-Theory",
bookTitle="Handbook of {K}-Theory",
year="2005",
publisher="Springer Berlin Heidelberg",
address="Berlin, Heidelberg",
pages="925--954",
abstract="The equivariant K-theory was developed by R. Thomason in [21]. Let an algebraic group G act on a variety X over a field F. We consider G-modules, i.e., {\$}{\$} {\backslash}mathcal{\{}O{\}}{\_}{\{}X{\}} {\$}{\$} -modules over X that are equipped with an G-action compatible with one on X. As in the non-equivariant case there are two categories: the abelian category ℳ(G; X) of coherent G-modules and the full subcategory {\$}{\$} {\backslash}mathcal{\{}P{\}}(G;X) {\$}{\$} consisting of locally free {\$}{\$} {\backslash}mathcal{\{}O{\}}{\_}{\{}X{\}} {\$}{\$} -modules. The groups K'n(G; X) and Kn(G; X) are defined as the K-groups of these two categories respectively.",
