@article{HeinigRost,
title = {On the inverses of Toeplitz-plus-Hankel matrices},
journal = {Linear Algebra and its Applications},
volume = {106},
pages = {39-52},
year = {1988},
issn = {0024-3795},
doi = {https://doi.org/10.1016/0024-3795(88)90021-3},
url = {https://www.sciencedirect.com/science/article/pii/0024379588900213},
author = {Georg Heinig and Karla Rost},
abstract = {It is well known that the inverses of Hankel and Toeplitz matrices can be represented as Bezoutians of polynomials. In the present note a Bezoutian-type formula for the inverses of Toeplitz-plus-Hankel matrices and a complete characterization of Toeplitz-plus-Hankel matrix inverses are given.}
}
