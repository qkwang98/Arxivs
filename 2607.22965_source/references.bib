@article{Bielawski1997,
author = {Bielawski, Roger},
title = {Hyperkähler Structures and Group Actions},
journal = {Journal of the London Mathematical Society},
volume = {55},
number = {2},
pages = {400-414},
doi = {10.1112/s0024610796004723},
url = {https://londmathsoc.onlinelibrary.wiley.com/doi/abs/10.1112/S0024610796004723},
abstract = {A 4n-dimensional Riemannian manifold (M, g) is hyperkähler if it possesses three anti-commuting complex structures I, J, K such that the metric g is Kähler with respect to each of them. The reduced holonomy group of such a manifold is necessarily a subgroup of Sp(n) so the Ricci tensor of g vanishes and (M, g) can be regarded as a positive definite solution to Einstein's equations in vacuum.},
year = {1997}
}

