\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=black] (0) at (0, 0) {};
		\node [style=none] (1) at (1.5, 1) {};
		\node [style=none] (2) at (1.5, -1) {};
		\node [style=black] (3) at (-1.5, 0) {};
		\node [style=label] (4) at (2.25, 1) {$A$};
		\node [style=label] (5) at (2.25, -1) {$A$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (3) to (0);
		\draw [bend right] (0) to (2.center);
		\draw [bend left] (0) to (1.center);
		\draw (1.center) to (4);
		\draw (2.center) to (5);
	\end{pgfonlayer}
\end{tikzpicture}
