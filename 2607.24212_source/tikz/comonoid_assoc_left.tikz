\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=black] (0) at (-1, 0) {};
		\node [style=label] (3) at (-3, 0) {$A$};
		\node [style=black] (4) at (0.5, -1) {};
		\node [style=label] (5) at (2.5, 0) {$A$};
		\node [style=label] (6) at (2.5, -2) {$A$};
		\node [style=label] (9) at (2.5, 1) {$A$};
		\node [style=none] (10) at (0.5, 1) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (3) to (0);
		\draw [bend right] (4) to (6);
		\draw [bend left] (4) to (5);
		\draw (10.center) to (9);
		\draw [bend right] (10.center) to (0);
		\draw [bend right] (0) to (4);
	\end{pgfonlayer}
\end{tikzpicture}
