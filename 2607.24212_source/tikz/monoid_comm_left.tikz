\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=black] (0) at (0, 0) {};
		\node [style=none] (1) at (-1.5, 1) {};
		\node [style=none] (2) at (-1.5, -1) {};
		\node [style=label] (3) at (2, 0) {$A$};
		\node [style=label] (4) at (-3.5, 1) {$A$};
		\node [style=label] (5) at (-3.5, -1) {$A$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (3) to (0);
		\draw [bend left] (0) to (2.center);
		\draw [bend right] (0) to (1.center);
		\draw [in=0, out=180, looseness=0.75] (2.center) to (4);
		\draw [in=0, out=180, looseness=0.75] (1.center) to (5);
	\end{pgfonlayer}
\end{tikzpicture}