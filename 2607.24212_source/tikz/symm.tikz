\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=label] (8) at (1.5, 0.5) {$B$};
		\node [style=label] (11) at (-1.5, 0.5) {$A$};
		\node [style=label] (12) at (-1.5, -0.5) {$B$};
		\node [style=label] (13) at (1.5, -0.5) {$A$};
