\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (1, 0) {};
		\node [style=none] (13) at (0.5, -0.5) {};
		\node [style=none] (14) at (0.5, 0.5) {};
		\node [style=none] (16) at (-1, 0) {};
		\node [style=none] (19) at (-0.5, -0.5) {};
		\node [style=none] (20) at (-0.5, 0.5) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\path [fill=tapeBg] (14.center)
			 to (20.center)
			 to [bend right=45] (16.center)
			 to [bend right=45] (19.center)
			 to (13.center)
			 to [bend right=45] (0.center)
			 to [bend right=45] cycle;
	\end{pgfonlayer}
\end{tikzpicture}
