\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-0.25, 1) {};
		\node [style=none] (1) at (-0.25, -1) {};
		\node [style=none] (2) at (3.5, -1) {};
		\node [style=none] (3) at (3.5, 1) {};
		\node [style=none] (4) at (5.5, 0) {$=$};
		\node [style=none] (5) at (7.5, 1) {};
		\node [style=none] (6) at (7.5, -1) {};
		\node [style=none] (7) at (9.5, -1) {};
		\node [style=none] (8) at (9.5, 1) {};
		\node [style=none] (9) at (12, -1) {};
		\node [style=none] (10) at (12, 1) {};
		\node [style=none] (11) at (14, 1) {};
		\node [style=none] (12) at (14, -1) {};
		\node [style=none] (15) at (3, 0) {};
		\node [style=none] (17) at (11.5, 0) {};
		\node [style=none] (18) at (14, 0) {};
		\node [style=none] (19) at (1.25, 0) {$\Flip{\bot}$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=tape] (3.center)
			 to (0.center)
			 to (1.center)
			 to (2.center)
			 to cycle;
		\draw [style=tape] (6.center)
			 to (7.center)
			 to [bend right=90, looseness=1.25] (8.center)
			 to (5.center)
			 to cycle;
		\draw [style=tape] (11.center)
			 to (10.center)
			 to [bend right=90] (9.center)
			 to (12.center)
			 to cycle;
		\draw (17.center) to (18.center);
		\draw (19.center) to (15.center);
	\end{pgfonlayer}
\end{tikzpicture}
