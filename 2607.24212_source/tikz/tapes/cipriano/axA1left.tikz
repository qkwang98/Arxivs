\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=black] (0) at (0, 0) {};
		\node [style=none] (1) at (-3, 0) {};
		\node [style=none] (2) at (2, 1) {};
		\node [style=none] (3) at (2, -1) {};
		\node [style=none] (4) at (4, 1) {};
		\node [style=none] (5) at (4, 0) {};
		\node [style=none] (6) at (4, -2) {};
		\node [style=black] (7) at (2, -1) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (1.center) to (0);
		\draw [bend left] (0) to (2.center);
		\draw [bend right] (0) to (3.center);
		\draw [bend left] (3.center) to (5.center);
		\draw [bend right] (3.center) to (6.center);
		\draw (2.center) to (4.center);
	\end{pgfonlayer}
\end{tikzpicture}
