\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=black] (0) at (0, -1) {};
		\node [style=none] (1) at (-3, -1) {};
		\node [style=none] (2) at (2, 0) {};
		\node [style=none] (3) at (2, -2) {};
		\node [style=black] (7) at (2, -2) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (1.center) to (0);
		\draw [bend left] (0) to (2.center);
		\draw [bend right] (0) to (3.center);
	\end{pgfonlayer}
\end{tikzpicture}
