\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=black] (11) at (16, -1) {};
		\node [style=none] (12) at (13, -1) {};
		\node [style=none] (13) at (18, 0) {};
		\node [style=black] (16) at (18, 0) {};
		\node [style=none] (18) at (18, -2) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (12.center) to (11);
		\draw [bend left, looseness=0.75] (11) to (16);
		\draw [bend right, looseness=0.75] (11) to (18.center);
	\end{pgfonlayer}
\end{tikzpicture}
