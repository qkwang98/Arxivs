\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (1) at (-5, 0) {};
		\node [style=none] (2) at (-4, 0) {};
		\node [style=none] (3) at (-2.5, 0.5) {};
		\node [style=none] (4) at (-2.5, -0.5) {};
		\node [style=black] (5) at (-4, 0) {};
		\node [style=none] (6) at (-5.75, 0) {$\Flip{1}$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (1.center) to (5);
		\draw [bend left, looseness=0.75] (5) to (3.center);
		\draw [bend right, looseness=0.75] (5) to (4.center);
	\end{pgfonlayer}
\end{tikzpicture}
