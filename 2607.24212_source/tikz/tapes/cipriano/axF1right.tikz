\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=black] (11) at (13, -1) {};
		\node [style=none] (12) at (16, -1) {};
		\node [style=none] (13) at (11, 0) {};
		\node [style=none] (14) at (9, 1) {};
		\node [style=none] (15) at (9, -1) {};
		\node [style=black] (16) at (11, 0) {};
		\node [style=none] (17) at (9, -2) {};
		\node [style=none] (18) at (11, -2) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (12.center) to (11);
		\draw [bend right] (13.center) to (14.center);
