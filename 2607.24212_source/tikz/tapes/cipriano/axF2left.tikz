\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=black] (0) at (2, -1) {};
		\node [style=none] (1) at (4, -1) {};
		\node [style=none] (2) at (0, 0) {};
		\node [style=none] (3) at (0, -2) {};
		\node [style=none] (21) at (-3, -2) {};
		\node [style=none] (22) at (-3, 0) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (1.center) to (0);
		\draw [bend right] (0) to (2.center);
		\draw [bend left] (0) to (3.center);
		\draw [in=0, out=180] (2.center) to (21.center);
		\draw [in=0, out=180] (3.center) to (22.center);
	\end{pgfonlayer}
\end{tikzpicture}
