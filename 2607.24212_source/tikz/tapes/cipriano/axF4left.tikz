\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=black] (0) at (1.25, -1) {};
		\node [style=none] (1) at (3.25, -1) {};
		\node [style=none] (2) at (0, 0) {};
		\node [style=none] (3) at (0, -2) {};
		\node [style=black] (20) at (-1, 1) {};
		\node [style=none] (21) at (-3, 1) {};
		\node [style=none] (22) at (0, 2) {};
		\node [style=none] (23) at (0, 0) {};
		\node [style=none] (24) at (-3, -2) {};
		\node [style=none] (25) at (3.25, 2) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (1.center) to (0);
		\draw [bend right] (0) to (2.center);
		\draw [bend left] (0) to (3.center);
		\draw (21.center) to (20);
		\draw [bend left] (20) to (22.center);
		\draw [bend right] (20) to (23.center);
		\draw (24.center) to (3.center);
		\draw (22.center) to (25.center);
	\end{pgfonlayer}
\end{tikzpicture}
