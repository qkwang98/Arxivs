\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-1, 1) {};
		\node [style=none] (1) at (-1, -1) {};
		\node [style=none] (2) at (2, -1) {};
		\node [style=none] (3) at (2, 1) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style = tape](2.center)
			 to (3.center)
			 to (0.center)
			 to (1.center)
			 to cycle;
	\end{pgfonlayer}
\end{tikzpicture}
