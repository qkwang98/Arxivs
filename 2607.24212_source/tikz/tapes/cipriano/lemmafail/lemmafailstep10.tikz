\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (1) at (-0.25, 1) {};
		\node [style=none] (2) at (1, 0) {};
		\node [style=none] (3) at (-0.25, 1) {};
		\node [style=none] (4) at (-0.25, -1) {};
		\node [style=black] (5) at (1, 0) {};
		\node [style=none] (6) at (2.5, 0) {};
		\node [style=none] (7) at (-1, 1) {$\Flip{1}$};
		\node [style=none] (8) at (-1, -1) {$\Flip{0}$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [bend right=45] (2.center) to (3.center);
		\draw [bend left=45] (2.center) to (4.center);
		\draw (6.center) to (5);
	\end{pgfonlayer}
\end{tikzpicture}
