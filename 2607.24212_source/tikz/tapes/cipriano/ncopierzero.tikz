\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (2) at (0.5, 1) {};
		\node [style=none] (3) at (1.5, 1) {};
		\node [style=black] (4) at (1.5, 1) {};
		\node [style=none] (5) at (2.5, 2) {};
		\node [style=none] (6) at (2.5, 0) {};
		\node [style=none,scale=0.5] (7) at (0.5, 1.5) {$0$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (2.center) to (4);
		\draw [bend left, looseness=0.75] (4) to (5.center);
		\draw [bend right] (4) to (6.center);
	\end{pgfonlayer}
\end{tikzpicture}
