\begin{tikzpicture}[scale=0.7, {every node/.style}={scale=0.7}]
	\begin{pgfonlayer}{nodelayer}
		\node [style={white_dot}] (55) at (0, -0.75) {};
		\node [style=none] (56) at (-0.5, 0) {};
		\node [style=none] (57) at (0.5, 0) {};
		\node [style=none] (58) at (0, -1.5) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (58.center) to (55);
		\draw [bend left] (55) to (56.center);
		\draw [bend right] (55) to (57.center);
	\end{pgfonlayer}
\end{tikzpicture}
