%%% << Environments and Numbering >>
%=====================================================
% - Enumeration 
\RequirePackage{enumitem}


% - Equations ---------------------------
%[O] Option that changes how numbering works. 

%\ifoptionequal{/styleoptions/numberbasedon}{integer}{}{}
\ifoptionequal{/styleoptions/numberbasedon}{section}{%
	\numberwithin{equation}{section}}{}
\ifoptionequal{/styleoptions/numberbasedon}{subsection}{%
	\numberwithin{equation}{subsection}}{}
\ifoptionequal{/styleoptions/numberbasedon}{subsubsection}{%
	\numberwithin{equation}{subsubsection}}{}



% - Theorems ---------------------------------------
\newtheorem{theorem}[equation]{Theorem}
\newtheorem{deftheorem}[equation]{Definition/Theorem}
\newtheorem{proposition}[equation]{Proposition}
\newtheorem{corollary}[equation]{Corollary}
\newtheorem{lemma}[equation]{Lemma}
\newtheorem*{thm}{Theorem}
\newtheorem*{prop}{Proposition}
\newtheorem*{cor}{Corollary}
\newtheorem*{lem}{Lemma}
\newtheorem{conjecture}[equation]{Conjecture}
\renewcommand\qedsymbol{$\centerdot$}

% -- Named Theorem: ``\begin{namedtheorem}[Name of the Theorem]''
\newtheoremstyle{named}{}{}{\itshape}{}{\bfseries}{.}{.5em}{\thmname{#3} \thmnumber{#2}}
\theoremstyle{named}
\newtheorem{namedtheorem}[equation]{Theorem}

% -- Tagged Theorem: ``\begin{taggedtheorem}{NewTag}[subtitle]''
\theoremstyle{theorem}
\newtheorem{taggedtheoremx}{Theorem}
\newenvironment{taggedtheorem}[1]
	{\renewcommand\thetaggedtheoremx{#1}\taggedtheoremx}
	{\endtaggedtheoremx}
	
% - Definitions --------------------------------
\theoremstyle{definition}
\newtheorem{definition}[equation]{Definition}
\newtheorem*{defn}{Definition}
\newtheorem{example}[equation]{Example}
\newtheorem*{eg}{Example}
\newtheorem{claim}[equation]{Claim}
\newtheorem*{clm}{Claim}
\newtheorem{exercise}[equation]{Exercise}
\newtheorem*{exer}{Exercise}
\newtheorem{problem}[equation]{Problem}
\newtheorem*{prob}{Problem}
\newtheorem{notation}[equation]{Notation}
\newtheorem*{notn}{Notation}
\newtheorem{question}[equation]{Question}
\newtheorem*{questn}{Question}
\newtheorem{clause}[equation]{}

% - Remarks -------------------------------------
\theoremstyle{remark}
\newtheorem{remark}[equation]{Remark}
