\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{zzzams}[2023/02/25 Style file for generic math writing with amsart]

%%% || Options usage ||
% - For an <option> of type "toggle", change its value by passing <option>=true or <option>=false to zzzams. For example, \usepackage[moddedop=false]{zzzams}.
% - For an <option> of type "value", change its value by passing <option>={value} to zzzams. For example, \usepackage[numberbasedon={subsection}]{zzzams}.
% - Default values of options are described in || Options summary ||.

%%% || Options summary ||
% - moddedfootnotes: add footnote customizationstegers, without correlation with section numbers. See << Footnotes >> below for details. Default is true. 
% - moddedbib: customizes how bibliography items appear in text. See << Referencing and Citation >> below for details. Default is false. 
% - moddedsymb: enables symbol modifications/shortcuts. See << Math >> below for details. Default is true. 
% - moddedop: enables shortcuts for math operators/functors like "coker". See << Math >> below for details. Default is true.
% - fontshortcuts: enables font shortcuts. See << Fonts >> below for details. Default is true. 
% - extgraphics: loads the packages graphicx and wrapfig. Default is false.
% - eulatino: sets math font to Euler and text font to Palatino Linotype. Requires XeLaTeX. Default is false.
% - addressfirstpage: displays adress and contact information on the first page, instead of the last page. Default is true.
% - articlesectitle: make the section titles appear in the style of article document class. Default is false.
% - numberbasedon: change the level based on which equations are numbered. Since all environments are numbered based on equations, this also determines how environments are numbered. Accepted values are integer (meaning numbering with integers), section, subsection, and subsubsection. Default is section.
% - bibfile: change the bibliography file to use. Default is References.bib.
% - linespreadvalue: this value is fed into \linespread{-}. Default is 1.0.
% - marginvalue: this value is fed into \geometry{margin= - }. Default is 1in.
% - tableofcontentdepth: determines how deep the table of contents go. Accepted values are section, subsection, subsubsection, paragraph, subparagraph. Default is paragraph.

\RequirePackage{options}
\options{
	/styleoptions/.new                      family,  
	/styleoptions/moddedfootnotes/.new      toggle,
	/styleoptions/moddedbib/.new            toggle,
	/styleoptions/moddedsymb/.new           toggle,
	/styleoptions/moddedop/.new             toggle,
	/styleoptions/fontshortcuts/.new        toggle,
	/styleoptions/extgraphics/.new          toggle,
	/styleoptions/eulatino/.new             toggle,
	/styleoptions/pxpazo/.new               toggle,
	/styleoptions/addressfirstpage/.new     toggle,
	/styleoptions/articlesectitle/.new      toggle,
	/styleoptions/numberbasedon/.new        value = {section},
	/styleoptions/bibfile/.new              value = {References.bib},
	/styleoptions/linespreadvalue/.new      value = {1.0},
	/styleoptions/marginvalue/.new          value = {1in},
	/styleoptions/tableofcontentdepth/.new  value = {paragraph},
}

% Sets the following options to be true, unless user declares otherwise.
\options{/styleoptions/moddedfootnotes}
\options{/styleoptions/moddedsymb}
\options{/styleoptions/moddedop}
\options{/styleoptions/fontshortcuts}
\options{/styleoptions/addressfirstpage}

\options@ProcessOptions{/styleoptions}
%\ProcessOptions\relax


%%% << Why do I need to load these first? >>
%=====================================================
%[P] Math and Symbol packages --------------------
\RequirePackage{amssymb, mathtools, mathabx, extpfeil}

%[O][P] Option that uses Euler + Palatino fonts; requires XeLaTeX
\iftoggle{/styleoptions/eulatino}{%
	\RequirePackage{euler}
	\RequirePackage{fontspec}
	\setmainfont{Palatino Linotype}%
}{}

%[O][P] Option that uses NewPX + Pazo fonts
\iftoggle{/styleoptions/pxpazo}{%
	\RequirePackage{newpxtext}
	\RequirePackage{mathpazo}%
}{}
%-------------------------------------------------

%%% << Spacing and Layout>>
%==================================================
%[P] Geometry -------------------------------
\RequirePackage{geometry}
\linespread{\option{/styleoptions/linespreadvalue}}
\geometry{margin=\option{/styleoptions/marginvalue}}

%[O] Table of Contents ------------------------
% -- Set depth of printed sections 
%-1 part     1 section     3 subsubsection  5 subparagraph
% 0 chapter  2 subsection  4 paragraph
% tocdepth determines to which level the sectioning commands are printed in the ToC;
% secnumdepth determines to what level the sectioning titles are numbered.
\ifoptionequal{/styleoptions/tableofcontentdepth}{section}{%
	\setcounter{tocdepth}{1}}{}
\ifoptionequal{/styleoptions/tableofcontentdepth}{subsection}{%
	\setcounter{tocdepth}{2}}{}
\ifoptionequal{/styleoptions/tableofcontentdepth}{subsubsection}{%
	\setcounter{tocdepth}{3}}{}
\ifoptionequal{/styleoptions/tableofcontentdepth}{paragraph}{%
	\setcounter{tocdepth}{4}}{}
\ifoptionequal{/styleoptions/tableofcontentdepth}{subparagraph}{%
	\setcounter{tocdepth}{5}}{}
%\setcounter{secnumdepth}{4}

%[O] Put address on the first page
\iftoggle{/styleoptions/addressfirstpage}{
	\RequirePackage[foot]{amsaddr}}{}

%[O] Change section title styles to those in article document class
\iftoggle{/styleoptions/articlesectitle}{
	\usepackage[indentafter]{titlesec}
	\titleformat{name=\section}{}{\bfseries\thetitle.}{0.8em}{\large\centering\bfseries}
	}{}
%----------------------------------------------------

%%% << Footnotes >>
%==================================================
%[O][P] Option that refines footnotes
\iftoggle{/styleoptions/moddedfootnotes}{
	\RequirePackage[hang,flushmargin]{footmisc}
	%\RequirePackage[numberlinked=false]{footnotebackref}
	%\RequirePackage{bigfoot}
	%\addtolength{\footnotesep}{-1mm} % add space between two footnotes
	\renewcommand{\thefootnote}{[\arabic{footnote}]} % change footnote style
	%\interfootnotelinepenalty=100000 % Prevent footnote split, requires bigfoot package%
}{}
%--------------------------------------------------------------


%%% << Referencing and Citation >>
%===============================================================
%[P] Hyperref ------------------------------------
% Should be loaded after footnote packages to ensure the links go to the correct places.
\RequirePackage[bookmarks, bookmarksdepth=2, colorlinks=true, linkcolor=blue, citecolor=blue, urlcolor=blue, unicode]{hyperref}

%[P] Citation -------------------------------------
\RequirePackage[hyperref=true, style=alphabetic, isbn=false, url=false, giveninits=true, sorting=nyt, maxalphanames=5, minalphanames=5, maxbibnames=99]{biblatex}
\addbibresource{\option{/styleoptions/bibfile}} % Put your .bib file here
\RequirePackage{mathscinet}

%[O] Bibliography style customization
\iftoggle{/styleoptions/moddedbib}{%
	\DeclareLabelalphaTemplate{
		\labelelement{
			\field[final]{shorthand}
		}
		\labelelement{
			\field[ifnames=1, strwidth=3]{labelname}
			\field[ifnames=2, varwidth, strwidthmax=2]{labelname}
			\field[ifnames={3-}, varwidthlist, strwidthmax=2, names=4]{labelname}
		}
		\labelelement{
			\field[strwidth=2,strside=right]{year}
		}
	}
}{}

% -- Suppress page prefix ("p.") in citations
\DeclareFieldFormat{postnote}{#1}
\DeclareFieldFormat{multipostnote}{#1}
%--------------------------------------------------------------


%%% << Graphing >>
%========================================================
%[P] Tikz ----------------------------
\RequirePackage{tikz, tikz-cd}
\usetikzlibrary{matrix,positioning,arrows}
\tikzset{>=stealth}
\tikzcdset{arrow style=tikz, diagrams={>=stealth}}

% -- Vertical arrow label
\tikzset{rot90/.style={anchor=south, rotate=90, inner sep=.5mm}}

%[P] External graphics ------------------
%[O] Option that loads packages dealing with external graphics
\iftoggle{/styleoptions/extgraphics}{\RequirePackage{graphicx, wrapfig}}{}
