%[O] Option that disables everything under "Modifications/shortcuts"
\iftoggle{/styleoptions/moddedsymb}{
	% -- Miscellaneous modifications and shortcuts
	\newcommand{\inv}{^{-1}}
	\renewcommand{\le}{\leqslant}
	\renewcommand{\ge}{\geqslant}
	\newcommand{\widesim}[2][1.5]{\mathrel{\overset{#2}{\scalebox{#1}[1]{$\sim$}}}}
	\renewcommand{\forany}{\,\forall\,} 
	\newcommand{\thereis}{\,\exists\,}
	\newcommand{\modulo}{\mathbin{\text{mod}}}
	\newcommand{\surj}{\twoheadrightarrow}
	\newcommand{\surjects}{\xtwoheadrightarrow{}}
	\newcommand{\inj}{\hookrightarrow}
	\newcommand{\injects}{\xhookrightarrow{\;\;\;\;\;}}
	\newcommand{\bij}{\xrightarrow{\raisebox{-1.2ex}[0ex][1ex]{$\sim$}}}
	\newcommand{\bijects}{\xrightarrow{\,\raisebox{-1.2ex}[0ex][1ex]{$\widesim[1]{}$\,}}}
	\newcommand{\aro}{\xrightarrow{\;\;\;\;\;}}
	\newcommand{\acts}{\mathrel{\reflectbox{$\righttoleftarrow$}}}
	\newcommand{\racts}{\righttoleftarrow}
	\newcommand{\mapsfrom}{\reflectbox{$\mapsto$}}
	\newcommand{\eps}{\varepsilon}
	\newcommand{\xmapsfrom}[2][]{\ext@arrow3095\leftarrowfill@{#1}{#2}\mapsfromchar}
	%\newcommand{\cle}{\preccurlyeq}
	%\newcommand{\cge}{\succcurlyeq}
	%\newcommand{\xeq}[1]{\overset{\mathrm{#1}}{=\joinrel=}}
	%\newcommand{\xlongeq}[1]{\overset{\mathrm{#1}}{=\joinrel=\joinrel=\joinrel=}}
	%\newcommand{\Iaro}{\xmapsto{\,\,\,\,\,\,\,}}
	
	% -- [P] dotimes/lotimes: otimes with subscripts on the bottom. The l-version has "L" on top
	\RequirePackage{xparse}
	\NewDocumentCommand{\dotimes}{t_}{\IfBooleanTF{#1}{\otimeop}{\otimes}}
	\NewDocumentCommand{\otimeop}{m}{\mathbin{\mathop{\otimes}\displaylimits_{#1}}}
	\NewDocumentCommand{\lotimes}{t_}{\IfBooleanTF{#1}{\lotimeop}{\otimes}}
	\NewDocumentCommand{\lotimeop}{m}{\mathbin{\mathop{\overset{\mathrm{L}}{\otimes}}\displaylimits_{#1}}}
	
	% -- Squiggley arrow
	\usetikzlibrary{calc,decorations.pathmorphing,shapes}
	\newcounter{sarrow}
	\newcommand\xrsquigarrow[1]{%
		\stepcounter{sarrow}%
		\mathrel{\begin{tikzpicture}[baseline= {( $ (current bounding box.south) + (0,-0.5ex) $ )}]
			\node[inner sep=.5ex] (\thesarrow) {$\scriptstyle #1$};
			\path[draw,<-,decorate,
			decoration={zigzag,amplitude=0.7pt,segment length=1.2mm,pre=lineto,pre length=4pt}] 
			(\thesarrow.south east) -- (\thesarrow.south west);
			\end{tikzpicture}}%
	}
	
	% -- Double arrow with text
	\newextarrow{\xtwoarrows}{{20}{20}{20}{20}}
	{\bigRelbar\bigRelbar{\bigtwoarrowsleft\rightarrow\rightarrow}}
	
	% -- Exterior Product with the correct size
	\newcommand{\Exterior}{\mathchoice{{\textstyle\bigwedge}}%
		{{\bigwedge}}%
		{{\textstyle\wedge}}%
		{{\scriptstyle\wedge}}%
	}

	% -- Small matrix
	\newcommand\SmallMatrix[1]{{%
			\tiny\arraycolsep=0.3\arraycolsep\ensuremath{\begin{pmatrix}#1\end{pmatrix}}}}
	
	% -- Subalign: substack but with an alignment point
	\makeatletter
	\newcommand{\subalign}[1]{%
		\vcenter{%
			\Let@ \restore@math@cr \default@tag
			\baselineskip\fontdimen10 \scriptfont\tw@
			\advance\baselineskip\fontdimen12 \scriptfont\tw@
			\lineskip\thr@@\fontdimen8 \scriptfont\thr@@
			\lineskiplimit\lineskip
			\ialign{\hfil$\m@th\scriptstyle##$&$\m@th\scriptstyle{}##$\hfil\crcr
				#1\crcr
			}%
		}%
	}
	\makeatother
}{}

