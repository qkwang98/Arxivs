@article{HEINE2023108941,
	title = {An equivalence between enriched $\infty$-categories and $\infty$-categories with weak action},
	journal = {Advances in Mathematics},
	volume = {417},
	pages = {108941},
	year = {2023},
	issn = {0001-8708},
	doi = {https://doi.org/10.1016/j.aim.2023.108941},
	url = {https://www.sciencedirect.com/science/article/pii/S0001870823000841},
	author = {Hadrian Heine},
	keywords = {Higher algebra, Enrichment, Infinity categories, Infinity operads},
	abstract = {We show that an $\infty$-category M with a closed left action of a monoidal $\infty$-category V is completely determined by the V-valued graph of morphism objects resulting from closedness of the action equipped with the structure of a V-enrichment in the sense of Gepner-Haugseng. We prove a similar result when M is a V-enriched $\infty$-category in the sense of Lurie, an operadic generalization of the notion of $\infty$-category with closed action. Precisely, we prove that sending a V-enriched $\infty$-category in the sense of Lurie to the V-valued graph of morphism objects refines to an equivalence χ between the $\infty$-category of V-enriched $\infty$-categories in the sense of Lurie and of Gepner-Haugseng. Moreover if V is a presentably k+1-monoidal $\infty$-category for 1≤k≤$\infty$, we prove that χ restricts to a lax k-monoidal functor between the $\infty$-category of left V-modules in PrL, the symmetric monoidal $\infty$-category of presentable $\infty$-categories, endowed with the relative tensor product, and the tensor product of V-enriched $\infty$-categories of Gepner-Haugseng. As an application of our theory we construct a lax symmetric monoidal embedding of the $\infty$-category of small stable $\infty$-categories into the $\infty$-category of small spectral $\infty$-categories. As a second application we produce an enriched Yoneda-embedding in the framework of Lurie's notion of enriched $\infty$-categories.}
}
