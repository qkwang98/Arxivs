@incollection{GRAY197663,
	title = {Coherence for the Tensor Product of 2-Categories, and Braid Groups},
	editor = {Alex Heller and Myles Tierney},
	booktitle = {Algebra, Topology, and Category Theory},
	publisher = {Academic Press},
	pages = {63-76},
	year = {1976},
	isbn = {978-0-12-339050-9},
	doi = {https://doi.org/10.1016/B978-0-12-339050-9.50011-0},
	url = {https://www.sciencedirect.com/science/article/pii/B9780123390509500110},
	author = {John W. Gray},
	abstract = {Publisher Summary
	This chapter discusses coherence for the tensor product of 2-categories and for braid groups. A tensor product is defined between 2-categories that is part of a (nonsymmetric) monoidal closed category structure on the category of (small) 2-categories and 2-functors. The chapter presents a proof of this coherence, ab initio, by means of a representation of a certain category in the positive semigroup of an appropriate braid group. An n-dimensional cube, n ≥ 3, all of whose 3-dimensional faces commute, is commutative. If a permutation B can be obtained from A by interchanges moving a smaller number to the right of a larger one, then all sequences of interchanges accomplishing this have the same length.}
}


