@article{hilmanParametrisedPresentabilityOrbital2024,
  title = {Parametrised {{Presentability Over Orbital Categories}}},
  author = {Hilman, Kaif},
  year = 2024,
  month = jun,
  journal = {Applied Categorical Structures},
  volume = {32},
  number = {3},
  pages = {15},
  issn = {1572-9095},
  doi = {10.1007/s10485-024-09772-1},
  urldate = {2026-07-15},
  abstract = {In this paper, we develop the notion of presentability in the parametrised homotopy theory framework of Barwick et al. (Parametrized higher category theory and higher algebra: a general introduction, 2016) over orbital categories. We formulate and prove a characterisation of parametrised presentable categories in terms of its associated straightening. From this we deduce a parametrised adjoint functor theorem from the unparametrised version, prove various localisation results, and we record the interactions of the notion of presentability here with multiplicative matters. Such a theory is of interest for example in equivariant homotopy theory, and we will apply it in Hilman (Parametrised noncommutative motives and cubical descent in equivariant algebraic K-theory, 2022) to construct the category of parametrised noncommutative motives for equivariant algebraic K-theory.},
  langid = {english},
  keywords = {Equivariant homotopy theory,Parametrised category theory},
  file = {C:\Users\liamk\Zotero\storage\UBLXHRIV\Hilman - 2024 - Parametrised Presentability Over Orbital Categories.pdf}
}






