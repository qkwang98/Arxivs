doi = {https://doi.org/10.1016/j.jpaa.2023.107385},
url = {https://www.sciencedirect.com/science/article/pii/S0022404923000683},
author = {Karina Batistelli and Aram Bingham and David Plaza},
keywords = {Kazhdan-Lusztig polynomials, Affine Weyl group},
abstract = {In 1979 Kazhdan and Lusztig defined, for an arbitrary Coxeter system (W,S), a family of polynomials indexed by pairs of elements of W. Despite their relevance and elementary definition, the explicit computation of these polynomials is still one of the hardest open problems in algebraic combinatorics. In this paper we explicitly compute Kazhdan-Lusztig polynomials for a Coxeter system of type B˜2.}
}

