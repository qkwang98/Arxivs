/*
  One-dimensional semilinear subgroups below 2^18.

  Let q=p^d be a proper prime power and put n=q-1.  On writing every
  nonzero element of GF(q) as zeta^t, the group GammaL(1,q) has the
  presentation

      <s,f | s^n=f^d=1, s^f=s^p>,

  where s sends t to t+1 and f sends t to pt modulo n.  Every subgroup L
  has a unique description

      L=<s^u, f^r s^j>,

  in which u divides n, r divides d, 0<=j<u, c=d/r, and

      u divides j(1+p^r+...+p^((c-1)r)).                    (1)

  Indeed, <s^u> is L intersect <s>, while the image of L in the cyclic
  quotient by <s> is generated by f^r<s>.  A lift of f^r is unique modulo
  <s^u>, giving j modulo u.  Its c-th power is

      (f^r s^j)^c=s^(j(1+p^r+...+p^((c-1)r))),

  so (1) is necessary and sufficient.  The order of L is (n/u)c.

  The <s^u>-orbits on the exponents are the residue classes modulo u and
  have length n/u.  The second generator permutes these classes by

      t -> p^r t+j  (mod u).

  Hence the largest L-orbit has length n/u times the largest cycle of this
  affine permutation.  Its c-th power is the identity.  For k dividing c,
  its k-th power fixes t precisely when

      (p^(rk)-1)t = -j(1+p^r+...+p^((k-1)r))  (mod u).      (2)

  The number of solutions of (2) is either zero or gcd(p^(rk)-1,u).
  Subtracting the points of smaller least period determines every cycle
  length exactly, without constructing field vectors or their orbits.

  Every point stabiliser in GammaL(1,q) is cyclic.  If m_L is the largest
  L-orbit length, then

      n_L=m_L^2/|L|.

  Put tau_L=n_L^3.  Since nu(L)<=|L|, tau_L>|L| proves
  tau_L/nu(L)>1 immediately.  If tau_L=|L|, equality holds exactly when L
  is nilpotent.  Only when tau_L<|L| is nu(L) found from the subgroup
  classes of L.  This occurs for three small groups.
*/

requireEqual := procedure(description, found, expected)
    if found ne expected then
        error Sprintf("%o\nexpected: %o\nfound: %o",
                      description, expected, found);
    end if;
end procedure;

largestNilpotentOrder := function(L)
    if IsNilpotent(L) then
        return #L;
    end if;
    largest := 1;
    for class in Subgroups(L) do
        T := class`subgroup;
        if IsNilpotent(T) then
            largest := Max([largest, #T]);
        end if;
    end for;
    return largest;
end function;

geometricSum := function(a, k)
    return (a^k-1) div (a-1);
end function;

// Return the largest cycle length of t -> at+j on the residues modulo u,
// assuming that its c-th power is the identity.
largestAffineCycle := function(u, a, j, c)
    divisors := Divisors(c);
    Sort(~divisors);
    leastPeriodCounts := [];
    largest := 0;

    for k in divisors do
        common := GCD(a^k-1, u);
        if (j*geometricSum(a, k)) mod common eq 0 then
            fixed := common;
        else
            fixed := 0;
        end if;

        exact := fixed;
        for position in [1..#leastPeriodCounts] do
            smaller := divisors[position];
            if k mod smaller eq 0 then
                exact -:= leastPeriodCounts[position];
            end if;
        end for;

        if exact lt 0 or exact mod k ne 0 then
            error Sprintf(
                "The least-period count is inconsistent for u=%o, a=%o, j=%o, c=%o.",
                u, a, j, c);
        end if;
        Append(~leastPeriodCounts, exact);
        if exact gt 0 then
            largest := k;
        end if;
    end for;

    requireEqual("the affine cycles account for every residue",
                 &+leastPeriodCounts, u);
    if largest eq 0 then
        error "No affine cycle was found.";
    end if;
    return largest;
end function;

JParameterFormat := recformat<
    c, a, sum, g, step, classRepresentatives>;

/*
  For fixed u and r, let

      T=1+p^r+...+p^((c-1)r),   g=gcd(u,T).

  The solutions of (1) are j=k(u/g), with k modulo g.  Conjugation by s
  and f sends k respectively to

      k+(1-p^r)/(u/g)   and   pk  (mod g).

  Their orbits are precisely the GammaL(1,q)-conjugacy classes of subgroups
  having these fixed values of u and r.
*/
jParameterData := function(q, u, r)
    isPrimePower, p, d := IsPrimePower(q);
    assert isPrimePower;
    c := d div r;
    a := p^r;
    sum := geometricSum(a, c);
    g := GCD(u, sum);
    step := u div g;
    if (1-a) mod step ne 0 then
        error "The conjugation translation is not a valid j-parameter.";
    end if;
    delta := ((1-a) div step) mod g;

    seen := [false : i in [1..g]];
    representatives := [];
    for k in [0..g-1] do
        if not seen[k+1] then
            Append(~representatives, k);
            orbit := [k];
            seen[k+1] := true;
            position := 1;
            while position le #orbit do
                current := orbit[position];
                for image in [(current+delta) mod g, (p*current) mod g] do
                    if not seen[image+1] then
                        seen[image+1] := true;
                        Append(~orbit, image);
                    end if;
                end for;
                position +:= 1;
            end while;
        end if;
    end for;

    return rec<JParameterFormat |
        c := c,
        a := a,
        sum := sum,
        g := g,
        step := step,
        classRepresentatives := representatives>;
end function;

// Construct GammaL(1,q) on the exponents 0,...,q-2.  This is called only
// when tau_L<=|L|; it is not used to enumerate the subgroup parameters.
semilinearPermutationModel := function(q)
    isPrimePower, p, d := IsPrimePower(q);
    assert isPrimePower;
    n := q-1;
    symmetricGroup := Sym(n);
    singer := symmetricGroup![((t+1) mod n)+1 : t in [0..n-1]];
    frobenius := symmetricGroup![((p*t) mod n)+1 : t in [0..n-1]];
    semilinearGroup := sub<symmetricGroup | singer, frobenius>;

    requireEqual(Sprintf("order of GammaL(1,%o)", q),
                 #semilinearGroup, d*n);
    requireEqual(Sprintf("Singer generator order for q=%o", q),
                 Order(singer), n);
    requireEqual(Sprintf("Frobenius generator order for q=%o", q),
                 Order(frobenius), d);
    requireEqual(Sprintf("semilinear relation for q=%o", q),
                 singer^frobenius, singer^p);

    return semilinearGroup, singer, frobenius;
end function;

VerificationFormat := recformat<
    subgroupCount,
    classCount,
    belowOrderSubgroups,
    belowOrderClasses,
    equalOrderNilpotentSubgroups,
    equalOrderNilpotentClasses,
    belowOrderEqualitySubgroups,
    belowOrderEqualityClasses,
    belowOrderRecords,
    equalityRecords,
    hasEquality>;

verifyOneField := function(q)
    isPrimePower, p, d := IsPrimePower(q);
    assert isPrimePower and d gt 1;
    n := q-1;

    subgroupCount := 0;
    classCount := 0;
    belowOrderSubgroups := 0;
    belowOrderClasses := 0;
    equalOrderNilpotentSubgroups := 0;
    equalOrderNilpotentClasses := 0;
    belowOrderEqualitySubgroups := 0;
    belowOrderEqualityClasses := 0;
    belowOrderRecords := [];
    equalityRecords := [];
    hasEquality := false;
    modelConstructed := false;

    for u in Divisors(n) do
        for r in Divisors(d) do
            data := jParameterData(q, u, r);
            for k in [0..data`g-1] do
                j := k*data`step;
                requireEqual("the subgroup closing condition",
                             (j*data`sum) mod u, 0);
                orderL := (n div u)*data`c;

                if orderL gt 1 then
                    subgroupCount +:= 1;
                    isClassRepresentative :=
                        k in data`classRepresentatives;
                    if isClassRepresentative then
                        classCount +:= 1;
                    end if;

                    largestCycle := largestAffineCycle(
                        u, data`a, j, data`c);
                    largestOrbit := (n div u)*largestCycle;
                    nL := (Rationals()!(largestOrbit^2))/orderL;
                    tauL := nL^3;

                    if tauL le orderL then
                        if not modelConstructed then
                            semilinearGroup, singer, frobenius :=
                                semilinearPermutationModel(q);
                            modelConstructed := true;
                        end if;
                        L := sub<semilinearGroup |
                            singer^u, frobenius^r*singer^j>;
                        requireEqual(
                            "the order given by the subgroup parameters",
                            #L, orderL);

                        if tauL eq orderL then
                            if IsNilpotent(L) then
                                hasEquality := true;
                                Append(~equalityRecords,
                                    <q, <u,r,j>, orderL, largestOrbit,
                                     nL, orderL, tauL/orderL>);
                                equalOrderNilpotentSubgroups +:= 1;
                                if isClassRepresentative then
                                    equalOrderNilpotentClasses +:= 1;
                                end if;
                            end if;
                        else
                            belowOrderSubgroups +:= 1;
                            if isClassRepresentative then
                                belowOrderClasses +:= 1;
                            end if;
                            nuL := largestNilpotentOrder(L);
                            value := tauL/nuL;
                            Append(~belowOrderRecords,
                                <q, <u,r,j>, orderL, largestOrbit,
                                 nL, nuL, value>);
                            if value lt 1 then
                                error Sprintf(
                                    "For q=%o the subgroup [u,r,j]=[%o,%o,%o] gives z_L n_L^3=%o.",
                                    q, u, r, j, value);
                            elif value eq 1 then
                                hasEquality := true;
                                belowOrderEqualitySubgroups +:= 1;
                                if isClassRepresentative then
                                    belowOrderEqualityClasses +:= 1;
                                end if;
                            end if;
                        end if;
                    end if;
                end if;
            end for;
        end for;
    end for;

    return rec<VerificationFormat |
        subgroupCount := subgroupCount,
        classCount := classCount,
        belowOrderSubgroups := belowOrderSubgroups,
        belowOrderClasses := belowOrderClasses,
        equalOrderNilpotentSubgroups := equalOrderNilpotentSubgroups,
        equalOrderNilpotentClasses := equalOrderNilpotentClasses,
        belowOrderEqualitySubgroups := belowOrderEqualitySubgroups,
        belowOrderEqualityClasses := belowOrderEqualityClasses,
        belowOrderRecords := belowOrderRecords,
        equalityRecords := equalityRecords,
        hasEquality := hasEquality>;
end function;

properPrimePowers := [];
for q in [2..2^18-1] do
    isPrimePower, p, d := IsPrimePower(q);
    if isPrimePower and d gt 1 then
        Append(~properPrimePowers, q);
    end if;
end for;
requireEqual("the number of proper prime powers below 2^18",
             #properPrimePowers, 149);

totalSubgroups := 0;
totalSubgroupClasses := 0;
belowOrderSubgroups := 0;
belowOrderClasses := 0;
equalOrderNilpotentSubgroups := 0;
equalOrderNilpotentClasses := 0;
belowOrderEqualitySubgroups := 0;
belowOrderEqualityClasses := 0;
belowOrderRecords := [];
equalityRecords := [];
equalityFields := [];

for q in properPrimePowers do
    result := verifyOneField(q);
    totalSubgroups +:= result`subgroupCount;
    totalSubgroupClasses +:= result`classCount;
    belowOrderSubgroups +:= result`belowOrderSubgroups;
    belowOrderClasses +:= result`belowOrderClasses;
    equalOrderNilpotentSubgroups +:=
        result`equalOrderNilpotentSubgroups;
    equalOrderNilpotentClasses +:= result`equalOrderNilpotentClasses;
    belowOrderEqualitySubgroups +:=
        result`belowOrderEqualitySubgroups;
    belowOrderEqualityClasses +:= result`belowOrderEqualityClasses;
    belowOrderRecords cat:= result`belowOrderRecords;
    equalityRecords cat:= result`equalityRecords;
    if result`hasEquality then
        Append(~equalityFields, q);
    end if;
    printf "q = %o: %o nontrivial subgroups in %o conjugacy classes.\n",
           q, result`subgroupCount, result`classCount;
end for;

requireEqual("the total number of nontrivial subgroups",
             totalSubgroups, 1896985);
requireEqual("the total number of nontrivial subgroup classes",
             totalSubgroupClasses, 17603);
requireEqual("subgroups with n_L^3 below |L|",
             belowOrderSubgroups, 3);
requireEqual("subgroup classes with n_L^3 below |L|",
             belowOrderClasses, 3);
requireEqual("nilpotent subgroup equality cases with n_L^3 = |L|",
             equalOrderNilpotentSubgroups, 1);
requireEqual("nilpotent class equality cases with n_L^3 = |L|",
             equalOrderNilpotentClasses, 1);
requireEqual("subgroup equality cases with n_L^3 below |L|",
             belowOrderEqualitySubgroups, 0);
requireEqual("class equality cases with n_L^3 below |L|",
             belowOrderEqualityClasses, 0);
requireEqual("the fields attaining equality", equalityFields, [9]);
requireEqual("the three subgroups with n_L^3 below |L|",
    belowOrderRecords,
    [<4,  <1,1,0>,  6,  3, 3/2,  3,   9/8>,
     <8,  <1,1,0>, 21,  7, 7/3,  7,  49/27>,
     <16, <1,1,0>, 60, 15, 15/4, 15, 225/64>]);
requireEqual("the nontrivial equality case",
    equalityRecords,
    [<9, <2,1,0>, 8, 4, Rationals()!2, 8, Rationals()!1>]);

printf "All 1,896,985 nontrivial subgroups belonging to the 149 proper prime powers q < 2^18 satisfy z_L n_L^3 >= 1.  ";
printf "They form 17,603 conjugacy classes, and equality occurs precisely for q = 9.  ";
printf "Exactly three subgroups have n_L^3 < |L|; exactly one has n_L^3 = |L| with L nilpotent; ";
printf "and none of the first three attains equality.\n";
quit;
