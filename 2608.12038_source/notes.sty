% somewhat tricky definition of lim and Lim

\newlength{\AGS@w}
\newlength{\AGS@h}

\newcommand{\AGS@underline}[2]%
{%
\settowidth{\AGS@w}{#1}%
\settoheight{\AGS@h}{#2}%
\makebox[0pt][l]{#1}\raisebox{-1.3\AGS@h}{\makebox[\AGS@w][s]{#2}}%
}

\renewcommand{\lim}{\mathop{\AGS@underline{$\mathrm{lim}$}{\leftarrowfill}}}
\newcommand{\colim}{\mathop{\AGS@underline{$\mathrm{lim}$}{\rightarrowfill}}}

\newcommand{\holim}{\mathop{\AGS@underline{$\mathrm{holim}$}{\leftarrowfill}}}
\newcommand{\hocolim}{\mathop{\AGS@underline{$\mathrm{holim}$}{\rightarrowfill}}}

