@article{ando_unitarizability_2016,
	title = {Unitarizability, {Maurey}–{Nikishin} factorization, and {Polish} groups of finite type},
	url = {http://arxiv.org/abs/1605.06909},
	abstract = {Let \${\textbackslash}textbackslashGamma\$ be a countable discrete group, and let \${\textbackslash}textbackslashpi{\textbackslash}textbackslashcolon {\textbackslash}textbackslashGamma{\textbackslash}textbackslashto \{{\textbackslash}textbackslashrm\{GL\}\}(H)\$ be a representation of \${\textbackslash}textbackslashGamma\$ by invertible operators on a separable Hilbert space \$H\$. We show that the semidirect product group \$G=H{\textbackslash}textbackslashrtimes\_\{{\textbackslash}textbackslashpi\}{\textbackslash}textbackslashGamma\$ is SIN (\$G\$ admits a two-sided invariant metric compatible with its topology) and unitarily representable (\$G\$ embeds into the unitary group \${\textbackslash}textbackslashmathcal\{U\}({\textbackslash}textbackslashellˆ2({\textbackslash}textbackslashmathbb N))\$), if and only if \${\textbackslash}textbackslashpi\$ is uniformly bounded, and that \${\textbackslash}textbackslashpi\$ is unitarizable if and only if \$G\$ is of finite type: that is, \$G\$ embeds into the unitary group of a II\$\_1\$-factor. Consequently, we show that a unitarily representable Polish SIN groups need not be of finite type, answering a question of Sorin Popa. The key point in our argument is an equivariant version of the Maurey–Nikishin factorization theorem for continuous maps from a Hilbert space to the space \$Lˆ0(X,m)\$ of all measurable maps on a probability space.},
	urlyear = {2016-11-20},
	journal = {arXiv:1605.06909 },
	author = {Ando, Hiroshi and Matsuzawa, Yasumichi and Thom, Andreas and Törnquist, Asger},
	month = may,
