@article{junge_ol_infty_2003,
	title = {On {OL}\_infty structures of nuclear {C}*-algebras},
	volume = {325},
	issn = {0025-5831, 1432-1807},
	url = {http://link.springer.com/article/10.1007/s00208-002-0384-7},
	doi = {10.1007/s00208-002-0384-7},
	abstract = {We study the local operator space structure of nuclear C * -algebras. It is shown that a C * -algebra is nuclear if and only if it is an ⬚⬚ℒ∞,λ space for some (and actually for every) λ{\textbackslash}textgreater6. The ⬚⬚ℒ∞ constant λ provides an interesting invariant for nuclear C * -algebras. Indeed, if ⬚⬚ is a nuclear C * -algebra, then we have 1≤⬚⬚ℒ∞(⬚⬚)≤6, and if ⬚⬚ is a unital nuclear C * -algebra with , we show that ⬚⬚ must be stably finite. We also investigate the connection between the rigid ⬚⬚ℒ∞,1+ structure and the rigid complete order ⬚⬚ℒ∞,1+ structure on C * -algebras, where the latter structure has been studied by Blackadar and Kirchberg in their characterization of strong NF C * -algebras. Another main result of this paper is to show that these two local structrues are actually equivalent on unital nuclear C * -algebras. We obtain this by showing that if a unital (nuclear) C * -algebra is a rigid ⬚⬚ℒ∞,1+ space, then it is inner quasi-diagonal, and thus is a strong NF algebra. It is also shown that if a unital (nuclear) C * -algebra is an ⬚⬚ℒ∞,1+ space, then it is quasi-diagonal, and thus is an NF algebra.},
	number = {3},
	urlyear = {2014-11-15},
	journal = {Mathematische Annalen},
	author = {Junge, Marius and Ozawa, Narutaka and Ruan, Zhong-Jin},
	year = {2003},
	pages = {449--483},
}

