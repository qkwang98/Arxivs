@article{mancinska_graph_2016,
	title = {Graph {Homomorphisms} for {Quantum} {Players}},
	volume = {118},
	issn = {00958956},
	url = {http://arxiv.org/abs/1212.1724},
	doi = {10.1016/j.jctb.2015.12.009},
	abstract = {A homomorphism from a graph \$X\$ to a graph \$Y\$ is an adjacency preserving mapping \$f:V(X) {\textbackslash}textbackslashrightarrow V(Y)\$. We consider a nonlocal game in which Alice and Bob are trying to convince a verifier with certainty that a graph \$X\$ admits a homomorphism to \$Y\$. This is a generalization of the well-studied graph coloring game. Via systematic study of quantum homomorphisms we prove new results for graph coloring. Most importantly, we show that the Lov{\textbackslash}textbackslash'\{a\}sz theta number of the complement lower bounds the quantum chromatic number, which itself is not known to be computable. We also show that some of our newly introduced graph parameters, namely quantum independence and clique numbers, can differ from their classical counterparts while others, namely quantum odd girth, cannot. Finally, we show that quantum homomorphisms closely relate to zero-error channel capacity. In particular, we use quantum homomorphisms to construct graphs for which entanglement-assistance increases their one-shot zero-error capacity.},
	journal = {Journal of Combinatorial Theory, Series B},
	author = {Mančinska, Laura and Roberson, David E.},
	month = may,
	year = {2016},
	keywords = {Mathematics - Combinatorics, Quantum Physics},
	pages = {228--267},
}

@article{severini_digraph_2003,
	title = {On the {Digraph} of a {Unitary} {Matrix}},
	volume = {25},
	issn = {0895-4798},
	url = {http://epubs.siam.org/doi/abs/10.1137/S0895479802410293},
	doi = {10.1137/S0895479802410293},
	abstract = {Given a matrix M of size n, the digraph D on n vertices is said to be the digraph ofM , when \$M\_\{ij\}{\textbackslash}textbackslashneq 0\$ if and only if (v,sub{\textbackslash}textgreateri,v,sub{\textbackslash}textgreaterj) is an arc of D. We give a necessary condition, called strong quadrangularity, for a digraph to be the digraph of a unitary matrix. With the use of such a condition, we show that a line digraph \${\textbackslash}textbackslashoverrightarrow\{L\}D\$ is the pattern of a unitary matrix if and only if D is Eulerian. It follows that, if D is strongly connected and \${\textbackslash}textbackslashoverrightarrow\{L\}D\$ is the digraph of a unitary matrix, then \${\textbackslash}textbackslashoverrightarrow\{L\}D\$ is Hamiltonian. We observe that strong quadrangularity is sufficient to show that disconnected strongly regular graphs are the digraphs of unitary matrices and that n-paths, n-paths with loops at each vertex, n-cycles, directed trees, and trees are not.},
	number = {1},
	journal = {SIAM Journal on Matrix Analysis and Applications},
	author = {Severini, S.},
	month = jan,
	year = {2003},
	pages = {295--300},
}

@article{avis_quantum_2006,
	title = {A {Quantum} {Protocol} to {Win} the {Graph} {Colouring} {Game} on {All} {Hadamard} {Graphs}},
	volume = {E89-A},
	issn = {1745-1337, 0916-8508},
	url = {http://search.ieice.org/bin/summary.php?id=e89-a_5_1378&category=A&year=2006&lang=E&abst=},
	abstract = {This paper deals with graph colouring games, an example of pseudo-telepathy, in which two players can convince a verifier that a graph {\textbackslash}textlessI{\textbackslash}textgreaterG{\textbackslash}textless/I{\textbackslash}textgreater is {\textbackslash}textlessI{\textbackslash}textgreaterc{\textbackslash}textless/I{\textbackslash}textgreater-colourable where {\textbackslash}textlessI{\textbackslash}textgreaterc{\textbackslash}textless/I{\textbackslash}textgreater is less than the chromatic number of the graph. They win the game if they convince the verifier. It is known that the players cannot win if they share only classical information, but they can win in some cases by sharing entanglement. The smallest known graph where the players win in the quantum setting, but not in the classical setting, was found by Galliard, Tapp and Wolf and has 32,768 vertices. It is a connected component of the Hadamard graph {\textbackslash}textlessI{\textbackslash}textgreaterG{\textbackslash}textlessSUB{\textbackslash}textgreaterN{\textbackslash}textless/SUB{\textbackslash}textgreater{\textbackslash}textless/I{\textbackslash}textgreater with {\textbackslash}textlessI{\textbackslash}textgreaterN{\textbackslash}textless/I{\textbackslash}textgreater={\textbackslash}textlessI{\textbackslash}textgreaterc{\textbackslash}textless/I{\textbackslash}textgreater=16. Their protocol applies only to Hadamard graphs where {\textbackslash}textlessI{\textbackslash}textgreaterN{\textbackslash}textless/I{\textbackslash}textgreater is a power of 2. We propose a protocol that applies to all Hadamard graphs. Combined with a result of Frankl, this shows that the players can win on any induced subgraph of {\textbackslash}textlessI{\textbackslash}textgreaterG{\textbackslash}textless/I{\textbackslash}textgreater{\textbackslash}textlessSUB{\textbackslash}textgreater12{\textbackslash}textless/SUB{\textbackslash}textgreater having 1609 vertices, with {\textbackslash}textlessI{\textbackslash}textgreaterc{\textbackslash}textless/I{\textbackslash}textgreater=12. Moreover combined with a result of Godsil and Newman, our result shows that all Hadamard graphs {\textbackslash}textlessI{\textbackslash}textgreaterG{\textbackslash}textlessSUB{\textbackslash}textgreaterN{\textbackslash}textless/SUB{\textbackslash}textgreater{\textbackslash}textless/I{\textbackslash}textgreater ({\textbackslash}textlessI{\textbackslash}textgreaterN{\textbackslash}textless/I{\textbackslash}textgreater ≥ 12) and {\textbackslash}textlessI{\textbackslash}textgreaterc{\textbackslash}textless/I{\textbackslash}textgreater={\textbackslash}textlessI{\textbackslash}textgreaterN{\textbackslash}textless/I{\textbackslash}textgreater yield pseudo-telepathy games.},
	number = {5},
	urlyear = {2017-09-20},
	journal = {IEICE TRANSACTIONS on Fundamentals of Electronics, Communications and Computer Sciences},
	author = {Avis, David and Hasegawa, Jun and Kikuchi, Yosuke and Sasaki, Yuuya},
	month = may,
	year = {2006},
	pages = {1378--1381},
}

