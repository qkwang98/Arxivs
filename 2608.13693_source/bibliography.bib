@article{mccoy_baire_1977,
	title = {Baire extensions},
	volume = {7},
	issn = {0016-660X},
	url = {https://www.sciencedirect.com/science/article/pii/0016660X7790006X},
	doi = {10.1016/0016-660X(77)90006-X},
	abstract = {A space is Baire if every nonempty open set is of second category. Every T1 space is shown to have a T1 Baire extension, and those Hausdorff spaces with Hausdorff Baire extensions are characterized. If a Hausdorff space has a Hausdorff Baire extension, then its Fomin H-closed extension is a Baire space. A problem by Mioduszewski issolved by giving an example of a minimal Hausdorff space that is the countable union of minimal Hausdorff, nowhere dense subsets. Every regular (not necessarily T1) space is shown to have a regular Baire extension if and only if every T3 space has a T3 Baire extension. Every completely regular (not necessarily T1) space is shown to have a completely regular Baire extension.},
	number = {1},
