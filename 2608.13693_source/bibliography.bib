	year = {2008},
	keywords = {⬚⬚ˆ\{⬚⬚\}-mapping space, ⬚⬚⬚⬚⬚⬚(0)-space, asymptotic compactness, Gromov-Hausdorff convergence, harmonic map, Measured metric space, Mosco convergence, resolvent, spectrum, the Poincaré inequality, Γ-convergence},
	pages = {35--75},
}

