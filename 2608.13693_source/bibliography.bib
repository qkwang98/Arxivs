	url = {http://arxiv.org/abs/0707.4215},
	abstract = {Consider two free measure preserving group actions \${\textbackslash}textbackslashGamma {\textbackslash}textbackslashactson (X, {\textbackslash}textbackslashmu), {\textbackslash}textbackslashDelta {\textbackslash}textbackslashactson (X, {\textbackslash}textbackslashmu)\$, and a measure preserving action \${\textbackslash}textbackslashDelta {\textbackslash}textbackslashactsonˆa (Z, {\textbackslash}textbackslashnu)\$ where \$(X, {\textbackslash}textbackslashmu), (Z, {\textbackslash}textbackslashnu)\$ are standard probability spaces. We show how to construct free measure preserving actions \${\textbackslash}textbackslashGamma {\textbackslash}textbackslashactsonˆc (Y, m)\$, \${\textbackslash}textbackslashDelta {\textbackslash}textbackslashactsonˆd (Y, m)\$ on a standard probability space such that \$E\_\{{\textbackslash}textbackslashDelta\}ˆd {\textbackslash}textbackslashsubset E\_\{{\textbackslash}textbackslashGamma\}ˆc\$ and \$d\$ has \$a\$ as a factor. This generalizes the standard notion of co-induction of actions of groups from actions of subgroups. We then use this construction to show that if \${\textbackslash}textbackslashGamma\$ is a countable non-amenable group, then \${\textbackslash}textbackslashGamma\$ admits continuum many orbit inequivalent free, measure preserving, ergodic actions on a standard probability space.},
	urlyear = {2016-08-06},
