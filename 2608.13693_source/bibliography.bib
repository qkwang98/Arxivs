@article{arveson_quantum_2008,
	title = {Quantum channels that preserve entanglement},
	volume = {343},
	issn = {0025-5831, 1432-1807},
	url = {http://link.springer.com/article/10.1007/s00208-008-0288-2},
	doi = {10.1007/s00208-008-0288-2},
	abstract = {Let M and N be full matrix algebras. A unital completely positive (UCP) map TeX\{{\textbackslash}textbackslashphi:M{\textbackslash}textbackslashto N\} is said to preserve entanglement if its inflation TeX\{{\textbackslash}textbackslashphi{\textbackslash}textbackslashotimes \{{\textbackslash}textbackslashrm id\}\_N : M{\textbackslash}textbackslashotimes N{\textbackslash}textbackslashto N{\textbackslash}textbackslashotimes N\} has the following property: for every maximally entangled pure state ρ of TeX\{N{\textbackslash}textbackslashotimes N\} , TeX\{{\textbackslash}textbackslashrho{\textbackslash}textbackslashcirc({\textbackslash}textbackslashphi{\textbackslash}textbackslashotimes \{{\textbackslash}textbackslashrm id\}\_N)\} is an entangled state of TeX\{M{\textbackslash}textbackslashotimes N\} . We show that there is a dichotomy in that every UCP map that is not entanglement breaking in the sense of Horodecki–Shor–Ruskai must preserve entanglement, and that entanglement preserving maps of every possible rank exist in abundance. We also show that with probability 1, all UCP maps of relatively small rank preserve entanglement, but that this is not so for UCP maps of maximum rank.},
	
	number = {4},
	urlyear = {2015-03-21},
	journal = {Mathematische Annalen},
	author = {Arveson, William},
	year = {2008},
	keywords = {general, Mathematics, 94B27, Primary: 46N50, Secondary: 81P68},
	pages = {757--771},
}

