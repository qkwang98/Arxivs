	doi = {10.1090/proc/12685},
	abstract = {We establish a new characterization of property (T) in terms of the Furstenberg entropy of nonsingular actions. Given any generating measure on a countable group , A. Nevo showed that a necessary condition for to have property (T) is that the Furstenberg -entropy values of the ergodic, properly nonsingular -actions are bounded away from zero. We show that this is also a sufficient condition.},
