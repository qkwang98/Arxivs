	issn = {0001-8708},
	shorttitle = {Ideals in {Triangulated} {Categories}},
	url = {https://www.sciencedirect.com/science/article/pii/S0001870898917352},
	doi = {10.1006/aima.1998.1735},
	abstract = {We begin by showing that in a triangulated category, specifying a projective class is equivalent to specifying an ideal I of morphisms with certain properties and that if I has these properties, then so does each of its powers. We show how a projective class leads to an Adams spectral sequence and give some results on the convergence and collapsing of this spectral sequence. We use this to study various ideals. In the stable homotopy category we examine phantom maps, skeletal phantom maps, superphantom maps, and ghosts. (A ghost is a map which induces the zero map of homotopy groups.) We show that ghosts lead to a stable analogue of the Lusternik–Schnirelmann category of a space, and we calculate this stable analogue for low-dimensional real projective spaces. We also give a relation between ghosts and the Hopf and Kervaire invariant problems. In the case ofA∞modules over anA∞ring spectrum, the ghost spectral sequence is a universal coefficient spectral sequence. From the phantom projective class we derive a generalized Milnor sequence for filtered diagrams of finite spectra, and from this it follows that the group of phantom maps fromXtoYcan always be described as alim←1group. The last two sections focus on algebraic examples. In the derived category of an abelian category we study the ideal of maps inducing the zero map of homology groups and find a natural setting for a result of Kelly on the vanishing of composites of such maps. We also explain how pure exact sequences relate to phantom maps in the derived category of a ring and give an example showing that phantoms can compose non-trivially.},
	number = {2},
	urlyear = {2024-12-07},
	journal = {Advances in Mathematics},
	author = {Christensen, J. Daniel},
	month = jun,
	year = {1998},
	keywords = {spectrum, Ideal, Brown representability, chain complex, derived category, ghost map, injective class, phantom map, projective class, pure extension, purity, real projective space, stable homotopy, superphantom, triangulated category},
	pages = {284--339},
	file = {Christensen - 1998 - Ideals in Triangulated Categories Phantoms, Ghost.pdf:C\:\\Users\\Martino Lupini\\Zotero\\storage\\A72FM3A7\\Christensen - 1998 - Ideals in Triangulated Categories Phantoms, Ghost.pdf:application/pdf},
