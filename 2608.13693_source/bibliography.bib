@article{grohe_pebble_2012,
	title = {Pebble {Games} and {Linear} {Equations}},
	volume = {558},
	url = {http://arxiv.org/abs/1204.1990},
	abstract = {We give a new, simplified and detailed account of the correspondence between levels of the Sherali-Adams relaxation of graph isomorphism and levels of pebble-game equivalence with counting (higher-dimensional Weisfeiler-Lehman colour refinement). The correspondence between basic colour refinement and fractional isomorphism, due to Tinhofer (1986, 1991) and Ramana, Scheinerman and Ullman (1994), is re-interpreted as the base level of Sherali-Adams and generalised to higher levels in this sense by Atserias and Maneva (2012) and Malkin (2014), who prove that the two resulting hierarchies interleave. In carrying this analysis further, we here give (a) a precise characterisation of the level-k Sherali-Adams relaxation in terms of a modified counting pebble game; (b) a variant of the Sherali-Adams levels that precisely match the k-pebble counting game; (c) a proof that the interleaving between these two hierarchies is strict. We also investigate the variation based on boolean arithmetic instead of real/rational arithmetic and obtain analogous correspondences and separations for plain k-pebble equivalence (without counting). Our results are driven by considerably simplified accounts of the underlying combinatorics and linear algebra.},
	urlyear = {2015-10-18},
	journal = {arXiv:1204.1990 [cs]},
	author = {Grohe, Martin and Otto, Martin},
	month = apr,
	year = {2012},
}

@article{pooya_simple_2014,
	title = {Simple reduced \${Lˆp}\$ operator crossed products with unique trace},
	url = {http://arxiv.org/abs/1402.3233},
	abstract = {In this article we study simplicity and traces of reduced \$Lˆp\$ operator crossed products \$Fˆp\_\{{\textbackslash}textbackslashmathrm\{r\}\}(G, A, {\textbackslash}textbackslashalpha)\$. Given \$p {\textbackslash}textbackslashin (1, {\textbackslash}textbackslashinfty)\$, let \$G\$ be a Powers group, and let \${\textbackslash}textbackslashalpha {\textbackslash}textbackslashcolon G {\textbackslash}textbackslashto Aut(A)\$ be an isometric action of \$G\$ on a unital \$Lˆp\$ operator algebra \$A\$ such that \$A\$ is \$G\$-simple. We prove that the reduced \$Lˆp\$ operator crossed product of \$A\$ by \$G\$, \$Fˆp\_\{{\textbackslash}textbackslashmathrm\{r\}\}(G, A, {\textbackslash}textbackslashalpha)\$, is simple. Moreover, we show that traces on \$Fˆp\_\{{\textbackslash}textbackslashmathrm\{r\}\}(G, A, {\textbackslash}textbackslashalpha)\$ are in correspondence with \$G\$-invariant traces on A. Our results generalize the results obtained by de la Harpe for reduced \$Cˆ*\$crossed products in 1985. By letting \$G\$ be a countable nonabelian free group as a special case, we recover an analogue of a result of Powers from 1975. For the case \$p = 1\$, it turns out that (reduced) \$Lˆp\$ operator group algebras are not simple.},
	urlyear = {2014-08-16},
	journal = {arXiv:1402.3233 },
	author = {Pooya, Sanaz and Hejazian, Shirin},
