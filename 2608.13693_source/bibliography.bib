@article{malicki_consequences_2014,
	title = {Consequences of the existence of ample generics and automorphism groups of homogeneous metric structures},
	abstract = {We define a criterion for a homogeneous, complete metric structure \$X\$ that implies that the automorphism group \${\textbackslash}textbackslashmbox\{Aut\}(X)\$ satisfies all the main consequences of the existence of ample generics: it has the small index property, the automatic continuity property, and uncountable cofinality for non-open subgroups. Then we verify it for the Urysohn space \${\textbackslash}textbackslashmbox\{U\}\$, the Lebesgue probability measure algebra \${\textbackslash}textbackslashmbox\{MALG\}\$, and the Hilbert space \${\textbackslash}textbackslashell\_2\$, thus proving that \${\textbackslash}textbackslashmbox\{Iso\}({\textbackslash}textbackslashmbox\{U\})\$, \${\textbackslash}textbackslashmbox\{Aut\}({\textbackslash}textbackslashmbox\{MALG\})\$, \$U({\textbackslash}textbackslashell\_2)\$, and \$O({\textbackslash}textbackslashell\_2)\$ share these properties. We also formulate a condition for \$X\$ which implies that every homomorphism of \${\textbackslash}textbackslashmbox\{Aut\}(X)\$ into a separable group \$K\$ with a left-invariant, complete metric, is trivial, and we verify it for \${\textbackslash}textbackslashmbox\{U\}\$, and \${\textbackslash}textbackslashell\_2\$.},
	urlyear = {2014-07-04},
