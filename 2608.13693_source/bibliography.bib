@article{goldbring_enforceable_2017,
	title = {Enforceable operator algebras},
	url = {http://arxiv.org/abs/1706.09048},
	abstract = {We adapt the classical notion of building models by games to the setting of continuous model theory. As an application, we study to what extent canonical operator algebras are enforceable models. For example, we show that the hyperfinite II\$\_1\$ factor is an enforceable II\$\_1\$ factor if and only if the Connes Embedding Problem has a positive solution. We also show that the set of continuous functions on the pseudoarc is an enforceable model of the theory of unital, projectionless, abelian {\textbackslash}textbackslashcstar-algebras and use this to show that it is the prime model of its theory.},
