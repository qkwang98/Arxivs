	volume = {129},
	issn = {0022-1236},
	url = {http://www.sciencedirect.com/science/article/pii/S0022123685710403},
	doi = {10.1006/jfan.1995.1040},
	abstract = {Let E and F be Banach spaces and T a bounded linear map from E into F. Using a certain perturbation function ƒ(·, T) we find a useful sufficient criterion that T maps the closed unit ball onto a closed set. Applying this to the quotient map from a C*-algebra A onto its quotient Banach space A/(L + R) by the sum L + R of closed left and right ideals L and R of A we obtain that the closed unit ball of A maps onto the closed unit ball of A/(L + R). This gives an independent description of the images of the right normalizer algebra Nr(D) and the normalizer algebra N(D) = Nl(D) ∩ Nr(D) of a hereditary C*-subalgebra D of A by the quotient map from A onto A/(cl(AD) + cl(DA)). We use this to prove a necessary and sufficient criterion for a C*-algebra B to be a C*-quotient-algebra of a C*-subalgebra of a C*-algebra A. The latter criterion will be applied in the situation where A equals the CAR-algebra in some forthcoming papers (cf. Section 6 for more details).},
	number = {1},
	urlyear = {2015-05-20},
	journal = {Journal of Functional Analysis},
	author = {Kirchberg, E.},
	month = apr,
	year = {1995},
	pages = {1--34},
}

