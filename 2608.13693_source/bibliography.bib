	volume = {51},
	issn = {0021-2172, 1565-8511},
	url = {http://link.springer.com/article/10.1007/BF02764724},
	doi = {10.1007/BF02764724},
	abstract = {If a locally compact groupG acts on a Lebesgue probability space (X, λ), it is natural to consider these conditions: (a) each group element preserves the class of λ, and (b) the action function is measurable. The latter is a weakening of the requirement that the action be Borel, providedX has a particular Borel structure as well as the σ-algebra of measurable sets. In this paper, we give an example showing that such an action need not be Borel relative to the given Borel structure, and prove that there is always a conull invariant subset and a new standard Borel structure on that subset for which the action is Borel. This is the meaning of the title.},
	
