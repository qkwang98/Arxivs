	abstract = {Suppose that H is a complex Hilbert space and that B(H) denotes the bounded linear operators on H. We show that every abelian, amenable operator algebra is similar to a C*-algebra. We do this by showing that if A is an abelian subalgebra of B(H) with the property that given any bounded representation \${\textbackslash}textbackslashvarrho: A {\textbackslash}textbackslashto B(H\_{\textbackslash}textbackslashvarrho)\$ of A on a Hilbert space \$H\_{\textbackslash}textbackslashvarrho\$, every invariant subspace of \${\textbackslash}textbackslashvarrho(A)\$ is topologically complemented by another invariant subspace of \${\textbackslash}textbackslashvarrho(A)\$, then A is similar to an abelian \$Cˆ*\$-algebra.},
	urlyear = {2014-10-29},
	journal = {arXiv:1311.2982 },
	author = {Marcoux, Laurent W. and Popov, Alexey I.},
	year = {2013},
}

