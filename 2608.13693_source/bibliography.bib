@article{gabe_lifting_2015,
	title = {Lifting theorems for completely positive maps},
	url = {http://arxiv.org/abs/1508.00389},
	abstract = {We prove an abstract lifting theorem for completely positive maps going out of exact \$Cˆ{\textbackslash}textbackslashast\$-algebras, where we may choose the lift to be weakly in some given closed operator convex cone. Given an action of a space \${\textbackslash}textbackslashmathsf X\$ on our \$Cˆ{\textbackslash}textbackslashast\$-algebras, we apply this theorem, together with an \${\textbackslash}textbackslashmathsf X\$-equivariant selection theorem, to prove that in most cases of interest, we may choose completely positive lifts which are \${\textbackslash}textbackslashmathsf X\$-equivariant. A consequence is, that if \${\textbackslash}textbackslashmathsf X\$ is a second countable topological space, \${\textbackslash}textbackslashmathfrak A\$ and \${\textbackslash}textbackslashmathfrak B\$ are separable, nuclear \$Cˆ{\textbackslash}textbackslashast\$-algebras over \${\textbackslash}textbackslashmathsf X\$, and the action of \${\textbackslash}textbackslashmathsf X\$ on \${\textbackslash}textbackslashmathfrak A\$ is continuous (if \${\textbackslash}textbackslashmathsf X\$ is Hausdorff this agrees with \${\textbackslash}textbackslashmathfrak A\$ being a continuous \$C\_0({\textbackslash}textbackslashmathsf X)\$-algebra), then \$E({\textbackslash}textbackslashmathsf X; {\textbackslash}textbackslashmathfrak A, {\textbackslash}textbackslashmathfrak B) {\textbackslash}textbackslashcong KK({\textbackslash}textbackslashmathsf X; {\textbackslash}textbackslashmathfrak A, {\textbackslash}textbackslashmathfrak B)\$ naturally. Combining this with a deep classification result of Kirchberg, shows that separable, nuclear, stable, strongly purely infinite \$Cˆ{\textbackslash}textbackslashast\$-algebras are strongly classified by ideal related \$E\$-theory. We apply this to prove a classification result using \$K\$-theory, for certain separable, nuclear, strongly purely infinite \$Cˆ{\textbackslash}textbackslashast\$-algebras where no restrictions are made on the primitive ideal spaces of these \$Cˆ{\textbackslash}textbackslashast\$-algebras. Consequently, if \${\textbackslash}textbackslashmathfrak A\$ is a separable, nuclear, strongly purely infinite \$Cˆ{\textbackslash}textbackslashast\$-algebra, then \${\textbackslash}textbackslashmathfrak A {\textbackslash}textbackslashotimes {\textbackslash}textbackslashmathcal O\_2 {\textbackslash}textbackslashcong {\textbackslash}textbackslashmathfrak A\$ if and only if every two-sided, closed ideal in \${\textbackslash}textbackslashmathfrak A\$ is \$KK\$-equivalent to zero.},
	urlyear = {2015-08-25},
	journal = {arXiv:1508.00389 },
	author = {Gabe, James},
	month = aug,
	year = {2015},
}

