	doi = {10.48550/arXiv.2506.17982},
	abstract = {We consider the natural generalization of the notion of the order of a phantom map from the topological setting to triangulated categories. When applied to the derived category of the category of countable flat modules over a countable Dedekind domain, this yields a notion of{\textbackslash}emph\{{\textbackslash} phantom extension\} of order \${\textbackslash}alpha {\textless}{\textbackslash}omega \_\{1\}\$. We provide a complexity-theoretic characterization of the module \${\textbackslash}mathrm\{Ph\}\% {\textasciicircum}\{{\textbackslash}alpha \}{\textbackslash}mathrm\{Ext\}{\textbackslash}left( C,A{\textbackslash}right) \$ of phantom extensions of order \${\textbackslash}alpha \$ with respect to the structure of {\textbackslash}emph\{phantom Polish module\} on \${\textbackslash}mathrm\{Ext\}{\textbackslash}left( C,A{\textbackslash}right) \$ obtained by considering it as an object of the left heart of the quasi-abelian category of Polish modules. We use this characterization to prove the following Dichotomy Theorem: either all the extensions of a countable flat module \$A\$ are trivial (which happens precisely when \$A\$ is divisible) or \$A\$ has phantom extensions of arbitrarily high order. By producing canonical phantom projective resolutions of order \${\textbackslash}alpha \$, we prove that phantom extensions of order \${\textbackslash}alpha \$ define on the category of countable flat modules an exact structure \${\textbackslash}mathcal\{E\}\_\{{\textbackslash}alpha \}\$ that is hereditary with enough projectives, and the functor \${\textbackslash}mathrm\{Ph\}{\textasciicircum}\{{\textbackslash}alpha \}\% {\textbackslash}mathrm\{Ext\}\$ is the derived functor of \${\textbackslash}mathrm\{Hom\}\$ with respect to \${\textbackslash}mathcal\{E\}\_\{{\textbackslash}alpha \}\$. We prove a Structure Theorem characterizing the objects of the class \${\textbackslash}mathcal\{P\}\_\{{\textbackslash}alpha \}\$ of countable flat modules that have {\textbackslash}emph\{projective length at most \}\${\textbackslash}alpha \$ (i.e., are \${\textbackslash}mathcal\{E\}\_\{{\textbackslash}alpha \}\$-projective) as the direct summands of colimits of presheaves of finite flat modules over well-founded forests of rank \$\% 1+{\textbackslash}alpha \$ regarded as ordered sets. This can be seen as the first analogue in the flat case of the classical Ulm Classification Theorem for torsion modules.},
	urldate = {2025-06-24},
	publisher = {arXiv},
	author = {Casarosa, Matteo and Lupini, Martino},
	month = jun,
	year = {2025},
	keywords = {Mathematics - Category Theory, Mathematics - Logic, Mathematics - K-Theory and Homology, Mathematics - Algebraic Topology, Mathematics - Commutative Algebra},
	file = {Preprint PDF:C\:\\Users\\lupin\\Zotero\\storage\\LNMMT334\\Casarosa and Lupini - 2025 - Projective length, phantom extensions, and the str.pdf:application/pdf},
}


