@article{lupini_definable_2020,
	title = {Definable {Eilenberg}--{Mac} {Lane} {Universal} {Coefficient} {Theorems}},
	url = {http://arxiv.org/abs/2009.10805},
	abstract = {We prove definable versions of the Universal Coefficient Theorems of Eilenberg--Mac Lane expressing the (Steenrod) homology groups of a compact metrizable space in terms of its integral cohomology groups, and the ({\textbackslash}v\{C\}ech) cohomology groups of a polyhedron in terms of its integral homology groups. Precisely, we show that, given a compact metrizable space \$X\$, a (not necessarily compact) polyhedron \$Y\$, and an abelian Polish group \$G\$ with the division closure property, there are natural definable exact sequences {\textbackslash}begin\{equation*\} 0{\textbackslash}rightarrow {\textbackslash}mathrm\{Ext\}{\textbackslash}left( H{\textasciicircum}\{n+1\}(X),G{\textbackslash}right) {\textbackslash}rightarrow H\_\{n\}(X;G){\textbackslash}rightarrow {\textbackslash}mathrm\{Hom\}{\textbackslash}left( H{\textasciicircum}\{n\}(X),G{\textbackslash}right) {\textbackslash}rightarrow 0 {\textbackslash}end\{equation*\} and {\textbackslash}begin\{equation*\} 0{\textbackslash}rightarrow {\textbackslash}mathrm\{Ext\}{\textbackslash}left( H\_\{n-1\}(Y),G{\textbackslash}right) {\textbackslash}rightarrow H{\textasciicircum}\{n\}(Y;G){\textbackslash}rightarrow {\textbackslash}mathrm\{Hom\}{\textbackslash}left( H\_\{n\}(Y),G{\textbackslash}right) {\textbackslash}rightarrow 0 {\textbackslash}end\{equation*\} which definably split, where \$H\_\{n\}(X;G)\$ is the \$n\$-dimensional definable homology group of \$X\$ with coefficients in \$G\$ and \$H{\textasciicircum}\{n\}(Y;G)\$ is the \$n\$ -dimensional definable cohomology group of \$Y\$ with coefficients in \$G\$. Both of these results are obtained as corollaries of a general algebraic Universal Coefficient Theorem relating the cohomology of a cochain complex of countable free abelian groups to the definable homology of its \$G\$-dual chain complex of Polish groups.},
	urlyear = {2021-10-12},
	journal = {arXiv:2009.10805 },
	author = {Lupini, Martino},
	month = oct,
	year = {2020},
	note = {arXiv: 2009.10805},
	keywords = {Mathematics - Logic, 54H05, 55N07 (Primary) 55N10, 18G10, 18G35 (Secondary), Mathematics - Algebraic Topology, Mathematics - K-Theory and Homology},
	file = {arXiv Fulltext PDF:C\:\\Users\\Martino Lupini\\Zotero\\storage\\3KCIC6K2\\Lupini - 2020 - Definable Eilenberg--Mac Lane Universal Coefficien.pdf:application/pdf},
}

@article{lupini_definable_2020-1,
	title = {Definable \${\textbackslash}mathrm\{{K}\}\$-homology of separable {C}*-algebras},
	url = {http://arxiv.org/abs/2008.13344},
	abstract = {In this paper we show that the \${\textbackslash}mathrm\{K\}\$-homology groups of a separable C*-algebra can be enriched with additional descriptive set-theoretic information, and regarded as definable groups. Using a definable version of the Universal Coefficient Theorem, we prove that the corresponding definable \${\textbackslash}mathrm\{K\}\$-homology is a finer invariant than the purely algebraic one, even when restricted to the class of UHF C*-algebras, or to the class of unital commutative C*-algebras whose spectrum is a \$1\$-dimensional connected subspace of \${\textbackslash}mathbb\{R\}{\textasciicircum}\{3\}\$.},
