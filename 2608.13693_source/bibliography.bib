	issn = {0022-1236},
	url = {http://www.sciencedirect.com/science/article/pii/0022123674900354},
	doi = {10.1016/0022-1236(74)90035-4},
	abstract = {A Hilbert bundle (p, B, X) is a type of fibre space p:B → X such that each fibre p−1(x) is a Hilbert space. However, p−1(x) may vary in dimension as x varies in X. We generalize the classical homotopy classification theory of vector bundles to a “homotopy” classification of certain Hilbert bundles. An (m, n)-bundle over the pair (X, A) is a Hilbert bundle (p, B, X) such that the dimension of p−1(x) is m for x in A and n otherwise. The main result here is that if A is a compact set lying in the “edge” of the metric space X (e.g. if X is a topological manifold and A is a compact subset of the boundary of X), then the problem of classifying (m, n)-bundles over (X, A) reduces to a problem in the classical theory of vector bundles. In particular, we show there is a one-to-one correspondence between the members of the orbit set, [A, Gm({\textbackslash}textlessimg height="13" border="0" style="vertical-align:bottom" width="14" alt="View the MathML source" title="View the MathML source" src="http://origin-ars.els-cdn.com/content/image/1-s2.0-0022123674900354-si1.gif"{\textbackslash}textgreatern)]/[X, U(n)] ¦ A, and the isomorphism classes of (m, n)-bundles over (X, A) which are trivial over X, A.},
	number = {3},
	urlyear = {2014-04-06},
	journal = {Journal of Functional Analysis},
	author = {Dupré, Maurice J},
	month = mar,
	year = {1974},
	pages = {244--278},
}

