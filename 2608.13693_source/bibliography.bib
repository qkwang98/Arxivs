@article{gardella_strongly_2018,
	title = {Strongly outer actions of amenable groups on \${\textbackslash}textbackslashmathcal\{{Z}\}\$-stable \${Cˆ}*\$-algebras},
	url = {http://arxiv.org/abs/1811.00447},
	abstract = {Let \$A\$ be a separable, unital, simple, \${\textbackslash}textbackslashmathcal\{Z\}\$-stable, nuclear \$Cˆ*\$-algebra, and let \${\textbackslash}textbackslashalpha{\textbackslash}textbackslashcolon G{\textbackslash}textbackslashto {\textbackslash}textbackslashmathrm\{Aut\}(A)\$ be an action of a countable amenable group. If the trace space \$T(A)\$ is a Bauer simplex and \${\textbackslash}textbackslashpartial\_eT(A)\$ has finite \$G\$-orbits, we show that \${\textbackslash}textbackslashalpha\$ is strongly outer if and only if \${\textbackslash}textbackslashalpha{\textbackslash}textbackslashotimes{\textbackslash}textbackslashmathrm\{id\}\_\{{\textbackslash}textbackslashmathcal\{Z\}\}\$ has the weak tracial Rokhlin property. If \$G\$ is finite, then these conditions are also equivalent to \${\textbackslash}textbackslashalpha{\textbackslash}textbackslashotimes{\textbackslash}textbackslashmathrm\{id\}\_\{{\textbackslash}textbackslashmathcal\{Z\}\}\$ having finite Rokhlin dimension (in fact, at most 2). When the covering dimension of \${\textbackslash}textbackslashpartial\_eT(A)\$ is finite, we prove that \${\textbackslash}textbackslashalpha\$ is cocycle conjugate to \${\textbackslash}textbackslashalpha{\textbackslash}textbackslashotimes{\textbackslash}textbackslashmathrm\{id\}\_\{{\textbackslash}textbackslashmathcal\{Z\}\}\$. In particular, the equivalences above hold for \${\textbackslash}textbackslashalpha\$ in place of \${\textbackslash}textbackslashalpha{\textbackslash}textbackslashotimes{\textbackslash}textbackslashmathrm\{id\}\_\{{\textbackslash}textbackslashmathcal\{Z\}\}\$. Our results generalize and extend a number of works by several authors, and constitute an important step towards developing a classification theory for strongly outer actions of amenable groups.},
	urlyear = {2019-02-11},
	journal = {arXiv:1811.00447 },
	author = {Gardella, Eusebio and Hirshberg, Ilan},
	month = nov,
	year = {2018},
	keywords = {Mathematics - Operator Algebras, Mathematics - Functional Analysis},
}

