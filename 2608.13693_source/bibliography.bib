	doi = {10.1016/j.jfa.2004.11.011},
	abstract = {For locally compact groups G and H let A(G)A(G) denote the Fourier algebra of G and B(H)B(H) the Fourier–Stieltjes algebra of H . Any continuous piecewise affine map α:Y⊂H→Gα:Y⊂H→G (where Y is an element of the open coset ring) induces a completely bounded homomorphism Φα:A(G)→B(H)Φα:A(G)→B(H) by setting Φαu=u∘αΦαu=u∘α on Y and Φαu=0Φαu=0 off of Y . We show that if G is amenable then any completely bounded homomorphism Φ:A(G)→B(H)Φ:A(G)→B(H) is of this form; and this theorem fails if G contains a discrete nonabelian free group. Our result generalises results of Cohen (Amer. J. Math. 82 (1960) 213–226), Host (Bull. Soc. Math. France (1986) 114) and of the first author (J. Funct. Anal. (2004) 213). We also obtain a description of all the idempotents in the Fourier–Stieltjes algebras which are contractive or positive definite.},
	number = {2},
	urlyear = {2014-04-01},
	journal = {Journal of Functional Analysis},
	author = {Ilie, Monica and Spronk, Nico},
