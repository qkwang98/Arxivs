	abstract = {This work is motivated by R{\textbackslash}textbackslashu\{a\}dulescu's result{\textbackslash}textasciitilde{\textbackslash}textbackslashcite\{R˘ad04\} on the comparison of \$Cˆ*\$-tensor norms on \$Cˆ*({\textbackslash}textbackslashF\_n){\textbackslash}textbackslashotimes Cˆ*({\textbackslash}textbackslashF\_n)\$. For unital \$Cˆ*\$-algebras \$A\$ and \$B\$, there are natural inclusions of \$A\$ and \$B\$ into the unital free product \$A{\textbackslash}textbackslashast\_1 B\$, the maximal tensor product \$A{\textbackslash}textbackslashotimes\_\{{\textbackslash}textbackslashmax\} B\$ and the minimal tensor product \$A{\textbackslash}textbackslashotimes\_\{{\textbackslash}textbackslashmin\} B\$. These inclusions define three operator system structures on the internal sum \$A+B\$. Partly using ideas from quantum entanglement theory, we prove various interrelations between these three operator systems. As an application, the present results yield a significant improvement over R{\textbackslash}textbackslashu\{a\}dulescu's bound. At the same time, this tight comparison is so general that it cannot be regarded as evidence for the QWEP conjecture.},
	number = {3},
