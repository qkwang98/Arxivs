@article{pogorzelski_banach_2012,
	title = {A {Banach} space-valued ergodic theorem for amenable groups and applications},
	url = {http://arxiv.org/abs/1205.3649},
	abstract = {In this paper we study unimodular amenable groups. The first part is devoted to results on the existence of uniform families of epsilon-quasi tilings for these groups. In this context, constructions of Ornstein and Weiss are extended by quantitative estimates for the covering properties of the corresponding decompositions. Afterwards, we apply the developed methods to obtain an abstract ergodic theorem for a class of functions mapping subsets of a countable, amenable group into some Banach space. This significantly extends and complements the previous results of Lenz, M{\textbackslash}textbackslash"uller, Schwarzenberger and Veseli{\textbackslash}textbackslash'c. Further, using the Lindenstrauss ergodic theorem, we describe a link of our results to classical ergodic theory. We conclude with two important applications: the uniform approximation of the integrated density of states on amenable Cayley graphs, as well as the almost-sure convergence of cluster densities in an amenable bond percolation model.},
	urlyear = {2015-04-11},
	journal = {arXiv:1205.3649 [math-ph]},
	author = {Pogorzelski, Felix and Schwarzenberger, Fabian},
	month = may,
	year = {2012},
	keywords = {Mathematics - Dynamical Systems, Mathematical Physics, Mathematics - Spectral Theory},
}

@article{danilenko_countable_2015,
	title = {Countable amenable groups are finitileable. {Dynamical} proof},
	url = {http://arxiv.org/abs/1503.01568},
	abstract = {We give a short dynamical proof of a recent theorem by Downarowicz, Huczek and Zhang that each infinite countable amenable group G is finitileable, i.e. G admits a tiling with finitely many almost invariant shapes. Moreover, it is shown that the symbolic dynamical system corresponding to this tiling is uniquely ergodic and of 0 topological entropy. We also prove a new version (related to the finitileability) of Rokhlin lemma for the measure preserving G-actions. A new version (related to the finitileability) of Rokhlin lemma for the measure preserving \$G\$-actions is proved. It is also obtained an affirmative answer to following question of D.{\textbackslash}textasciitildeRudolph: whether \$G\$ has a mixing free action of \$0\$ entropy?},
	urlyear = {2015-04-10},
	journal = {arXiv:1503.01568 },
	author = {Danilenko, Alexandre I.},
	month = mar,
	year = {2015},
	keywords = {Mathematics - Dynamical Systems, 37B05, 37A20, 37A35, 37B10, 20F99, 20P05, 37A15, 37A40},
}

