	doi = {10.1090/S0002-9947-10-04988-3},
	abstract = {We introduce a notion of Polish structure and, in doing so, provide a setting which allows the application of ideas and techniques from model theory, descriptive set theory, topology and the theory of profinite groups. We define a topological notion of independence in Polish structures and prove that it has some nice properties. Using this notion, we prove counterparts of some basic results from geometric stability theory in the context of small Polish structures. Then, we prove some structural theorems about compact groups regarded as Polish structures: each small, -stable compact -group is solvable-by-finite; each small compact -group of finite -rank is nilpotent-by-finite. Examples of small Polish structures and groups are also given.},
