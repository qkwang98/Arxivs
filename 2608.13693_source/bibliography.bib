	doi = {10.48550/arXiv.2210.01565},
	abstract = {Quantitative algebras are \${\textbackslash}Sigma\$-algebras acting on metric spaces, where operations are nonexpanding. Mardare, Panangaden and Plotkin introduced 1-basic varieties as categories of quantitative algebras presented by quantitative equations. We prove that for the category \${\textbackslash}mathsf\{UMet\}\$ of ultrametric spaces such varieties bijectively correspond to strongly finitary monads on \${\textbackslash}mathsf\{UMet\}\$. The same holds for the category \${\textbackslash}mathsf\{Met\}\$ of metric spaces, provided that strongly finitary endofunctors are closed under composition. For uncountable cardinals \${\textbackslash}lambda\$ there is an analogous bijection between varieties of \${\textbackslash}lambda\$-ary quantitative algebras and monads that are strongly \${\textbackslash}lambda\$-accessible. Moreover, we present a bijective correspondence between \${\textbackslash}lambda\$-basic varieties as introduced by Mardare et al and enriched, surjections-preserving \${\textbackslash}lambda\$-accesible monads on \${\textbackslash}mathsf\{Met\}\$. Finally, for general enriched \${\textbackslash}lambda\$-accessible monads on \${\textbackslash}mathsf\{Met\}\$ a bijective correspondence to generalized varieties is presented.},
