	abstract = {Given an arbitrary countable ordinal \${\textbackslash}alpha \$, we introduce the notion of type \$I\_\{{\textbackslash}alpha \}\$ C*-algebra and \${\textbackslash}alpha \$-subhomogeneous C*-algebra. When \${\textbackslash}alpha =0\$, these recover the notions of Fell C*-algebra and of commutative C*-algebra, respectively. When \${\textbackslash}alpha = n {\textless}{\textbackslash}omega \$, these recover the notions of type \$I\_\{n\}\$ C*-algebra and of \$n\$-subhomogeneous C*-algebra, respectively. We prove that a separable C*-algebra is liminary if and only if it is type \$I\_\{{\textbackslash}alpha \}\$ for some \${\textbackslash}alpha {\textless}{\textbackslash}omega \_\{1\}\$, and it is preliminary (i.e., has no infinite-dimensional irreducible representation) if and only if it is \${\textbackslash}alpha \$-subhomogeneous for some \${\textbackslash}alpha {\textless}{\textbackslash}omega \_\{1\}\$ . We also prove that for any countable ordinal \${\textbackslash}alpha \$ there exists a separable C*-algebra that is type \$I\_\{{\textbackslash}alpha \}\$ and not type \$I\_\{{\textbackslash}beta \}\$ for \${\textbackslash}beta {\textless}{\textbackslash}alpha \$, and a separable C*-algebra that is \${\textbackslash}alpha \$-subhomogeneous and not \${\textbackslash}beta \$-subhomogeneous for any \${\textbackslash}beta {\textless}{\textbackslash}alpha \$.},
	urldate = {2025-10-05},
	publisher = {arXiv},
	author = {Lupini, Martino},
	month = sep,
	year = {2025},
	note = {arXiv:2509.20980},
	keywords = {Mathematics - Functional Analysis, Mathematics - General Topology, Mathematics - Logic, Mathematics - Operator Algebras},
	file = {Preprint PDF:C\:\\Users\\lupin\\Zotero\\storage\\G6THJYKZ\\Lupini - 2025 - A new characterization of (pre)liminary C-algebras.pdf:application/pdf;Snapshot:C\:\\Users\\lupin\\Zotero\\storage\\CMQI7K75\\2509.html:text/html},
