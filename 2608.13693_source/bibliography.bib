@article{phillips_crossed_2013,
	title = {Crossed products of \${Lˆp}\$ operator algebras and the {K}-theory of {Cuntz} algebras on \${Lˆp}\$ spaces},
	url = {http://arxiv.org/abs/1309.6406},
	abstract = {For \$p {\textbackslash}textbackslashin [1, {\textbackslash}textbackslashinfty),\$ we define and study full and reduced crossed products of algebras of operators on \${\textbackslash}textbackslashsigma\$-finite \$Lˆp\$ spaces by isometric actions of second countable locally compact groups. We give universal properties for both crossed products. When the group is abelian, we prove the existence of a dual action on the full and reduced \$Lˆp\$ operator crossed products. When the group is discrete, we construct a conditional expectation to the original algebra which is faithful in a suitable sense. For a free action of a discrete group on a compact metric space \$X,\$ we identify all traces on the reduced \$Lˆp\$ operator crossed product, and if the action is also minimal we show that the reduced \$Lˆp\$ operator crossed product is simple. We prove that the full and reduced \$Lˆp\$ operator crossed products of an amenable \$Lˆp\$ operator algebra by a discrete amenable group are again amenable. We prove a Pimsner-Voiculescu exact sequence for the K-theory of reduced \$Lˆp\$ operator crossed products by \$\{{\textbackslash}textbackslashmathbb\{Z\}\}.\$ We show that the \$Lˆp\$ analogs \$\{{\textbackslash}textbackslashmathcal\{O\}\}\_dˆp\$ of the Cuntz algebras \$\{{\textbackslash}textbackslashmathcal\{O\}\}\_d\$ are stably isomorphic to reduced \$Lˆp\$ operator crossed products of stabilized \$Lˆp\$ UHF algebra by \$\{{\textbackslash}textbackslashmathbb\{Z\}\},\$ and show that \$K\_0 (\{{\textbackslash}textbackslashmathcal\{O\}\}\_dˆp) {\textbackslash}textbackslashcong \{{\textbackslash}textbackslashmathbb\{Z\}\} / (d - 1) \{{\textbackslash}textbackslashmathbb\{Z\}\}\$ and \$K\_1 (\{{\textbackslash}textbackslashmathcal\{O\}\}\_dˆp) = 0.\$},
	urlyear = {2014-01-26},
	journal = {arXiv:1309.6406 },
	author = {Phillips, N. Christopher},
	year = {2013},
	keywords = {Mathematics - Operator Algebras, Mathematics - Functional Analysis, 19K99, 46H05 (Primary) 19A49, 46H35, 46M20, 47L10 (Secondary)},
}

