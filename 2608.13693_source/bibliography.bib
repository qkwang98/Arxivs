@article{carrera_functorial_2024,
	title = {Functorial {Polar} {Functions} in {Compact} {Normal} {Joinfit} {Frames}},
	volume = {32},
	issn = {1572-9095},
	url = {https://doi.org/10.1007/s10485-024-09783-y},
	doi = {10.1007/s10485-024-09783-y},
	abstract = {\$\${\textbackslash}mathfrak \{KNJ\}\$\$is the category of compact normal joinfit frames and frame homomorphisms. \$\${\textbackslash}mathcal \{P\}F\$\$is the complete boolean algebra of polars of the frame F. A function \$\${\textbackslash}mathfrak \{X\}\$\$that assigns to each \$\$F {\textbackslash}in {\textbackslash}mathfrak \{KNJ\}\$\$a subalgebra \$\${\textbackslash}mathfrak \{X\}(F)\$\$of \$\${\textbackslash}mathcal \{P\}F\$\$that contains the complemented elements of F is a polar function. A polar function \$\${\textbackslash}mathfrak \{X\}\$\$is invariant (resp., functorial) if whenever \$\${\textbackslash}phi : F {\textbackslash}longrightarrow H {\textbackslash}in {\textbackslash}mathfrak \{KNJ\}\$\$is \$\${\textbackslash}mathcal \{P\}\$\$-essential (resp., skeletal) and \$\$p {\textbackslash}in {\textbackslash}mathfrak \{X\}(F)\$\$, then \$\${\textbackslash}phi (p){\textasciicircum}\{{\textbackslash}perp {\textbackslash}perp \} {\textbackslash}in {\textbackslash}mathfrak \{X\}(H)\$\$. \$\${\textbackslash}phi : F {\textbackslash}longrightarrow H {\textbackslash}in {\textbackslash}mathfrak \{KNJ\}\$\$is \$\${\textbackslash}mathfrak \{X\}\$\$-splitting if \$\${\textbackslash}phi \$\$is \$\${\textbackslash}mathcal \{P\}\$\$-essential and whenever \$\$p {\textbackslash}in {\textbackslash}mathfrak \{X\}(F)\$\$, then \$\${\textbackslash}phi (p){\textasciicircum}\{{\textbackslash}perp {\textbackslash}perp \}\$\$is complemented in H. \$\$F {\textbackslash}in {\textbackslash}mathfrak \{KNJ\}\$\$is \$\${\textbackslash}mathfrak \{X\}\$\$-projectable means that every \$\$p {\textbackslash}in {\textbackslash}mathfrak \{X\}(F)\$\$is complemented. For a polar function \$\${\textbackslash}mathfrak \{X\}\$\$and \$\$F {\textbackslash}in {\textbackslash}mathfrak \{KNJ\}\$\$, we construct the least \$\${\textbackslash}mathfrak \{X\}\$\$-splitting frame of F. Moreover, we prove that if \$\${\textbackslash}mathfrak \{X\}\$\$is a functorial polar function, then the class of \$\${\textbackslash}mathfrak \{X\}\$\$-projectable frames is a \$\${\textbackslash}mathcal \{P\}\$\$-essential monoreflective subcategory of \$\${\textbackslash}mathfrak \{KNJS\}\$\$, the category of \$\${\textbackslash}mathfrak \{KNJ\}\$\$-objects and skeletal maps (the case \$\${\textbackslash}mathfrak \{X\}= {\textbackslash}mathcal \{P\}\$\$is the result from Martínez and Zenk, which states that the class of strongly projectable \$\${\textbackslash}mathfrak \{KNJ\}\$\$-objects is a reflective subcategory of \$\${\textbackslash}mathfrak \{KNJS\}\$\$).},
	language = {en},
	number = {5},
	urldate = {2026-03-10},
	journal = {Applied Categorical Structures},
	author = {Carrera, Ricardo E.},
	month = aug,
	year = {2024},
	keywords = {18A40, {\textbackslash}mathcal \{P\}-essential, 06D22, Compact normal joinfit frames, Compact regular frames, Essential, Functorial polar functions, Polar functions},
	pages = {26},
	file = {Full Text PDF:C\:\\Users\\lupin\\Zotero\\storage\\AFWNVG9B\\Carrera - 2024 - Functorial Polar Functions in Compact Normal Joinfit Frames.pdf:application/pdf},
}

