	abstract = {We study the topological variant of Rokhlin dimension for topological dynamical systems (X,α,Zm)(X,α,Zm)(X,{\textbackslash}textbackslashalpha ,\{{\textbackslash}textbackslashmathbb \{Z\}\}ˆm) in the case, where XXX is assumed to have finite covering dimension. Finite Rokhlin dimension in this sense is a property that implies finite Rokhlin dimension of the induced action on C∗C∗\{{\textbackslash}textbackslashmathrm \{C\}\}ˆ\{* \}-algebraic level, as was discussed in a recent paper by Hirshberg, Winter and Zacharias. In particular, it implies under these conditions that the transformation group C∗C∗\{{\textbackslash}textbackslashmathrm \{C\}\}ˆ\{* \}-algebra has finite nuclear dimension. Generalizing partial results of Lindenstrauss and Gutman, we show that free ZmZm\{{\textbackslash}textbackslashmathbb \{Z\}\}ˆm-actions on finite-dimensional spaces satisfy a strengthened version of the so-called marker property, which yields finite Rokhlin dimension for such actions.},
	
	number = {3},
	urlyear = {2016-04-05},
	journal = {Proceedings of the London Mathematical Society},
	author = {Szabó, Gábor},
	month = mar,
	year = {2015},
	pages = {673--694},
}

@article{marcoux_abelian_2013,
