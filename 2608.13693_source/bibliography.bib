	doi = {10.1090/S0002-9947-09-04882-X},
	abstract = {Divergence functions of a metric space estimate the length of a path connecting two points , at distance avoiding a large enough ball around a third point . We characterize groups with non-linear divergence functions as groups having cut-points in their asymptotic cones. That property is weaker than the property of having Morse (rank 1) quasi-geodesics. Using our characterization of Morse quasi-geodesics, we give a new proof of the theorem of Farb-Kaimanovich-Masur that states that mapping class groups cannot contain copies of irreducible lattices in semi-simple Lie groups of higher ranks. It also gives a generalization of the result of Birman-Lubotzky-McCarthy about solvable subgroups of mapping class groups not covered by the Tits alternative of Ivanov and McCarthy.},
