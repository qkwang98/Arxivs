	abstract = {Let Alg L be a CSL algebra. We say that a family of linear maps δ = \{ δ n , δ n : Alg L → Alg L , n ∈ N \} is higher derivable at Ω ∈ Alg L if ∑ i + j = n δ i ( A ) δ j ( B ) = δ n ( Ω ) for all A , B ∈ Alg L with A B = Ω . In this paper, a necessary and sufficient condition for a family of linear maps δ = \{ δ n , n ∈ N \} on Alg L to be higher derivable at Ω ∈ Alg L is given. Moreover, we show that if there is a faithful projection P in L such that P Ω P and ( I − P ) Ω ( I − P ) are a left or right separating point in P Alg L P and ( I − P ) Alg L ( I − P ) respectively, then a family of linear maps δ = \{ δ n , n ∈ N \} on Alg L is higher derivable at Ω if and only if it is a higher derivation. In particular, if Alg L is an irreducible CDCSL algebra or a nest algebra, then a family of linear maps δ = \{ δ n , n ∈ N \} on Alg L is higher derivable at Ω ≠ 0 if and only if it is a higher derivation.},
	number = {4},
	urlyear = {2014-08-21},
	journal = {Expositiones Mathematicae},
	author = {Zhang, Xu and An, Runling and Hou, Jinchuan},
	year = {2013},
	keywords = {CDCSL algebras, Higher derivations, Nest algebras},
	pages = {392--404},
}

