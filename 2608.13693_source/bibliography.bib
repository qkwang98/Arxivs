@article{bergfalk_strong_2015,
	title = {Strong {Homology}, {Derived} {Limits}, and {Set} {Theory}},
	url = {http://arxiv.org/abs/1509.09267},
	abstract = {We consider the question of the additivity of strong homology. This entails isolating the set-theoretic content of the higher derived limits of an inverse system indexed by the functions from \${\textbackslash}textbackslashmathbb\{N\}\$ to \${\textbackslash}textbackslashmathbb\{N\}\$. We show that this system governs, at a certain level, the additivity of strong homology over sums of arbitrary cardinality. We show in addition that, under the Proper Forcing Axiom, strong homology is not additive, not even on closed subspaces of \${\textbackslash}textbackslashmathbb\{R\}ˆ4\$.},
	urlyear = {2019-03-18},
	journal = {arXiv:1509.09267 },
	author = {Bergfalk, Jeffrey},
	month = sep,
	year = {2015},
}

@article{melikhov_algebraic_2018,
	title = {Algebraic topology of {Polish} spaces: {I}. {Fine} shape},
	shorttitle = {Algebraic topology of {Polish} spaces},
	url = {https://arxiv.org/abs/1808.10228v1},
	abstract = {Fine shape of Polish spaces is a common "correction" of strong shape and compactly generated strong shape (which differ from each other essentially by permuting a direct limit with an inverse limit). For compacta fine shape coincides with strong shape, and in general it involves a stronger form of coherence which amounts to taking into account a natural topology on the indexing sets. Both Steenrod-Sitnikov homology and Čech cohomology are proved to be invariant under fine shape, which cannot be said of any previously known shape theory. In general, fine shape invariance of a (co)homology theory is a strong form of homotopy invariance which implies the map excision axiom.},
	
	urlyear = {2019-03-18},
	author = {Melikhov, Sergey A.},
	month = aug,
	year = {2018},
}

