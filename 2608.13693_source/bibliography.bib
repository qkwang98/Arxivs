@article{burton_topology_2015,
	title = {Topology and convexity in the space of actions modulo weak equivalence},
	url = {http://arxiv.org/abs/1501.04079},
	abstract = {We analyse the structure of the quotient \${\textbackslash}textbackslashmathrm\{A\}\_{\textbackslash}textbackslashsim({\textbackslash}textbackslashGamma,X,{\textbackslash}textbackslashmu)\$ of the space of measure-preserving actions of a countable discrete group by the relation of weak equivalence. This space carries a natural operation of convex combination. We show that the convex structure of \${\textbackslash}textbackslashmathrm\{A\}\_{\textbackslash}textbackslashsim({\textbackslash}textbackslashGamma,X,{\textbackslash}textbackslashmu)\$ is compatible with the topology, and as a consequence deduce that \${\textbackslash}textbackslashmathrm\{A\}\_{\textbackslash}textbackslashsim({\textbackslash}textbackslashGamma,X,{\textbackslash}textbackslashmu)\$ is path connected. Using ideas of Tucker-Drob we are able to give a complete description of the topological and convex structure of \${\textbackslash}textbackslashmathrm\{A\}\_{\textbackslash}textbackslashsim({\textbackslash}textbackslashGamma,X,{\textbackslash}textbackslashmu)\$ for amenable \${\textbackslash}textbackslashGamma\$ by identifying it with the simplex of invariant random subgroups. In particular we conclude that \${\textbackslash}textbackslashmathrm\{A\}\_{\textbackslash}textbackslashsim({\textbackslash}textbackslashGamma,X,{\textbackslash}textbackslashmu)\$ can be represented as a compact convex subset of a Banach space if and only if \${\textbackslash}textbackslashGamma\$ is amenable. We consider the space \${\textbackslash}textbackslashmathrm\{A\}\_\{{\textbackslash}textbackslashsim\_s\}({\textbackslash}textbackslashGamma,X,{\textbackslash}textbackslashmu)\$ of stable weak equivalence classes and show that is always a compact convex subset of a Banach space. For a free group \${\textbackslash}textbackslashmathbb\{F\}\_N\$, we show that if one restricts to the compact convex set \${\textbackslash}textbackslashmathrm\{FR\}\_\{{\textbackslash}textbackslashsim\_s\}({\textbackslash}textbackslashmathbb\{F\}\_N,X,{\textbackslash}textbackslashmu) {\textbackslash}textbackslashsubseteq {\textbackslash}textbackslashmathrm\{A\}\_\{{\textbackslash}textbackslashsim\_s\}({\textbackslash}textbackslashmathbb\{F\}\_N,X,{\textbackslash}textbackslashmu)\$ of the stable weak equivalence classes of free actions, the extreme points are dense in \${\textbackslash}textbackslashmathrm\{FR\}\_\{{\textbackslash}textbackslashsim\_s\}({\textbackslash}textbackslashmathbb\{F\}\_N,X,{\textbackslash}textbackslashmu)\$.},
	urlyear = {2015-10-24},
	journal = {arXiv:1501.04079 },
	author = {Burton, Peter},
	month = jan,
	year = {2015},
}

