	volume = {26},
	issn = {0097-5397},
	url = {http://epubs.siam.org.ezproxy.library.yorku.ca/doi/abs/10.1137/S0097539796300933},
	doi = {10.1137/S0097539796300933},
	abstract = {Recently a great deal of attention has been focused on quantum computation following a sequence of results [Bernstein and Vazirani, in Proc. 25th Annual ACM Symposium Theory Comput., 1993, pp. 11–20, SIAM J. Comput., 26 (1997), pp. 1277–1339], [Simon, in Proc. 35th Annual IEEE Symposium Foundations Comput. Sci., 1994, pp. 116–123, SIAM J. Comput., 26 (1997), pp. 1340–1349], [Shor, in Proc. 35th Annual IEEE Symposium Foundations Comput. Sci., 1994, pp. 124–134] suggesting that quantum computers are more powerful than classical probabilistic computers. Following Shor's result that factoring and the extraction of discrete logarithms are both solvable in quantum polynomial time, it is natural to ask whether all of \${\textbackslash}textbackslashNP\$ can be efficiently solved in quantum polynomial time. In this paper, we address this question by proving that relative to an oracle chosen uniformly at random with probability 1 the class \${\textbackslash}textbackslashNP\$ cannot be solved on a quantum Turing machine (QTM) in time \$o(2ˆ\{n/2\})\$. We also show that relative to a permutation oracle chosen uniformly at random with probability 1 the class \${\textbackslash}textbackslashNP {\textbackslash}textbackslashcap {\textbackslash}textbackslashcoNP\$ cannot be solved on a QTM in time \$o(2ˆ\{n/3\})\$. The former bound is tight since recent work of Grover [in \{{\textbackslash}textbackslashit Proc.{\textbackslash}textbackslash \$28\$th Annual ACM Symposium Theory Comput.\}, 1996] shows how to accept the class \${\textbackslash}textbackslashNP\$ relative to any oracle on a quantum computer in time \$O(2ˆ\{n/2\})\$.},
	number = {5},
	urlyear = {2015-12-17},
	journal = {SIAM Journal on Computing},
	author = {Bennett, C. and Bernstein, E. and Brassard, G. and Vazirani, U.},
	month = oct,
	year = {1997},
	pages = {1510--1523},
}

