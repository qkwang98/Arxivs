	abstract = {Let V be a norm-closed subset of the unit sphere of a Hilbert space H that is stable under multiplication by scalars of absolute value 1. A maximal vector (for V) is a unit vector ξ ∈ H whose distance to V is maximum d ( ξ , V ) = sup ‖ η ‖ = 1 d ( η , V ) , d ( ξ , V ) denoting the distance from ξ to the set V. Maximal vectors generalize the maximally entangled unit vectors of quantum theory. In general, under a mild regularity hypothesis on V, there is a norm on H whose restriction to the unit sphere achieves its minimum precisely on V and its maximum precisely on the set of maximal vectors. This “entanglement-measuring norm” is unique. There is a corresponding “entanglement-measuring norm” on the predual of B ( H ) that faithfully detects entanglement of normal states. We apply these abstract results to the analysis of entanglement in multipartite tensor products H = H 1 ⊗ ⋯ ⊗ H N , and we calculate both entanglement-measuring norms. In cases for which dim H N is relatively large with respect to the others, we describe the set of maximal vectors in explicit terms and show that it does not depend on the number of factors of the Hilbert space H 1 ⊗ ⋯ ⊗ H N − 1 .},
	number = {5},
	urlyear = {2015-11-27},
	journal = {Journal of Functional Analysis},
	author = {Arveson, William},
	month = mar,
	year = {2009},
	pages = {1476--1510},
}

