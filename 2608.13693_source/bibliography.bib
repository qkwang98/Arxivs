	url = {http://arxiv.org/abs/1611.04440},
	abstract = {We present a stable uniqueness theorem for non-unital C*-algebras. Generalized tracial rank one is defined for stably projectionless simple C*-algebras. Let \$A\$ and \$B\$ be two stably projectionless separable simple amenable C*-algebras with \$gTR(A){\textbackslash}textbackslashle 1\$and \$gTR(B){\textbackslash}textbackslashle 1.\$ Suppose also that \$KK(A, D)=KK(B,D)={\textbackslash}textbackslash\{0{\textbackslash}textbackslash\}\$ for all C*-algebras \$D.\$ Then \$A{\textbackslash}textbackslashcong B\$ if and only if they have the same tracial cones with scales. We also show that every separable simple C*-algebra, \$A\$ with finite nuclear dimension which satisfies the UCT with non-zero traces must have \$gTR(A){\textbackslash}textbackslashle 1\$ if \$K\_0(A)\$ is torsion. In the next part of this research, we show similar results without the restriction on \$K\$-theory.},
	urlyear = {2016-11-20},
	journal = {arXiv:1611.04440 },
	author = {Gong, Guihua and Lin, Huaxin},
	month = nov,
	year = {2016},
}

