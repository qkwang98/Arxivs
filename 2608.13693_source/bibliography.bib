	url = {http://arxiv.org/abs/1501.03466},
	doi = {10.48550/arXiv.1501.03466},
	abstract = {We investigate Banach space automorphisms \$T:{\textbackslash}ell\_{\textbackslash}infty/c\_0{\textbackslash}rightarrow{\textbackslash}ell\_{\textbackslash}infty/c\_0 \$ focusing on the possibility of representing their fragments of the form \$\$T\_\{B,A\}:{\textbackslash}ell\_{\textbackslash}infty(A)/c\_0(A){\textbackslash}rightarrow {\textbackslash}ell\_{\textbackslash}infty(B)/c\_0(B)\$\$ for \$A, B{\textbackslash}subseteq N\$ infinite by means of linear operators from \${\textbackslash}ell\_{\textbackslash}infty(A)\$ into \${\textbackslash}ell\_{\textbackslash}infty(B)\$, infinite \$A{\textbackslash}times B\$-matrices, continuous maps from \$B{\textasciicircum}*={\textbackslash}beta B{\textbackslash}setminus B\$ into \$A{\textasciicircum}*\$, or bijections from \$B\$ to \$A\$. This leads to the analysis of general linear operators on \${\textbackslash}ell\_{\textbackslash}infty/c\_0\$. We present many examples, introduce and investigate several classes of operators, for some of them we obtain satisfactory representations and for other give examples showing that it is impossible. In particular, we show that there are automorphisms of \${\textbackslash}ell\_{\textbackslash}infty/c\_0\$ which cannot be lifted to operators on \${\textbackslash}ell\_{\textbackslash}infty\$ and assuming OCA+MA we show that every automorphism of \${\textbackslash}ell\_{\textbackslash}infty/c\_0\$ with no fountains or with no funnels is locally, i.e., for some infinite \$A, B{\textbackslash}subseteq N\$ as above, induced by a bijection from \$B\$ to \$A\$. This additional set-theoretic assumption is necessary as we show that the continuum hypothesis implies the existence of counterexamples of diverse flavours. However, many basic problems, some of which are listed in the last section, remain open.},
	urlyear = {2022-06-29},
	publisher = {arXiv},
	author = {Koszmider, Piotr and Rodriguez-Porras, Cristóbal},
	month = jan,
	year = {2015},
	note = {arXiv:1501.03466 },
	keywords = {Mathematics - Logic, Mathematics - Operator Algebras, Mathematics - Functional Analysis, Mathematics - General Topology},
	file = {Koszmider and Rodriguez-Porras - 2015 - On automorphisms of the Banach space \$ell_infty.pdf:C\:\\Users\\Martino Lupini\\Zotero\\storage\\J6ZKQ4VP\\Koszmider and Rodriguez-Porras - 2015 - On automorphisms of the Banach space \$ell_infty.pdf:application/pdf},
