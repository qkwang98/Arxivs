@article{holt_closure_2016,
	title = {Some closure results for {C}-approximable groups},
	url = {http://arxiv.org/abs/1601.01836},
	abstract = {We investigate closure results for \${\textbackslash}textbackslashC\$-approximable groups, for certain classes \${\textbackslash}textbackslashC\$ of groups with invariant length functions. In particular we prove, each time for certain (but not necessarily the same) classes \${\textbackslash}textbackslashC\$ that: {\textbackslash}textbackslashlinebreak (i) the direct product of two \${\textbackslash}textbackslashC\$-approximable groups is \${\textbackslash}textbackslashC\$-approximable; (ii) the restricted standard wreath product \$G {\textbackslash}textbackslashwr H\$ is \${\textbackslash}textbackslashC\$-approximable when \$G\$ is \$\{{\textbackslash}textbackslashmathcal C\}\$-approximable and \$H\$ is residually finite; and (iii) a group \$G\$ with normal subgroup \$N\$ is \$\{{\textbackslash}textbackslashmathcal C\}\$-approximable when \$N\$ is \$\{{\textbackslash}textbackslashmathcal C\}\$-approximable and \$G/N\$ is amenable. Our direct product result is valid for LEF, weakly sofic and hyperlinear groups, as well as for all groups that are approximable by finite groups equipped with commutator-contractive invariant length functions (considered by Thom). Our wreath product result is valid for weakly sofic groups, and we prove it separately for sofic groups. Our result on extensions by amenable groups is valid for weakly sofic groups, and was proved by Elek and Szabo for sofic groups \$N\$.},
	urlyear = {2016-08-29},
	journal = {arXiv:1601.01836 },
	author = {Holt, Derek F. and Rees, Sarah},
	month = jan,
	year = {2016},
	keywords = {Mathematics - Group Theory, 20F65, 20E22},
}

