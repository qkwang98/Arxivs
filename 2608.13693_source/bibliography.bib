@article{hartman_abramov_2014,
	title = {An {Abramov} formula for stationary spaces of discrete groups},
	volume = {34},
	issn = {1469-4417},
	url = {http://journals.cambridge.org/article_S0143385712001678},
	doi = {10.1017/etds.2012.167},
	abstract = {Let \$(G, {\textbackslash}textbackslashmu )\$ be a discrete group equipped with a generating probability measure, and let \${\textbackslash}textbackslashGamma \$ be a finite index subgroup of \$G\$ . A \${\textbackslash}textbackslashmu \$ -random walk on \$G\$ , starting from the identity, returns to \${\textbackslash}textbackslashGamma \$ with probability one. Let \$þeta \$ be the hitting measure, or the distribution of the position in which the random walk first hits \${\textbackslash}textbackslashGamma \$ . We prove that the Furstenberg entropy of a \$(G, {\textbackslash}textbackslashmu )\$ -stationary space, with respect to the action of \$({\textbackslash}textbackslashGamma , þeta )\$ , is equal to the Furstenberg entropy with respect to the action of \$(G, {\textbackslash}textbackslashmu )\$ , times the index of \${\textbackslash}textbackslashGamma \$ in \$G\$ . The index is shown to be equal to the expected return time to \${\textbackslash}textbackslashGamma \$ . As a corollary, when applied to the Furstenberg–Poisson boundary of \$(G, {\textbackslash}textbackslashmu )\$ , we prove that the random walk entropy of \$({\textbackslash}textbackslashGamma , þeta )\$ is equal to the random walk entropy of \$(G, {\textbackslash}textbackslashmu )\$ , times the index of \${\textbackslash}textbackslashGamma \$ in \$G\$ .},
	number = {03},
	urlyear = {2016-02-21},
	journal = {Ergodic Theory and Dynamical Systems},
	author = {Hartman, Yair and Lima, Yuri and Tamuz, Omer},
	month = jun,
	year = {2014},
	pages = {837--853},
}

@article{bowen_property_2016,
	title = {Property ({T}) and the {Furstenberg} entropy of nonsingular actions},
