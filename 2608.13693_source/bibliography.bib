	doi = {10.48550/arXiv.2210.07989},
	abstract = {We give a method of producing a Polish module over an arbitrary subring of \${\textbackslash}mathbb Q\$ from an ideal of subsets of \${\textbackslash}mathbb N\$ and a sequence in \${\textbackslash}mathbb N\$. The method allows us to construct two Polish \${\textbackslash}mathbb Q\$-vector spaces, \$U\$ and \$V\$, such that -- both \$U\$ and \$V\$ embed into \${\textbackslash}mathbb R\$ but -- \$U\$ does not embed into \$V\$ and \$V\$ does not embed into \$U\$, where by an embedding we understand a continuous \${\textbackslash}mathbb Q\$-linear injection. This construction answers a question of Frisch and Shinko. In fact, our method produces a large number of incomparable with respect to embeddings Polish \${\textbackslash}mathbb Q\$-vector spaces.},
