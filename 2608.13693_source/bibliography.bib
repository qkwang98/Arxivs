@article{brown_semicontinuity_2018,
	title = {Semicontinuity and closed faces of \${C}{\textasciicircum}*\$-algebras},
	volume = {3},
	issn = {2538-225X},
	url = {https://projecteuclid.org/journals/advances-in-operator-theory/volume-3/issue-1/Semicontinuity-and-closed-faces-of-C-algebras/10.22034/aot.1611-1048.full},
	doi = {10.22034/aot.1611-1048},
	abstract = {C. Akemann and G.K. Pedersen [Duke Math. J. 40 (1973), 785-795.] defined three concepts of semicontinuity for self-adjoint elements of \$A{\textasciicircum}\{**\}\$, the enveloping von Neumann algebra of a \$C{\textasciicircum}*\$-algebra \$A\$. We give the basic properties of the analogous concepts for elements of \$pA{\textasciicircum}\{**\}p\$, where \$p\$ is a closed projection in \$A{\textasciicircum}\{**\}\$. In other words, in place of affine functionals on \$Q\$, the quasi-state space of \$A\$, we consider functionals on \$F(p)\$, the closed face of \$Q\$ suppported by \$p\$. We prove an interpolation theorem: If \$h {\textbackslash}geq k\$, where \$h\$ is lower semicontinuous on \$F(p)\$ and \$k\$ upper semicontinuous, then there is a continuous affine functional \$x\$ on \$F(p)\$ such that \$k {\textbackslash}leq x {\textbackslash}leq h\$. We also prove an interpolation-extension theorem: Now \$h\$ and \$k\$ are given on \$Q\$, \$x\$ is given on \$F(p)\$ between \$h\_\{{\textbar}F(p)\}\$ and \$k\_\{{\textbar}F(p)\}\$, and we seek to extend \$x\$ to \${\textbackslash}widetilde x\$ on \$Q\$ so that \$k {\textbackslash}leq {\textbackslash}widetilde x {\textbackslash}leq h\$. We give a characterization of \$pM(A)\_\{\{{\textbackslash}mathrm\{sa\}\}\}p\$ in terms of semicontinuity. And we give new characterizations of operator convexity and strong operator convexity in terms of semicontinuity.},
	number = {1},
	urlyear = {2025-07-21},
	journal = {Advances in Operator Theory},
	author = {Brown, Lawrence G.},
	month = jan,
	year = {2018},
	note = {Publisher: Tusi Mathematical Research Group},
	keywords = {46L05, closed projection, operator algebras, operator convex, semicontinuity},
	pages = {17--41},
	file = {Full Text PDF:C\:\\Users\\lupin\\Zotero\\storage\\RAKDE68I\\Brown - 2018 - Semicontinuity and closed faces of \$C^\$-algebras.pdf:application/pdf},
}

