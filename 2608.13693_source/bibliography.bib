	issn = {0010-3616, 1432-0916},
	url = {http://link.springer.com.ezproxy.library.yorku.ca/article/10.1007/s00220-008-0665-4},
	doi = {10.1007/s00220-008-0665-4},
	abstract = {We prove that the C*-algebra of a minimal diffeomorphism satisfies Blackadar’s Fundamental Comparability Property for positive elements. This leads to the classification, in terms of K-theory and traces, of the isomorphism classes of countably generated Hilbert modules over such algebras, and to a similar classification for the closures of unitary orbits of self-adjoint elements. We also obtain a structure theorem for the Cuntz semigroup in this setting, and prove a conjecture of Blackadar and Handelman: the lower semicontinuous dimension functions are weakly dense in the space of all dimension functions. These results continue to hold in the broader setting of unital simple ASH algebras with slow dimension growth and stable rank one. Our main tool is a sharp bound on the radius of comparison of a recursive subhomogeneous C*-algebra. This is also used to construct uncountably many non-Morita-equivalent simple separable amenable C*-algebras with the same K-theory and tracial state space, providing a C*-algebraic analogue of McDuff’s uncountable family of II1 factors. We prove in passing that the range of the radius of comparison is exhausted by simple C*-algebras.},
	number = {2},
	urlyear = {2015-01-02},
	journal = {Communications in Mathematical Physics},
	author = {Toms, Andrew S.},
	month = jul,
	year = {2009},
	keywords = {Quantum Physics, Mathematical and Computational Physics, Statistical Physics, Complexity, Information and Physics, Quantum Computing, Relativity and Cosmology},
	pages = {401--433},
}

