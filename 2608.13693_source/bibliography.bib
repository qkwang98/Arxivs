@article{jasinski_ramsey_2013,
	title = {Ramsey precompact expansions of homogeneous directed graphs},
	url = {http://arxiv.org/abs/1310.6466},
	abstract = {In 2005, Kechris, Pestov and Todorcevic provided a powerful tool to compute an invariant of topological groups known as the universal minimal flow, immediately leading to an explicit representation of this invariant in many concrete cases. More recently, the framework was generalized allowing for further applications, and the purpose of this paper is to apply these new methods in the context of homogeneous directed graphs. In this paper, we show that the age of any homogeneous directed graph allows a Ramsey precompact expansion. Moreover, we verify the relative expansion properties and consequently describe the respective universal minimal flows.},
	urlyear = {2014-08-22},
	journal = {arXiv:1310.6466 },
	author = {Jasiński, Jakub and Laflamme, Claude and Van Thé, Lionel Nguyen and Woodrow, Robert},
