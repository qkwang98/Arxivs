MSC2010: 91A43 = Games involving graphs},
	keywords = {entanglement, fractional isomorphism, graph isomorphism, non-local games, non-signalling, quantum strategies},
	pages = {289--328},
	file = {Full Text:C\:\\Users\\Martino Lupini\\Zotero\\storage\\L7BIWG2A\\Atserias et al. - 2019 - Quantum and non-signalling graph isomorphisms.pdf:application/pdf},
