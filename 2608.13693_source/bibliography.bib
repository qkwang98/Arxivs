	keywords = {Field Theory, Gauge Group, Gauge Theory, Quantum Computing, Quantum Field Theory},
	pages = {389--416},
	file = {Full Text PDF:C\:\\Users\\Martino Lupini\\Zotero\\storage\\IBNPFEQ9\\Carey et al. - 1995 - Group actions on C-algebras, 3-cocycles and quant.pdf:application/pdf},
}

