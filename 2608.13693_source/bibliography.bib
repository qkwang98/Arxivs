@article{odden_baseleaf_2005-1,
	title = {The baseleaf preserving mapping class group of the universal hyperbolic solenoid},
	volume = {357},
	issn = {0002-9947, 1088-6850},
	url = {https://www.ams.org/tran/2005-357-05/S0002-9947-04-03472-5/},
	doi = {10.1090/S0002-9947-04-03472-5},
	abstract = {Given a closed surface , the covering solenoid is by definition the inverse limit of all finite covering surfaces over . If the genus of is greater than one, then there is only one homeomorphism type of covering solenoid; it is called the universal hyperbolic solenoid. In this paper we describe the topology of , the mapping class group of the universal hyperbolic solenoid. Central to this description is the notion of a virtual automorphism group. The main result is that there is a natural isomorphism of the baseleaf preserving mapping class group of onto the virtual automorphism group of . This may be regarded as a genus independent generalization of the theorem of Dehn, Nielsen, Baer, and Epstein that the pointed mapping class group is isomorphic to the automorphism group of .},
	
	number = {5},
	urlyear = {2019-06-06},
	journal = {Transactions of the American Mathematical Society},
	author = {Odden, Chris},
	year = {2005},
	keywords = {mapping class group, Teichmüller theory, Virtual automorphism},
	pages = {1829--1858},
}

