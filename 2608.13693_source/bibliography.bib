	url = {https://doi.org/10.1080/00927872.2024.2309525},
	doi = {10.1080/00927872.2024.2309525},
	abstract = {A ring extension is a ring homomorphism preserving identities. In this paper, we give the definitions of relative injective envelopes and relative projective covers of modules on ring extensions, and study their basic properties. In particular, we give their equivalent characterizations in terms of relative essential monomorphisms and relative superfluous epimorphisms, and prove that relative injective envelopes and relative projective covers on ring extensions are unique up to isomorphism whenever they exist. Moreover, for an extension of Artin algebras, we show that every finitely generated module has both a relative injective envelope and a relative projective cover. In addition, we compare relative injective envelopes and relative projective covers on two ring extensions linked by surjective homomorphisms of rings respectively.},
	number = {7},
