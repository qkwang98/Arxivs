@article{epstein_borel_2011,
	title = {The {Borel} complexity of von {Neumann} equivalence},
	url = {http://arxiv.org/abs/1109.2351},
	abstract = {We prove that for a countable discrete group \${\textbackslash}textbackslashGamma\$ containing a copy of the free group \${\textbackslash}textbackslashF\_n\$, for some \$2{\textbackslash}textbackslashleq n{\textbackslash}textbackslashleq{\textbackslash}textbackslashinfty\$, as a normal subgroup, the equivalence relations of conjugacy, orbit equivalence and von Neumann equivalence of the ergodic a.e. free actions of \${\textbackslash}textbackslashGamma\$ are analytic non-Borel equivalence relations in the Polish space of probability measure preserving \${\textbackslash}textbackslashGamma\$ actions. As a consequence we obtain that the isomorphism relation in the spaces of separably acting factors of type \${\textbackslash}textbackslashII\_1\$, \${\textbackslash}textbackslashII\_{\textbackslash}textbackslashinfty\$ and \${\textbackslash}textbackslashIII\_{\textbackslash}textbackslashlambda\$, \$0{\textbackslash}textbackslashleq{\textbackslash}textbackslashlambda{\textbackslash}textbackslashleq 1\$, are analytic and not Borel when these spaces are given the Effros Borel structure.},
	urlyear = {2016-08-06},
	journal = {arXiv:1109.2351 },
	author = {Epstein, Inessa and Tornquist, Asger},
	month = sep,
	year = {2011},
	keywords = {Mathematics - Group Theory, Mathematics - Logic, Mathematics - Operator Algebras, Mathematics - Dynamical Systems, 03E15, 37A20, 37A35, 28D15, 46L36},
}

@article{epstein_orbit_2007,
