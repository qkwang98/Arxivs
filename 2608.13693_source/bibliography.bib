@phdthesis{herman_totally_1997,
	address = {United States -- Oregon},
	type = {Ph.{D}.},
	title = {Totally disconnected locally compact topological groups},
	copyright = {Database copyright ProQuest LLC; ProQuest does not claim copyright in the individual underlying works.},
	url = {https://www.proquest.com/docview/304391816/abstract/510EB616208E4CBEPQ/1},
	abstract = {Let G be a totally disconnected locally compact topological group and let x be an element of G. Then a subgroup K is said to be tidy for x if K is a compact open subgroup of G which obeys certain algebraic and topological conditions. Willis showed that for every element x in a totally disconnected group G there exists at least one tidy subgroup. Associated with these tidy subgroups is a continuous scale function, mapping G into the positive integers. In this dissertation, several important examples of totally disconnected groups are analyzed, including GL(n, L) and SL(n, L), where L is a finite field extension of the p-adic numbers. An example is given in which the scale function maps G onto all of the positive integers. Several theorems are proved relating the scale function of G to that of its subgroups and quotient groups. A theorem is proved concerning the scale functions of semi-direct products of abelian groups, it is then generalized to a larger category of groups.},
	language = {English},
