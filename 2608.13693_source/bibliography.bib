	author = {Etedadialiabadi, Mahmood and Gao, Su and Le Maître, François and Melleray, Julien},
	month = nov,
	year = {2021},
	keywords = {Extension property for partial automorphisms (EPPA), HL-extension, Hrushovski property, Mixed identity free (MIF), Omnigenous, Ultraextensive},
