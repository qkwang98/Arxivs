@article{conti_endomorphisms_2012,
	title = {Endomorphisms of graph algebras},
	volume = {263},
	issn = {0022-1236},
	url = {http://www.sciencedirect.com/science/article/pii/S0022123612003278},
	doi = {10.1016/j.jfa.2012.08.024},
	abstract = {We initiate a systematic investigation of endomorphisms of graph C⁎C⁎-algebras C⁎(E)C⁎(E), extending several known results on endomorphisms of the Cuntz algebras OnOn. Most but not all of this study is focused on endomorphisms which permute the vertex projections and globally preserve the diagonal MASA DEDE of C⁎(E)C⁎(E). Our results pertain both automorphisms and proper endomorphisms. Firstly, the Weyl group and the restricted Weyl group of a graph C⁎C⁎-algebra are introduced and investigated. In particular, criteria of outerness for automorphisms in the restricted Weyl group are found. We also show that the restriction to the diagonal MASA of an automorphism which globally preserves both DEDE and the core AF-subalgebra eventually commutes with the corresponding one-sided shift. Secondly, we exhibit several properties of proper endomorphisms, investigate invertibility of localized endomorphisms both on C⁎(E)C⁎(E) and in restriction to DEDE, and develop a combinatorial approach to analysis of permutative endomorphisms.},
	number = {9},
	urlyear = {2014-03-06},
	journal = {Journal of Functional Analysis},
	author = {Conti, Roberto and Hong, Jeong Hee and Szymański, Wojciech},
	month = nov,
	year = {2012},
	keywords = {automorphism, endomorphism, Graph algebra, AF-subalgebra, Cuntz–Krieger algebra, MASA, Permutative endomorphism, Subshift},
	pages = {2529--2554},
}

@article{conti_weyl_2012,
	title = {The {Weyl} group of the {Cuntz} algebra},
	volume = {231},
	issn = {0001-8708},
	url = {http://www.sciencedirect.com/science/article/pii/S000187081200326X},
	doi = {10.1016/j.aim.2012.09.003},
	abstract = {The Weyl group of the Cuntz algebra OnOn is investigated. This is (isomorphic to) the group of polynomial automorphisms λuλu of OnOn, namely those induced by unitaries uu that can be written as finite sums of words in the canonical generating isometries SiSi and their adjoints. A necessary and sufficient algorithmic combinatorial condition is found for deciding when a polynomial endomorphism λuλu restricts to an automorphism of the canonical diagonal MASA. Some steps towards a general criterion for invertibility of λuλu on the whole of OnOn are also taken. A condition for verifying invertibility of a certain subclass of polynomial endomorphisms is given. First examples of polynomial automorphisms of OnOn not inner related to those induced by unitaries from the core UHF subalgebra are exhibited, for every n≥2n≥2. In particular, the image of the Weyl group in the outer automorphism group of OnOn is strictly larger than the image of the restricted Weyl group analyzed in previous papers. Results about the action of the Weyl group on the spectrum of the diagonal are also included.},
	number = {6},
	urlyear = {2014-03-06},
	journal = {Advances in Mathematics},
	author = {Conti, Roberto and Hong, Jeong Hee and Szymański, Wojciech},
	month = dec,
	year = {2012},
	keywords = {automorphism, Cuntz algebra, endomorphism, MASA, Cantor set},
	pages = {3147--3161},
}

