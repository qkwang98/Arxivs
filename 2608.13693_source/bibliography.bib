	doi = {10.1007/s00023-011-0121-4},
	abstract = {In this second paper, we study the case of substitution tilings of Rd\{\{{\textbackslash}textbackslashmathbb R\}ˆd\} . The substitution on tiles induces substitutions on the faces of the tiles of all dimensions j = 0, . . . , d − 1. We reconstruct the tiling’s equivalence relation in a purely combinatorial way using the AF-relations given by the lower dimensional substitutions. We define a Bratteli multi-diagram B\{\{{\textbackslash}textbackslashmathcal B\}\} which is made of the Bratteli diagrams Bj,j=0,…d\{\{{\textbackslash}textbackslashmathcal B\}ˆj, j=0, {\textbackslash}textbackslashldots d\} , of all those substitutions. The set of infinite paths in Bd\{\{{\textbackslash}textbackslashmathcal B\}ˆd\} is identified with the canonical transversal Ξ of the tiling. Any such path has a “border”, which is a set of tails in Bj\{\{{\textbackslash}textbackslashmathcal B\}ˆj\} for some j ≤ d, and this corresponds to a natural notion of border for its associated tiling. We define an étale equivalence relation RB\{\{{\textbackslash}textbackslashmathcal R\}\_\{{\textbackslash}textbackslashmathcal B\}\} on B\{\{{\textbackslash}textbackslashmathcal B\}\} by saying that two infinite paths are equivalent if they have borders which are tail equivalent in Bj\{\{{\textbackslash}textbackslashmathcal B\}ˆj\} for some j ≤ d. We show that RB\{\{{\textbackslash}textbackslashmathcal R\}\_\{{\textbackslash}textbackslashmathcal B\}\} is homeomorphic to the tiling’s equivalence relation RΞ\{\{{\textbackslash}textbackslashmathcal R\}\_{\textbackslash}textbackslashXi\} .},
	
	number = {2},
