@article{neshveyev_second_2011,
	title = {On second cohomology of duals of compact groups},
	volume = {22},
	issn = {0129-167X},
	url = {http://www.worldscientific.com/doi/abs/10.1142/S0129167X11007239},
	doi = {10.1142/S0129167X11007239},
	abstract = {We show that for any compact connected group G the second cohomology group defined by unitary invariant two-cocycles on Ĝ is canonically isomorphic to . This implies that the group of autoequivalences of the C*-tensor category Rep G is isomorphic to . We also show that a compact connected group G is completely determined by Rep G. More generally, extending a result of Etingof–Gelaki and Izumi–Kosaki we describe all pairs of compact separable monoidally equivalent groups. The proofs rely on the theory of ergodic actions of compact groups developed by Landstad and Wassermann and on its algebraic counterpart developed by Etingof and Gelaki for the classification of triangular semisimple Hopf algebras. We give a self-contained account of amenability of tensor categories, fusion rings and discrete quantum groups, and prove an analog of Radford's theorem on minimal Hopf subalgebras of quasitriangular Hopf algebras for compact quantum groups.},
	number = {09},
	urlyear = {2017-03-27},
	journal = {International Journal of Mathematics},
	author = {Neshveyev, Sergey and Tuset, Lars},
	month = sep,
	year = {2011},
	pages = {1231--1260},
}

@article{kasprzak_rieffel_2010,
	title = {Rieffel {Deformation} of {Group} {Coactions}},
	volume = {300},
	issn = {0010-3616, 1432-0916},
	url = {https://link.springer.com/article/10.1007/s00220-010-1093-9},
	doi = {10.1007/s00220-010-1093-9},
	abstract = {Let G be a locally compact group, Γ⊂GΓ⊂G\{{\textbackslash}textbackslashGamma{\textbackslash}textbackslashsubset G\} an abelian subgroup and let Ψ be a continuous 2-cocycle on the dual group {\textbackslash}textbackslashHatΓ{\textbackslash}textbackslashHatΓ\{{\textbackslash}textbackslashHat{\textbackslash}textbackslashGamma\}. Let B be a C*-algebra and ΔB∈Mor(B,B⊗C0(G))ΔB∈Mor(B,B⊗C0(G))\{{\textbackslash}textbackslashDelta\_B{\textbackslash}textbackslashin\{{\textbackslash}textbackslashrm Mor\}{\textbackslash}textbackslash,(B,B{\textbackslash}textbackslashotimes\{{\textbackslash}textbackslashrm C\}\_0(G))\} a continuous right coaction. Using Rieffel deformation, we can construct a quantum group (C0(G)Ψ{\textbackslash}textasciitilde⊗Ψ,ΔΨ)(C0(G)Ψ{\textbackslash}textasciitilde⊗Ψ,ΔΨ)\{(\{{\textbackslash}textbackslashrm C\}\_0(G)ˆ\{{\textbackslash}textbackslashtilde{\textbackslash}textbackslashPsi{\textbackslash}textbackslashotimes{\textbackslash}textbackslashPsi\},{\textbackslash}textbackslashDeltaˆ{\textbackslash}textbackslashPsi)\} and the deformed C*-algebra BΨ. The aim of this paper is to present a construction of the continuous coaction ΔΨBΔBΨ\{{\textbackslash}textbackslashDelta\_Bˆ{\textbackslash}textbackslashPsi\} of the quantum group (C0(G)Ψ{\textbackslash}textasciitilde⊗Ψ,ΔΨ)(C0(G)Ψ{\textbackslash}textasciitilde⊗Ψ,ΔΨ)\{(\{{\textbackslash}textbackslashrm C\}\_0(G)ˆ\{{\textbackslash}textbackslashtilde{\textbackslash}textbackslashPsi{\textbackslash}textbackslashotimes{\textbackslash}textbackslashPsi\},{\textbackslash}textbackslashDeltaˆ{\textbackslash}textbackslashPsi)\} on BΨ. The transition from the coaction ΔB to its deformed counterpart ΔΨBΔBΨ\{{\textbackslash}textbackslashDelta\_Bˆ{\textbackslash}textbackslashPsi\} is nontrivial in the sense that ΔΨBΔBΨ\{{\textbackslash}textbackslashDelta\_Bˆ{\textbackslash}textbackslashPsi\} contains complete information about ΔB. In order to illustrate our construction we apply it to the action of the Lorentz group on the Minkowski space obtaining a C*-algebraic quantum Minkowski space.},
	
	number = {3},
	urlyear = {2017-03-25},
	journal = {Communications in Mathematical Physics},
	author = {Kasprzak, P.},
	month = dec,
	year = {2010},
	pages = {741--763},
}

@article{kustermans_locally_2000-1,
	title = {Locally compact quantum groups},
	volume = {33},
	issn = {0012-9593},
	url = {http://www.sciencedirect.com/science/article/pii/S0012959300010557},
	doi = {10.1016/S0012-9593(00)01055-7},
	abstract = {In this paper we propose a simple definition of a locally compact quantum group in reduced form. By the word `reduced' we mean that we suppose the Haar weight to be faithful. So in fact we define and study an arbitrary locally compact quantum group, represented on the L2-space of its Haar weight. For this locally compact quantum group we construct the antipode with polar decomposition. We construct the associated multiplicative unitary and prove that it is manageable in the sense of Woronowicz. We define the modular element and prove the uniqueness of the Haar weights. Following [15] we construct the reduced dual, which will again be a reduced locally compact quantum group. Finally we prove that the second dual is canonically isomorphic to the original reduced locally compact quantum group, extending the Pontryagin duality theorem. Dans cet article nous proposons une définition simple des groupes quantiques localement compacts et réduits. L'adjectif ‘réduit’ exprime l'hypothèse de fidélité du poids de Haar. Nous définissons et étudions des groupes quantiques localement compacts arbitraires représentés sur l'espace L2 du poids de Haar. Nous construisons l'antipode de ce groupe quantique localement compact, ainsi que sa décomposition polaire. Nous construisons l'unitaire multiplicatif associé et nous démontrons qu'il est maniable au sens de Woronowicz. Nous définissons l'élément modulaire et démontrons l'unicité des poids de Haar. En nous inspirant de [15] nous construisons le dual réduit, qui est de nouveau un groupe quantique localement compact et réduit. Finalement, nous démontrons que le groupe quantique bidual est isomorphe au groupe quantique de départ, ce qui constitue une généralisation du théorème de dualité de Pontryagin.},
	number = {6},
	urlyear = {2017-03-25},
	journal = {Annales Scientifiques de l’École Normale Supérieure},
	author = {Kustermans, Johan and Vaes, Stefaan},
	month = nov,
	year = {2000},
	pages = {837--934},
}

@article{kasprzak_rieffel_2009,
	title = {Rieffel deformation via crossed products},
	volume = {257},
	issn = {0022-1236},
	url = {http://www.sciencedirect.com/science/article/pii/S0022123609002171},
	doi = {10.1016/j.jfa.2009.05.013},
	abstract = {We start from Rieffel data (A,Ψ,ρ), where A is a C∗-algebra, ρ is an action of an abelian group Γ on A and Ψ is a 2-cocycle on the dual group. Using Landstad theory of crossed product we get a deformed C∗-algebra AΨ. In the case of Γ=Rn we obtain a very simple proof of invariance of K-groups under the deformation. In the general case we also get a very simple proof that nuclearity is preserved under the deformation. We show how our approach leads to quantum groups and investigate their duality. The general theory is illustrated by an example of the deformation of SL(2,C). A description of it, in terms of noncommutative coordinates αˆ,βˆ,γˆ,δˆ, is given.},
	number = {5},
	urlyear = {2017-03-25},
	journal = {Journal of Functional Analysis},
	author = {Kasprzak, P.},
	month = sep,
	year = {2009},
	keywords = {quantum groups, -algebras},
	pages = {1288--1332},
}

@article{rainone_crossed_2016,
	title = {Crossed products of nuclear {C}*-algebras by free groups and their traces},
	url = {http://arxiv.org/abs/1601.06090},
	abstract = {We study the matricial field (MF) property for certain reduced crossed product C*-algebras and their traces. Using classification techniques and induced K-theoretic dynamics, we show that reduced crossed products of ASH-algebras of real rank zero by free groups are MF if and only if they are stably finite. We also examine traces on these crossed products and show they always admit certain finite dimensional approximation properties. Combining these results with recent progress in Elliott's Classification Program, it follows that if \$A\$ is a separable, simple, unital, nuclear, monotracial C*-algebra satisfying the UCT, then \$A {\textbackslash}textbackslashrtimes\_\{{\textbackslash}textbackslashlambda\} {\textbackslash}textbackslashmathbb\{F\}\_r\$ is MF for any action \${\textbackslash}textbackslashalpha\$. Appealing to a result of Ozawa, R\{{\textbackslash}textbackslasho\}rdam, and Sato, we show that discrete groups of the form \$G {\textbackslash}textbackslashrtimes {\textbackslash}textbackslashmathbb\{F\}\_r\$ with \$G\$ amenable admit MF reduced group C*-algebras In the process, some new permanence properties of MF algebras are obtained which are of independent interest. In particular, minimal tensor products of MF algebras are again MF provided one of the factors is exact.},
	urlyear = {2017-03-24},
	journal = {arXiv:1601.06090 },
	author = {Rainone, Timothy and Schafhauser, Christopher},
	month = jan,
	year = {2016},
	keywords = {Mathematics - Operator Algebras},
}

