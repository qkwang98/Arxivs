@misc{allison_class_2024,
	title = {The class and dynamics of {$\alpha $}-balanced {Polish} groups},
	url = {http://arxiv.org/abs/2406.06082},
	doi = {10.48550/arXiv.2406.06082},
	abstract = {For each ordinal \${\textbackslash}alpha{\textless}{\textbackslash}omega\_1\$, we introduce the class of \${\textbackslash}alpha\$-balanced Polish groups. These classes form a hierarchy that completely stratifies the space between the class of Polish groups admitting a two-side-invariant metric (TSI) and the class of Polish groups admitting a complete left-invariant metric (CLI). We establish various closure properties, provide connections to model theory, and we develop a boundedness principle for CLI groups by showing that \${\textbackslash}alpha\$-balancedness is an initial segment of a regular coanalytic rank. In the spirit of Hjorth's turbulence theory we also introduce "generic \${\textbackslash}alpha\$-unbalancedness": a new dynamical condition for Polish \$G\$-spaces which serves as an obstruction to classification by actions of \${\textbackslash}alpha\$-balanced Polish groups. We use this to provide, for each \${\textbackslash}alpha{\textless}{\textbackslash}omega\_1\$, an action of an \${\textbackslash}alpha\$-balanced Polish group whose orbit equivalence relation is strongly generically ergodic against actions of any \${\textbackslash}beta\$-balanced Polish group with \${\textbackslash}beta{\textless}{\textbackslash}alpha\$.},
	urlyear = {2024-12-28},
	publisher = {arXiv},
	author = {Allison, Shaun and Panagiotopoulos, Aristotelis},
	month = jun,
	year = {2024},
	note = {arXiv:2406.06082 },
	keywords = {Mathematics - Group Theory, Mathematics - Logic, Mathematics - Dynamical Systems, Mathematics - General Topology},
	file = {Preprint PDF:C\:\\Users\\Martino Lupini\\Zotero\\storage\\YE8BUFV2\\Allison and Panagiotopoulos - 2024 - The class and dynamics of \$α\$-balanced Polish grou.pdf:application/pdf},
}

@article{clemens_new_2022,
	title = {New jump operators on equivalence relations},
	volume = {22},
	issn = {0219-0613, 1793-6691},
	url = {http://arxiv.org/abs/2008.06613},
	doi = {10.1142/S0219061322500155},
	abstract = {We introduce a new family of jump operators on Borel equivalence relations; specifically, for each countable group \${\textbackslash}Gamma\$ we introduce the \${\textbackslash}Gamma\$-jump. We study the elementary properties of the \${\textbackslash}Gamma\$-jumps and compare them with other previously studied jump operators. One of our main results is to establish that for many groups \${\textbackslash}Gamma\$, the \${\textbackslash}Gamma\$-jump is {\textbackslash}emph\{proper\} in the sense that for any Borel equivalence relation \$E\$ the \${\textbackslash}Gamma\$-jump of \$E\$ is strictly higher than \$E\$ in the Borel reducibility hierarchy. On the other hand there are examples of groups \${\textbackslash}Gamma\$ for which the \${\textbackslash}Gamma\$-jump is not proper. To establish properness, we produce an analysis of Borel equivalence relations induced by continuous actions of the automorphism group of what we denote the full \${\textbackslash}Gamma\$-tree, and relate these to iterates of the \${\textbackslash}Gamma\$-jump. We also produce several new examples of equivalence relations that arise from applying the \${\textbackslash}Gamma\$-jump to classically studied equivalence relations and derive generic ergodicity results related to these. We apply our results to show that the complexity of the isomorphism problem for countable scattered linear orders properly increases with the rank.},
	number = {03},
	urlyear = {2024-12-28},
	journal = {Journal of Mathematical Logic},
	author = {Clemens, John D. and Coskey, Samuel},
	month = dec,
	year = {2022},
	note = {arXiv:2008.06613 },
	keywords = {Mathematics - Logic},
	pages = {2250015},
	file = {Preprint PDF:C\:\\Users\\Martino Lupini\\Zotero\\storage\\2HDTBISB\\Clemens and Coskey - 2022 - New jump operators on equivalence relations.pdf:application/pdf},
}

@misc{casarosa_homological_2024,
	title = {Homological algebra of pro-{Lie} {Polish} abelian groups},
	url = {http://arxiv.org/abs/2405.13444},
	doi = {10.48550/arXiv.2405.13444},
	abstract = {In this paper, we initiate the study of pro-Lie Polish abelian groups from the perspective of homological algebra. We extend to this context the type-decomposition of locally compact Polish abelian groups of Hoffmann and Spitzweck, and prove that the category \${\textbackslash}mathbf\{proLiePAb\}\$ of pro-Lie Polish abelian groups is a thick subcategory of the category of Polish abelian groups. We completely characterize injective and projective objects in \${\textbackslash}mathbf\{proLiePAb\}\$. We conclude that \${\textbackslash}mathbf\{proLiePAb\}\$ has enough projectives but not enough injectives and homological dimension \$1\$. We also completely characterize injective and projective objects in the category of non-Archimedean Polish abelian groups, concluding that it has enough injectives and projectives and homological dimension \$1\$. Injective objects are also characterized for the categories of topological torsion Polish abelian groups and for Polish abelian topological \$p\$-groups, showing that these categories have enough injectives and homological dimension \$1\$.},
	urlyear = {2025-01-22},
