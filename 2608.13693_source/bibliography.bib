	title = {On the axiomatizability of {C}*-algebras as operator systems},
	url = {http://arxiv.org/abs/1603.05444},
	abstract = {We show that the class of unital \${\textbackslash}textbackslashtextbackslashmathrm\{C\}ˆ*\$-algebras is an elementary class in the language of operator systems. As a result, we have that there is a definable predicate in the language of operator systems that defines the multiplication in any \${\textbackslash}textbackslashtextbackslashmathrm\{C\}ˆ*\$-algebra. Moreover, we prove that the aforementioned class is \${\textbackslash}textbackslashtextbackslashforall{\textbackslash}textbackslashtextbackslashexists{\textbackslash}textbackslashtextbackslashforall\$-axiomatizable but not \${\textbackslash}textbackslashtextbackslashforall{\textbackslash}textbackslashtextbackslashexists\$-axiomatizable nor \${\textbackslash}textbackslashtextbackslashexists{\textbackslash}textbackslashtextbackslashforall\$-axiomatizable.},
