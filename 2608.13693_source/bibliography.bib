@article{pestov_free_1998,
	title = {On free actions, minimal flows, and a problem by {Ellis}},
	volume = {350},
	issn = {0002-9947, 1088-6850},
	url = {http://www.ams.org/tran/1998-350-10/S0002-9947-98-02329-0/},
	doi = {10.1090/S0002-9947-98-02329-0},
	abstract = {We exhibit natural classes of Polish topological groups such that every continuous action of on a compact space has a fixed point, and observe that every group with this property provides a solution (in the negative) to a 1969 problem by Robert Ellis, as the Ellis semigroup of the universal minimal -flow , being trivial, is not isomorphic with the greatest -ambit. Further refining our construction, we obtain a Polish topological group acting freely on the universal minimal flow yet such that and are not isomorphic. We also display Polish topological groups acting effectively but not freely on their universal minimal flows. In fact, we can produce examples of groups of all three types having any prescribed infinite weight. Our examples lead to dynamical conclusions for some groups of importance in analysis. For instance, both the full group of permutations of an infinite set, equipped with the pointwise topology, and the unitary group of an infinite-dimensional Hilbert space with the strong operator topology admit no free action on a compact space, and the circle forms the universal minimal flow for the topological group of orientation-preserving homeomorphisms. It also follows that a closed subgroup of an amenable topological group need not be amenable.},
	number = {10},
	urlyear = {2014-01-22},
	journal = {Transactions of the American Mathematical Society},
	author = {Pestov, Vladimir},
	year = {1998},
	keywords = {extremely amenable groups, effective actions, Ellis semigroup, fixed point, Free actions on compacta, greatest ambit, universal minimal flow},
	pages = {4149--4165},
}

