@article{hindman_left_2014,
	title = {Left large subsets of free semigroups and groups that are not right large},
	volume = {90},
	issn = {0037-1912, 1432-2137},
	url = {http://link.springer.com.ezproxy.library.yorku.ca/article/10.1007/s00233-014-9622-z},
	doi = {10.1007/s00233-014-9622-z},
	abstract = {There are several notions of size for subsets of a semigroup SS that originated in topological dynamics and are of interest because of their combinatorial applications as well as their relationship to the algebraic structure of the Stone–Čech compactification βS{\textbackslash}textbackslashbeta S of SS. Among these notions are thick sets, central sets, piecewise syndetic sets, IP sets, and Δ{\textbackslash}textbackslashDelta sets. Two related notions, namely CC sets and JJ sets, arose in the study of combinatorial applications of the algebra of βS{\textbackslash}textbackslashbeta S. If the semigroup is noncommutative, then all of these notions have both left and right versions. In any semigroup, a left thick set must be a right JJ set (and of course a right thick set must be a left JJ set). We show here that for any free semigroup or free group on more than one generator, there is a set which satisfies all of the left versions of these notions and none of the right versions except JJ. We also show that for the free semigroup on countably many generators, there is a left JJ set which is not a right JJ set.},
	
	number = {2},
	urlyear = {2015-07-25},
	journal = {Semigroup Forum},
	author = {Hindman, Neil and Jones, Lakeshia Legette and Peters, Monique Agnes},
	month = jul,
	year = {2014},
	pages = {374--385},
}

