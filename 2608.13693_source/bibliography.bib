@misc{chen_borel_2020,
	title = {Borel and analytic sets in locales},
	url = {http://arxiv.org/abs/2011.00437},
	doi = {10.48550/arXiv.2011.00437},
	abstract = {We systematically develop analogs of basic concepts from classical descriptive set theory in the context of pointless topology. Our starting point is to take the elements of the free complete Boolean algebra generated by the frame \${\textbackslash}mathcal\{O\}(X)\$ of opens to be the "\${\textbackslash}infty\$-Borel sets" in a locale \$X\$. We show that several known results in locale theory may be interpreted in this framework as direct analogs of classical descriptive set-theoretic facts, including e.g., the Lusin separation, Lusin-Suslin, and Baire category theorems for locales; we also prove several extensions of these results. We give a detailed analysis of various notions of image, and prove that a continuous map need not have an \${\textbackslash}infty\$-Borel image. We introduce the category of "analytic \${\textbackslash}infty\$-Borel locales" as the regular completion under images of the unary site of locales and \${\textbackslash}infty\$-Borel maps, and prove analogs of several classical results about analytic sets, such as a boundedness theorem for well-founded analytic relations. We also consider the "positive \${\textbackslash}infty\$-Borel sets" of a locale, formed from opens without using \${\textbackslash}neg\$. We in fact work throughout with \${\textbackslash}kappa\$-copresented \${\textbackslash}kappa\$-locales and \${\textbackslash}kappa\$-Borel sets for arbitrary regular \${\textbackslash}omega\_1 {\textbackslash}le {\textbackslash}kappa {\textbackslash}le {\textbackslash}infty\$, thereby incorporating the classical context as the special case \${\textbackslash}kappa = {\textbackslash}omega\_1\$. The basis for the aforementioned localic results is a detailed study of various known and new methods for presenting \${\textbackslash}kappa\$-frames, \${\textbackslash}kappa\$-Boolean algebras, etc. In particular, we introduce a new type of "two-sided posite" for presenting \$({\textbackslash}kappa, {\textbackslash}kappa)\$-frames \$A\$ (i.e., both \$A\$ and \$A{\textasciicircum}\{op\}\$ are \${\textbackslash}kappa\$-frames), and use this to prove a general \${\textbackslash}kappa\$-ary interpolation theorem for \$({\textbackslash}kappa, {\textbackslash}kappa)\$-frames, which dualizes to the aforementioned separation theorems.},
	urlyear = {2023-03-11},
	publisher = {arXiv},
	author = {Chen, Ruiyuan},
	month = nov,
	year = {2020},
	note = {arXiv:2011.00437 },
	keywords = {Mathematics - Logic, Mathematics - Category Theory, Mathematics - General Topology, 06D22, 03E15, 06E75, 54H05},
	file = {arXiv Fulltext PDF:C\:\\Users\\Martino Lupini\\Zotero\\storage\\FTJHWXTV\\Chen - 2020 - Borel and analytic sets in locales.pdf:application/pdf},
