@article{odden_baseleaf_2005-2,
	title = {The {Baseleaf} {Preserving} {Mapping} {Class} {Group} of the {Universal} {Hyperbolic} {Solenoid}},
	volume = {357},
	issn = {0002-9947},
	url = {https://www.jstor.org/stable/3845136},
	abstract = {Given a closed surface X, the covering solenoid {\textbackslash}textlesstex-math{\textbackslash}textgreater\$X\_{\textbackslash}textbackslashinfty\${\textbackslash}textless/tex-math{\textbackslash}textgreater is by definition the inverse limit of all finite covering surfaces over X. If the genus of X is greater than one, then there is only one homeomorphism type of covering solenoid; it is called the universal hyperbolic solenoid. In this paper we describe the topology of {\textbackslash}textlesstex-math{\textbackslash}textgreater\${\textbackslash}textbackslashGamma(X\_{\textbackslash}textbackslashinfty)\${\textbackslash}textless/tex-math{\textbackslash}textgreater, the mapping class group of the universal hyperbolic solenoid. Central to this description is the notion of a virtual automorphism group. The main result is that there is a natural isomorphism of the baseleaf preserving mapping class group of {\textbackslash}textlesstex-math{\textbackslash}textgreater\$X\_{\textbackslash}textbackslashinfty\${\textbackslash}textless/tex-math{\textbackslash}textgreater onto the virtual automorphism group of {\textbackslash}textlesstex-math{\textbackslash}textgreater\${\textbackslash}textbackslashpi\_1(X, {\textbackslash}textbackslashast)\${\textbackslash}textless/tex-math{\textbackslash}textgreater. This may be regarded as a genus independent generalization of the theorem of Dehn, Nielsen, Baer, and Epstein that the pointed mapping class group {\textbackslash}textlesstex-math{\textbackslash}textgreater\${\textbackslash}textbackslashGamma(X, {\textbackslash}textbackslashast)\${\textbackslash}textless/tex-math{\textbackslash}textgreater is isomorphic to the automorphism group of {\textbackslash}textlesstex-math{\textbackslash}textgreater\${\textbackslash}textbackslashpi\_1(X, {\textbackslash}textbackslashast)\${\textbackslash}textless/tex-math{\textbackslash}textgreater.},
	number = {5},
	urlyear = {2019-09-29},
	journal = {Transactions of the American Mathematical Society},
	author = {Odden, Chris},
	year = {2005},
	pages = {1829--1858},
}

