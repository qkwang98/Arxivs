@phdthesis{seaton_brauer_2024,
	type = {thesis},
	title = {The {Brauer} group for {Fell} algebras},
	url = {https://ro.uow.edu.au/articles/thesis/The_Brauer_group_for_Fell_algebras/27666468/1},
	abstract = {In the 1960's, Dixmier and Douady showed that continuous-trace C*-algebras can be classified up to spectral-preserving Morita equivalence. They provided a cohomology group which can track this equivalence. In 2010, an Huef, Kumjian and Sims provided a Dixmier-Douady theory for a more general class of C*-algebras, namely Fell algebras. It follows that there is a group structure on the collection of Morita-equivalence classes of Fell algebras with a given spectrum {\textbar} the one pulled back from the cohomology group. For continuous-trace C*-algebras, this group structure is explicitly described by a balanced tensor product operation, and the resulting group is called the Brauer group. This thesis aims to describe a Brauer group for Fell algebras. We give an account of the Dixmier-Douady theory for continuous-trace C*-algebras. We then give the full details of the Dixmier-Douady theory of Fell algebras. With this, we will give the construction of the Brauer group for Fell algebras.},
	
	urlyear = {2025-09-25},
	school = {University of Wollongong},
	author = {Seaton, Nicholas},
	month = nov,
	year = {2024},
	note = {ISSN: 2766-6468},
}

