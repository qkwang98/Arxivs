@article{henrard_left_2021,
	title = {The left heart and exact hull of an additive regular category},
	url = {http://arxiv.org/abs/2105.11483},
	abstract = {Quasi-abelian categories are abundant in functional analysis and representation theory. It is known that a quasi-abelian category \${\textbackslash}mathcal\{E\}\$ is a cotilting torsionfree class of an abelian category. In fact, this property characterizes quasi-abelian categories. This ambient abelian category is derived equivalent to the category \${\textbackslash}mathcal\{E\}\$, and can be constructed as the heart \${\textbackslash}mathcal\{LH\}({\textbackslash}mathcal\{E\})\$ of a \${\textbackslash}operatorname\{t\}\$-structure on the bounded derived category \${\textbackslash}operatorname\{D{\textasciicircum}b\}({\textbackslash}mathcal\{E\})\$ or as the localization of the category of monomorphisms in \${\textbackslash}mathcal\{E\}.\$ However, there are natural examples of categories in functional analysis which are not quasi-abelian, but merely one-sided quasi-abelian or even weaker. Examples are the category of \${\textbackslash}operatorname\{LB\}\$-spaces or the category of complete Hausdorff locally convex spaces. In this paper, we consider additive regular categories as a generalization of quasi-abelian categories that covers the aforementioned examples. These categories can be characterized as pre-torsionfree subcategories of abelian categories. As for quasi-abelian categories, we show that such an ambient abelian category of an additive regular category \${\textbackslash}mathcal\{E\}\$ can be found as the heart of a \${\textbackslash}operatorname\{t\}\$-structure on the bounded derived category \${\textbackslash}operatorname\{D{\textasciicircum}b\}({\textbackslash}mathcal\{E\})\$, or as the localization of the category of monomorphisms of \${\textbackslash}mathcal\{E\}\$. In our proof of this last construction, we formulate and prove a version of Auslander's formula for additive regular categories. Whereas a quasi-abelian category is an exact category in a natural way, an additive regular category has a natural one-sided exact structure. Such a one-sided exact category can be 2-universally embedded into its exact hull. We show that the exact hull of an additive regular category is again an additive regular category.},
	urlyear = {2022-02-14},
	journal = {arXiv:2105.11483 },
	author = {Henrard, Ruben and Kvamme, Sondre and van Roosmalen, Adam-Christiaan and Wegner, Sven-Ake},
	month = may,
	year = {2021},
	note = {arXiv: 2105.11483},
	keywords = {Mathematics - Functional Analysis, Mathematics - Category Theory, Mathematics - Representation Theory, 18E05, 18E08, 18E20, 18E35 (primary), 18E40, 18G80, 46A13, 46M18 (secondary)},
	file = {arXiv Fulltext PDF:C\:\\Users\\Martino Lupini\\Zotero\\storage\\IHPPXJEX\\Henrard et al. - 2021 - The left heart and exact hull of an additive regul.pdf:application/pdf},
}

