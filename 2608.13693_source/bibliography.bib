	volume = {25},
	issn = {1572-9095},
	url = {https://doi.org/10.1007/s10485-016-9462-y},
	doi = {10.1007/s10485-016-9462-y},
	abstract = {A quasi-pointed category in the sense of D. Bourn is a finitely complete category \${\textbackslash}mathcal \{C\}\$having an initial object such that the unique morphism from the initial object to the terminal object is a monomorphism. When instead this morphism is an isomorphism, we obtain a (finitely complete) pointed category, and as it is well known, the structure of zero morphisms in a pointed category determines an enrichment of the category in the category of pointed sets. In this note we examine quasi-pointed categories through the structure formed by the zero morphisms (i.e. the morphisms which factor through the initial object), with the aim to compare this structure with an enrichment in the category of pointed sets.},
	
	number = {6},
