@article{lupini_universal_2014,
	title = {A universal nuclear operator system},
	url = {http://arxiv.org/abs/1412.0281},
	abstract = {By means of Fra{\textbackslash}textbackslash"\{i\}ss{\textbackslash}textbackslash'\{e\} theory for metric structures developed by Ben Yaacov, we show that there exists a separable \$1\$-exact operator system \${\textbackslash}textbackslashmathbb\{GS\}\$—which we call the Gurarij operator system—of almost universal disposition. This means that whenever \$E{\textbackslash}textbackslashsubset F\$ are finite-dimensional \$1\$-exact operator systems, \${\textbackslash}textbackslashphi :E{\textbackslash}textbackslashrightarrow {\textbackslash}textbackslashmathbb\{GS\}\$ is a unital complete isometry, and \${\textbackslash}textbackslashvarepsilon {\textbackslash}textgreater0\$, there is a linear extension \${\textbackslash}textbackslashwidehat\{{\textbackslash}textbackslashphi \}:F{\textbackslash}textbackslashrightarrow {\textbackslash}textbackslashmathbb\{GS\}\$ of \${\textbackslash}textbackslashphi \$ such that \${\textbackslash}textbar{\textbackslash}textbar{\textbackslash}textbackslashwidehat\{{\textbackslash}textbackslashphi \}{\textbackslash}textbar{\textbackslash}textbar\_\{cb\}\{\}{\textbackslash}textbar{\textbackslash}textbar{\textbackslash}textbackslashwidehat\{{\textbackslash}textbackslashphi \}ˆ\{-1\}{\textbackslash}textbar{\textbackslash}textbar\_\{cb\}{\textbackslash}textbackslashleq 1+{\textbackslash}textbackslashvarepsilon \$. Such an operator system is unique up to complete order isomorphism. Furthermore it is nuclear, homogeneous, and any separable \$1\$-exact operator system admits a complete order embedding into \${\textbackslash}textbackslashmathbb\{GS\}\$. The space \${\textbackslash}textbackslashmathbb\{GS\}\$ can be regarded as the operator system analog of the Gurarij operator space \${\textbackslash}textbackslashmathbb\{NG\}\$ introduced by Oikhberg, which is in turn a canonical operator space structure on the Gurarij Banach space. We also show that the canonical \${\textbackslash}textbackslashast \$-homomorphism from the universal C*-algebra of \${\textbackslash}textbackslashmathbb\{GS\}\$ to the C*-envelope of \${\textbackslash}textbackslashmathbb\{GS\}\$ is a \${\textbackslash}textbackslashast \$-isomorphism. This implies that \${\textbackslash}textbackslashmathbb\{GS\}\$ does not admit any complete order embedding into a unital exact C*-algebra. In particular \${\textbackslash}textbackslashmathbb\{GS\}\$ is not completely order isomorphic to a unital C*-algebra. With similar methods we show that the Gurarij operator space \${\textbackslash}textbackslashmathbb\{NG\}\$ does not admit any completely isometric embedding into an exact C*-algebra, and in particular \${\textbackslash}textbackslashmathbb\{NG\}\$ is not completely isometric to a C*-algebra. This answers a question of Timur Oikhberg.},
	urlyear = {2015-02-24},
	journal = {arXiv:1412.0281 },
	author = {Lupini, Martino},
	month = nov,
	year = {2014},
	keywords = {Mathematics - Logic, Mathematics - Operator Algebras, 03C30 (Secondary), 46L07 (Primary)},
}

