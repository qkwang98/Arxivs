	url = {http://arxiv.org/abs/1907.10010},
	abstract = {We explore the recently introduced local-triviality dimensions by studying gauge actions on graph \$Cˆ*\$-algebras, as well as the restrictions of the gauge action to finite cyclic subgroups. For \$Cˆ*\$-algebras of finite acyclic graphs and finite cycles, we characterize the finiteness of these dimensions, and we further study the gauge actions on many examples of graph \$Cˆ*\$-algebras. These include the Toeplitz algebra, Cuntz algebras, and \$q\$-deformed spheres.},
