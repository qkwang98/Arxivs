@article{pestov_ramsey-milman_2002,
	title = {Ramsey-{Milman} phenomenon, {Urysohn} metric spaces, and extremely amenable groups},
	volume = {127},
	issn = {0021-2172, 1565-8511},
	url = {http://link.springer.com/article/10.1007/BF02784537},
	doi = {10.1007/BF02784537},
	abstract = {In this paper we further study links between concentration of measure in topological transformation groups, existence of fixed points, and Ramsey-type theorems for metric spaces. We prove that whenever the group Iso (U){\textbackslash}textbackslashleft( {\textbackslash}textbackslashmathbb\{U\} {\textbackslash}textbackslashright) of isometries of Urysohn’s universal complete separable metric space U{\textbackslash}textbackslashmathbb\{U\} , equipped with the compact-open topology, acts upon an arbitrary compact space, it has a fixed point. The same is true if U{\textbackslash}textbackslashmathbb\{U\} is replaced with any generalized Urysohn metric spaceU that is sufficiently homogeneous. Modulo a recent theorem by Uspenskij that every topological group embeds into a topological group of the form Iso(U), our result implies that every topological group embeds into an extremely amenable group (one admitting an invariant multiplicative mean on bounded right uniformly continuous functions). By way of the proof, we show that every topological group is approximated by finite groups in a certain weak sense. Our technique also results in a new proof of the extreme amenability (fixed point on compacta property) for infinite orthogonal groups. Going in the opposite direction, we deduce some Ramsey-type theorems for metric subspaces of Hilbert spaces and for spherical metric spaces from existing results on extreme amenability of infinite unitary groups and groups of isometries of Hilbert spaces.},
	
	number = {1},
	urlyear = {2014-07-04},
	journal = {Israel Journal of Mathematics},
	author = {Pestov, Vladimir},
	month = dec,
	year = {2002},
	keywords = {Mathematical and Computational Physics, Algebra, Analysis, Applications of Mathematics, general, Group Theory and Generalizations, Mathematics},
	pages = {317--357},
}

@article{goldblatt_observational_2003,
	title = {Observational ultraproducts of polynomial coalgebras},
	volume = {123},
	issn = {0168-0072},
	url = {http://www.sciencedirect.com/science/article/pii/S0168007203000381},
	doi = {10.1016/S0168-0072(03)00038-1},
	abstract = {Coalgebras of polynomial functors constructed from sets of observable elements have been found useful in modelling various kinds of data types and state-transition systems. This paper continues the study of equational logic and model theory for polynomial coalgebras begun in Goldblatt (in: Advances in Modal Logic, vol. 4, 2001, to appear), where it was shown that Boolean combinations of equations between terms of observable type form a natural language of observable formulas for specifying properties of polynomial coalgebras, and for giving a Hennessy–Milner style logical characterisation of observational indistinguishability (bisimilarity) of states. Here we give a structural characterisation of classes of coalgebras definable by observable formulas. This is an analogue for polynomial coalgebras of Birkhoff's celebrated characterisation of equationally definable classes of abstract algebras as being those closed under homomorphic images, subalgebras, and direct products. The coalgebraic characterisation involves new notions of observational ultraproduct and ultrapower of coalgebras, obtained from the classical construction of ultraproducts by deleting states that assign “nonstandard” values to terms of observable type. A class of polynomial coalgebras is shown to be the class of all models of a set of observable formulas if, and only if, it is closed under images of bisimulation relations, disjoint unions and observational ultrapowers. Observational ultraproducts are also used to discuss compactness—which holds only under limited conditions; to characterise finitely, axiomatisable classes of polynomial coalgebras; and to show that there are axiomatisable classes that are not finitely axiomatisable.},
	number = {1–3},
	urlyear = {2014-07-06},
	journal = {Annals of Pure and Applied Logic},
	author = {Goldblatt, Robert},
	month = oct,
	year = {2003},
	keywords = {Birkhoff's variety theorem, Coalgebra, Polynomial functor, Ultraproduct},
	pages = {235--290},
}

