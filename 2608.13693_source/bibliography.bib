@article{farah_extreme_2008-1,
	title = {Extreme amenability of , a {Ramsey} theorem, and {Lévy} groups},
	volume = {255},
	issn = {0022-1236},
	url = {http://www.sciencedirect.com/science/article/pii/S0022123608001286},
	doi = {10.1016/j.jfa.2008.03.016},
	abstract = {We show that L 0 ( ϕ , H ) is extremely amenable for any diffused submeasure ϕ and any solvable compact group H. This extends results of Herer–Christensen, and of Glasner and Furstenberg–Weiss. Proofs of these earlier results used spectral theory or concentration of measure. Our argument is based on a new Ramsey theorem proved using ideas coming from combinatorial applications of algebraic topological methods. Using this work, we give an example of a group which is extremely amenable and contains an increasing sequence of compact subgroups with dense union, but which does not contain a Lévy sequence of compact subgroups with dense union. This answers a question of Pestov. We also show that many Lévy groups have non-Lévy sequences, answering another question of Pestov.},
	number = {2},
	urlyear = {2016-05-27},
	journal = {Journal of Functional Analysis},
	author = {Farah, Ilijas and Solecki, Sławomir},
	month = jul,
	year = {2008},
	pages = {471--493},
}

