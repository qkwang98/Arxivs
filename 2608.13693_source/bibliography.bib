@article{gardella_functoriality_2014,
	title = {Functoriality of group algebras acting on \${Lˆp}\$-spaces},
	url = {http://arxiv.org/abs/1408.6137},
	abstract = {We continue our study of group algebras acting on \$Lˆp\$-spaces, particularly of algebras of \$p\$-pseudofunctions of locally compact groups. We focus on the functoriality properties of these objects. We show that \$p\$-pseudofunctions are functorial with respect to homomorphisms that are either injective, or whose kernel is amenable and has finite index. We also show that the universal completion of the group algebra with respect to representations on \$Lˆp\$-spaces, is functorial with respect to quotient maps. As an application, we show that the algebras of \$p\$- and \$q\$-pseudofunctions on \${\textbackslash}textbackslashmathbb\{Z\}\$ are (abstractly) isometrically isomorphic as Banach algebras if and only if \$p\$ and \$q\$ are either equal or conjugate.},
