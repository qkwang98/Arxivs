	issn = {0022-1236},
	url = {http://www.sciencedirect.com/science/article/pii/0022123676900148},
	doi = {10.1016/0022-1236(76)90014-8},
	abstract = {A Hilbert bundle (p, B, X) is a type of fibre space p: B → X such that each fibre p−1(x) is a Hilbert space. However, p−1(x) may vary in dimension as x varies in X, even when X is connected. We give two “homotopy” type classification theorems for Hilbert bundles having primarily finite dimensional fibres. An (m, n)-bundle over the pair (X, A) is a Hilbert bundle over (p, B, X) such that the dimension of p−1(x) is m for x in A and n otherwise. As a special case, we show that if X is a compact metric space, C+X the upper cone of the suspension SX, then the isomorphism classes of (m, n)-bundles over (SX, C+X) are in one-to-one correspondence with the members of [X, Vm({\textbackslash}textlessimg height="13" border="0" style="vertical-align:bottom" width="14" alt="View the MathML source" title="View the MathML source" src="http://origin-ars.els-cdn.com/content/image/1-s2.0-0022123676900148-si1.gif"{\textbackslash}textgreatern)] where Vm({\textbackslash}textlessimg height="13" border="0" style="vertical-align:bottom" width="14" alt="View the MathML source" title="View the MathML source" src="http://origin-ars.els-cdn.com/content/image/1-s2.0-0022123676900148-si2.gif"{\textbackslash}textgreatern) is the Stiefel manifold. The results are all applicable to the classification of separable, continuous trace C∗-algebras, with specific results given to illustrate.},
	number = {3},
	urlyear = {2014-04-06},
	journal = {Journal of Functional Analysis},
	author = {Dupré, Maurice J},
	month = jul,
	year = {1976},
	pages = {295--322},
}

@article{dupre_classifying_1974,
	title = {Classifying {Hilbert} bundles},
