	journal = {SIAM Journal on Matrix Analysis and Applications},
	author = {Karow, M. and Kressner, D.},
	month = jan,
	year = {2014},
	pages = {599--618},
}

@article{stewart_error_1971,
	title = {Error {Bounds} for {Approximate} {Invariant} {Subspaces} of {Closed} {Linear} {Operators}},
	volume = {8},
	issn = {0036-1429},
	url = {http://epubs.siam.org.clsproxy.library.caltech.edu/doi/abs/10.1137/0708073},
	doi = {10.1137/0708073},
	abstract = {Let A be a closed linear operator on a separable Hilbert space \${\textbackslash}textbackslashmathcal\{H\}\$ whose domain is dense in \${\textbackslash}textbackslashmathcal\{H\}\$ Let \${\textbackslash}textbackslashmathcal\{X\}\$ be a subspace of \${\textbackslash}textbackslashmathcal\{H\}\$ contained in the domain of A and let \${\textbackslash}textbackslashmathcal\{Y\}\$ be its orthogonal complement. Let B and C be the compressions of A to \${\textbackslash}textbackslashmathcal\{Z\}\$ and \${\textbackslash}textbackslashmathcal\{Y\}\$ respectively, let \$G = Yˆ * AX\$, where X and Y are the injections of \${\textbackslash}textbackslashmathcal\{X\}\$ and \${\textbackslash}textbackslashmathcal\{Y\}\$ into \${\textbackslash}textbackslashmathcal\{H\}\$. It is shown that if B and C have disjoint spectra and \${\textbackslash}textbackslash{\textbackslash}textbar G {\textbackslash}textbackslash{\textbackslash}textbar\$ is sufficiently small, then there is an invariant subspace \${\textbackslash}textbackslashmathcal\{X\}'\$ of A near \${\textbackslash}textbackslashmathcal\{X\}\$. Bounds for the distance between \${\textbackslash}textbackslashmathcal\{X\}'\$ and \${\textbackslash}textbackslashmathcal\{X\}\$ are given, and the spectrum of A is related to the spectra of B and C. In the development a measure of the separation of the spectra of B and C which is insensitive to small perturbations in B and C is introduced and analyzed.},
	number = {4},
	urlyear = {2016-09-11},
	journal = {SIAM Journal on Numerical Analysis},
	author = {Stewart, G.},
	month = dec,
	year = {1971},
	pages = {796--808},
}

@article{demmel_computing_1986,
	title = {Computing stable eigendecompositions of matrices},
	volume = {79},
	issn = {0024-3795},
	url = {http://www.sciencedirect.com/science/article/pii/0024379586902983},
	doi = {10.1016/0024-3795(86)90298-3},
	abstract = {If a matrix T is known only to within a tolerance ϵ (because of measurement or roundoff errors), then it may be difficult to compute an eigendecomposition of T, since its invariant subspaces are discontinuous functions of its entries. In this paper we show how to compute a stable decomposition of an uncertain matrix T which varies continuously and boundedly as T varies in a ball of radius ϵ.},
	urlyear = {2016-09-11},
	journal = {Linear Algebra and its Applications},
	author = {Demmel, James Weldon},
	month = jul,
	year = {1986},
	pages = {163--193},
}

@article{demmel_computing_1987,
	title = {Computing stable eigendecompositions of matrix pencils},
	volume = {88},
	issn = {0024-3795},
	url = {http://www.sciencedirect.com/science/article/pii/002437958790108X},
	doi = {10.1016/0024-3795(87)90108-X},
	abstract = {If a matrix pencil A−λB is known only to within a tolerance ϵ (because of measurement or roundoff errors), then it may be difficult to compute a generalized eigendecomposition of A−λB, since its eigenspaces are discontinuous functions of its entries. We are interested in computing an eigendecomposition of A−λB which varies continuously and boundedly as A−λB varies inside a ball of radius ϵ. There are two cases with qualitatively different solutions. The first case is when A−λB is regular, i.e. det(A−λB) is not identically zero. In this case we show how to partition the spectrum of A−λB into disjoint pieces which remain disjoint and whose associated eigenspaces vary smoothly. The second case is when A−λB is singular [i.e. either det(A−λB)≡0 or A−λB is nonsquare]. This case is more difficult than the first, because applications call for computing nongeneric eigenspaces which exist only when A−λB lies in a proper variety (a set of measure zero). The known algorithms for computing these nongeneric structures produce the eigendecomposition of a pencil close to the input which is guaranteed to lie in this proper variety. In this case we prove that as long as the norm of the perturbations produced by the algorithm are smaller than a certain ϵ we can compute from the pencil, the resulting nongeneric eigenspaces and eigenvalues produced by the algorithm vary smoothly. This theorem shows that standard algorithms can compute accurate solutions of many ill-posed problems in systems theory, such as the controllable subspace and uncontrollable modes of a system x̀=Cx+Du.},
	urlyear = {2016-09-11},
	journal = {Linear Algebra and its Applications},
	author = {Demmel, James Weldon and Kågström, Bo},
	month = apr,
	year = {1987},
	pages = {139--186},
}

