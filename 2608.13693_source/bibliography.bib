@article{read_quest_2011,
	title = {On the quest for positivity in operator algebras},
	volume = {381},
	issn = {0022-247X},
	url = {http://www.sciencedirect.com/science/article/pii/S0022247X1100134X},
	doi = {10.1016/j.jmaa.2011.02.022},
	abstract = {We show that in every nonzero operator algebra with a contractive approximate identity (or c.a.i.), there is a nonzero operator T such that ‖I−T‖⩽1. In fact, there is a c.a.i. consisting of operators T with ‖I−2T‖⩽1. So, the numerical range of the elements of our contractive approximate identity is contained in the closed disk center 12 and radius 12. This is the necessarily weakened form of the result for C⁎-algebras, where there is always a contractive approximate identity consisting of operators with 0⩽T⩽1 – the numerical range is contained in the real interval [0,1]. So, if an operator algebra has a c.a.i., it must have operators with a “certain amount” of positivity.},
	number = {1},
	urlyear = {2016-07-06},
	journal = {Journal of Mathematical Analysis and Applications},
	author = {Read, C. J.},
	month = sep,
	year = {2011},
	pages = {202--214},
}

