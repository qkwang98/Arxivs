@article{everaert_relative_2012,
	series = {Special {Issue} devoted to the {International} {Conference} in {Category} {Theory} `{CT2010}'},
	title = {Relative commutator theory in semi-abelian categories},
	volume = {216},
	issn = {0022-4049},
	url = {https://www.sciencedirect.com/science/article/pii/S0022404912000576},
	doi = {10.1016/j.jpaa.2012.02.018},
	abstract = {Based on the concept of double central extension from categorical Galois theory, we study a notion of commutator which is defined relative to a Birkhoff subcategory B of a semi-abelian category A. This commutator characterises Janelidze and Kelly’s B-central extensions; when the subcategory B is determined by the abelian objects in A, it coincides with Huq’s commutator; and when the category A is a variety of Ω-groups, it coincides with the relative commutator introduced by the first author.},
