@article{BUHMANN1992117,
title = {{On orthogonal polynomials transformed by the QR algorithm}},
journal = {Journal of Computational and Applied Mathematics},
volume = {43},
number = {1},
pages = {117-134},
year = {1992},
issn = {0377-0427},
doi = {https://doi.org/10.1016/0377-0427(92)90262-V},
url = {https://www.sciencedirect.com/science/article/pii/037704279290262V},
author = {M.D. Buhmann and A. Iserles},
keywords = {QR algorithm, modified Lommel polynomials, Hankel determinants},
abstract = {In this paper, we study two equivalent ways of transforming a system of orthogonal polynomials: one is the so-called lifting of the recurrence relation associated with an orthogonal polynomial system (OPS) and the other consists of applying the QR algorithm to the Jacobi matrix of the OPS. These transformations are useful for, among other things, identifying the Sobolev orthogonal polynomials with respect to certain measures, which were previously investigated by Iserles et al. (1991). As a by-product we obtain a new class of modified Lommel polynomials.}
}
