   @article{ISMAIL2003562,
title = {Difference equations and quantized discriminants for q-orthogonal polynomials},
journal = {Advances in Applied Mathematics},
volume = {30},
number = {3},
pages = {562-589},
year = {2003},
issn = {0196-8858},
doi = {https://doi.org/10.1016/S0196-8858(02)00547-X},
url = {https://www.sciencedirect.com/science/article/pii/S019688580200547X},
author = {Mourad E.H Ismail},
keywords = {Discriminants, -orthogonal polynomials, Functions of the second kind, Recurrence relations, -difference equations, Raising and lowering operators, Little -Jacobi polynomials, Continuous -Jacobi polynomials},
abstract = {We show that orthogonal polynomials on generalized q-linear grid have raising and lowering operators and satisfy a second-order q-difference equation. It is shown that for a general class of weight functions on general q-linear grids, the functions of the second kind and the orthogonal polynomials are linear independent solutions of the same second-order q-difference equation. We introduce q-analogues of the discriminant and evaluate the quantized discriminant for general q-orthogonal polynomials in terms of the recursion coefficients. The q-discriminants of the discrete q-Hermite and little q-Jacobi polynomials, as well as a generalized discriminant of the continuous q-Jacobi polynomials, are given explicitly. A q-analogue of the Freud weights is introduced and we derive the second-order q-difference equation they satisfy.}
}
