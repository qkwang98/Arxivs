% Formattazione per \chapter
\titleformat{\part}
  [display] % Modalità display per centrare e andare a capo
  {\centering\Huge\bfseries} % Stile del titolo
  {} % Lascia vuoto il campo del numero della parte
  {1em} % Spazio tra il numero e il titolo
  {%
    \textcolor{sunYellowOrange}{\HUGE \particon}\\[3em] % Riga 1: Sole (giallo-arancione)
    \textcolor{gruvboxfg}{\Huge \thepart}\\[1em] % Riga 2: Numero della parte
  }
\titleformat{\chapter}
  {\Huge\bfseries\color{gruvboxfg}} % Stile del capitolo
  {\thechapter} % Numero del capitolo
  {1em} % Spazio tra il numero e il titolo
  {\chaptericon\hspace{1.0em}} % Icona o testo prima del titolo (puoi usare \chaptericon o un'altra icona/titolo)

\titleformat{\section}{\Large\bfseries\color{gruvboxfg}}{\thesection}{1em}{\sectionicon\hspace{0.5em}}
\titleformat{\subsection}{\normalsize\bfseries\color{gruvboxfg}}{\thesubsection}{1em}{\subsectionicon\hspace{0.5em}}
\titleformat{\subsubsection}{\small\bfseries\color{gruvboxfg}}{\thesubsubsection}{1em}{\subsectionicon\hspace{0.5em}}

