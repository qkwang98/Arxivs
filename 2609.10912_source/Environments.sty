\usepackage[most]{tcolorbox}
\newtcbtheorem{BigQ}{Question}{%tcolorbox
  enhanced,
  sharp corners,
  attach boxed title to top left={
    yshifttext=-1mm
  },
  colback=ChhaiG,
  colframe=ChhaiB!75!ChhaiC,
  fonttitle=\bfseries,
  boxed title style={
    sharp corners,
    size=small,
    colback=ChhaiD!75!black,
    colframe=ChhaiC!75!black,
  } 
}{BigQ}
