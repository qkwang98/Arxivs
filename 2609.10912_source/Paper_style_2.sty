%...................Global indentation and spacing...................%
\hoffset = -1.0 in % horizontal margin minus 1 inch, the left half of left margin
\oddsidemargin = 0.05\paperwidth %gap between left margin and actual text in 'textwidth' area
\textwidth = 0.89\paperwidth % thickness of body
\marginparsep = 0.05\paperwidth % separation between right margin of document and actual right edge of 'textwidth' area
\marginparwidth = 0.0\paperwidth % total margin on the right, includes oddside margin

\voffset = -0.07\paperheight% vertical margin minus 1 inch (1 inch=0.091\paperheight for letter-paper)
%\topmargin = 0.9\paperheight % gap between top margin and header
\headheight = 0.02\paperheight % header height/thickness
\headsep = 0.001\paperheight % gap between header and body
\textheight = 0.9\paperheight % height of body
\footskip = 0.02\paperheight %Distance from last line of text and footer (which includes page number)Q

\setstretch{1.0} %Global Linespacing
\setlength{\parindent}{0.6cm}
\setlength{\parskip}{0.1em}
\setlist[enumerate,1]{leftmargin=1.0\oddsidemargin}
\setlist[enumerate,2]{leftmargin=1.0\oddsidemargin}
\setlist[enumerate,3]{leftmargin=1.0\oddsidemargin}
