  3.995700621939933*^9, 
  3.9957006237583027`*^9}},ExpressionUUID->"73ce865c-c2fc-43de-886b-\
8ff9be4cb2c1"],

Cell[TextData[{
 "In case the user wants access to the output of \[OpenCurlyDoubleQuote]",
 StyleBox["showWeightLattice",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote] or \[OpenCurlyDoubleQuote]",
 StyleBox["showRootLattice",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote] ",
 StyleBox["without",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["formatting",
  FontSlant->"Italic"],
 ", this can be obtained from \n",
 StyleBox["representationWeights[",
  FontWeight->"Bold"],
 StyleBox["dynkinLabel_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 " and ",
 StyleBox["representationRoots[",
  FontWeight->"Bold"],
 StyleBox["dynkinLabel_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ", respectively. "
}], "Text",
 CellChangeTimes->{{3.9950155226836777`*^9, 3.9950156383059177`*^9}, {
  3.995700629978429*^9, 
  3.995700631064301*^9}},ExpressionUUID->"da96f182-fd86-440c-b277-\
a89662ea4672"],

