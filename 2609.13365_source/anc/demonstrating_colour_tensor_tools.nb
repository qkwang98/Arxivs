Cell[TextData[{
 "We can check this for ",
 StyleBox["any",
  FontWeight->"Bold"],
 " pair of generators (a,b) easily enough\[LongDash]",
 StyleBox["e.g.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.990279369253249*^9, 3.9902794344732733`*^9}, {
  3.993309079047164*^9, 
  3.993309079882868*^9}},ExpressionUUID->"5cd6da03-6fa1-441b-acba-\
4b58202f96f2"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rep", "=", "egRep"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Ta", "=", 
           RowBox[{
            RowBox[{"Transpose", "[", "rep", "]"}], "[", 
            RowBox[{"[", "a", "]"}], "]"}]}], ",", 
          RowBox[{"Tb", "=", 
           RowBox[{
            RowBox[{"Transpose", "[", "rep", "]"}], "[", 
            RowBox[{"[", "b", "]"}], "]"}]}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Ta", ".", "Tb"}], "-", 
          RowBox[{"Tb", ".", "Ta"}]}], "==", 
         RowBox[{
          RowBox[{"egInducedAdjoint", "[", 
           RowBox[{"[", 
            RowBox[{"a", ",", "b"}], "]"}], "]"}], ".", 
          RowBox[{"Transpose", "[", "rep", "]"}]}]}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}], "[", 
    RowBox[{"1", ",", "7"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.990279436240357*^9, 3.99027957191918*^9}, 
   3.990279683666183*^9, {3.995017003736128*^9, 3.9950170083739433`*^9}},
 CellLabel->
  "In[120]:=",ExpressionUUID->"e3c38a19-88a2-4b1c-853d-fcb5277fb66c"],

Cell[TextData[{
 "And we can even verify this for ",
 StyleBox["all",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 StyleBox["possible",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " pairs of generators:"
}], "Text",
 CellChangeTimes->{{3.9902796876118193`*^9, 
  3.990279696381233*^9}},ExpressionUUID->"db005c4b-8087-46e4-b911-\
3f85cd3de376"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rep", "=", "egRep"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Ta", "=", 
            RowBox[{
             RowBox[{"Transpose", "[", "rep", "]"}], "[", 
             RowBox[{"[", "a", "]"}], "]"}]}], ",", 
           RowBox[{"Tb", "=", 
            RowBox[{
             RowBox[{"Transpose", "[", "rep", "]"}], "[", 
             RowBox[{"[", "b", "]"}], "]"}]}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"Ta", ".", "Tb"}], "-", 
           RowBox[{"Tb", ".", "Ta"}]}], "==", 
          RowBox[{
           RowBox[{"egInducedAdjoint", "[", 
            RowBox[{"[", 
             RowBox[{"a", ",", "b"}], "]"}], "]"}], ".", 
           RowBox[{"Transpose", "[", "rep", "]"}]}]}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}], "@@@", 
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"Dimensions", "[", "rep", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"And", "@@", "%"}]}], "Input",
 CellChangeTimes->{{3.990279703384853*^9, 3.99027972207128*^9}, {
  3.995017012245267*^9, 3.995017013241351*^9}},
 CellLabel->
  "In[121]:=",ExpressionUUID->"32a184a4-3dc3-4d8b-8003-b002981012f9"],

Cell[TextData[{
 "But it is easier to encode ",
 StyleBox["all components",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of left-hand-side as a rank-(3,1) ",
 StyleBox["tensor ",
  FontWeight->"Bold"],
 "defined as the difference between the two \[OpenCurlyDoubleQuote]",
 StyleBox["dotPower",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote] tensors:"
}], "Text",
 CellChangeTimes->{{3.9902797244853573`*^9, 3.990279755463785*^9}, {
  3.990279825601574*^9, 3.990279825779647*^9}, {3.994846523518124*^9, 
  3.9948465511429157`*^9}},ExpressionUUID->"8205df66-0a91-4f9c-9e5c-\
ab241db88353"],

Cell[BoxData[{
 RowBox[{"{", 
  RowBox[{
   RowBox[{"dotPower", "[", 
    RowBox[{"egRep", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}]}], "]"}], ",", 
   RowBox[{"dotPower", "[", 
    RowBox[{"egRep", ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"nice", "[", "#", "]"}], ",", 
     RowBox[{"drawTensors", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
  "%"}]}], "Input",
 CellChangeTimes->{{3.9926189994029617`*^9, 3.992619013539036*^9}, {
   3.992686392204793*^9, 3.992686393829123*^9}, {3.992686600591358*^9, 
   3.992686607220236*^9}, 3.992686659082271*^9, {3.992686796944977*^9, 
   3.992686801527368*^9}, {3.992952250045301*^9, 3.9929522614166117`*^9}},
 CellLabel->
  "In[123]:=",ExpressionUUID->"b222df45-91bc-4808-a3f5-ee16183d1364"],

Cell[BoxData[{
 RowBox[{"commutatorTensor", "=", 
  RowBox[{
   RowBox[{"dotPower", "[", 
    RowBox[{"egRep", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "-", 
   RowBox[{"dotPower", "[", 
    RowBox[{"egRep", ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"drawTensors", "@", "%"}]}], "Input",
 CellChangeTimes->{{3.99027975948973*^9, 3.990279801725086*^9}, {
