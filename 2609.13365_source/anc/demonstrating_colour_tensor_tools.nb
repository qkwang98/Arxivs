Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["selfDualityMetric[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":",
 StyleBox[" ",
  FontWeight->"Bold"],
 "for ",
 StyleBox["Real",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 StyleBox["Representations",
  FontWeight->"Bold",
  FontSlant->"Italic"]
}], "Subsubsection",
 CellChangeTimes->{{3.9949285218252563`*^9, 3.994928522034333*^9}, {
  3.994928569457213*^9, 3.994928576756218*^9}, {3.995030284444394*^9, 
  3.9950302934117203`*^9}, {3.9951959955757713`*^9, 
  3.995196003311014*^9}},ExpressionUUID->"5584ad2b-a795-4534-aad2-\
d995a0e9cdb9"],

Cell[TextData[{
 "As we have seen in examples above, ",
 StyleBox["isomorphic",
  FontWeight->"Bold"],
 " but ",
 StyleBox["non-identical",
  FontWeight->"Bold"],
 " representations may be related via a similarity transform. \nIf two \
representations are related by similarity, there exists a change of basis \
which relates them.\n\n",
 StyleBox["Real",
  FontWeight->"Bold"],
 " representations are ",
 StyleBox["similar",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " to their conjugates. Specifically, this means that there exists a matrix \
",
 StyleBox["M",
  FontWeight->"Bold"],
 " such that \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SuperscriptBox[
     StyleBox["M",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], ")"}], TraditionalForm]],ExpressionUUID->
  "f91231b9-93b6-473c-b7f2-572a26465798"],
 ".",
 StyleBox["R",
  FontWeight->"Bold"],
 ".",
 StyleBox["M",
  FontWeight->"Bold"],
 "=",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["R",
     FontWeight->"Bold",
     FontSlant->"Plain"], "_"], TraditionalForm]],ExpressionUUID->
  "adad4405-802b-45b7-8a30-541d0714bef0"]
}], "Text",
 CellChangeTimes->{
  3.995377840378654*^9},ExpressionUUID->"d575d82c-99b7-4ece-8727-\
c7e94143c411"],

Cell[TextData[{
 "For any ",
 StyleBox["real",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " representation, there exists a similarity transform between itself and its \
conjugate representation. "
}], "Text",
 CellChangeTimes->{{3.9949415655031548`*^9, 
  3.994941600387547*^9}},ExpressionUUID->"f32d0264-2626-424f-9591-\
13820952e0f7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"fundamentalRep", "[", 
    RowBox[{"g", "[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"egSelfDualityMetric", "=", 
  RowBox[{"selfDualityMetric", "[", "egRep", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"matrixForm", "[", "%", "]"}], ",", 
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.994929264680581*^9, 3.994929304354807*^9}, {
  3.995195981894742*^9, 3.9951959821025887`*^9}},
 CellLabel->
  "In[310]:=",ExpressionUUID->"5b0182ab-6cd3-4d0f-928c-65d8b11359a0"],

Cell[TextData[{
 "We can verify that the ",
 StyleBox["conjugateRep",
  FontWeight->"Bold"],
 " (",
 StyleBox["defined",
  FontSlant->"Italic"],
 " as having generators given by the negative transpose of the given \
representation) \nis identical to this similarity transformation acting on \
the generators of the original representation:"
}], "Text",
 CellChangeTimes->{{3.995030316551552*^9, 
  3.995030414744296*^9}},ExpressionUUID->"db9214f7-0366-4bd6-933d-\
a67101bee7db"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"inverse", "[", "egSelfDualityMetric", "]"}], ".", "egRep", ".", 
   "egSelfDualityMetric"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Equal", "[", 
  RowBox[{
   RowBox[{"conjugateRep", "[", "egRep", "]"}], ",", "%"}], "]"}]}], "Input",
 CellChangeTimes->{{3.994929573041308*^9, 3.994929590020187*^9}, {
  3.994929643230644*^9, 3.994929658815548*^9}},
 CellLabel->
  "In[313]:=",ExpressionUUID->"c2e3787f-8123-42bf-a5ca-de55bcb9e69f"],

Cell[TextData[{
 StyleBox["Note",
  FontWeight->"Bold"],
 ": for the ",
 StyleBox["adjoint",
  FontWeight->"Bold"],
 " representation, this self-similarity is (defined) to be the ",
 StyleBox["Killing metric",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ":"
}], "Text",
 CellChangeTimes->{{3.99493015799105*^9, 
  3.99493019466471*^9}},ExpressionUUID->"daee2e48-dab7-4a9d-8128-\
e776147138b2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egAdj", "=", 
   RowBox[{"adjointRep", "[", 
    RowBox[{"g", "[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"egSelfDualityMetric", "=", 
  RowBox[{"selfDualityMetric", "[", "egAdj", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"matrixForm", "[", "%", "]"}], ",", 
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.994929602398034*^9, 3.994929604678938*^9}, {
  3.995030452699121*^9, 3.995030456756897*^9}, {3.995195978077181*^9, 
  3.995195978722046*^9}},
 CellLabel->
  "In[315]:=",ExpressionUUID->"107d9130-09de-4d01-b8e5-c4280abcb468"],

Cell[TextData[{
 "As before we can verify that acting with the ",
 StyleBox["killingMetric",
  FontWeight->"Bold"],
 " as the similarity-transformation results in the ",
 StyleBox["conjugateRep",
  FontWeight->"Bold"],
 " of the ",
 StyleBox["adjointRep",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.995030419308913*^9, 
  3.9950304469828587`*^9}},ExpressionUUID->"e47927fc-c3a5-4175-8c15-\
aa39babe8cd6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"inverse", "[", "egSelfDualityMetric", "]"}], ".", "egAdj", ".", 
  "egSelfDualityMetric"}], "\[IndentingNewLine]", 
 RowBox[{"Equal", "[", 
  RowBox[{
   RowBox[{"conjugateRep", "[", "egAdj", "]"}], ",", "%"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9949296181166058`*^9, 3.994929664392659*^9}, {
  3.995030461681397*^9, 3.995030463441915*^9}},
 CellLabel->
  "In[318]:=",ExpressionUUID->"dc9184c9-457d-4174-ba92-b69c9ea56f10"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["findSimilarity[",
  FontWeight->"Bold"],
 StyleBox["rep_,repPrime_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.990283251971992*^9, 3.990283256027812*^9}, {
  3.9951960187204533`*^9, 
  3.99519603015359*^9}},ExpressionUUID->"8135b16a-674b-4de7-8247-\
424cb2448987"],

Cell["\<\
More generally, there are many instances in which concrete representations \
may be related by more complex similarity transformations. 
We may construct this artificially as follows \
\>", "Text",
 CellChangeTimes->{{3.994929680371393*^9, 3.994929744545999*^9}, {
  3.995018420149239*^9, 
  3.995018428492517*^9}},ExpressionUUID->"d269fa6b-7674-4c4d-86a2-\
312f5b3dae23"],

Cell[BoxData[
 RowBox[{"egRep", "=", 
  RowBox[{"fundamentalRep", "[", 
   RowBox[{"a", "[", "5", "]"}], "]"}]}]], "Input",
 CellLabel->
  "In[320]:=",ExpressionUUID->"f1cf78b6-503c-4ed9-95d5-5ca062e5321d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egChangeOfBasis", "=", 
   RowBox[{"SparseArray", "@", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "50"}], "}"}], ",", 
      RowBox[{
       RowBox[{"Dimensions", "[", "egRep", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}], "]"}], "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.994929755539069*^9, 3.994929763802566*^9}, {
  3.995196041193799*^9, 3.995196043473435*^9}},
 CellLabel->
  "In[321]:=",ExpressionUUID->"09f0e909-42d1-44b2-9b4f-a1f7460f6893"],

Cell[BoxData[{
 RowBox[{"egSimilarRep", "=", 
  RowBox[{
   RowBox[{"inverse", "[", "egChangeOfBasis", "]"}], ".", "egRep", ".", 
   "egChangeOfBasis"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.994929780256117*^9, 3.994929781338313*^9}, {
  3.995196047997257*^9, 3.995196048964126*^9}},
 CellLabel->
  "In[323]:=",ExpressionUUID->"e0b528b5-c8b9-461c-af43-3f3d0586497e"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " this representation is presented with generators ",
 StyleBox["far",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " from canonical"
}], "Text",
 CellChangeTimes->{
  3.994929853588779*^9},ExpressionUUID->"3707fa89-f89f-4ed7-b5b7-\
42e1c07b05f1"],

Cell[BoxData[
 RowBox[{"showGenerators", "[", 
  RowBox[{"h", ",", "egSimilarRep"}], "]"}]], "Input",
 CellChangeTimes->{{3.995378015735119*^9, 3.995378020124572*^9}},
 CellLabel->
  "In[325]:=",ExpressionUUID->"ed00d655-85cd-4171-8c3e-936307a2b7e6"],

Cell["\<\
Even though far from diagonal, we can check that these generators are \
mutually commuting via direct computation. \
\>", "Text",
 CellChangeTimes->{{3.9953780496322393`*^9, 
  3.9953780798845987`*^9}},ExpressionUUID->"0d26b3a3-980b-46eb-a6bb-\
e748f2475689"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"#1", ".", "#2"}], "-", 
     RowBox[{"#2", ".", "#1"}]}], "]"}], "&"}], "@@@", 
  RowBox[{"Subsets", "[", 
   RowBox[{
    RowBox[{"Transpose", "@", 
     RowBox[{"cartanGenerators", "[", "egSimilarRep", "]"}]}], ",", 
    RowBox[{"{", "2", "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.995378023446534*^9, 3.9953780431530323`*^9}},
 CellLabel->
  "In[326]:=",ExpressionUUID->"0dd86ef5-674e-4766-9848-3293ce1518cf"],

Cell[TextData[{
 "And we can easily check that the \
nontrivially-\[OpenCurlyDoubleQuote]rotated\[CloseCurlyDoubleQuote] \
generators induce the same ",
 StyleBox["adjoint",
  FontWeight->"Bold"],
 " (hence, satisfy ",
 StyleBox["identical",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " commutation relations): "
}], "Text",
 CellChangeTimes->{{3.994929864546907*^9, 3.994929902256802*^9}, {
  3.995378087710155*^9, 
  3.995378088961425*^9}},ExpressionUUID->"a3f31777-a0dd-4b84-822e-\
48c06721b33b"],

Cell[BoxData[{
 RowBox[{"inducedAdjoint", "[", "egSimilarRep", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"inducedAdjoint", "[", "egSimilarRep", "]"}], "===", 
  RowBox[{"inducedAdjoint", "[", "egRep", "]"}]}]}], "Input",
 CellChangeTimes->{{3.994929903941492*^9, 3.9949299245819263`*^9}},
 CellLabel->
  "In[327]:=",ExpressionUUID->"8866ef3c-d774-4352-88fe-826f8e54dd2f"],

Cell[TextData[{
 "For two ",
 StyleBox["similar",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " representations ",
 StyleBox["R\[TildeEqual]S",
  FontWeight->"Bold"],
 ", the function ",
 StyleBox["findSimilarity[",
  FontWeight->"Bold"],
 StyleBox["R,S",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 " will return the matrix ",
 StyleBox["M",
  FontWeight->"Bold"],
 " such that \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SuperscriptBox[
     StyleBox["M",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], ")"}], TraditionalForm]],ExpressionUUID->
  "5c06d604-c26a-48d3-a76b-96a0e4cfe014"],
 ".",
 StyleBox["R",
  FontWeight->"Bold"],
 ".",
 StyleBox["M",
  FontWeight->"Bold"],
 "=",
 Cell[BoxData[
  FormBox[
   StyleBox["S",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]],ExpressionUUID->
  "313f6d77-dbc3-4b1e-8bf6-efa171d4a64e"]
}], "Text",
 CellChangeTimes->{{3.994929932308034*^9, 
  3.994930054820943*^9}},ExpressionUUID->"7b1cdff0-f96b-463f-8ed8-\
61d91b8d2eaa"],

Cell[BoxData[{
 RowBox[{"egSimilarity", "=", 
  RowBox[{"findSimilarity", "[", 
   RowBox[{"egRep", ",", "egSimilarRep"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"nice", "[", "egChangeOfBasis", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.994930062375597*^9, 3.99493011833971*^9}, 
   3.995196065275201*^9},
 CellLabel->
  "In[330]:=",ExpressionUUID->"593981d0-70a6-40db-a0b7-5ac0ae91b5d6"]
}, Closed]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Building ",
 StyleBox["Other",
  FontWeight->"Bold"],
 " (\[OpenCurlyDoubleQuote]",
 StyleBox["Colour",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote]) ",
 StyleBox["Tensors",
  FontWeight->"Bold"],
 " from ",
 StyleBox["Concrete ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["Representations",
  FontWeight->"Bold"]
}], "Section",
 CellChangeTimes->{{3.9902826538877*^9, 3.9902827200710993`*^9}, {
  3.9950305132764263`*^9, 3.99503052278439*^9}, {3.9951960949523687`*^9, 
  3.995196097621715*^9}},ExpressionUUID->"f52999ce-19ab-46f9-af9e-\
3b2873ece8ca"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Structure Constants",
 FontWeight->"Bold",
 FontSlant->"Italic"]], "Subsection",
 CellChangeTimes->{{3.995105016505842*^9, 
  3.995105025468927*^9}},ExpressionUUID->"d2c22cf1-5717-4730-b392-\
7b7ce79122b8"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["structureConstants[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.995105063212483*^9, 
  3.995105069552121*^9}},ExpressionUUID->"7500caed-562f-49f1-b103-\
a6ad3073673c"],

Cell[TextData[{
 "The \[OpenCurlyDoubleQuote]structure constants\[CloseCurlyDoubleQuote] of a \
Lie algebra is the fully-antisymmetric tensor related to the ",
 StyleBox["adjoint representation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " obtained",
 StyleBox[" ",
  FontWeight->"Bold",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.995105028458419*^9, 3.995105042419609*^9}, {
  3.995105121401019*^9, 
  3.995105232617584*^9}},ExpressionUUID->"cc0d4c71-39ef-4cbc-9434-\
cb0df9c6cf59"],

Cell[BoxData[
 RowBox[{"structureConstantIdentity", "//", "nice"}]], "Input",
 CellChangeTimes->{{3.9951051454890347`*^9, 3.995105151320373*^9}},
 CellLabel->
  "In[332]:=",ExpressionUUID->"0101764f-9a4e-4973-b5a2-8edd34693dad"],

Cell[BoxData[{
 RowBox[{"structureConstants", "[", 
  RowBox[{"g", "[", "2", "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.9951050474031887`*^9, 3.995105058430746*^9}},
 CellLabel->
  "In[333]:=",ExpressionUUID->"e56b84fc-6719-4244-8c3b-fe844cfbecbb"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "The ",
 StyleBox["Quadratic",
  FontWeight->"Bold"],
 " ",
 StyleBox["Casimir ",
  FontWeight->"Bold"],
 "(as a ",
 StyleBox["Tensor",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ")"
}], "Subsection",
 CellChangeTimes->{{3.995030531162239*^9, 3.995030584380393*^9}, {
  3.995105111491571*^9, 3.995105113586874*^9}, {3.995196125274795*^9, 
  3.9951961381891127`*^9}},ExpressionUUID->"f2e69672-58b1-4c50-b305-\
2cced16fe4e5"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["casimirC2[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.990283055379019*^9, 3.9902830651806183`*^9}, {
  3.995031049998125*^9, 
  3.9950310507441683`*^9}},ExpressionUUID->"b7a4c578-1815-45e8-93f0-\
81e8f2417249"],

Cell[TextData[{
 "An important \[OpenCurlyDoubleQuote]invariant\[CloseCurlyDoubleQuote] of a \
representation is the ",
 StyleBox["quadratic Casimir",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " operator defined via\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "2"], TraditionalForm]],ExpressionUUID->
  "396f2da2-476d-469b-9589-f5eeebff6cf2"],
 "(",
 StyleBox["R",
  FontWeight->"Bold"],
 "):=",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["R",
      FontWeight->"Bold",
      FontSlant->"Plain"], "a"], ".", 
    SuperscriptBox[
     StyleBox["R",
      FontWeight->"Bold",
      FontSlant->"Plain"], "b"]}], TraditionalForm]],ExpressionUUID->
  "b69e2b0d-15f9-41fb-9c46-171eda55476d"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Kappa]", 
    StyleBox["ab",
     FontSlant->"Italic"]], TraditionalForm]],ExpressionUUID->
  "19176b30-20bc-425e-bf1e-92a90c357301"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Kappa]", 
    StyleBox["ab",
     FontSlant->"Italic"]], TraditionalForm]],ExpressionUUID->
  "6af98ea2-093c-4aa4-a7ef-a0fbf9bd7cd5"],
 " is the (",
 StyleBox["conventionally defined",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ") ",
 StyleBox["inverse of the Killing metric",
  FontWeight->"Bold"],
 " for the algebra\[LongDash]namely, "
}], "Text",
 CellChangeTimes->{{3.995358215721243*^9, 
  3.9953582232990227`*^9}},ExpressionUUID->"df563ef5-bf9d-4f0a-824d-\
c6e8f21273df"],

Cell[BoxData[{
 RowBox[{"inverse", "@", 
  RowBox[{"killingMetric", "[", 
   RowBox[{"g", "[", "2", "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"matrixForm", "[", "%", "]"}], ",", 
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.995537659532852*^9, 3.9955376699162188`*^9}},
 CellLabel->
  "In[335]:=",ExpressionUUID->"6b05be12-c57b-4ba7-899e-96adfc812d9c"],

Cell[TextData[{
 "For ",
 StyleBox["irreducible representations",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " it is a consequence of Schur\[CloseCurlyQuote]s Lemma that the quadratic \
Casimir be proportional to the identity matrix:"
}], "Text",
 CellChangeTimes->{{3.9950306315403337`*^9, 
  3.995030665029924*^9}},ExpressionUUID->"7d418804-ddfa-49b6-8d23-\
335baa99b4f1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"fundamentalRep", "[", 
    RowBox[{"g", "[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"egC2", "=", 
  RowBox[{"casimirC2", "[", "egRep", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.993032011135209*^9, 3.993032053690136*^9}, {
  3.9950308070296593`*^9, 3.995030844545727*^9}},
 CellLabel->
  "In[337]:=",ExpressionUUID->"bb3354a0-caaf-409e-857b-fc07b2d9d986"],

Cell[TextData[{
 "It is easy to verify that this \[OpenCurlyDoubleQuote]",
 StyleBox["invariant",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote] is proportional to the identity tensor:"
}], "Text",
 CellChangeTimes->{{3.995030860564104*^9, 
  3.9950308828312187`*^9}},ExpressionUUID->"a4fda8d6-651b-4968-9ded-\
e2386fc75f09"],

Cell[BoxData[
 RowBox[{"matrixForm", "[", "egC2", "]"}]], "Input",
 CellChangeTimes->{{3.995030851884446*^9, 3.995030854756277*^9}, {
  3.995196154155702*^9, 3.99519615440302*^9}},
 CellLabel->
  "In[340]:=",ExpressionUUID->"ef3d03e6-b511-4fb5-8555-aba6bba71563"],

Cell["And the coefficient is given by:", "Text",
 CellChangeTimes->{{3.9950308884689217`*^9, 
  3.9950309118652554`*^9}},ExpressionUUID->"0b70ea10-f5c5-42d3-853f-\
7491cb7b4ed8"],

Cell[BoxData[
 RowBox[{"casimirEigenvalue", "[", 
  RowBox[{"dynkinLabel", "[", "egRep", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.995030893511901*^9, 3.9950309062939243`*^9}},
 CellLabel->
  "In[341]:=",ExpressionUUID->"823922a2-3d8f-42ae-a4a9-33a43c1f5c22"],

Cell[TextData[{
 "For ",
 StyleBox["reducible",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 StyleBox["representations",
  FontWeight->"Bold"],
 ", however, this tensor is generally ",
 StyleBox["not proportional to the identity",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". All that can be said is that its ",
 StyleBox["eigenvalues",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " correspond to those of the irreducible representations appearing in its \
decomposition into irreducible representation. "
}], "Text",
 CellChangeTimes->{{3.990781142563785*^9, 3.990781205829356*^9}, {
  3.990781253660487*^9, 3.9907812982229033`*^9}, {3.995030681237664*^9, 
  3.9950306950848837`*^9}, {3.9950309170473347`*^9, 
  3.9950309792008944`*^9}},ExpressionUUID->"c0807d2c-0144-4d60-8b3c-\
75d7c83932a6"],

Cell[BoxData[{
 RowBox[{"egRep", "=", 
  RowBox[{"repPower", "[", 
   RowBox[{
    RowBox[{"fundamentalRep", "[", 
     RowBox[{"g", "[", "2", "]"}], "]"}], ",", "2"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"egRepDynkinLabel", "=", 
  RowBox[{"dynkinLabel", "[", "egRep", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"egC2", "=", 
  RowBox[{"casimirC2", "[", "egRep", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.993032266782301*^9, 3.993032291862195*^9}, {
  3.995030711598217*^9, 3.995030747988716*^9}},
 CellLabel->
  "In[342]:=",ExpressionUUID->"62240a98-4ef9-487e-ab2f-b5f91a029395"],

Cell[TextData[{
 "We can easily verify that this quadratic Casimir is ",
 StyleBox["not",
  FontWeight->"Bold"],
 " proportional to the identity:"
}], "Text",
 CellChangeTimes->{{3.995030993582571*^9, 
  3.995031022555307*^9}},ExpressionUUID->"256e04a9-cac8-49e9-9681-\
2a473378eb01"],

Cell[BoxData[
 RowBox[{"matrixForm", "[", "egC2", "]"}]], "Input",
 CellChangeTimes->{{3.995031023936035*^9, 3.995031026586215*^9}, {
  3.9951961665196037`*^9, 3.995196166751225*^9}},
 CellLabel->
  "In[347]:=",ExpressionUUID->"93004851-5703-49bb-b8b2-b6b66b2fd0a8"],

Cell[BoxData[{
 RowBox[{"Eigenvalues", "[", "egC2", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"#", ",", 
     RowBox[{"Count", "[", 
      RowBox[{"%", ",", "#"}], "]"}]}], "}"}], "&"}], "/@", 
  RowBox[{"Sort", "@", 
   RowBox[{"DeleteDuplicates", "[", "%", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"List", "@@", "egRepDynkinLabel"}], "/.", 
  RowBox[{
   RowBox[{"times", "[", 
    RowBox[{"mult_", ",", "label_"}], "]"}], ":>", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"casimirEigenvalue", "[", "label", "]"}], ",", 
     RowBox[{"mult", " ", 
      RowBox[{"representationDimension", "[", "label", "]"}]}]}], 
    "}"}]}]}]}], "Input",
 CellChangeTimes->{{3.993032304331766*^9, 3.993032363587562*^9}, {
  3.993032396633284*^9, 3.993032512791396*^9}, {3.993309698631411*^9, 
  3.993309699282922*^9}, {3.995030755601153*^9, 3.995030756412368*^9}, {
  3.995376793651493*^9, 3.9953767942764397`*^9}},
 CellLabel->
  "In[348]:=",ExpressionUUID->"21c9fd03-920e-4aee-a9e9-98893df82013"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "(",
 StyleBox["Dot-",
  FontWeight->"Bold"],
 ")",
 StyleBox["Powers",
  FontWeight->"Bold"],
 " of ",
 StyleBox["Generators ",
  FontWeight->"Bold"],
 "of a ",
 StyleBox["Concrete ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["Representation",
  FontWeight->"Bold"]
}], "Subsection",
 CellChangeTimes->{{3.990517934056685*^9, 3.990517940282976*^9}, {
  3.990781320142478*^9, 3.9907813434670687`*^9}, {3.995196241638097*^9, 
  3.9951962488719873`*^9}},ExpressionUUID->"842e2525-02aa-4a39-8cf9-\
e0afc85fbcfa"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["dotPower[",
  FontWeight->"Bold"],
 StyleBox["rep_,n_",
  FontSlant->"Italic"],
 "Integer",
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.9905179439550533`*^9, 
  3.990517959171896*^9}},ExpressionUUID->"1bf5ec66-e383-49ea-a025-\
bbd148fd2ae5"],

Cell[BoxData[{
 RowBox[{"dotPower", "[", 
  RowBox[{
   RowBox[{"fundamentalRep", "[", 
    RowBox[{"g", "[", "2", "]"}], "]"}], ",", "4"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.9905395063271637`*^9, 3.990539523110279*^9}, {
  3.992618514892198*^9, 3.9926185204053907`*^9}, {3.9927045899148293`*^9, 
  3.9927045904006233`*^9}, {3.992705514191843*^9, 3.992705516259034*^9}, {
  3.992707764585259*^9, 3.992707767160254*^9}, {3.993032531428433*^9, 
  3.993032537302857*^9}},
 CellLabel->
