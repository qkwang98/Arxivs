Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["realRepresentationQ[",
  FontWeight->"Bold"],
 StyleBox["dynkinLabel",
  FontSlant->"Italic"],
 "_",
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.99070200628467*^9, 3.990702031628426*^9}, {
   3.990702064665764*^9, 3.990702065368287*^9}, 
   3.9950167938122177`*^9},ExpressionUUID->"9c9eefd0-aa09-45b6-9ad4-\
1e2070168e3b"],

Cell[TextData[{
 "A representation is ",
 StyleBox["real",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " if it is ",
 StyleBox["equivalent",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " to its image under conjugation. \n(Notice that ",
 StyleBox["all",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " all representations of ",
 StyleBox["b[",
  FontWeight->"Bold"],
 StyleBox["k",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ",",
 StyleBox["c[",
  FontWeight->"Bold"],
 StyleBox["k",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ",",
 StyleBox["e[",
  FontWeight->"Bold"],
 "7",
 StyleBox["]",
  FontWeight->"Bold"],
 ",",
 StyleBox["e[",
  FontWeight->"Bold"],
 "8",
 StyleBox["]",
  FontWeight->"Bold"],
 ",",
 StyleBox["f[",
  FontWeight->"Bold"],
 "4",
 StyleBox["]",
  FontWeight->"Bold"],
 ", and ",
 StyleBox["g[",
  FontWeight->"Bold"],
 "2",
 StyleBox["]",
  FontWeight->"Bold"],
 " are ",
 StyleBox["real",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ".)"
}], "Text",
 CellChangeTimes->{{3.990703067977803*^9, 3.990703147510604*^9}, {
  3.995194676786232*^9, 
  3.995194694686962*^9}},ExpressionUUID->"7c124a89-b460-42ac-85f3-\
e26fa5fdfe46"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"nice", "[", "#", "]"}], ",", "#", ",", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"realRepresentationQ", "[", "#", "]"}], ",", "Bold"}], 
       "]"}]}], "}"}], "&"}], "/@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"w", "[", "e", "]"}], "@@@", 
     RowBox[{"IdentityMatrix", "[", "6", "]"}]}], ")"}]}], "//", 
  "Grid"}]], "Input",
 CellChangeTimes->{{3.990703152743669*^9, 3.990703165688703*^9}, {
  3.994846117133876*^9, 3.994846132573214*^9}, {3.9948461757562323`*^9, 
