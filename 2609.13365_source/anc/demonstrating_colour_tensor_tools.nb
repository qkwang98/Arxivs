Cell["\<\
We can find the change of basis between these two bases.
If we apply the change of basis PermutationOrder[egPerm] number of times, we \
will return to the original basis.

n.b. in the below example we \[OpenCurlyDoubleQuote]cheat\
\[CloseCurlyDoubleQuote] slightly by stripping off the superscript on the \
Clebsches in permuted bases.
Instead, it is understood in the last table that the ordering in the i-th row \
is the result of applying egPerm i-1 times to Range[5].\
\>", "Text",
 CellChangeTimes->{{3.9960758763956833`*^9, 
  3.99607598375005*^9}},ExpressionUUID->"8bb5abd8-9554-473b-98bc-\
760c324bc6ca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egPermRelation", "=", 
   RowBox[{
    RowBox[{"tensorRelations", "[", 
     RowBox[{"F", "[", 
      RowBox[{"a", "[", "1", "]"}], "]"}], "]"}], "[", 
    RowBox[{"Join", "@@", "egTensorLists"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Column", "[", 
   RowBox[{"nice", "/@", "%"}], "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NestList", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"#", "/.", "egPermRelation"}], ")"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"clebschTensor", "[", 
          RowBox[{"x__", ",", " ", "order_List"}], "]"}], "->", 
         RowBox[{"clebschTensor", "[", "x", "]"}]}], "}"}]}], "]"}], "&"}], ",",
     " ", 
    RowBox[{"a1ClebschBasis", "[", "ephN", "]"}], ",", 
    RowBox[{"PermutationOrder", "[", "egPerm", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", 
  RowBox[{"nice", "/@", "%"}], "]"}]}], "Input",
 CellChangeTimes->{{3.995280450194376*^9, 3.9952804523800898`*^9}, {
  3.996075486124239*^9, 3.996075499566201*^9}, {3.996075542704871*^9, 
