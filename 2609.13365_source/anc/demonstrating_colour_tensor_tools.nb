e9f5f177fd59"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["representationDimension[",
  FontWeight->"Bold"],
 StyleBox["dynkinLabel_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.99070262033285*^9, 3.990702634187208*^9}, 
   3.995016786749716*^9},ExpressionUUID->"431f95a0-a1ca-41da-95d7-\
50a7c2827125"],

Cell[BoxData[{
 RowBox[{"egIrrepLabel", "=", 
  RowBox[{
   RowBox[{"w", "[", "e", "]"}], "@@", 
   RowBox[{"RandomInteger", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "5"}], "}"}], ",", 
     RowBox[{"{", "6", "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"representationDimension", "[", "egIrrepLabel", "]"}]}], "Input",
 CellChangeTimes->{{3.9907028235729017`*^9, 3.99070283783962*^9}},
