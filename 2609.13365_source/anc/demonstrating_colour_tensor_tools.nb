Cell[TextData[{
 StyleBox["Conjugate",
  FontWeight->"Bold"],
 " ",
 StyleBox["Representations",
  FontWeight->"Bold"]
}], "Subsection",
 CellChangeTimes->{{3.9949281824479647`*^9, 
  3.994928188700891*^9}},ExpressionUUID->"9c944dc2-927a-474c-9b39-\
68bfb0551adf"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["conjugateRep[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.9949282822381477`*^9, 
  3.994928291363812*^9}},ExpressionUUID->"62e016f5-6cb5-4fb2-a37e-\
5ec282c34daa"],

Cell[TextData[{
 "Every representation has a ",
 StyleBox["conjugate",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " representation defined as having generators related by the \
negative-transpose. "
}], "Text",
 CellChangeTimes->{
  3.995358122984758*^9},ExpressionUUID->"598974f2-e230-4aea-ac11-\
24547a69f218"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"fundamentalRep", "[", 
    RowBox[{"a", "[", "3", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"egConjugate", "=", 
  RowBox[{"conjugateRep", "[", "egRep", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.994928253356516*^9, 3.99492826883759*^9}, {
  3.994928321533083*^9, 3.9949283440133457`*^9}},
 CellLabel->
  "In[178]:=",ExpressionUUID->"6d5b1f06-dbf5-4f97-8ab9-356d00860673"],

Cell[BoxData[
 RowBox[{"Transpose", "[", 
  RowBox[{"showGenerators", "/@", 
   RowBox[{"{", 
    RowBox[{"egRep", ",", "egConjugate"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.994928301637442*^9, 3.9949283646792192`*^9}},
 CellLabel->
  "In[181]:=",ExpressionUUID->"db69338d-730c-4ac7-86a8-33bbb7a7d6bc"],

Cell[TextData[{
 StyleBox["Real",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " representations are those that are ",
 StyleBox["similar to",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " their ",
 StyleBox["conjugates",
  FontWeight->"Bold"],
 ". They need not have identical generators\[LongDash]their generators must \
(merely) be related by ",
 StyleBox["similarity",
  FontWeight->"Bold"],
 ". "
}], "Text",
 CellChangeTimes->{{3.994928379630102*^9, 
  3.994928456491568*^9}},ExpressionUUID->"7669a46d-ba53-43e7-bbd0-\
a71096ace617"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"fundamentalRep", "[", 
    RowBox[{"b", "[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"egConjugate", "=", 
  RowBox[{"conjugateRep", "[", "egRep", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.994928469576589*^9, 3.994928472670053*^9}},
 CellLabel->
  "In[182]:=",ExpressionUUID->"c4ddea71-8e04-4058-aa30-6bd31f100fec"],

Cell[BoxData[
 RowBox[{"Transpose", "[", 
  RowBox[{"showGenerators", "/@", 
   RowBox[{"{", 
    RowBox[{"egRep", ",", "egConjugate"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[185]:=",ExpressionUUID->"fff86935-5366-4b4f-9469-bfffb4aa47a4"]
}, Closed]]
}, Closed]],

