  3.995104947239934*^9, 3.9951049526282187`*^9}},
 CellLabel->
  "In[293]:=",ExpressionUUID->"017d433b-0ea9-4c5c-8d33-d4e5727775b2"],

Cell[BoxData[{
 RowBox[{"egRep", "=", 
  RowBox[{"repPower", "[", 
   RowBox[{
    RowBox[{"fundamentalRep", "[", 
     RowBox[{"f", "[", "4", "]"}], "]"}], ",", "2"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"buildTensors", "[", "egRep", "]"}], "[", 
