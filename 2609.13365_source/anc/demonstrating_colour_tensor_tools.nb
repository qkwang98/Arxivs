  3.992965622320363*^9, 3.9929656251792793`*^9}, {3.995195223455015*^9, 
  3.995195237704028*^9}},
 CellLabel->
  "In[186]:=",ExpressionUUID->"73e76d0c-d91e-4278-a084-5cf1d5412080"],

Cell[TextData[{
 "For adding multiples of the same representation, the function ",
 StyleBox["repSum",
  FontWeight->"Bold"],
 " allows for syntax such as\n",
 StyleBox["repSum[",
  FontWeight->"Bold"],
 StyleBox["n_",
  FontSlant->"Italic"],
 "Integer",
 StyleBox[",rep_",
  FontSlant->"Italic"],
 StyleBox["] ",
  FontWeight->"Bold"],
 "or ",
 StyleBox["repSum[",
  FontWeight->"Bold"],
 StyleBox["rep_,n_",
  FontSlant->"Italic"],
 "Integer",
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.990440440553309*^9, 3.9904404977111883`*^9}, {
  3.990440530222373*^9, 
  3.990440563748694*^9}},ExpressionUUID->"21467442-3a7a-4008-83a6-\
2d596b2e8ef4"],

