 CellLabel->"In[29]:=",ExpressionUUID->"a42a6083-04ff-4a20-8173-2f0229744000"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " when there are multiple irreducible representations of a given dimension, ",
 StyleBox["irrepDimensionToDynkinLabels",
  FontWeight->"Bold"],
 " will return the Dynkin labels of all such irreducible representations"
}], "Text",
 CellChangeTimes->{{3.990704218876964*^9, 
  3.990704266143446*^9}},ExpressionUUID->"bc0a2c19-84b5-497c-877d-\
c6db2a1107e6"],

