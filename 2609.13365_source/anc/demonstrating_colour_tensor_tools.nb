 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"nice", "[", "#", "]"}], ",", "#", ",", 
      RowBox[{"realRepresentationQ", "[", "#", "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"pseudoRealRepresentationQ", "[", "#", "]"}], ",", "Bold"}], 
       "]"}]}], "}"}], "&"}], "/@", 
   RowBox[{"(", 
    RowBox[{
