Cell[TextData[{
 StyleBox["Note: ",
  FontWeight->"Bold"],
 "the function ",
 StyleBox["tensorPowerDecomposition",
  FontWeight->"Bold"],
 " allows for both \[OpenCurlyDoubleQuote]",
 StyleBox["standard",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote] Dynkin labels (of the form ",
 StyleBox["w[",
  FontWeight->"Bold"],
 StyleBox["type_",
  FontSlant->"Italic"],
 StyleBox["][",
  FontWeight->"Bold"],
 StyleBox["highestWeightLabelSequence__",
  FontSlant->"Italic"],
 "Integer",
 StyleBox["]",
  FontWeight->"Bold"],
 ")\nand also the (optional) special syntax for ",
 StyleBox["adjoint",
  FontWeight->"Bold"],
 " (\[OpenCurlyDoubleQuote]",
 StyleBox["ad[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote]), and ",
 StyleBox["defining ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "(aka ",
 StyleBox["Fundamental",
  FontWeight->"Bold"],
 ") representation ",
 StyleBox["F[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{{3.990778845340217*^9, 
  3.990778966504005*^9}},ExpressionUUID->"ef28fc2a-9277-4b3e-a128-\
1e4e2edb1695"],

