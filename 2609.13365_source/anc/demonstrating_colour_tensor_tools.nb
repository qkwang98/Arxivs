   3.990870267986567*^9},
 CellLabel->
  "In[131]:=",ExpressionUUID->"6b867a6c-9242-4787-8ed0-72574ac65ca3"],

Cell[TextData[{
 StyleBox["Note",
  FontWeight->"Bold"],
 ": the difference is not ",
 StyleBox["identically",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " zero unless ",
 StyleBox["wrapped",
  FontWeight->"Bold"],
 " ",
 StyleBox["in",
  FontWeight->"Bold"],
 " ",
 StyleBox["SparseArray ",
  FontWeight->"Bold"],
 "(which removes all indices set to zero)",
 ":"
}], "Text",
 CellChangeTimes->{{3.990279893417863*^9, 3.9902799402984457`*^9}, {
  3.9949215731670027`*^9, 
  3.994921599386592*^9}},ExpressionUUID->"43a13312-4a6b-4db7-bb6f-\
5ad288b7499c"],

Cell[BoxData[{
 RowBox[{"commutatorTensor", "-", "fDotTtensor"}], "\[IndentingNewLine]", 
 RowBox[{"SparseArray", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", 
  RowBox[{"%", "[", "\"\<NonzeroValues\>\"", "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.994921534908515*^9, 3.994921556813467*^9}},
 CellLabel->
  "In[132]:=",ExpressionUUID->"753c2245-5c1c-4c9d-988b-50eb54795a13"],

Cell[TextData[{
 StyleBox["Note",
  FontWeight->"Bold"],
 ": wrapping a tensor in ",
 StyleBox["SparseArray",
  FontWeight->"Bold"],
 "[] does not apply ",
 StyleBox["FullSimplify",
  FontWeight->"Bold"],
 "[]; \nin particular, any expressions which are not \
\[OpenCurlyDoubleQuote]",
 StyleBox["trivially zero",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote] (in the sense that Mathematica will ",
 StyleBox["automatically",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " express it as such) will be left undetermined:"
}], "Text",
 CellChangeTimes->{{3.99492160685189*^9, 3.994921687159956*^9}, {
  3.994921892239311*^9, 
  3.99492190277109*^9}},ExpressionUUID->"cd5da0b0-cd36-4c14-8f55-\
ce67af4520b8"],

Cell[BoxData[{
 RowBox[{"egNontrivialZero", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"#1", "+", 
       RowBox[{"#2", 
        SqrtBox["2"]}]}], 
      RowBox[{"#3", "+", 
       RowBox[{"#4", " ", 
        SqrtBox["2"]}]}]], "-", 
     RowBox[{
      FractionBox["1", 
       RowBox[{
        SuperscriptBox["#3", "2"], "-", 
        RowBox[{"2", 
         SuperscriptBox["#4", "2"]}]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#1", " ", "#3"}], "-", 
          RowBox[{"2", " ", "#2", " ", "#4"}]}], ")"}], "-", 
        RowBox[{
         SqrtBox["2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#1", " ", "#4"}], "-", 
           RowBox[{"#2", " ", "#3"}]}], ")"}]}]}], ")"}]}]}], "&"}], "@@", 
   RowBox[{"RandomInteger", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "5"}], "}"}], ",", 
     RowBox[{"{", "4", "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"SparseArray", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i_", ",", "i_"}], "}"}], ":>", "egNontrivialZero"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "10"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", "egNontrivialZero", "]"}]}], "Input",
 CellChangeTimes->{{3.99492168796303*^9, 3.9949217116706743`*^9}, {
  3.9949217651590433`*^9, 3.994921933552638*^9}, {3.9949220792474537`*^9, 
  3.994922100478128*^9}},
 CellLabel->
  "In[135]:=",ExpressionUUID->"faad4032-2e5a-415f-a232-0327bc9c6332"]
}, Closed]],

