Cell[TextData[{
 "These numbers are ",
 StyleBox["conventionally defined",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ";",
 StyleBox[" ",
  FontSlant->"Italic"],
 "but for ",
 StyleBox["any",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " set of conventions, they ",
 StyleBox["must",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " be related via:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"dim", "(", 
     StyleBox["R",
      FontWeight->"Bold",
      FontSlant->"Plain"], ")"}], 
    SubscriptBox["C", "2"]}], TraditionalForm]],ExpressionUUID->
  "7dce241c-3027-4148-bc41-998c7d7026f5"],
 "(",
 StyleBox["R",
  FontWeight->"Bold"],
 ")=dim(",
 StyleBox["g",
  FontWeight->"Bold"],
 ")T(",
 StyleBox["R",
  FontWeight->"Bold"],
 ")"
}], "Text",
 CellChangeTimes->{{3.990704103749899*^9, 3.990704164443893*^9}, {
  3.995194782113905*^9, 
  3.995194788056837*^9}},ExpressionUUID->"cfb8324b-56e8-447b-b6c6-\
698b80e4e27c"],

