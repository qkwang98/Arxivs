  "nice"}]], "Input",
 CellChangeTimes->{{3.9960737285488367`*^9, 3.996073732014235*^9}, {
  3.996073824819147*^9, 3.9960738287299128`*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"71b4a342-2cab-4023-a244-71b60510245f"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Exempli Gratia : ",
  FontWeight->"Bold"],
 "generating rank-m symmetric tensors of a[k_] "
}], "Subsubsection",
 CellChangeTimes->{
  3.9960721591164913`*^9, {3.99607384723748*^9, 
   3.996073851504553*^9}},ExpressionUUID->"2e390982-6607-4683-a3e9-\
858a30508d98"],

Cell["\<\
The rank-m completely symmetric irrep of a[k] is given exactly by the m-th \
symmetric power of the first fundamental. 
This makes it especially easy to generate these irreps concretely.\
\>", "Text",
 CellChangeTimes->{{3.996071691101261*^9, 3.996071751750029*^9}, {
   3.996072140117775*^9, 3.996072157083517*^9}, {3.996072242736437*^9, 
   3.996072259083109*^9}, 3.9960738584707317`*^9, {3.996076120682783*^9, 
   3.996076134139639*^9}},ExpressionUUID->"44abb88a-4259-46d0-89cc-\
d26fda5d6517"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"symPowerDecomposition", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"w", "[", "a", "]"}], "[", 
      RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "]"}], ",", "#"}], "]"}], 
   "&"}], "/@", 
  RowBox[{"Range", "[", "4", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "@", "%"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"symPower", "[", 
    RowBox[{
     RowBox[{"fundamentalRep", "[", 
      RowBox[{"a", "[", "4", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
  RowBox[{"Range", "[", "4", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "@", "%"}]}], "Input",
 CellChangeTimes->{{3.996072193139639*^9, 3.996072206878228*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"1539e38e-16d4-4114-81b6-48491282f705"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["numberOfIndependentColourTensors[",
  FontWeight->"Bold"],
 StyleBox["reps__",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ": Counting ",
 StyleBox["Independent",
  FontWeight->"Bold"],
 " Tensors for ",
 StyleBox["Scattering Amplitudes",
  FontWeight->"Bold",
  FontSlant->"Italic"]
}], "Subsubsection",
 CellChangeTimes->{{3.990541441090242*^9, 3.990541454898625*^9}, {
  3.995105519427127*^9, 
  3.995105545686693*^9}},ExpressionUUID->"d4414e4c-772b-4f76-b67b-\
bdfad179f383"],

Cell[TextData[{
 "Scattering amplitude involving some number of ",
 StyleBox["incoming",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " particles charged (or \[OpenCurlyDoubleQuote]coloured\
\[CloseCurlyDoubleQuote]) under some gauge group must map these \
representation/colour indices into those of the ",
 StyleBox["vacuum",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (namely, the trivial representation \[OpenCurlyDoubleQuote]",
 StyleBox["1",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote]); as such, a process involving ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "i"], TraditionalForm]],ExpressionUUID->
  "81fa2e03-5079-4242-9924-dc7fca186a55"],
 " particles transforming under ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R",
     FontWeight->"Bold"], "i"], TraditionalForm]],ExpressionUUID->
  "4e8969b1-2b5e-448a-a69d-8722e6bf6e5c"],
 " of some Lie algebra must involve tensors mapping these indices into the \
vacuum. The number of ",
 StyleBox["linearly independent",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " tensors ",
 "that exist is given by the ",
 StyleBox["multiplicity of ",
  FontSlant->"Italic"],
 "\[OpenCurlyQuote]",
 StyleBox["1",
  FontWeight->"Bold"],
 "\[CloseCurlyQuote] appearing in the decomposition of the tensor product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CircleTimes]", "i"], 
    SuperscriptBox[
     StyleBox["R",
      FontWeight->"Bold",
      FontSlant->"Plain"], 
     RowBox[{"\[CirclePlus]", 
      SubscriptBox["n", "i"]}]]}], TraditionalForm]],ExpressionUUID->
  "12d99014-72d0-46b1-bee9-5fca8f9d4d62"],
 " into irreducible representations. "
}], "Text",
 CellChangeTimes->{{3.990779334142974*^9, 
  3.9907796245963497`*^9}},ExpressionUUID->"8ded3403-4e36-41a6-b93a-\
c8d22a390df7"],

Cell[TextData[{
 "The function ",
 StyleBox["numberOfIndependentColourTensors[",
  FontWeight->"Bold"],
 StyleBox["colouredParticles__",
  FontSlant->"Italic"],
 StyleBox["] ",
  FontWeight->"Bold"],
 "gives this number. "
}], "Text",
 CellChangeTimes->{{3.990779794105939*^9, 
  3.990779866129541*^9}},ExpressionUUID->"79eaea48-8961-4f87-b890-\
524f51e728b3"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " the ",
 StyleBox["syntax",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of ",
 StyleBox["colouredParticles",
  FontSlant->"Italic"],
 " is quite flexible, but ",
 StyleBox["possibly confusing",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". \nThe simplest example syntax would be:\n\t(",
 StyleBox["n",
  FontSlant->"Italic"],
 "_Integer) ",
 StyleBox["ad[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ": counts the number of independent colour tensors for a process involving \
",
 StyleBox["n",
  FontSlant->"Italic"],
 " adjoint-coloured particles in ",
 StyleBox["algebra ",
  FontSlant->"Italic"],
 "gauge theory"
}], "Text",
 CellChangeTimes->{{3.990779869636175*^9, 3.990780051596759*^9}, {
  3.990780111231145*^9, 3.990780121415986*^9}},
 FontWeight->"Plain",ExpressionUUID->"3f8062bc-c1ba-4bd4-af99-89f25f1af697"],

Cell[BoxData[
 RowBox[{"numberOfIndependentColourTensors", "[", 
  RowBox[{"6", " ", 
   RowBox[{"ad", "[", 
    RowBox[{"e", "[", "8", "]"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.990780053639076*^9, 3.990780059371417*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"e7417ffa-e162-4273-9b16-4bab52ce009f"],

Cell[BoxData[{
 RowBox[{"Cases", "[", 
  RowBox[{
   RowBox[{"tensorPowerDecomposition", "[", 
    RowBox[{
     RowBox[{"ad", "[", 
      RowBox[{"e", "[", "8", "]"}], "]"}], ",", "6"}], "]"}], ",", 
   RowBox[{"times", "[", 
    RowBox[{"no_", ",", 
     RowBox[{
      RowBox[{"w", "[", "e", "]"}], "[", 
      RowBox[{"0", ".."}], "]"}]}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.990780062307582*^9, 3.990780092643045*^9}},
 CellLabel->"In[79]:=",ExpressionUUID->"390eebef-479e-4b5c-b797-09f86c72c79b"],

Cell[TextData[{
 "Similarly, for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "1"], TraditionalForm]],ExpressionUUID->
  "c042f71b-decf-4795-b39c-dc7fe6ea6c07"],
 " gauge theory, we can readily count these as a function of ",
 StyleBox["n",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.9907801254351807`*^9, 
  3.990780146162177*^9}},ExpressionUUID->"f77367ec-5274-4e13-8d90-\
d023e00f4159"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"numberOfIndependentColourTensors", "[", 
    RowBox[{"#", " ", 
     RowBox[{"ad", "[", 
      RowBox[{"a", "[", "1", "]"}], "]"}]}], "]"}], "&"}], "/@", 
  RowBox[{"Range", "[", 
   RowBox[{"3", ",", "20"}], "]"}]}]], "Input",
 CellLabel->"In[81]:=",ExpressionUUID->"c33611e5-9385-4995-bc73-8e920449f6b2"],

Cell[TextData[{
 "which agrees with the ",
 StyleBox["n",
  FontWeight->"Bold"],
 "th ",
 StyleBox["riordanNumber[",
  FontWeight->"Bold"],
 StyleBox["n_",
  FontSlant->"Italic"],
 "Integer",
 StyleBox["]",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.990780153626314*^9, 
  3.990780180799408*^9}},ExpressionUUID->"2b433969-07b7-4397-8e0c-\
c0b07bdd72e1"],

Cell[BoxData[
 RowBox[{"riordanNumber", "/@", 
  RowBox[{"Range", "[", 
   RowBox[{"3", ",", "20"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.990780182863826*^9, 3.990780186093239*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"53c2c90b-59de-414a-bdb0-6eee9e51d902"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " any ",
 StyleBox["non-adjoint",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " representations (including \[OpenCurlyQuote]",
 StyleBox["F[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 "\[CloseCurlyQuote] or any representation labelled by it\[CloseCurlyQuote]s \
Dynkin label) is ",
 StyleBox["presumed to label the representation of ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "matter-particles ",
 StyleBox["which must come in complex-conjugate pairs",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". Thus, "
}], "Text",
 CellChangeTimes->{{3.990780198970935*^9, 
  3.9907802727431107`*^9}},ExpressionUUID->"2330fa70-58fe-44aa-acd5-\
94faf0110b00"],

Cell[BoxData[
 RowBox[{"numberOfIndependentColourTensors", "[", 
  RowBox[{"2", 
   RowBox[{"F", "[", 
    RowBox[{"e", "[", "6", "]"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.990780276040862*^9, 3.990780289055627*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"d9e37264-48fc-4b8a-9668-e4ff39a074d2"],

Cell[TextData[{
 StyleBox["counts the number of independent colour tensors for ",
  FontWeight->"Plain"],
 StyleBox["two fermion ",
  FontSlant->"Italic"],
 StyleBox["lines\[LongDash]each corresponding to a ",
  FontWeight->"Plain"],
 StyleBox["pair",
  FontSlant->"Italic"],
 StyleBox[" of particles with endpoints labelled by representations ",
  FontWeight->"Plain"],
 "F[e[",
 StyleBox["6",
  FontWeight->"Plain"],
 "]] ",
 StyleBox["and ",
  FontWeight->"Plain"],
 "conjugateRep[F[e[",
 StyleBox["6",
  FontWeight->"Plain"],
 "]]]"
}], "Text",
 CellChangeTimes->{{3.9907803071443453`*^9, 3.9907804043509283`*^9}},
 FontWeight->"Bold",ExpressionUUID->"816c79c8-136a-4c78-bf0f-3d89e8f3330e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tensorProductDecomposition", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"w", "[", "e", "]"}], "[", 
     RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], "]"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"w", "[", "e", "]"}], "[", 
     RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], "]"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"conjugateRep", "[", 
     RowBox[{
      RowBox[{"w", "[", "e", "]"}], "[", 
      RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], "]"}], 
     "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"conjugateRep", "[", 
     RowBox[{
      RowBox[{"w", "[", "e", "]"}], "[", 
      RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], "]"}], 
     "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "@", 
  RowBox[{"Cases", "[", 
   RowBox[{"%", ",", 
    RowBox[{"times", "[", 
     RowBox[{"no_", ",", 
      RowBox[{
       RowBox[{"w", "[", "e", "]"}], "[", 
       RowBox[{"0", ".."}], "]"}]}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.99078041185935*^9, 3.990780454611742*^9}, {
  3.994846313953836*^9, 3.994846318129636*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"017a3efa-0381-4e9f-964f-1d426463ed5e"],

Cell[TextData[{
 StyleBox["So, to reiterate for clarity, ",
  FontWeight->"Plain"],
 StyleBox["any",
  FontSlant->"Italic"],
 StyleBox[" representation listed that is ",
  FontWeight->"Plain"],
 StyleBox["not the adjoint",
  FontSlant->"Italic"],
 StyleBox[" is ",
  FontWeight->"Plain"],
 StyleBox["automatically",
  FontWeight->"Plain",
  FontSlant->"Italic"],
 StyleBox[" paired with its conjugate representation. ",
  FontWeight->"Plain"]
}], "Text",
 CellChangeTimes->{{3.9907804665336237`*^9, 3.990780533169134*^9}},
 FontWeight->"Bold",ExpressionUUID->"7457e535-2db6-4ccb-92f1-62f7ea9303f5"],

Cell["\<\
Perhaps one final (potentially confusing, but) illustrative example will help \
clarify this presumed meaning. Consider\
\>", "Text",
 CellChangeTimes->{{3.9907805526535263`*^9, 
  3.990780592733489*^9}},ExpressionUUID->"5cb5fa6b-70ae-410a-990c-\
e09d8965541f"],

Cell[BoxData[{
 RowBox[{"egRepList", "=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"w", "[", "a", "]"}], "/@", 
    RowBox[{"Range", "[", "4", "]"}]}], ")"}]}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "nice"}]}], "Input",
 CellChangeTimes->{{3.990869709458652*^9, 3.990869710058278*^9}, {
  3.993308437498458*^9, 3.993308444065722*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"b77481b1-8ed1-4503-9d60-685e321a343b"],

Cell[BoxData[
 RowBox[{"numberOfIndependentColourTensors", "@@", "egRepList"}]], "Input",
 CellChangeTimes->{{3.993308447110931*^9, 3.9933084482082787`*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"b9c36a4c-e842-4e03-8341-110b27cdb981"],

Cell[TextData[{
 "This result, \[OpenCurlyQuote]37\[CloseCurlyQuote], does ",
 StyleBox["not",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " count the multiplicity of ",
 StyleBox["1",
  FontWeight->"Bold"],
 " in the tensor-product w[a][1]\[CircleTimes]w[a][2]\[CircleTimes]w[a][3]\
\[CircleTimes]w[a][4] "
}], "Text",
 CellChangeTimes->{{3.990780597736298*^9, 3.9907807687921457`*^9}, {
  3.990780801264131*^9, 
  3.990780804027975*^9}},ExpressionUUID->"764d96a2-dffb-44e6-bf7c-\
676d2810ac88"],

Cell[BoxData[{
 RowBox[{"tensorProductDecomposition", "@@", "egRepList"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "@", 
  RowBox[{"Cases", "[", 
   RowBox[{"%", ",", 
    RowBox[{"times", "[", 
     RowBox[{"no_", ",", 
      RowBox[{
       RowBox[{"w", "[", "x_", "]"}], "[", 
       RowBox[{"0", ".."}], "]"}]}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.990780807202856*^9, 3.990780807836577*^9}, {
  3.993308453317769*^9, 3.9933084562833767`*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"70d6373f-0209-42b5-9c7d-d89f1a76781a"],

Cell[TextData[{
 StyleBox["but rather",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of the tensor product\n(w[a][1]\[CircleTimes]w[a][1])\[CircleTimes]w[a][2]\
\[CircleTimes](w[a][3]\[CircleTimes]w[a][3])\[CircleTimes](w[a][4]\
\[CircleTimes]w[a][4])\nwhere ",
 StyleBox["note",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ": the ",
 StyleBox["adjoint",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " representation w[a][2] is ",
 StyleBox["not",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " assumed to count as \[OpenCurlyDoubleQuote]matter\[CloseCurlyDoubleQuote] \
and so is not paired with its conjugate"
}], "Text",
 CellChangeTimes->{{3.990780597736298*^9, 3.9907807687921457`*^9}, {
  3.990780801264131*^9, 3.990780802385829*^9}, {3.993308470823937*^9, 
  3.993308473685873*^9}},ExpressionUUID->"e6b40b8d-4476-407d-ab7c-\
829465455b64"],

Cell[BoxData[{
 RowBox[{"matterAmplitudeReps", "=", 
  RowBox[{"Join", "[", 
   RowBox[{
    RowBox[{"Cases", "[", 
     RowBox[{"egRepList", ",", 
      RowBox[{"adjointDynkinLabel", "[", 
       RowBox[{"a", "[", "1", "]"}], "]"}]}], "]"}], ",", 
    RowBox[{"Join", "@@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", 
          RowBox[{"conjugateRep", "@", "#"}]}], "}"}], "&"}], "/@", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{"egRepList", ",", 
         RowBox[{"adjointDynkinLabel", "[", 
          RowBox[{"a", "[", "1", "]"}], "]"}]}], "]"}]}], ")"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.993308482853993*^9, 3.993308639060364*^9}, 
   3.994846336016221*^9},
 CellLabel->"In[91]:=",ExpressionUUID->"4a83c23d-4639-48c3-af79-01c8a6033cb1"],

Cell[BoxData[{
 RowBox[{"tensorProductDecomposition", "@@", "matterAmplitudeReps"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "@", 
  RowBox[{"Cases", "[", 
   RowBox[{"%%", ",", 
    RowBox[{"times", "[", 
     RowBox[{"no_", ",", 
      RowBox[{
       RowBox[{"w", "[", "x_", "]"}], "[", 
       RowBox[{"0", ".."}], "]"}]}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.990780667928133*^9, 3.9907806802509413`*^9}, {
  3.9907807756447287`*^9, 3.9907807931127853`*^9}, {3.993308588151308*^9, 
  3.99330859246848*^9}, {3.99330864453732*^9, 3.993308653893146*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"2e3dfc41-9f6e-4c58-94d7-7386880ecf43"],

Cell[TextData[{
 StyleBox["Aside",
  FontWeight->"Bold"],
 ": this number can also be counted by the size of the ",
 StyleBox["basis",
  FontWeight->"Bold"],
 " of ",
 StyleBox["clebschTensors",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " for this process"
}], "Text",
 CellChangeTimes->{{3.990780816030613*^9, 
  3.990780856136546*^9}},ExpressionUUID->"9bb3e831-c4d8-4b98-9376-\
2281cba75bb2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a1ClebschBasis", "@", 
   RowBox[{"(", 
    RowBox[{"matterAmplitudeReps", "/.", 
     RowBox[{
      RowBox[{
       RowBox[{"w", "[", "a", "]"}], "[", "no_", "]"}], ":>", "no"}]}], 
    ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.9907808571675262`*^9, 3.990780873149764*^9}, {
  3.99510558332827*^9, 3.9951055926978703`*^9}, {3.995205714896319*^9, 
  3.995205717172515*^9}},
 CellLabel->"In[96]:=",ExpressionUUID->"536e20a8-ffea-4549-ada6-289905cd2315"]
}, Closed]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Concrete",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" Representations ",
  FontWeight->"Bold"],
 "of ",
 StyleBox["Simple",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 StyleBox["Lie Algebras",
  FontWeight->"Bold"]
}], "Section",
 CellChangeTimes->{{3.990277741799244*^9, 3.990277749892089*^9}, {
  3.990277856874956*^9, 3.99027786783939*^9}, {3.990278172426609*^9, 
  3.990278182046476*^9}, {3.995194892171138*^9, 
  3.995194893006878*^9}},ExpressionUUID->"d8962326-4d0d-44d8-bfb3-\
aca08596cddf"],

Cell[TextData[{
 "A (matrix) ",
 StyleBox["representation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of any Lie algebra is defined by a set of ",
 StyleBox["generators",
  FontWeight->"Bold"],
 " (r\[Times]r) matrices for which any pair\[CloseCurlyQuote]s ",
 StyleBox["commutator",
  FontWeight->"Bold"],
 " is within the linear ",
 StyleBox["span",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of the generators themselves:"
}], "Text",
 CellChangeTimes->{{3.9901149115861*^9, 3.990115005297997*^9}, {
  3.990277817659481*^9, 3.990277821255938*^9}, {3.990277871058058*^9, 
  3.9902778713577747`*^9}, {3.990277902138439*^9, 
  3.990277903014559*^9}},ExpressionUUID->"c84794b8-dcea-4e70-b1a1-\
6ea13b44a6b0"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"[", 
    RowBox[{
     SuperscriptBox["T", "a"], ",", " ", 
     SuperscriptBox["T", "b"]}], "]"}], "=", 
   RowBox[{":", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["f", "ab"], "c"], 
     SuperscriptBox["T", "c"]}]}]}], 
  TraditionalForm]],ExpressionUUID->"5f8a2c9b-2720-40cf-a405-37bc4d224d2d"]], \
"Text",
 CellChangeTimes->{{3.987078749583312*^9, 
  3.987078792638468*^9}},ExpressionUUID->"3238f5f5-fce1-4fe7-bb46-\
911d2788086b"],

Cell[TextData[{
 "Any set of matrices satisfying this property will ",
 StyleBox["furnish a representation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of some Lie algebra. "
}], "Text",
 CellChangeTimes->{{3.990277933532526*^9, 
  3.990277949680307*^9}},ExpressionUUID->"1f9ddab2-ed56-4ef4-a002-\
63caefb43df4"],

Cell[TextData[{
 "The ",
 StyleBox["number of",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 StyleBox["generators ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "is the \[OpenCurlyDoubleQuote]",
 StyleBox["dimension",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] of the algebra \[OpenCurlyDoubleQuote]",
 StyleBox["d",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote]. Their ",
 StyleBox["size",
  FontSlant->"Italic"],
 " as matrices is the \[OpenCurlyDoubleQuote]",
 StyleBox["dimension",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] of the ",
 StyleBox["representation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.9902778276086063`*^9, 3.990277835419312*^9}, {
  3.990277887478652*^9, 3.990277960627819*^9}, {3.9902781349122*^9, 
  3.990278139034162*^9}, {3.990278253869678*^9, 
  3.990278271570271*^9}},ExpressionUUID->"a754f5fd-8958-4069-81dc-\
67a40631e9c2"],

Cell[TextData[{
 "Considered as ",
 StyleBox["matrices ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "(reflecting the action of linear maps on the ",
 StyleBox["basis",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " vectors of some space of dimension \[OpenCurlyDoubleQuote]",
 StyleBox["r",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote]), \na ",
 StyleBox["representation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " is encoded by (",
 StyleBox["r\[Times]d\[Times]r",
  FontWeight->"Bold"],
 ") numbers. "
}], "Text",
 CellChangeTimes->{{3.990277992040615*^9, 
  3.99027813267122*^9}},ExpressionUUID->"df607ff6-3aba-49d0-a79c-\
2c70024db904"],

Cell[TextData[{
 "We choose to gather this information as a ",
 StyleBox["SparseArray",
  FontWeight->"Bold"],
 " encoding the components of a rank-(2,1) ",
 StyleBox["tensor",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "with indices ordered (",
 StyleBox["r",
  FontWeight->"Bold"],
 ",",
 StyleBox["d",
  FontWeight->"Bold"],
 ",",
 StyleBox["r",
  FontWeight->"Bold"],
 ")\n\[LongDash]",
 StyleBox["e.g.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.9902781440937977`*^9, 3.99027816756111*^9}, {
   3.9902782109320593`*^9, 3.99027824489076*^9}, {3.990278280960176*^9, 
   3.990278327622004*^9}, {3.990278585598111*^9, 3.990278594488428*^9}, 
   3.990278959028035*^9, {3.99501644012516*^9, 3.9950164405099077`*^9}, {
   3.9950164799192467`*^9, 
   3.995016485794816*^9}},ExpressionUUID->"7ff5eb4a-528a-453b-a381-\
fe8b7b6d06b4"],

Cell[BoxData[{
 RowBox[{"egRep", "=", 
  RowBox[{"fundamentalRep", "[", 
   RowBox[{"g", "[", "2", "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.990278596540511*^9, 3.990278632672873*^9}, {
  3.995016210803116*^9, 3.995016213120825*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"a0c7ff09-7b17-49c4-b2ef-e51cc0c581d4"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Defining ",
  FontWeight->"Bold"],
 "(\[OpenCurlyQuote]",
 StyleBox["Fundamental",
  FontWeight->"Bold"],
 "\[CloseCurlyQuote])",
 " ",
 StyleBox["Concrete",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 StyleBox["Representations ",
  FontWeight->"Bold"],
 "for all ",
 StyleBox["Simple Lie Algebras",
  FontWeight->"Bold"]
}], "Subsection",
 CellChangeTimes->{{3.990278185268014*^9, 3.990278201319518*^9}, {
  3.990278527890126*^9, 3.990278528642177*^9}, {3.9902801002926893`*^9, 
  3.990280101134528*^9}, {3.99501634822328*^9, 
  3.995016384800131*^9}},ExpressionUUID->"d4ad234d-2fbe-4992-886c-\
652c49d1de06"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["fundamentalRep[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.995016247511718*^9, 
  3.9950162586693983`*^9}},ExpressionUUID->"82b6462b-bf95-45bb-80a6-\
49230fbed5df"],

Cell[TextData[{
 "For each simple Lie algebra, we have provided one \
(\[OpenCurlyDoubleQuote]fundamental\[CloseCurlyDoubleQuote]) representation, \
encoded via \n",
 StyleBox["fundamentalRep",
  FontWeight->"Bold"],
 "[",
 StyleBox["algebra_",
  FontSlant->"Italic"],
 "]"
}], "Text",
 CellChangeTimes->{{3.990278378443222*^9, 
  3.99027838949716*^9}},ExpressionUUID->"371d1812-be6e-4e67-9142-\
2f268116dbb5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egAlgebras", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"su", "[", "6", "]"}], ",", 
     RowBox[{"so", "[", "13", "]"}], ",", 
     RowBox[{"sp", "[", "14", "]"}], ",", 
     RowBox[{"d", "[", "8", "]"}], ",", 
     RowBox[{"e", "[", "4", "]"}], ",", 
     RowBox[{"e", "[", "5", "]"}], ",", 
     RowBox[{"e", "[", "6", "]"}], ",", 
     RowBox[{"e", "[", "7", "]"}], ",", 
     RowBox[{"e", "[", "8", "]"}], ",", 
     RowBox[{"f", "[", "4", "]"}], ",", 
     RowBox[{"g", "[", "2", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fundamentalRep", "/@", "egAlgebras"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"nice", "[", "#", "]"}], ",", 
      RowBox[{"drawTensors", "[", "#", "]"}], ",", "#", ",", 
      RowBox[{"byteCount", "[", "#", "]"}]}], "}"}], "&"}], "/@", "%"}], "//",
   "Column"}]}], "Input",
 CellChangeTimes->{{3.995016529899926*^9, 3.995016552859927*^9}, {
  3.997945521232729*^9, 
  3.997945526674159*^9}},ExpressionUUID->"1b82b219-cbf9-4bb9-84ce-\
48d04f61b919"],

Cell[TextData[{
 "Notice that ",
 StyleBox["nice",
  FontWeight->"Bold"],
 " not only ",
 StyleBox["identifies",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " the ",
 StyleBox["representation",
  FontWeight->"Bold"],
 " as \[OpenCurlyDoubleQuote]",
 StyleBox["F",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote] (indicating the ",
 StyleBox["defining",
  FontSlant->"Italic"],
 " representation of the algebra), \[LineSeparator]but the output also shows \
the representation\[CloseCurlyQuote]s ",
 StyleBox["Dynkin label",
  FontWeight->"Bold"],
 " upon mouse-over. \nAlso, ",
 StyleBox["drawTensor",
  FontWeight->"Bold"],
 " shows a graphical representation of the tensor, with incoming/outgoing \
edges denoting \[OpenCurlyDoubleQuote]raised\[CloseCurlyDoubleQuote] or \
\[OpenCurlyDoubleQuote]lowered\[CloseCurlyDoubleQuote] indices, and ",
 StyleBox["Slot",
  FontWeight->"Bold"],
 " positions indicated as external labels. "
}], "Text",
 CellChangeTimes->{{3.989934952577463*^9, 3.989934993299165*^9}, {
  3.9902776129507427`*^9, 3.990277640668166*^9}, {3.995016570308651*^9, 
  3.995016642636921*^9}},ExpressionUUID->"bcccc727-3d0a-48b8-a071-\
a35aa390d555"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["showGenerators[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.990280024401305*^9, 3.990280035543118*^9}, {
  3.995016290226097*^9, 
  3.995016299811084*^9}},ExpressionUUID->"99f80a75-d456-4169-b525-\
59f3086a547a"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "th"], TraditionalForm]],ExpressionUUID->
  "438a8981-0789-49f7-b9ac-e61ce40f4031"],
 StyleBox["generator",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of some ",
 StyleBox["rep",
  FontWeight->"Bold"],
 " is given by the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "th"], TraditionalForm]],ExpressionUUID->
  "93bb0448-3e2d-4ce4-96e9-fa1cc6ac59ca"],
 " element of ",
 StyleBox["Transpose",
  FontWeight->"Bold"],
 "[rep]. "
}], "Text",
 CellChangeTimes->{{3.990278676314478*^9, 3.990278758648821*^9}, {
  3.9902800537883377`*^9, 
  3.990280061237062*^9}},ExpressionUUID->"2e400d49-96ef-4f7d-bdb5-\
e6b6bfd3266c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"fundamentalRep", "[", 
    RowBox[{"g", "[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", 
  RowBox[{"RandomChoice", "[", 
   RowBox[{"Transpose", "[", "egRep", "]"}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.994846414761455*^9, 3.994846433543578*^9}, {
  3.995105658620216*^9, 3.995105666256371*^9}, {3.995200403432087*^9, 
  3.995200412303155*^9}},
 CellLabel->
  "In[103]:=",ExpressionUUID->"8e6e4780-1c70-4957-9048-3c285382c112"],

Cell[TextData[{
 "We can display all the generators of the representation using ",
 StyleBox["showGenerators[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{
  3.990280041080648*^9},ExpressionUUID->"b8e029cd-9eb5-4449-a207-\
2c3008dbd1f2"],

Cell[BoxData[
 RowBox[{"showGenerators", "[", "egRep", "]"}]], "Input",
 CellChangeTimes->{{3.990278625962267*^9, 3.99027862891366*^9}},
 CellLabel->
  "In[105]:=",ExpressionUUID->"c892fedf-95ef-47f8-bfe7-8dfc24c696c2"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " these generators are organized into ordered groups: the ",
 StyleBox["lowering",
  FontWeight->"Bold"],
 " operators \[OpenCurlyDoubleQuote]",
 StyleBox["f",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote], the generators of the ",
 StyleBox["Cartan sub-algebra ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\[OpenCurlyDoubleQuote]",
 StyleBox["h",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote], followed by the ",
 StyleBox["raising",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " operators \[OpenCurlyDoubleQuote]",
 StyleBox["e",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote]. These can be shown separately via "
}], "Text",
 CellChangeTimes->{{3.9902787888815393`*^9, 
  3.990278922175469*^9}},ExpressionUUID->"4ea18c8b-8c20-4337-a54e-\
ee79dd461b8a"],

Cell[BoxData[
 RowBox[{"showGenerators", "[", 
  RowBox[{"f", ",", "egRep"}], "]"}]], "Input",
 CellChangeTimes->{{3.9902789239139843`*^9, 3.990278927580421*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"02b82168-e23d-48ec-bacc-c9fbf198494e"],

Cell[BoxData[
 RowBox[{"showGenerators", "[", 
  RowBox[{"h", ",", "egRep"}], "]"}]], "Input",
 CellChangeTimes->{{3.990278932986311*^9, 3.990278935444893*^9}},
 CellLabel->
  "In[107]:=",ExpressionUUID->"68cc76d3-9298-4fcf-8d9a-8fb97ecde5b1"],

Cell[BoxData[
 RowBox[{"showGenerators", "[", 
  RowBox[{"e", ",", "egRep"}], "]"}]], "Input",
 CellChangeTimes->{{3.9902789386796103`*^9, 3.990278938826921*^9}},
 CellLabel->
  "In[108]:=",ExpressionUUID->"ac569554-e286-4913-94c0-d95973e0449c"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["cartanGenerators[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.995377970753263*^9, 
  3.995377977570175*^9}},ExpressionUUID->"c20eaa64-028c-4190-97a4-\
dc27e255d0a3"],

Cell["\<\
Returns the rank[g] commuting representation matrices that generate the \
Cartan sub-algebra.\
\>", "Text",
 CellChangeTimes->{{3.995377981118132*^9, 3.9953779865441217`*^9}, {
  3.996074148058908*^9, 3.996074166436468*^9}, {3.9960741983899717`*^9, 
  3.996074210883657*^9}},ExpressionUUID->"a0791e27-546b-4f26-9293-\
9b9cffa5a1d1"],

Cell[BoxData[{
 RowBox[{"cartanGenerators", "[", 
  RowBox[{"fundamentalRep", "[", 
   RowBox[{"a", "[", "5", "]"}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"matrixForm", "/@", 
  RowBox[{"Transpose", "[", "%", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"showGenerators", "[", 
  RowBox[{"h", ",", 
   RowBox[{"fundamentalRep", "[", 
    RowBox[{"a", "[", "5", "]"}], "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.99607392029364*^9, 3.996073938016014*^9}, {
  3.9960739854822683`*^9, 3.996074130467972*^9}, {3.996074174239887*^9, 
  3.99607417577201*^9}},
 CellLabel->
  "In[109]:=",ExpressionUUID->"9e47d3e8-c3c8-47a1-b304-062392b2b842"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["(Induced) ",
  FontWeight->"Bold"],
 StyleBox["Adjoint ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["Representations ",
  FontWeight->"Bold"],
 "for all ",
 StyleBox["Simple Lie Algebras",
  FontWeight->"Bold"]
}], "Subsection",
 CellChangeTimes->{{3.995016423848444*^9, 3.9950164302233477`*^9}, {
  3.99501667959438*^9, 
  3.995016701560584*^9}},ExpressionUUID->"da2c90a0-3da8-4cb2-93d5-\
1ddeab404a4d"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["inducedAdjoint[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.99501670883634*^9, 
  3.995016716238624*^9}},ExpressionUUID->"abb24d83-ee6e-48fc-8530-\
8bfacf6fdc37"],

Cell[TextData[{
 "The ",
 StyleBox["structure constants",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["f", "ab"], "c"], TraditionalForm]],ExpressionUUID->
  "c6867d26-923c-4fe8-b121-569084439736"],
 "\[CloseCurlyDoubleQuote] that appear in the ",
 StyleBox["defining relation ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "of any representation of any Lie algebra"
}], "Text",
 CellChangeTimes->{{3.9902790083324127`*^9, 3.990279043535387*^9}, {
  3.990279079883192*^9, 
  3.990279083702156*^9}},ExpressionUUID->"ac0b2b72-ba5b-42a9-b319-\
a1be5176812f"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"[", 
    RowBox[{
     SuperscriptBox["T", "a"], ",", " ", 
     SuperscriptBox["T", "b"]}], "]"}], "=", 
   RowBox[{":", 
    RowBox[{
     SubscriptBox[
      SuperscriptBox["f", "ab"], "c"], 
     SuperscriptBox["T", "c"]}]}]}], 
  TraditionalForm]],ExpressionUUID->"254aaabd-933c-4f0c-a4ff-fd164300b789"]], \
"Text",
 CellChangeTimes->{{3.987078749583312*^9, 
  3.987078792638468*^9}},ExpressionUUID->"d9377c40-589e-4ced-8520-\
f53f9c27f237"],

Cell[TextData[{
 "also ",
 StyleBox["satisfy the same commutation relations with identical coefficients\
\[LongDash]and thereby furnish a (possibly distinct) representation called \
the ",
  FontSlant->"Plain"],
 StyleBox["adjoint",
  FontWeight->"Bold",
  FontSlant->"Plain"],
 StyleBox[". \nGiven a set of ",
  FontSlant->"Plain"],
 StyleBox["generators",
  FontWeight->"Bold",
  FontSlant->"Plain"],
 StyleBox[" (encoded as a tensor), these coefficients are obtained using the \
function ",
  FontSlant->"Plain"],
 StyleBox["inducedAdjoint[",
  FontWeight->"Bold",
  FontSlant->"Plain"],
 "representation_",
 StyleBox["]",
  FontWeight->"Bold",
  FontSlant->"Plain"],
 StyleBox[":",
  FontSlant->"Plain"]
}], "Text",
 CellChangeTimes->{{3.990279050498085*^9, 3.990279179775754*^9}},
 FontWeight->"Plain",
 FontSlant->"Italic",ExpressionUUID->"58d4c80c-ff5f-47c0-964d-e7a36c20f2ee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"fundamentalRep", "[", 
    RowBox[{"f", "[", "4", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"inducedAdjoint", "[", "egRep", "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.995016868860297*^9, 3.995016873719767*^9}},
 CellLabel->
  "In[112]:=",ExpressionUUID->"e68224da-24c5-47e9-8d36-b38888d16cb0"],

Cell[TextData[{
 "It is worthwhile to verify that the ",
 StyleBox["inducedAdjoint",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 StyleBox["of the",
  FontSlant->"Italic"],
 " ",
 StyleBox["inducedAdjoint",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " is itself:"
}], "Text",
 CellChangeTimes->{{3.9902791999863787`*^9, 3.9902792642376623`*^9}, {
  3.990279306919437*^9, 
  3.990279313185486*^9}},ExpressionUUID->"1228c6c7-0d8c-403f-aac0-\
1878328d7b87"],

Cell[BoxData[
 RowBox[{
  RowBox[{"inducedAdjoint", "[", "egRep", "]"}], "===", 
  RowBox[{"inducedAdjoint", "[", 
   RowBox[{"inducedAdjoint", "[", "egRep", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.990279269172838*^9, 3.990279296688397*^9}},
 CellLabel->
  "In[115]:=",ExpressionUUID->"10bf4829-2786-4501-9b1e-23cb326df7b5"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Exempli Gratia",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ": Checking the Defining ",
 StyleBox["Commutation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontWeight->"Bold"],
 StyleBox["Relations",
  FontWeight->"Bold",
