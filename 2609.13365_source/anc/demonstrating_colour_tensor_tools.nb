Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Simple Lie Algebras ",
  FontWeight->"Bold"],
 "and their ",
 StyleBox["Representations",
  FontWeight->"Bold"],
 " (in the ",
 StyleBox["Abstract",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ")"
}], "Section",
 CellChangeTimes->{{3.987077840063403*^9, 3.987077856197508*^9}, {
   3.987157395935841*^9, 3.987157411679491*^9}, {3.99018113558891*^9, 
   3.9901811548837013`*^9}, {3.99018124505089*^9, 3.990181246458785*^9}, {
   3.990181741407342*^9, 3.990181755747672*^9}, 3.990277440924473*^9, {
   3.990280141576098*^9, 3.990280169162978*^9}, {3.990541306714971*^9, 
   3.990541314956628*^9}, {3.990704380570643*^9, 3.9907044040201263`*^9}, 
   3.9951949012224627`*^9},ExpressionUUID->"2dcb6eab-9a20-4527-aef1-\
c55e6adb7b46"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Naming",
  FontWeight->"Bold"],
 " of Simple Lie Algebras: ",
 StyleBox["Cartan\[CloseCurlyQuote]s Conventions",
  FontWeight->"Bold",
  FontSlant->"Italic"]
}], "Subsection",
 CellChangeTimes->{{3.9871574235840263`*^9, 3.9871574334154367`*^9}, {
  3.990114887288743*^9, 3.990114888556525*^9}, {3.990541365732079*^9, 
  3.990541365840475*^9}, {3.995194253140812*^9, 
  3.995194262855208*^9}},ExpressionUUID->"ae6d153a-9e7c-4981-ac13-\
db1f11c932ef"],

Cell[TextData[{
 "The ",
 StyleBox["Cartan",
  FontWeight->"Bold"],
 " system of naming is preferred, but support exists to convert other \
familiar naming of Lie algebras (such \[OpenCurlyDoubleQuote]so[10]\
\[CloseCurlyDoubleQuote] or \[OpenCurlyDoubleQuote]e[4]\
\[CloseCurlyDoubleQuote]). "
}], "Text",
 CellChangeTimes->{{3.98715743880595*^9, 3.987157449627366*^9}, {
  3.987158623931315*^9, 
  3.9871586528652773`*^9}},ExpressionUUID->"cd0ac11e-3185-4c07-b8bb-\
069b7efd80a5"],

Cell[BoxData[{
 RowBox[{"egAlgebras", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"su", "[", "6", "]"}], ",", 
    RowBox[{"so", "[", "13", "]"}], ",", 
    RowBox[{"sp", "[", "14", "]"}], ",", 
    RowBox[{"d", "[", "8", "]"}], ",", 
    RowBox[{"e", "[", "4", "]"}], ",", 
    RowBox[{"e", "[", "5", "]"}], ",", 
    RowBox[{"e", "[", "6", "]"}], ",", 
    RowBox[{"e", "[", "7", "]"}], ",", 
    RowBox[{"e", "[", "8", "]"}], ",", 
    RowBox[{"f", "[", "4", "]"}], ",", 
    RowBox[{"g", "[", "2", "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.987078067384808*^9, 3.9870781564562197`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"1d3cebbc-ab91-45a6-a500-c9ffe0e12932"],

Cell[TextData[{
 "Notice that ",
 StyleBox["nice",
  FontWeight->"Bold"],
 " will ",
 StyleBox["automatically",
  FontSlant->"Italic"],
 " re-label any algebras according to ",
 StyleBox["Cartan",
  FontWeight->"Bold"],
 "\[CloseCurlyQuote]s conventions. "
}], "Text",
 CellChangeTimes->{{3.990700145415037*^9, 
  3.99070018472683*^9}},ExpressionUUID->"a8322adc-5961-4e66-ba0b-\
6393790bab93"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Weight Systems",
  FontWeight->"Bold"],
 " for ",
 StyleBox["Lie Algebras ",
  FontWeight->"Bold"],
 "(and Conventions)"
}], "Subsection",
 CellChangeTimes->{{3.99054132619843*^9, 
  3.990541371140895*^9}},ExpressionUUID->"7d43c34c-0432-42db-a672-\
e956ff1387e2"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["dynkinDiagram[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ": gives a ",
 StyleBox["labelled",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " Dynkin diagram for each simple Lie algebra"
}], "Subsubsection",
 CellChangeTimes->{{3.990700774613674*^9, 3.990700786268894*^9}, 
   3.995016182596343*^9, {3.995194226710574*^9, 
   3.995194243930738*^9}},ExpressionUUID->"13006501-bc1a-4733-bf76-\
8235f2ad87fe"],

Cell[TextData[{
 "Simple Lie algebras are characterized by their Dynkin diagrams, which \
encode their ",
 StyleBox["weight systems",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "/",
 StyleBox["root lattices",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". \nThese can be drawn using the function \n",
 StyleBox["dynkinDiagram[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]:",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.9907001973146963`*^9, 
  3.9907003745359898`*^9}},ExpressionUUID->"a06e5470-3f65-4f33-b956-\
f6b110c280b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dynkinDiagram", "/@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", "8", "]"}], ",", 
     RowBox[{"b", "[", "8", "]"}], ",", 
     RowBox[{"c", "[", "8", "]"}], ",", 
     RowBox[{"d", "[", "8", "]"}], ",", 
     RowBox[{"e", "[", "6", "]"}], ",", 
     RowBox[{"e", "[", "7", "]"}], ",", 
     RowBox[{"e", "[", "8", "]"}], ",", 
     RowBox[{"f", "[", "4", "]"}], ",", 
     RowBox[{"g", "[", "2", "]"}]}], "}"}]}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.990181601941028*^9, 3.990181611224642*^9}, 
   3.995200163335989*^9},
 CellLabel->"In[5]:=",ExpressionUUID->"b6dd884b-48f0-485b-9dcf-1042a62788fc"],

Cell[TextData[{
 "Although the ",
 StyleBox["Dynkin",
  FontWeight->"Bold"],
 " ",
 StyleBox["diagrams",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " are themselves fairly standard,",
 StyleBox[" conventions for the association between nodes and the simple \
roots ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "vary ",
 StyleBox["wildly",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". \n\n",
 StyleBox["Notice",
  FontWeight->"Bold"],
 ":",
 " our conventions are indicated in the labeling of nodes on each Dynkin \
diagram. "
}], "Text",
 CellChangeTimes->{{3.9907001973146963`*^9, 3.990700349461256*^9}, {
  3.9907004398914957`*^9, 3.990700466943256*^9}, {3.995194074407659*^9, 
  3.995194082389064*^9}},ExpressionUUID->"51d5d3a5-8c82-4329-ad36-\
5f7501f0c6e9"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["showLatticeData[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ": gives stylized display of information about each simple Lie algebra"
}], "Subsubsection",
 CellChangeTimes->{{3.990700799032181*^9, 3.990700804384941*^9}, 
   3.995016185976595*^9, {3.995194191606298*^9, 
   3.995194220470443*^9}},ExpressionUUID->"d71faf65-99c1-48fd-a0a7-\
652c74339c8c"],

Cell[TextData[{
 "The conventional choice of how simple roots of weight lattices are ordered \
has many knock-on-effects for how ",
 StyleBox["weight-systems",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " are organized/ordered, and affects the ordering of rows/columns of the \n\
",
 StyleBox["Cartan matrix",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", ",
 StyleBox["weight metrics",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[", ",
  FontSlant->"Italic"],
 "etc. \n\nA summary of all convention-related choices made for the ",
 StyleBox["weight lattices ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "of each of the simple Lie algebras can be obtained via \n",
 StyleBox["showLatticeData[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]:",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.990700468596541*^9, 3.990700603804776*^9}, {
  3.990700808425592*^9, 
  3.990700837344119*^9}},ExpressionUUID->"54cd8694-84cd-4ce9-874b-\
a83585eb6516"],

Cell[BoxData[
 RowBox[{
  RowBox[{"showLatticeData", "/@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", "8", "]"}], ",", 
     RowBox[{"b", "[", "8", "]"}], ",", 
     RowBox[{"c", "[", "8", "]"}], ",", 
     RowBox[{"d", "[", "8", "]"}], ",", 
     RowBox[{"e", "[", "6", "]"}], ",", 
     RowBox[{"e", "[", "7", "]"}], ",", 
     RowBox[{"e", "[", "8", "]"}], ",", 
     RowBox[{"f", "[", "4", "]"}], ",", 
     RowBox[{"g", "[", "2", "]"}]}], "}"}]}], "//", "Column"}]], "Input",
 CellChangeTimes->{3.995200175216668*^9},
 CellLabel->"In[6]:=",ExpressionUUID->"e9a17452-6c53-402a-843e-009cc4bf7fa4"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " the individual bits of data in these summaries can be obtained \
separately:"
}], "Text",
 CellChangeTimes->{{3.990700610139049*^9, 
  3.990700637242095*^9}},ExpressionUUID->"9ecaeefb-437d-4f5c-84a1-\
14b81fa18430"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["cartan[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ": returns the ",
 StyleBox["Cartan matrix",
  FontWeight->"Bold"]
}], "Subsubsection",
 CellChangeTimes->{{3.990700643133214*^9, 
  3.990700664537524*^9}},ExpressionUUID->"219ac0ef-a54a-4d39-9daa-\
dec7dc6db223"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cartan", "/@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", "4", "]"}], ",", 
     RowBox[{"b", "[", "4", "]"}], ",", 
     RowBox[{"c", "[", "4", "]"}], ",", 
     RowBox[{"d", "[", "4", "]"}], ",", 
     RowBox[{"e", "[", "6", "]"}], ",", 
     RowBox[{"e", "[", "7", "]"}], ",", 
     RowBox[{"e", "[", "8", "]"}], ",", 
     RowBox[{"f", "[", "4", "]"}], ",", 
     RowBox[{"g", "[", "2", "]"}]}], "}"}]}], "//", "nice"}]], "Input",
 CellChangeTimes->{{3.9948456239744787`*^9, 3.994845633085397*^9}, {
  3.995194105243451*^9, 3.9951941387419777`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"674f568d-e3dc-4f34-b1ec-4dc61d95ef08"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["weightMetric[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ": returns the ",
 StyleBox["weight metric",
  FontWeight->"Bold"]
}], "Subsubsection",
 CellChangeTimes->{{3.990700684758922*^9, 3.990700702613923*^9}, 
   3.990701569413328*^9},ExpressionUUID->"f89ae29f-686e-4337-8e41-\
ade7cf7101f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"weightMetric", "/@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", "4", "]"}], ",", 
     RowBox[{"b", "[", "4", "]"}], ",", 
     RowBox[{"c", "[", "4", "]"}], ",", 
     RowBox[{"d", "[", "4", "]"}], ",", 
     RowBox[{"e", "[", "6", "]"}], ",", 
     RowBox[{"e", "[", "7", "]"}], ",", 
     RowBox[{"e", "[", "8", "]"}], ",", 
     RowBox[{"f", "[", "4", "]"}], ",", 
     RowBox[{"g", "[", "2", "]"}]}], "}"}]}], "//", "nice"}]], "Input",
 CellChangeTimes->{{3.995194145211014*^9, 3.995194148102652*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"5be7beeb-9210-47d3-bbd9-9be26b6936f2"],

Cell[TextData[{
 StyleBox["Note",
  FontWeight->"Bold"],
 ":",
 " this data is ",
 StyleBox["computed from ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "our each algebra\[CloseCurlyQuote]s ",
 StyleBox["defining",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " representation; they are ",
 StyleBox["not",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " pre-stored. "
}], "Text",
 CellChangeTimes->{{3.990700709657984*^9, 
  3.990700756192697*^9}},ExpressionUUID->"065e0e14-2e4f-438f-9bcb-\
86c247ec5e4a"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["positiveRoots[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["] ",
  FontWeight->"Bold"],
 "and ",
 StyleBox["positiveWeights[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.990701556984482*^9, 3.990701565155367*^9}, {
  3.990701794739209*^9, 
  3.990701806282753*^9}},ExpressionUUID->"06433be1-8a52-46ba-b0c9-\
655ef48e1115"],

Cell[TextData[{
 "The ",
 StyleBox["root-system",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " describing a simple Lie algebra is given by positive/negative roots which \
are sums over ",
 StyleBox["positive roots",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " with integer coefficients. \nThe ",
 StyleBox["roots",
  FontWeight->"Bold"],
 " consist of these ",
 StyleBox["integer-valued coefficients",
  FontWeight->"Bold"],
 StyleBox[", ",
  FontSlant->"Italic"],
 "and the ",
 StyleBox["weights",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " are the vectors themselves"
}], "Text",
 CellChangeTimes->{{3.9907016324934464`*^9, 3.9907016933625603`*^9}, {
  3.990701808771697*^9, 
  3.990701866205593*^9}},ExpressionUUID->"cdc0a327-03e5-4d24-9006-\
8b611f3525ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"positiveRoots", "[", 
     RowBox[{"e", "[", "6", "]"}], "]"}], ",", 
    RowBox[{"positiveWeights", "[", 
     RowBox[{"e", "[", "6", "]"}], "]"}]}], "}"}], "//", "nice"}]], "Input",
 CellChangeTimes->{{3.9907015715689707`*^9, 3.990701576062542*^9}, {
  3.990701758682509*^9, 3.9907017653258677`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"05264b8f-85db-4a6e-9225-323d7195947d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"positiveRoots", "[", 
     RowBox[{"f", "[", "4", "]"}], "]"}], ",", 
    RowBox[{"positiveWeights", "[", 
     RowBox[{"f", "[", "4", "]"}], "]"}]}], "}"}], "//", "nice"}]], "Input",
 CellChangeTimes->{{3.994845807708342*^9, 3.994845811076795*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"55127109-402f-4ed2-8c16-31c015080dcb"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " these two sets of data are simply related by the ",
 StyleBox["Cartan matrix",
  FontWeight->"Bold"],
 ": \n\troots.cartan=weights; or, equivalently, \n\t\
roots=weights.inverse[cartan]."
}], "Text",
 CellChangeTimes->{{3.9907018701286182`*^9, 3.9907019621600847`*^9}, {
  3.994845833042519*^9, 
  3.9948458391438093`*^9}},ExpressionUUID->"a4d25dc5-70af-4a70-bd48-\
9d5142f86db1"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["coxeter[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 " and ",
 StyleBox["dualCoxeter[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ": "
}], "Subsubsection",
 CellChangeTimes->{{3.995537402835986*^9, 3.995537422067515*^9}, {
  3.9960708753055353`*^9, 
  3.996070898677814*^9}},ExpressionUUID->"d3ba62ff-eec2-4b85-892b-\
13f0a560b25c"],

Cell["\<\
The Coxeter number is defined as 1 + the sum of the marks of the highest root. 
The dual Coxeter number is defined as 1 + the sum of the co-marks of the \
highest root. \
\>", "Text",
 CellChangeTimes->{{3.996070906929996*^9, 3.99607091803933*^9}, {
  3.996071010677561*^9, 
  3.996071032233733*^9}},ExpressionUUID->"4daeba4e-c87a-42e4-8193-\
fa8533cf8f27"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egAlgebras", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", "1", "]"}], ",", 
     RowBox[{"b", "[", "2", "]"}], ",", 
     RowBox[{"g", "[", "2", "]"}], ",", 
     RowBox[{"c", "[", "3", "]"}], ",", 
     RowBox[{"d", "[", "4", "]"}], ",", 
     RowBox[{"f", "[", "4", "]"}], ",", 
     RowBox[{"e", "[", "6", "]"}], ",", 
     RowBox[{"e", "[", "7", "]"}], ",", 
     RowBox[{"e", "[", "8", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"nice", "/@", "#"}], ",", " ", 
      RowBox[{"coxeter", "/@", "#"}], ",", " ", 
      RowBox[{"dualCoxeter", "/@", "#"}]}], "}"}], "&"}], "@", "egAlgebras"}],
   "]"}]}], "Input",
 CellChangeTimes->{{3.996070776810904*^9, 3.996070858801394*^9}, {
  3.996070940758656*^9, 3.996071001803356*^9}, {3.996071085223527*^9, 
  3.9960711242000628`*^9}, {3.9960711619641123`*^9, 3.996071266835641*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"544fbdc2-36e5-45e7-9c73-a93d89e04334"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Dynkin-(",
  FontWeight->"Bold"],
 "\[OpenCurlyQuote]",
 StyleBox["Highest-Weight-",
  FontWeight->"Bold"],
 "\[CloseCurlyQuote])",
 StyleBox["Labelling ",
  FontWeight->"Bold"],
 "of",
 StyleBox[" Irreducible Representations",
  FontWeight->"Bold"]
}], "Subsection",
 CellChangeTimes->{{3.9905412331817417`*^9, 3.990541273390648*^9}, {
   3.990700866582264*^9, 3.99070088756588*^9}, {3.9951942812557373`*^9, 
   3.995194287027585*^9}, 
   3.995194326567465*^9},ExpressionUUID->"8cf52065-3986-4a03-9d58-\
094832e54cf0"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Basic Syntax ",
  FontWeight->"Bold"],
 "of",
 StyleBox[" Dynkin Labels",
  FontWeight->"Bold"]
}], "Subsubsection",
 CellChangeTimes->{{3.995194302330914*^9, 3.9951943252708178`*^9}, {
  3.995194477589361*^9, 
  3.995194478584197*^9}},ExpressionUUID->"12aa3bcb-3892-41e7-bf39-\
f23de9031b0e"],

Cell[TextData[{
 "Irreducible representations of any rank-",
 StyleBox["k,",
  FontSlant->"Italic"],
 " simple Lie algebra can be identified by their ",
 StyleBox["highest",
  FontWeight->"Bold"],
 "-",
 StyleBox["weights ",
  FontWeight->"Bold"],
 "or \[OpenCurlyDoubleQuote]",
 StyleBox["Dynkin Label",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote]. \nThese are ",
 StyleBox["k",
  FontSlant->"Italic"],
 "-tuples of non-negative integers. Any choice of such a ",
 StyleBox["k",
  FontSlant->"Italic"],
 "-tuple corresponds to ",
 StyleBox["some",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " irreducible representation of the Lie algebra. "
}], "Text",
 CellChangeTimes->{{3.9906273108303347`*^9, 3.990627377630282*^9}, {
  3.990700896132585*^9, 
  3.990700932099111*^9}},ExpressionUUID->"818a6d3e-17f3-40a9-9680-\
95cd22444dc4"],

Cell[TextData[{
 "In order to disambiguate between algebras of the same rank, we \
conventionally use the following syntax for Dynkin labels\n\n",
 StyleBox["w[",
  FontWeight->"Bold"],
 StyleBox["algebraType_",
  FontSlant->"Italic"],
 StyleBox["][",
  FontWeight->"Bold"],
 StyleBox["highestWeightLabelSequence__",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.9907009352478848`*^9, 
  3.990701011375648*^9}},ExpressionUUID->"66312b1d-6ccc-4704-8353-\
77cfba08fd03"],

Cell[BoxData[{
 RowBox[{"egIrrepLabel", "=", 
  RowBox[{
   RowBox[{"w", "[", "e", "]"}], "@@", 
   RowBox[{"RandomInteger", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "5"}], "}"}], ",", 
     RowBox[{"{", "6", "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.9906273835471354`*^9, 3.99062742280506*^9}, {
  3.990629300045973*^9, 3.990629326737728*^9}, {3.9907021717384157`*^9, 
  3.990702171905363*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"43212971-27d6-4b99-804a-0b9d8a1a116d"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["adjointDynkinLabel[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ": returns the ",
 StyleBox["Dynkin",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 StyleBox["Label",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " for the ",
 StyleBox["Adjoint",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 StyleBox["Representation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 "(\[OpenCurlyQuote]\[Theta]\[CloseCurlyQuote])"
}], "Subsubsection",
 CellChangeTimes->{{3.9907787653385077`*^9, 3.990778773019965*^9}, 
   3.9950160141874933`*^9, {3.995194334439183*^9, 3.995194351113461*^9}, {
   3.995194411186943*^9, 
   3.995194427680797*^9}},ExpressionUUID->"059c7b7c-2297-42ad-ab56-\
eeae9fb2267b"],

Cell[TextData[{
 "The ",
 StyleBox["adjoint",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " representation\[CloseCurlyQuote]s Dynkin label (often denoted \
\[OpenCurlyQuote]\[Theta]\[CloseCurlyQuote]) can be identified by\n",
 StyleBox["e.g.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.990778774668211*^9, 3.990778790880239*^9}, {
  3.995194342075789*^9, 3.995194343647502*^9}, {3.995194382360529*^9, 
  3.995194384981051*^9}},ExpressionUUID->"935811cc-3c17-40ef-bb75-\
d987fe53d8e4"],

Cell[BoxData[{
 RowBox[{"adjointDynkinLabel", "[", 
  RowBox[{"e", "[", "7", "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.9907788208809958`*^9, 3.990778823339262*^9}, {
  3.990800543397018*^9, 3.9908005441212807`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"9b523119-8dce-4b06-ab04-78b10bbbf2d1"],

Cell["\<\
We can summarize this for each for the types of Lie algebras as follows:\
\>", "Text",
 CellChangeTimes->{{3.9951943891943283`*^9, 
  3.995194406039503*^9}},ExpressionUUID->"773c11e6-1f65-499c-aa8c-\
cc43b90e6d29"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"nice", "[", "#", "]"}], ",", 
      RowBox[{"adjointDynkinLabel", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", "8", "]"}], ",", 
     RowBox[{"b", "[", "8", "]"}], ",", 
     RowBox[{"c", "[", "8", "]"}], ",", 
     RowBox[{"d", "[", "8", "]"}], ",", 
     RowBox[{"e", "[", "6", "]"}], ",", 
     RowBox[{"e", "[", "7", "]"}], ",", 
     RowBox[{"e", "[", "8", "]"}], ",", 
     RowBox[{"f", "[", "4", "]"}], ",", 
     RowBox[{"g", "[", "2", "]"}]}], "}"}]}], "//", "Grid"}]], "Input",
 CellChangeTimes->{{3.9907787922419252`*^9, 3.9907788081423683`*^9}, 
   3.995194374828981*^9},
 CellLabel->"In[17]:=",ExpressionUUID->"3dbb607b-eb10-4060-88e7-b7f642c3f815"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["showFundamentalIrrepLabels[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.990630467922248*^9, 3.990630477621056*^9}, {
  3.995015956067193*^9, 3.9950160090527*^9}, {3.9950160413696833`*^9, 
  3.995016043184709*^9}},ExpressionUUID->"99ae962d-cdd5-4ca1-84de-\
79447b5c5dcb"],

Cell[TextData[{
 "A special role is played by irreducible representations of ",
 StyleBox["fundamental weight\n",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\[LongDash]namely, those with a Dynkin label corresponding to a row of the \
(",
 StyleBox["k",
  FontSlant->"Italic"],
 "\[Times]",
 StyleBox["k",
  FontSlant->"Italic"],
 ") identity matrix."
}], "Text",
 CellChangeTimes->{{3.990701021635977*^9, 
  3.990701108907598*^9}},ExpressionUUID->"b622f117-1c21-444c-9d72-\
64fcf4ae4b15"],

Cell[TextData[{
 "As the organization of these irreducible representations effectively \
disambiguates the \nDynkin-labeling of all irreducible representations, a \
summary of these representations\[CloseCurlyQuote] Dynkin labels is given by\n\
\n",
 StyleBox["showFundamentalIrrepLabels[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.990701112180656*^9, 3.990701118987007*^9}, {
  3.990701154524446*^9, 3.990701164043674*^9}, {3.990701395762938*^9, 
  3.9907014897994347`*^9}, {3.9950160539010973`*^9, 
  3.9950160544212217`*^9}},ExpressionUUID->"700403f4-f92e-47a0-af4a-\
c0c1ddd7d6e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"showFundamentalIrrepLabels", "/@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", "8", "]"}], ",", 
     RowBox[{"b", "[", "8", "]"}], ",", 
     RowBox[{"c", "[", "8", "]"}], ",", 
     RowBox[{"d", "[", "8", "]"}], ",", 
     RowBox[{"e", "[", "6", "]"}], ",", 
     RowBox[{"e", "[", "7", "]"}], ",", 
     RowBox[{"e", "[", "8", "]"}], ",", 
     RowBox[{"f", "[", "4", "]"}], ",", 
     RowBox[{"g", "[", "2", "]"}]}], "}"}]}], "//", "Column"}]], "Input",
 CellChangeTimes->{{3.990629677311234*^9, 3.990629679939578*^9}, {
  3.990629936607479*^9, 3.9906299384149446`*^9}, {3.9906304382418337`*^9, 
  3.990630443608654*^9}, {3.995016056076036*^9, 3.995016073558982*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"0ffb1e92-0369-4c01-a295-23bd42a77220"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Weight Systems ",
  FontWeight->"Bold"],
 "for ",
 StyleBox["Irreducible Representations",
  FontWeight->"Bold"]
}], "Subsection",
 CellChangeTimes->{{3.995016104206283*^9, 
  3.995016117668088*^9}},ExpressionUUID->"f5a806f0-81fa-45a0-bc0a-\
899b1e210080"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["showWeightLattice[",
  FontWeight->"Bold"],
 StyleBox["dynkinLabel_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.995014213719146*^9, 3.9950142244928083`*^9}, {
  3.9950142669035473`*^9, 3.995014268021121*^9}, {3.995014418705967*^9, 
  3.995014420743355*^9}},ExpressionUUID->"7e878b07-26c7-455e-8a77-\
09cadf690db7"],

Cell[TextData[{
 "Irreducible representations are associated with a system of ",
 StyleBox["weights",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["\[LongDash]",
  FontSlant->"Italic"],
 "which are arranged into a ",
 StyleBox["spindle",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " starting with the ",
 StyleBox["highest-weight",
  FontWeight->"Bold",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.995013932858172*^9, 3.995013936377899*^9}, {
  3.995014116001191*^9, 3.995014124386346*^9}, {3.9950142359786987`*^9, 
  3.9950142552436543`*^9}, {3.995014776626453*^9, 
  3.9950148183587303`*^9}},ExpressionUUID->"595a77e4-ce49-42f8-8aff-\
2c5430086c88"],

Cell[BoxData[
 RowBox[{"showWeightLattice", "[", 
  RowBox[{
   RowBox[{"w", "[", "e", "]"}], "[", 
   RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], "]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9950148700364017`*^9, 3.9950148824849367`*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"0f4345dd-03ba-4677-afbe-e83e048249b3"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " alternative syntax allowed\n",
 StyleBox["showWeightLattice[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["] ",
  FontWeight->"Bold"],
 "returns that for the ",
 StyleBox["adjoint representation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\n",
 StyleBox["showWeightLattice[",
  FontWeight->"Bold"],
 "F[",
 StyleBox["algebra_",
  FontSlant->"Italic"],
 "]",
 StyleBox["] ",
  FontWeight->"Bold"],
 "returns that for the ",
 StyleBox["defining/\[OpenCurlyQuote]fundamental",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["\[CloseCurlyQuote] ",
  FontWeight->"Bold"],
 StyleBox["representation",
  FontWeight->"Bold",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.9950148928228407`*^9, 
  3.9950149829668617`*^9}},ExpressionUUID->"cdda3f96-2df3-45f9-a4af-\
8dd79be61f7f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"showWeightLattice", "[", 
     RowBox[{"d", "[", "4", "]"}], "]"}], ",", 
    RowBox[{"positiveWeights", "[", 
     RowBox[{"d", "[", "4", "]"}], "]"}]}], "}"}], "//", "nice"}]], "Input",
 CellChangeTimes->{{3.995014129171424*^9, 3.9950141629968443`*^9}, {
  3.9950146736934557`*^9, 3.995014714299806*^9}, {3.995014829044031*^9, 
  3.995014829410883*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"f606069e-935c-4a51-b2f8-a6154610305e"],

Cell[BoxData[
 RowBox[{"showWeightLattice", "[", 
  RowBox[{"F", "[", 
   RowBox[{"f", "[", "4", "]"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.995014719772637*^9, 3.995014729157588*^9}, {
  3.9950149910553617`*^9, 3.995015001493269*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"e72af171-1dec-43ff-8dad-80b048926ff6"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["showRootLattice[",
  FontWeight->"Bold"],
 StyleBox["dynkinLabel_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.9950150085061703`*^9, 
  3.9950150231312037`*^9}},ExpressionUUID->"82041b0d-29cb-48af-9a86-\
5f7dcbb66eca"],

Cell[TextData[{
 "All the ",
 StyleBox["weights",
  FontWeight->"Bold"],
 " of the adjoint lattice are ",
 StyleBox["integer",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " multiples of ",
 StyleBox["simple roots",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[". \n",
  FontSlant->"Italic"],
 "These roots are related to weights as \n",
 StyleBox["root",
  FontWeight->"Bold"],
 "=",
 StyleBox["weight.",
  FontWeight->"Bold"],
 "cartan, or \n",
 StyleBox["weight",
  FontWeight->"Bold"],
 "=",
 StyleBox["root",
  FontWeight->"Bold"],
 ".(inverse[cartan])"
}], "Text",
 CellChangeTimes->{{3.995015030412809*^9, 3.995015101155717*^9}, {
  3.995015154264612*^9, 
  3.995015225051153*^9}},ExpressionUUID->"9fb9289d-8f00-407a-8ba2-\
c3092256d4ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"positiveWeights", "[", 
     RowBox[{"a", "[", "4", "]"}], "]"}], ",", 
    RowBox[{"positiveRoots", "[", 
     RowBox[{"a", "[", "4", "]"}], "]"}], ",", 
    RowBox[{"showWeightLattice", "[", 
     RowBox[{"a", "[", "4", "]"}], "]"}], ",", 
    RowBox[{"showRootLattice", "[", 
     RowBox[{"a", "[", "4", "]"}], "]"}]}], "}"}], "//", "nice"}]], "Input",
 CellChangeTimes->{{3.995015104452506*^9, 3.995015142798633*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"9ca48221-2512-44e7-94b9-934f0a7b2957"],

Cell[TextData[{
 "For non-adjoint irreducible representations, weights are not necessarily \
integer combinations of simple roots; \ntheir coefficients (with respect to \
the basis of simple roots) are called ",
 StyleBox["marks",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontSlant->"Italic"],
 StyleBox["\n",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "These coefficients are returned by the function ",
 StyleBox["showRootLattice",
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{{3.995015236349247*^9, 3.995015311816057*^9}, {
  3.995015345160308*^9, 
  3.99501536556798*^9}},ExpressionUUID->"65104391-bb00-4880-a90f-\
af8c4686a644"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"showRootLattice", "[", 
    RowBox[{"F", "[", 
     RowBox[{"f", "[", "4", "]"}], "]"}], "]"}], ",", 
   RowBox[{"showWeightLattice", "[", 
    RowBox[{"F", "[", 
     RowBox[{"f", "[", "4", "]"}], "]"}], "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.995015314763949*^9, 3.995015333489223*^9}, {
  3.995015371849058*^9, 3.995015372325835*^9}, {3.9950154046902018`*^9, 
  3.995015424914304*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"2ef3ed1b-af22-404d-b7af-acce3735ac4f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"showRootLattice", "[", 
    RowBox[{"F", "[", 
     RowBox[{"d", "[", "4", "]"}], "]"}], "]"}], ",", 
   RowBox[{"showWeightLattice", "[", 
    RowBox[{"F", "[", 
     RowBox[{"d", "[", "4", "]"}], "]"}], "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.995015445329691*^9, 3.995015446937957*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"ef643dfd-b3f7-48ca-949b-8262d489cd58"]
}, Closed]],

