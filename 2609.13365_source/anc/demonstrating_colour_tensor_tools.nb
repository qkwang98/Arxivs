Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Exempli Gratia : ",
  FontWeight->"Bold"],
 "generating fundamentals of a[k_] "
}], "Subsubsection",
 CellChangeTimes->{
  3.9960721591164913`*^9},ExpressionUUID->"b6bfda4f-b902-4dbc-9284-\
41455c495b36"],

Cell["\<\
The i-th fundamental of a[k] is given exactly by the i-th anti-symmetric \
power of the first fundamental. 
This makes it especially easy to generate these irreps concretely.\
\>", "Text",
 CellChangeTimes->{{3.996071691101261*^9, 3.996071751750029*^9}, {
   3.996072140117775*^9, 3.996072157083517*^9}, {3.996073707557745*^9, 
   3.996073709173243*^9}, 
   3.996073862221079*^9},ExpressionUUID->"91f19c8a-bb61-40c7-81fa-\
159961c1aa53"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"antiSymPowerDecomposition", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"w", "[", "a", "]"}], "[", 
      RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "]"}], ",", "#"}], "]"}], 
   "&"}], "/@", 
  RowBox[{"Range", "[", "4", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "@", "%"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"antiSymPower", "[", 
    RowBox[{
     RowBox[{"fundamentalRep", "[", 
      RowBox[{"a", "[", "4", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
  RowBox[{"Range", "[", "4", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "@", "%"}]}], "Input",
 CellChangeTimes->{{3.9960714727166567`*^9, 3.996071583307164*^9}, {
  3.99607175838993*^9, 3.996071880862322*^9}, {3.996072083911194*^9, 
  3.9960720921061172`*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"5dd8bbc3-7a2d-45c5-a09d-0642e0b96887"]
}, Closed]],

