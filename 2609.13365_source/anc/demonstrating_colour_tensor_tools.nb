   3.9950167977467823`*^9},
 FontWeight->"Plain",ExpressionUUID->"f543e04b-618e-4665-af31-d6d557dbdad4"],

Cell[TextData[{
 "It is sometimes valuable to differentiate among the ",
 StyleBox["real",
  FontWeight->"Bold"],
 " irreducible representations, \nthose for which ",
 StyleBox["R\[Wedge]R\[Superset]1",
  FontWeight->"Bold"],
 " (\[OpenCurlyDoubleQuote]",
 StyleBox["pseudoReal",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote]) from those for which ",
 StyleBox["R\[CircleDot]R\[Superset]1",
  FontWeight->"Bold"],
 " (\[OpenCurlyDoubleQuote]",
 StyleBox["real-real",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote]). \nFor our purposes, we consider the later case \
to be those representations which are ",
 StyleBox["real",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " but ",
 StyleBox["not",
  FontWeight->"Bold"],
 " ",
 StyleBox["psuedoReal",
  FontWeight->"Bold"],
 ". "
}], "Text",
 CellChangeTimes->{{3.9907031785304337`*^9, 3.990703450865994*^9}, {
  3.995194716307135*^9, 
  3.995194730639585*^9}},ExpressionUUID->"43033d43-18b9-4ebc-ac3c-\
7c348bc4e6f3"],

