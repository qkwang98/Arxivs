}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["representationWeights[",
  FontWeight->"Bold"],
 StyleBox["rep",
  FontSlant->"Italic"],
 "_",
 StyleBox["] ",
  FontWeight->"Bold"],
 "and ",
 StyleBox["representationRoots[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.990283781159535*^9, 3.9902837880793037`*^9}, {
  3.995029594161455*^9, 3.995029594482037*^9}, {3.995029725494783*^9, 
  3.995029733952858*^9}, {3.995700651012743*^9, 
  3.995700659901321*^9}},ExpressionUUID->"81c03153-e8e7-485f-835d-\
03ffd0cddfac"],

Cell[TextData[{
 "In the Chevalley basis, the Cartan subalgebra is generated by ",
 StyleBox["diagonal",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " matrices whose entries encode the ",
 StyleBox["marks",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of the representation. \nThe ",
 StyleBox["marks",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of a representation are related to its ",
 StyleBox["weights",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " via: \n",
 StyleBox["weight",
  FontWeight->"Bold"],
 "=",
 StyleBox["roots",
  FontWeight->"Bold"],
 ".",
 StyleBox["cartan",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.990871782097949*^9, 3.990871785933648*^9}, {
  3.9949424343473186`*^9, 3.994942484527644*^9}, {3.994944588530654*^9, 
  3.994944646096789*^9}, {3.99570067476503*^9, 
  3.995700675184865*^9}},ExpressionUUID->"a9bb81f0-c80a-4ced-a5a6-\
9fe9d2d88f9e"],

Cell[BoxData[{
 RowBox[{"fundamentalRep", "[", 
  RowBox[{"g", "[", "2", "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"representationRoots", "[", "%", "]"}], ",", 
    RowBox[{"representationRoots", "[", "%", "]"}]}], "}"}], "//", 
  "nice"}]}], "Input",
 CellChangeTimes->{{3.9905178008593893`*^9, 3.9905178116438923`*^9}, {
  3.993031929289184*^9, 3.9930319787565317`*^9}, {3.994944618771174*^9, 
  3.994944625039493*^9}, {3.995029740022479*^9, 3.995029752549498*^9}, {
  3.99570068055334*^9, 3.9957007056156197`*^9}},
 CellLabel->
  "In[297]:=",ExpressionUUID->"02d93bdd-f8fc-40b8-896b-1f742d9cab83"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"adjointRep", "[", 
   RowBox[{"g", "[", "2", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"representationWeights", "[", "%", "]"}], ",", 
    RowBox[{"representationRoots", "[", "%", "]"}]}], "}"}], "//", 
  "nice"}]}], "Input",
 CellChangeTimes->{{3.994944627281365*^9, 3.994944629139605*^9}, {
  3.9949447333496103`*^9, 3.9949447387900143`*^9}, {3.995029055679213*^9, 
  3.995029104346792*^9}, {3.995029767778256*^9, 3.9950297746140823`*^9}, {
  3.995700698920334*^9, 3.995700709037139*^9}},
 CellLabel->
  "In[299]:=",ExpressionUUID->"b44dd405-bfac-4851-b818-10a2ecb18892"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["showWeightLattice[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 " and ",
 StyleBox["showRootLattice[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.990283043203671*^9, 3.990283050639661*^9}, {
  3.995029600380126*^9, 3.9950296023760366`*^9}, {3.995029860607066*^9, 
  3.995029900236635*^9}, {3.995700665276951*^9, 
  3.995700669880045*^9}},ExpressionUUID->"6f9d54b0-9dad-4fb7-bd8b-\
874147ceb93a"],

Cell[TextData[{
 "For irreducible representations, ",
 StyleBox["showWeightLattice[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["] ",
  FontWeight->"Bold"],
 "and ",
 StyleBox["showRootLattice[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["] ",
  FontWeight->"Bold"],
 "returns the same output as with ",
 StyleBox["rep",
  FontSlant->"Italic"],
 " replaced by ",
 StyleBox["dynkinIndex[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.995029909817049*^9, 3.995029997668538*^9}, {
  3.995700722949839*^9, 
  3.995700726714617*^9}},ExpressionUUID->"2b90b63f-feec-4213-a912-\
a23bb7e8d034"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"fundamentalRep", "[", 
    RowBox[{"g", "[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"showWeightLattice", "[", "egRep", "]"}], ",", 
   RowBox[{"showWeightLattice", "[", 
    RowBox[{"dynkinLabel", "[", "egRep", "]"}], "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"showRootLattice", "[", "egRep", "]"}], ",", 
   RowBox[{"showRootLattice", "[", 
    RowBox[{"dynkinLabel", "[", "egRep", "]"}], "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.995030000081758*^9, 3.995030050987157*^9}},
 CellLabel->
  "In[301]:=",ExpressionUUID->"a5506df0-6530-44a7-b200-cb0fc3ab4088"],

Cell[TextData[{
 "What is more interesting is that for ",
 StyleBox["not necessarily irreducible representations",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[", ",
  FontSlant->"Italic"],
 "the whole spindles can be shown (by directly assessing the diagonal entries \
of the Cartan subalgebra in the Chevalley basis):"
}], "Text",
 CellChangeTimes->{{3.9950300542472477`*^9, 
  3.995030136508415*^9}},ExpressionUUID->"8528706c-c0e4-4371-b3e3-\
28d6cf7a496e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"repPower", "[", 
    RowBox[{
     RowBox[{"fundamentalRep", "[", 
      RowBox[{"g", "[", "2", "]"}], "]"}], ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"showWeightLattice", "[", "egRep", "]"}], ",", 
   RowBox[{"showRootLattice", "[", "egRep", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.995030086899703*^9, 3.995030101572295*^9}},
 CellLabel->
  "In[304]:=",ExpressionUUID->"202ee0ce-378c-40d2-b30c-a2d19db59e3e"],

Cell[TextData[{
 StyleBox["Note",
  FontWeight->"Bold"],
 ": if an ",
 StyleBox["optional",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " second argument of these functions is set to ",
 StyleBox["True",
  FontWeight->"Bold"],
 "\[LongDash]as in\n",
 StyleBox["showWeightLattice[",
  FontWeight->"Bold"],
 StyleBox["rep_,",
  FontSlant->"Italic"],
 "True",
 StyleBox["] ",
  FontWeight->"Bold"],
 "or ",
 StyleBox["showRootLattice[",
  FontWeight->"Bold"],
 StyleBox["rep_,",
  FontSlant->"Italic"],
 "True",
 StyleBox["]\n",
  FontWeight->"Bold"],
 "then these lattices will be decomposed into sums of those corresponding to \
irreducible representations:"
}], "Text",
 CellChangeTimes->{{3.995030139467865*^9, 
  3.9950302389123507`*^9}},ExpressionUUID->"2c345605-e84f-461b-87ed-\
0c1cdf886adc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"repPower", "[", 
    RowBox[{
     RowBox[{"fundamentalRep", "[", 
      RowBox[{"g", "[", "2", "]"}], "]"}], ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"showWeightLattice", "[", 
    RowBox[{"egRep", ",", "True"}], "]"}], ",", 
   RowBox[{"showRootLattice", "[", 
    RowBox[{"egRep", ",", "True"}], "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.995030246404119*^9, 3.995030249611994*^9}},
 CellLabel->
  "In[306]:=",ExpressionUUID->"a7e61d19-fed0-4357-84e7-ac74b3ce62c0"]
}, Closed]]
}, Closed]],

