   RowBox[{"fundamentalRep", "[", 
    RowBox[{"g", "[", "2", "]"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"dynkinLabel", "[", "%%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.99044049969691*^9, 3.990440527600902*^9}, {
  3.992965584476582*^9, 3.99296558878723*^9}},
