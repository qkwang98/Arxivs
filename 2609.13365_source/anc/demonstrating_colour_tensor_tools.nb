}], "Subsubsection",
 CellChangeTimes->{{3.9950171834531097`*^9, 3.9950172284001007`*^9}},
 FontWeight->"Plain",ExpressionUUID->"ca5d7dfd-2685-4ed1-b451-ec129b2975a4"],

Cell[TextData[{
 "For ",
 StyleBox["SO(n)",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " type Lie algebras, what we have called the \[OpenCurlyDoubleQuote]",
 StyleBox["fundamental",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] representation (the ",
 StyleBox["n",
  FontWeight->"Bold"],
 "-dimensional representation of SO(",
 StyleBox["n",
  FontWeight->"Bold"],
 ")) does not induce ",
 StyleBox["all",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " irreducible representations via tensor products/etc. \nIn particular, it \
does not induce the ",
 StyleBox["spinor",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 StyleBox["representations",
  FontWeight->"Bold"],
 ". "
}], "Text",
 CellChangeTimes->{{3.9902805004339447`*^9, 
  3.9902806419581623`*^9}},ExpressionUUID->"a347fc6e-837c-493a-9df2-\
907c8874f33d"],

Cell[TextData[{
 "For ",
 StyleBox["odd-n",
  FontWeight->"Bold"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "(b[k] Lie algebras) there is a unique ",
 StyleBox["spinor ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["representation",
  FontWeight->"Bold"],
 ".\nFor rank ",
 Cell[BoxData[
  FormBox["\[LessEqual]", TraditionalForm]],ExpressionUUID->
  "d2289920-1c1b-405f-9c3a-f030d64a6bc1"],
 " 8, these have been encoded via ",
 StyleBox["spinorRep[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9902806444214897`*^9, 3.990280675091412*^9}, {
  3.990280744738799*^9, 
  3.990280799789804*^9}},ExpressionUUID->"9877b606-29a5-42df-bfa3-\
4fbf3ad78b3c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"spinorRep", "[", 
    RowBox[{"b", "[", "#", "]"}], "]"}], "&"}], "/@", 
  RowBox[{"Range", "[", 
   RowBox[{"2", ",", "8"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"dynkinLabel", "/@", "%%"}]}], "Input",
 CellChangeTimes->{{3.990280675955716*^9, 3.9902806854638*^9}, {
  3.991558231638431*^9, 3.9915582365468082`*^9}, {3.9949221411958447`*^9, 
  3.99492214133488*^9}},
 CellLabel->
  "In[152]:=",ExpressionUUID->"3147d9a3-112b-4757-91b0-a0eaf2864441"],

Cell[TextData[{
 "While for ",
 StyleBox["even-n",
  FontWeight->"Bold"],
 ", (d[k] Lie algebras) there are 2 distinct irreducible ",
 StyleBox["spinor ",
  FontWeight->"Bold"],
 "representations "
}], "Text",
 CellChangeTimes->{{3.990280708029665*^9, 3.990280742922917*^9}, {
  3.9902808128819532`*^9, 
  3.990280827507903*^9}},ExpressionUUID->"3a3fc2d8-c2d6-4f62-af17-\
7aa46683a1c3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"spinorRep", "[", 
    RowBox[{"so", "[", 
     RowBox[{"2", "#"}], "]"}], "]"}], "&"}], "/@", 
  RowBox[{"Range", "[", 
   RowBox[{"4", ",", "8"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"dynkinLabel", "/@", "%%"}]}], "Input",
 CellChangeTimes->{{3.990280829600638*^9, 3.990280850633266*^9}, {
  3.992617284356144*^9, 3.992617289038999*^9}},
 CellLabel->
  "In[155]:=",ExpressionUUID->"72fec3fa-fd67-40c7-81ac-019e2b54dd33"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"spinor2Rep", "[", 
    RowBox[{"so", "[", 
     RowBox[{"2", "#"}], "]"}], "]"}], "&"}], "/@", 
  RowBox[{"Range", "[", 
   RowBox[{"4", ",", "8"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"dynkinLabel", "/@", "%%"}]}], "Input",
 CellChangeTimes->{{3.9902808567529383`*^9, 3.990280858322233*^9}, {
  3.9926172929359503`*^9, 3.992617295826581*^9}},
 CellLabel->
  "In[158]:=",ExpressionUUID->"b7f79057-f696-4cc1-ae99-310e35b5a3d4"],

Cell[TextData[{
 "Notice that although both spinors of ",
 StyleBox["d[",
  FontWeight->"Bold"],
 StyleBox["k_",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 " are of the same dimension, they are not identical. \nThis is indicated by \
the representations\[CloseCurlyQuote] ",
 StyleBox["Dynkin labels",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (about which we have more to say anon):"
}], "Text",
 CellChangeTimes->{{3.990280867912973*^9, 3.990280889204134*^9}, {
  3.9902812429618807`*^9, 3.990281257254402*^9}, {3.990281296895721*^9, 
  3.9902813244638777`*^9}},ExpressionUUID->"188ecb01-51cd-49b8-9f66-\
4823fc29f115"],

Cell[BoxData[{
 RowBox[{"{", 
  RowBox[{
   RowBox[{"spinorRep", "[", 
    RowBox[{"d", "[", "5", "]"}], "]"}], ",", 
   RowBox[{"spinor2Rep", "[", 
    RowBox[{"d", "[", "5", "]"}], "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "/@", "%"}], "\[IndentingNewLine]", 
 RowBox[{"dynkinLabel", "/@", "%%"}]}], "Input",
 CellChangeTimes->{{3.9902812585939283`*^9, 3.990281284222769*^9}, {
  3.994922163578616*^9, 3.99492216370623*^9}},
 CellLabel->
  "In[161]:=",ExpressionUUID->"41ccc59b-3957-4349-9f09-eef77f58b90f"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["fundamentalRep[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 ",",
 StyleBox["number_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ": ",
 StyleBox["all ",
  FontSlant->"Italic"],
 "irreducible representations of ",
 StyleBox["fundamental weights",
  FontWeight->"Bold",
  FontSlant->"Italic"]
}], "Subsubsection",
 CellChangeTimes->{{3.9871673348350286`*^9, 3.9871673462423286`*^9}, {
  3.990281331699067*^9, 3.990281341505548*^9}, {3.9902816452771587`*^9, 
  3.9902816453639174`*^9}, {3.994922676423161*^9, 3.9949226775315857`*^9}, {
  3.995017298829137*^9, 
  3.995017339767231*^9}},ExpressionUUID->"4159c4ea-6b73-40de-85a4-\
b3735e397b7a"],

Cell[TextData[{
 "For a simple Lie algebra of ",
 StyleBox["rank",
  FontWeight->"Bold"],
 "-",
 StyleBox["k",
  FontSlant->"Italic"],
 ", it is sometimes said that there are ",
 StyleBox["k",
  FontWeight->"Bold"],
 " \[OpenCurlyDoubleQuote]fundamental\[CloseCurlyDoubleQuote] representations\
\[LongDash]meaning a set from which ",
 StyleBox["all ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "irreducible representations may be obtained from these via symmetric tensor \
products. \n\nThe ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["i", "th"], TraditionalForm]],ExpressionUUID->
  "9f29a9cf-0325-4325-9b22-8d7866c74604"],
 " \[OpenCurlyDoubleQuote]",
 StyleBox["fundamental",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote] representation can be obtained via the optional \
second argument of \n",
 StyleBox["fundamentalRep[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 ",i",
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.990281022399354*^9, 
  3.990281218726818*^9}},ExpressionUUID->"6c0d9b97-a0ae-48e5-828a-\
159ffbf793f6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egAlgebra", "=", 
   RowBox[{"e", "[", "6", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", 
   RowBox[{"AbsoluteTime", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"egFundamentalReps", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"fundamentalRep", "[", 
     RowBox[{"egAlgebra", ",", "#"}], "]"}], "&"}], "/@", 
   RowBox[{"Range", "[", 
    RowBox[{"First", "@", "egAlgebra"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"niceTime", "[", 
  RowBox[{
   RowBox[{"AbsoluteTime", "[", "]"}], "-", "t0"}], "]"}]}], "Input",
 CellChangeTimes->{{3.990281385917363*^9, 3.990281386517744*^9}},
 CellLabel->
  "In[164]:=",ExpressionUUID->"1d901391-9840-4ba1-8e9e-5e59095fad82"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"nice", "[", "#", "]"}], ",", 
      RowBox[{"dynkinLabel", "[", "#", "]"}], ",", 
      RowBox[{"representationDimension", "[", "#", "]"}]}], "}"}], "&"}], "/@",
    "egFundamentalReps"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.990281388089349*^9, 3.99028141896642*^9}, 
   3.990281543821059*^9},
 CellLabel->
  "In[169]:=",ExpressionUUID->"dcbcc377-56f5-4f47-aea8-0633cf03108c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egAlgebra", "=", 
   RowBox[{"f", "[", "4", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t0", "=", 
   RowBox[{"AbsoluteTime", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"egFundamentalReps", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"fundamentalRep", "[", 
     RowBox[{"egAlgebra", ",", "#"}], "]"}], "&"}], "/@", 
   RowBox[{"Range", "[", 
    RowBox[{"First", "@", "egAlgebra"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"niceTime", "[", 
  RowBox[{
   RowBox[{"AbsoluteTime", "[", "]"}], "-", "t0"}], "]"}]}], "Input",
 CellChangeTimes->{{3.987167350515422*^9, 3.9871673918547697`*^9}, {
  3.990281377848126*^9, 3.990281381675075*^9}},
 CellLabel->
  "In[171]:=",ExpressionUUID->"928b34f4-cd69-4d2a-9382-3d2df628f45b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"nice", "[", "#", "]"}], ",", 
      RowBox[{"dynkinLabel", "[", "#", "]"}], ",", 
      RowBox[{"representationDimension", "[", "#", "]"}]}], "}"}], "&"}], "/@",
    "egFundamentalReps"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.990281448683913*^9, 3.9902814750400476`*^9}, {
  3.9902815333760443`*^9, 3.9902815344379053`*^9}},
