Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Building ",
  FontWeight->"Bold"],
 StyleBox["Concrete",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" Colour Tensors for Amplitudes ",
  FontWeight->"Bold"]
}], "Section",
 CellChangeTimes->{{3.994428655952609*^9, 3.9944286654135647`*^9}, 
   3.99519743475*^9},ExpressionUUID->"5f07dc5e-fa24-439e-8e9b-dedda7d1d0b9"],

Cell[TextData[{
 "The main function is ",
 StyleBox["buildTensors[_]",
  FontWeight->"Bold"],
 "\[LongDash]which requires either an ",
 StyleBox["algebra",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " or ",
 StyleBox["representation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " to be specified.\nAbstract labels for tensors such as ",
 StyleBox["trR",
  FontWeight->"Bold"],
 ", ",
 StyleBox["joTensor",
  FontWeight->"Bold"],
 ", require that a ",
 StyleBox["particular",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " representation be specified.\nAbstract objects such as ",
 StyleBox["trF",
  FontWeight->"Bold"],
 ", ",
 StyleBox["trAd",
  FontWeight->"Bold"],
 ", and ",
 StyleBox["ddmTensor ",
  FontWeight->"Bold"],
 "require ",
 StyleBox["only",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " an algebra be specified.\nFinally, ",
 StyleBox["clebschTensor",
  FontWeight->"Bold"],
 " objects can only be built for (and are only ",
 StyleBox["defined for",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ") the algebra ",
 StyleBox["a[1]",
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{{3.9944286684737988`*^9, 3.994428671058339*^9}, {
  3.995108898253661*^9, 
  3.995109291266385*^9}},ExpressionUUID->"35eced89-2274-47e4-a27f-\
b17571a22346"],

