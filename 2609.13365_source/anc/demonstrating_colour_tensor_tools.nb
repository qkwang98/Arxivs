  3.996071637342002*^9}},ExpressionUUID->"6e054cf2-94f3-4b83-853f-\
cb8eb9140d43"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"t0", "=", 
   RowBox[{"AbsoluteTime", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"irrepList", "=", 
  RowBox[{"Join", "@@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"irrepDimensionToDynkinLabels", "[", 
      RowBox[{"e", "[", "6", "]"}], "]"}], "/@", 
     RowBox[{"Range", "[", 
      RowBox[{"10", "^", "4"}], "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"niceTime", "[", 
  RowBox[{
   RowBox[{"AbsoluteTime", "[", "]"}], "-", "t0"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "irrepList", "]"}]}], "Input",
