Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Exempli Gratia",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ": ",
 "Finding",
 " ",
 StyleBox["Dynkin-Labels",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " for Irreducible Representations of ",
 StyleBox["Specified",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 StyleBox["Dimension",
  FontWeight->"Bold"]
}], "Subsection",
 CellChangeTimes->{{3.990702204601179*^9, 3.990702231820315*^9}, {
  3.990702280686254*^9, 3.990702302769063*^9}, {3.99501614994948*^9, 
  3.995016175614251*^9}},ExpressionUUID->"2320ff91-f188-4108-a4c8-\
55981f827a77"],

Cell[TextData[{
 "It is sometimes common (especially for physicists to) \
\[OpenCurlyDoubleQuote]",
 StyleBox["identify",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote]",
 StyleBox[" ",
  FontSlant->"Italic"],
 "or ",
 StyleBox["label",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " irreducible representations by their ",
 StyleBox["dimension",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{{3.990702304809114*^9, 3.990702402514278*^9}, {
  3.99484590099551*^9, 3.994845941266821*^9}, {3.995194531417255*^9, 
  3.9951945342255697`*^9}},ExpressionUUID->"712a26ba-0900-4130-a6ef-\
a77da1056a13"],

Cell[TextData[{
 "This is ",
 StyleBox["unequivocally",
  FontSlant->"Italic"],
 " ",
 StyleBox["problematic",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", as there are often multiple irreducible representations of identical \
dimension; \nbut ",
 StyleBox["often",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[",",
  FontSlant->"Italic"],
 " this information is sufficient to uniquely identify an irreducible \
representation."
}], "Text",
 CellChangeTimes->{{3.990702304809114*^9, 3.990702402514278*^9}, {
  3.99484590099551*^9, 3.994845941266821*^9}, {3.995194531417255*^9, 
  3.995194531868792*^9}},ExpressionUUID->"32a89f68-6af4-436f-8bf9-\
07f0566b3060"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["irrepDimensionToDynkinLabels[",
  FontWeight->"Bold"],
 StyleBox["algebra_",
  FontSlant->"Italic"],
 StyleBox["][",
  FontWeight->"Bold"],
 StyleBox["dimension_",
  FontSlant->"Italic"],
 StyleBox["]:",
  FontWeight->"Bold"]
}], "Subsubsection",
 CellChangeTimes->{{3.990702407681967*^9, 
  3.990702439755692*^9}},ExpressionUUID->"61efe063-6cd0-4aa7-a898-\
caee84de9f7e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"irrepDimensionToDynkinLabels", "[", 
   RowBox[{"e", "[", "8", "]"}], "]"}], "[", "248", "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
