 RowBox[{"repSum", "[", 
  RowBox[{
   RowBox[{"repSum", "[", 
    RowBox[{"3", ",", 
     RowBox[{"fundamentalRep", "[", 
      RowBox[{"g", "[", "2", "]"}], "]"}]}], "]"}], ",", 
