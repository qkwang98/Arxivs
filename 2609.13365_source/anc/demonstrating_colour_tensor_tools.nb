Cell[TextData[{
 "Two ",
 StyleBox["conventionally",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 StyleBox["defined",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (",
 StyleBox["but related",
  FontWeight->"Bold"],
 ") numbers characterizing any irreducible representation are: \nits \
(quadratic) ",
 StyleBox["Casimir",
  FontWeight->"Bold"],
 " eigenvalue, and its ",
 StyleBox["Dynkin Index",
  FontWeight->"Bold"],
 ". "
}], "Text",
