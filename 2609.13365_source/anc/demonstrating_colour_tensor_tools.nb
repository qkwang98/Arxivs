}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["dotPower[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 ",{",
 StyleBox["orderingOfAdjointIndices__",
  FontSlant->"Italic"],
 "}",
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.99503110926223*^9, 
  3.995031141796754*^9}},ExpressionUUID->"70a20d53-2543-4a80-a905-\
37d13dd6a66c"],

Cell[TextData[{
 "As dot-powers of representation tensors will always have a number of \
(raised) adjoint indices, their positioning in the ",
 StyleBox["SlotSequence",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of the tensor be arranged in whatever order. If a ",
 StyleBox["permutation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " is specified (instead of merely an ",
 StyleBox["Integer",
  FontWeight->"Bold"],
 "), ",
 StyleBox["dotPower[] ",
  FontWeight->"Bold"],
 "will permute/",
 StyleBox["Transpose",
  FontWeight->"Bold"],
 " these arguments accordingly. "
}], "Text",
 CellChangeTimes->{{3.995031144741857*^9, 
  3.995031299459817*^9}},ExpressionUUID->"8d6f9c54-0db9-49a3-9a06-\
aadecbb4c9ee"],

Cell[BoxData[{
 RowBox[{"dotPower", "[", 
  RowBox[{
   RowBox[{"fundamentalRep", "[", 
    RowBox[{"g", "[", "2", "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "3", ",", "2", ",", "1"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.992704621983527*^9, 3.992704632890891*^9}, {
  3.9927055189610853`*^9, 3.992705520733756*^9}, {3.992707757507489*^9, 
  3.992707760076923*^9}, {3.992707813245613*^9, 3.992707813919718*^9}, {
  3.993032541295588*^9, 3.9930325448121*^9}, {3.995031258301944*^9, 
  3.995031259045475*^9}},
 CellLabel->
  "In[353]:=",ExpressionUUID->"b8f765d4-ab59-46fe-bca6-184f0e3a8a62"],

Cell[TextData[{
 "Notice that in the ",
 "output of ",
 StyleBox["drawTensors",
  FontWeight->"Bold"],
 "[], \nthe ",
 StyleBox["Integer",
  FontWeight->"Bold"],
 " labels identify the ",
 StyleBox["Slot",
  FontWeight->"Bold"],
 " ",
 StyleBox["Position",
  FontWeight->"Bold"],
 " of each argument of the corresponding ",
 StyleBox["SparseArray ",
  FontWeight->"Bold"],
 "(aka \[OpenCurlyDoubleQuote]tensor\[CloseCurlyDoubleQuote])."
}], "Text",
 CellChangeTimes->{{3.995031302127844*^9, 
  3.995031372241683*^9}},ExpressionUUID->"edae7fd4-4459-40d4-b9d3-\
652ec5e47369"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "(",
 StyleBox["Multi-",
  FontWeight->"Bold"],
 ")",
 StyleBox["Traces ",
  FontWeight->"Bold"],
 "over ",
 StyleBox["Generators",
  FontWeight->"Bold"],
 " of a ",
 StyleBox["Concrete",
  FontWeight->"Bold",
  FontSlant->"Italic"],
