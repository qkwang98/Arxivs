  FontWeight->"Bold"]
}], "Subsection",
 CellChangeTimes->{{3.990517883240736*^9, 3.990517896484377*^9}, {
  3.9951962201774187`*^9, 
  3.995196238167489*^9}},ExpressionUUID->"8b946e89-d1a5-498d-8bfa-\
029a4a5c4aab"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["repTrace[",
  FontWeight->"Bold"],
 StyleBox["rep_,n_",
  FontSlant->"Italic"],
 "Integer",
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.990517899199398*^9, 3.990517920799774*^9}, {
  3.992618542034443*^9, 3.992618543890292*^9}, {3.995196212239231*^9, 
  3.995196212891417*^9}},ExpressionUUID->"7dc1c3bd-dd1d-45d5-a89f-\
82509c5165c6"],

Cell[TextData[{
 "Another important set of tensors constructed from a given representation is \
a ",
 StyleBox["trace",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " over its generators.  "
}], "Text",
 CellChangeTimes->{{3.993032771321438*^9, 3.993032772638184*^9}, {
  3.9950313925396967`*^9, 
  3.995031425876314*^9}},ExpressionUUID->"c2af98c3-8d9a-4c4e-8bbf-\
208318b09988"],

Cell[BoxData[{
 RowBox[{"repTrace", "[", 
  RowBox[{
   RowBox[{"fundamentalRep", "[", 
    RowBox[{"a", "[", "2", "]"}], "]"}], ",", "5"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.990781478919208*^9, 3.990781483307508*^9}, {
  3.992618545595731*^9, 3.992618549720261*^9}, {3.9927045943602743`*^9, 
  3.99270459475983*^9}, {3.992704672728394*^9, 3.992704674790267*^9}, {
  3.992705523710883*^9, 3.992705527209921*^9}, {3.9927077727523937`*^9, 
  3.992707775146343*^9}, {3.993032557220573*^9, 3.993032560107419*^9}, {
  3.9930326520370092`*^9, 3.9930326522408257`*^9}, {3.993032697443372*^9, 
  3.9930327247771187`*^9}},
 CellLabel->
  "In[355]:=",ExpressionUUID->"e0bdcbfa-f14d-46b9-b130-357c3b30084c"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["repTrace[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 ",{",
 StyleBox["indexOrderings",
  FontSlant->"Italic"],
 "__List}",
 StyleBox["] ",
  FontWeight->"Bold"],
 "generate ",
 StyleBox["multi-trace",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " tensors:"
}], "Subsubsection",
 CellChangeTimes->{{3.995031450297893*^9, 3.995031516810453*^9}},
 FontWeight->"Plain",ExpressionUUID->"e6fb6185-9942-4d74-9413-227034ad51df"],

Cell[TextData[{
 "Especially in physics applications, one often encounters ",
 StyleBox["tr",
  FontWeight->"Bold"],
 " objects comprised of (tensor)-products",
 " of ",
 StyleBox["traces",
  FontWeight->"Bold"],
 ", with slot sequence"
}], "Text",
 CellChangeTimes->{{3.995031669381344*^9, 
  3.9950317230282793`*^9}},ExpressionUUID->"dcf0f0e6-7f69-4a8b-a663-\
fa0ab6dd9c00"],

Cell[BoxData[{
 RowBox[{"egMultiTrace", "=", 
  RowBox[{"RandomChoice", "[", 
   RowBox[{"multiTraceTensors", "[", "7", "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"egIndexOrderings", "=", 
  RowBox[{"List", "@@", "egMultiTrace"}]}]}], "Input",
 CellChangeTimes->{{3.995031522592514*^9, 3.995031547198275*^9}, {
  3.995031626658289*^9, 3.995031636621315*^9}},
 CellLabel->
  "In[357]:=",ExpressionUUID->"2c272e98-cd7c-474a-bae9-2de1499ce921"],

Cell[BoxData[{
 RowBox[{"egTraceTensor", "=", 
  RowBox[{"repTrace", "[", 
   RowBox[{
    RowBox[{"symPower", "[", 
     RowBox[{
      RowBox[{"fundamentalRep", "[", 
       RowBox[{"a", "[", "3", "]"}], "]"}], ",", "2"}], "]"}], ",", 
    "egIndexOrderings"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.995031649430017*^9, 3.9950316503201227`*^9}, {
  3.99503172795713*^9, 3.995031731066058*^9}, {3.995032010655656*^9, 
  3.995032012800948*^9}},
 CellLabel->
  "In[360]:=",ExpressionUUID->"3aa29e71-d98a-4a5a-b230-a76bd6e9a948"],

Cell[TextData[{
 "Incidentally, we can check that the ",
 StyleBox["egTraceTensor",
  FontWeight->"Bold"],
 " is appropriately ",
 StyleBox["cyclically-invariant",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " in each of its indexOrderings via"
}], "Text",
 CellChangeTimes->{{3.995031948044505*^9, 
  3.9950319796181097`*^9}},ExpressionUUID->"da0a3757-2db9-404d-9f7d-\
23ec802cdeba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Tuples", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Partition", "[", 
      RowBox[{"#", ",", 
       RowBox[{"Length", "[", "#", "]"}], ",", "1", ",", "1"}], "]"}], "&"}], 
    "/@", "egIndexOrderings"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"egSymmetryPerms", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Flatten", "[", "egIndexOrderings", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"Ordering", "[", 
       RowBox[{"Flatten", "[", "#", "]"}], "]"}], "]"}], "]"}], "&"}], "/@", 
   "%"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{
     RowBox[{"SparseArray", "[", 
      RowBox[{"egTraceTensor", "-", 
       RowBox[{"Transpose", "[", 
        RowBox[{"egTraceTensor", ",", "#"}], "]"}]}], "]"}], 
     "[", "\"\<NonzeroValues\>\"", "]"}], "]"}], "&"}], "/@", 
  "egSymmetryPerms"}]}], "Input",
 CellChangeTimes->{{3.99503173475539*^9, 3.995031745874488*^9}, {
   3.995031822177752*^9, 3.995031896819566*^9}, 3.9950319443837633`*^9, {
   3.995031982169957*^9, 3.995032003703472*^9}},
 CellLabel->
  "In[362]:=",ExpressionUUID->"eda4e9c0-3984-435f-9a98-eef86bb8e505"]
}, Closed]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Abstract",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" Colour Tensors ",
  FontWeight->"Bold"],
 "defined",
 StyleBox[" ",
  FontWeight->"Bold"],
 "for",
 StyleBox[" Scattering Amplitudes",
  FontWeight->"Bold"]
}], "Section",
 CellChangeTimes->{{3.990541187856679*^9, 3.990541204656494*^9}, {
  3.9907815037660313`*^9, 3.9907815048980503`*^9}, {3.993288910126822*^9, 
  3.993288912052328*^9}},ExpressionUUID->"b34870f3-fc89-4298-a322-\
73fa4455f784"],

Cell[CellGroupData[{

Cell[TextData[{
 "(",
 StyleBox["Multi-",
  FontWeight->"Bold"],
 ")",
 StyleBox["Trace",
  FontWeight->"Bold"],
 " ",
 StyleBox["Tensors",
  FontWeight->"Bold"],
 " (for ",
 StyleBox["n",
  FontSlant->"Italic"],
 "-",
 StyleBox["Adjoint",
  FontWeight->"Bold"],
 " Scattering)"
}], "Subsection",
 CellChangeTimes->{{3.993288888077536*^9, 3.99328895572528*^9}, {
  3.993310098524867*^9, 3.993310102206126*^9}, {3.995196292530912*^9, 
  3.995196294104795*^9}},ExpressionUUID->"8f59d421-483b-4acb-b623-\
0dba71909ee6"],

Cell[TextData[{
 "Amplitudes involving gluons (which are necessarily charged under the ",
 StyleBox["adjoint representation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " for any gauge group) involve colour tensors constructed from (\
\[OpenCurlyQuote]",
 StyleBox["f",
  FontSlant->"Italic"],
 "-\[CloseCurlyQuote])graphs of structure constants. "
}], "Text",
 CellChangeTimes->{{3.995100876516397*^9, 3.995100985189399*^9}, 
   3.995358239871892*^9},ExpressionUUID->"3e8ca4fa-8d7b-4803-a138-\
e3a18b78533b"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["treeAmpTraceExpansion[",
  FontWeight->"Bold"],
 StyleBox["n_,",
  FontSlant->"Italic"],
 StyleBox["fundamentalRepQ_",
  FontSlant->"Italic"],
 ":",
 StyleBox["True",
  FontColor->RGBColor[0., 0., 0.]],
 ",",
 StyleBox["realRepQ_",
  FontSlant->"Italic"],
 ":",
 StyleBox["False",
  FontColor->RGBColor[0., 0., 0.]],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.993821242583818*^9, 3.993821251219783*^9}, {
  3.995196318026744*^9, 3.995196330521668*^9}, {3.996055770478793*^9, 
  3.996055770622567*^9}, {3.9960558278651237`*^9, 
  3.9960558507241793`*^9}},ExpressionUUID->"17bf1f5a-98b6-4934-b0ab-\
b73255b154cb"],

Cell[TextData[{
 "Any tensor constructed from a trivalent tree of structure constants can be \
expressed in terms of ",
 StyleBox["single",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "-",
 StyleBox["trace",
  FontWeight->"Bold"],
 " tensors involving any representation. ",
 StyleBox["Setting the Dynkin index of the fundamental representation to 1",
  FontSlant->"Italic"],
 ", this gives a representation of amplitudes in terms of the ",
 StyleBox["fundamental",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " representation:"
}], "Text",
 CellChangeTimes->{{3.995100992437707*^9, 3.995101080674183*^9}, {
  3.9951083023954678`*^9, 
  3.995108328100445*^9}},ExpressionUUID->"0673db4f-452e-4435-98ae-\
8d8ba85f7625"],

Cell[BoxData[{
 RowBox[{"treeAmpTraceExpansion", "[", "5", "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.993310880678817*^9, 3.993310887478972*^9}},
 CellLabel->
  "In[365]:=",ExpressionUUID->"9b68e412-b11d-45f9-af3c-8683b27b4100"],

Cell[TextData[{
 StyleBox["Note",
  FontWeight->"Bold"],
 ": this expansion makes use of the fact that ",
 StyleBox["T(F)=1",
  FontWeight->"Bold"],
 " and also the dihedral symmetry of partial amplitudes"
}], "Text",
 CellChangeTimes->{{3.995196407571418*^9, 3.995196423164214*^9}, {
  3.9951964907032347`*^9, 
  3.9951964977044783`*^9}},ExpressionUUID->"c4c49a11-408e-4c97-af89-\
73fe7f5873a0"],

Cell[TextData[{
 "If one were to use traces over the generators of an ",
 StyleBox["arbitrary representation ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["R",
  FontWeight->"Bold"],
 ", then there must be a compensatory \[OpenCurlyDoubleQuote]dynkinIndex[R]\
\[CloseCurlyDoubleQuote] included"
}], "Text",
 CellChangeTimes->{{3.995196335092823*^9, 3.9951963416886587`*^9}, {
  3.9951964282685423`*^9, 
  3.9951964650093813`*^9}},ExpressionUUID->"916217b6-dd36-4a34-85b6-\
51d3fb5c4d6b"],

Cell[BoxData[{
 RowBox[{"treeAmpTraceExpansion", "[", 
  RowBox[{"4", ",", "False"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.995196467515191*^9, 3.995196471755766*^9}, {
  3.996055779526745*^9, 3.996055789566969*^9}},
 CellLabel->
  "In[367]:=",ExpressionUUID->"b4cd2c08-580f-4374-bfb8-8e099cd55dbd"],

Cell[TextData[{
 "Finally, it is worth noting that ",
 StyleBox["if the representation appearing in the trace is known to be ",
  FontWeight->"Bold",
