Cell[TextData[{
 "The decomposition of tensor-product-representations into irreducible \
representations (with multiplicities) can be obtained using \n",
 StyleBox["tensorProductDecomposition[",
  FontWeight->"Bold"],
 StyleBox["representationSequence__",
  FontSlant->"Italic"],
 StyleBox["] ",
  FontWeight->"Bold"],
 "(where ",
 StyleBox["representationSequence",
  FontSlant->"Italic"],
 " may consist of irreducible reps, sums, powers, etc.)"
}], "Text",
 CellChangeTimes->{{3.990778574470398*^9, 
  3.990778666526183*^9}},ExpressionUUID->"06ee7786-27d8-4b5e-815a-\
