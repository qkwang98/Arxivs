dffe0b968d57"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["repSum[",
  FontWeight->"Bold"],
 StyleBox["repA_,repB_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ", ",
 StyleBox["repSum[",
  FontWeight->"Bold"],
 StyleBox["n_",
  FontSlant->"Italic"],
 "Integer,",
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ", etc.:"
}], "Subsubsection",
 CellChangeTimes->{{3.994922696027232*^9, 3.9949227178495903`*^9}, {
  3.995017446107918*^9, 
  3.995017482633609*^9}},ExpressionUUID->"0383ed1e-aa24-4e31-af88-\
0365d6665c84"],

Cell[TextData[{
 "The ",
 StyleBox["outer-sum",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of two representations will form a new representation, as in \n(",
 StyleBox["R\[CirclePlus]S",
  FontWeight->"Bold"],
 ") using \[LineSeparator]",
 StyleBox["repSum[",
  FontWeight->"Bold"],
 StyleBox["repA_,repB_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.99044035297353*^9, 3.9904404013247833`*^9}, {
   3.990440445632094*^9, 3.990440466897859*^9}, 
   3.990440537327346*^9},ExpressionUUID->"6a568c50-2978-4358-9ae3-\
e8711fd61cfe"],

Cell[BoxData[{
 RowBox[{"repSum", "[", 
  RowBox[{
   RowBox[{"fundamentalRep", "[", 
    RowBox[{
     RowBox[{"b", "[", "6", "]"}], ",", "3"}], "]"}], ",", 
   RowBox[{"spinorRep", "[", 
    RowBox[{"b", "[", "6", "]"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"dynkinLabel", "[", "%%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
