Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Tensor-Product-Representations ",
  FontWeight->"Bold"],
 "of Representations"
}], "Subsection",
 CellChangeTimes->{{3.990281759621792*^9, 3.9902817958931227`*^9}, {
  3.990281881634357*^9, 3.990281882584405*^9}, {3.995018131105481*^9, 
  3.9950181442320423`*^9}},ExpressionUUID->"15e33083-1863-410e-8a06-\
dc358568a638"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["productRep[",
  FontWeight->"Bold"],
 StyleBox["repR_,repS_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.9904406284435987`*^9, 3.9904406367024384`*^9}, {
  3.995017508776046*^9, 3.995017516091034*^9}, {3.9950175526417093`*^9, 
  3.995017562884166*^9}, {3.995195272581427*^9, 
  3.9951952829880047`*^9}},ExpressionUUID->"85d429cb-905a-42b3-876a-\
21b46a72c80d"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " the \[OpenCurlyDoubleQuote]tensor-product representation\
\[CloseCurlyDoubleQuote] of two Lie algebra representations is ",
 StyleBox["not",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " the ",
 StyleBox["tensor-product ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["of",
  FontWeight->"Bold"],
 " the two representations. \nRather, it is the representation defined by\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["R",
      FontWeight->"Bold",
      FontSlant->"Plain"], "\[CircleTimes]", 
     StyleBox["S",
      FontWeight->"Bold",
      FontSlant->"Plain"]}], ":=", 
    RowBox[{
     RowBox[{
      StyleBox["R",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox[" ",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      SubscriptBox[
       SuperscriptBox["\[Delta]", 
        RowBox[{"[", "s", "]"}]], 
       RowBox[{"[", "s", "]"}]]}], "+", 
     RowBox[{
      SubscriptBox[
       SuperscriptBox["\[Delta]", 
        RowBox[{"[", "r", "]"}]], 
       RowBox[{"[", "r", "]"}]], 
      StyleBox["S",
       FontWeight->"Bold",
       FontSlant->"Plain"]}]}]}], TraditionalForm]],ExpressionUUID->
  "2a843c3c-784c-4a0c-b936-09a4f444f3ef"]
}], "Text",
 CellChangeTimes->{
  3.995358162593231*^9},ExpressionUUID->"7945eb04-70d4-409a-ae4f-\
17e2e224c3b9"],

Cell[TextData[{
 "The ",
 StyleBox["tensor-product-representation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "of two representations can be generated via\n",
 StyleBox["productRep[",
  FontWeight->"Bold"],
 StyleBox["repR_,repS_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.990281891745118*^9, 3.9902818938014793`*^9}, {
  3.990440572619216*^9, 3.9904406195269823`*^9}, {3.995195288933118*^9, 
  3.995195290528603*^9}},ExpressionUUID->"106452f6-40fd-495e-bfd7-\
24c097f8ed25"],

Cell[BoxData[{
 RowBox[{"newRep", "=", 
  RowBox[{"productRep", "[", 
   RowBox[{
    RowBox[{"adjointRep", "[", 
     RowBox[{"e", "[", "6", "]"}], "]"}], ",", 
    RowBox[{"fundamentalRep", "[", 
     RowBox[{"e", "[", "6", "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"dynkinLabel", "[", "newRep", "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.990440644823639*^9, 3.990440669668119*^9}, {
  3.992965187849695*^9, 3.99296521133637*^9}, {3.9930299301962023`*^9, 
  3.9930299333310947`*^9}},
 CellLabel->
  "In[198]:=",ExpressionUUID->"96cdc55e-13da-4bfb-b483-dd39103fd1d3"],

Cell[TextData[{
 "We can verify that this agrees with ",
 StyleBox["tensorProductDecomposition",
  FontWeight->"Bold"],
 " "
}], "Text",
 CellChangeTimes->{{3.990870853489727*^9, 
  3.990870868204639*^9}},ExpressionUUID->"f7840a3f-3b53-4628-bce5-\
1b8b73ca57b6"],

Cell[BoxData[{
 RowBox[{"tensorProductDecomposition", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"w", "[", "e", "]"}], "[", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], "]"}], ",", 
   RowBox[{
    RowBox[{"w", "[", "e", "]"}], "[", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "1"}], "]"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.990870872457787*^9, 3.990870901088319*^9}, {
  3.993029938179771*^9, 3.993029947993351*^9}},
 CellLabel->
  "In[202]:=",ExpressionUUID->"47b79d2f-f2f2-4222-a8c1-aea0f4f481ba"],

Cell["", "Text",ExpressionUUID->"c6583985-a19a-4455-958a-0f91ff56e18a"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["repPower[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 ",",
 StyleBox["n_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.995017528670514*^9, 3.995017545456771*^9}, {
  3.995537591462514*^9, 
  3.995537593994651*^9}},ExpressionUUID->"7fe0af5e-cfee-4294-a7c8-\
62be619ae2ac"],

Cell[TextData[{
 "Similarly, tensor products of two identical representations can be used to \
generate ",
 StyleBox["tensor-powers",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " via\n",
 StyleBox["repPower[",
  FontWeight->"Bold"],
 StyleBox["rep_,n_",
  FontSlant->"Italic"],
 "Integer",
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.990440695364025*^9, 
  3.990440784726221*^9}},ExpressionUUID->"ec3e8354-96ce-4557-a21a-\
315b5020b89f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"spinor2Rep", "[", 
    RowBox[{"d", "[", "5", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"repPower", "[", 
  RowBox[{"egRep", ",", "4"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"dynkinLabel", "[", "%%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.990281815333173*^9, 3.990281849196306*^9}, {
  3.9904407940218267`*^9, 3.990440809251398*^9}, {3.990440857532029*^9, 
  3.990440860927718*^9}, {3.9924434795505466`*^9, 3.992443479682342*^9}, {
  3.992443886790098*^9, 3.992443887317156*^9}, {3.99244400141792*^9, 
  3.9924440019792767`*^9}, {3.992444345826892*^9, 3.9924443460735197`*^9}, {
  3.992444400779978*^9, 3.9924444146383*^9}, {3.992444461252242*^9, 
  3.992444461432775*^9}, {3.9924444965518303`*^9, 3.992444525403736*^9}, {
  3.99244459443493*^9, 3.9924445946364927`*^9}, {3.993029955080187*^9, 
  3.993029959452837*^9}},
 CellLabel->
  "In[204]:=",ExpressionUUID->"a1d0e130-f750-46d2-85a0-1937fef177e1"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["symPower[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 ",",
 StyleBox["n_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 " and ",
 StyleBox["antiSymPower[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 ",",
 StyleBox["n_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.995017600825006*^9, 3.995017637213605*^9}, {
  3.995537595494857*^9, 
  3.995537599902238*^9}},ExpressionUUID->"4115edf5-7369-4f74-a213-\
aaaea56b5dae"],

Cell[TextData[{
 "For tensor-products of representations with themselves, these can be \
divided into ",
 StyleBox["symmetric ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "and ",
 StyleBox["anti-symmetric powers",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[".\n",
  FontSlant->"Italic"],
 "Of course, ",
 StyleBox["R",
  FontWeight->"Bold"],
 "\[CircleTimes]",
 StyleBox["R",
  FontWeight->"Bold"],
 "\[EqualTilde](",
 StyleBox["R",
  FontWeight->"Bold"],
 "\[Wedge]",
 StyleBox["R",
  FontWeight->"Bold"],
 ")\[CirclePlus](",
 StyleBox["R",
  FontWeight->"Bold"],
 "\[CircleDot]",
 StyleBox["R",
  FontWeight->"Bold"],
 ")"
}], "Text",
 CellChangeTimes->{{3.99044081656066*^9, 3.990440843523514*^9}, {
  3.995017646454039*^9, 
  3.995017683617646*^9}},ExpressionUUID->"383a8059-f6ed-4dd1-ae56-\
049073aab2fc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"spinor2Rep", "[", 
    RowBox[{"d", "[", "5", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"symPower", "[", 
  RowBox[{"egRep", ",", "2"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", 
  RowBox[{"dynkinLabel", "[", "%%", "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.990281955323938*^9, 3.990281964654092*^9}, {
  3.99028202548973*^9, 3.9902820257161903`*^9}, {3.990440847604665*^9, 
  3.990440863784676*^9}, {3.9930299795004187`*^9, 3.9930299840204077`*^9}, {
  3.993030075875699*^9, 3.993030076046783*^9}, {3.9930301208976393`*^9, 
  3.993030130474072*^9}},
 CellLabel->
  "In[209]:=",ExpressionUUID->"2cc91d51-fafe-4c71-a2bd-26786bca72a5"],

Cell[BoxData[{
 RowBox[{"antiSymPower", "[", 
  RowBox[{"egRep", ",", "2"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", 
  RowBox[{"dynkinLabel", "[", "%%", "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.990281971046*^9, 3.990281971779769*^9}, {
  3.990282027811873*^9, 3.990282028024057*^9}, {3.992687120281076*^9, 
  3.992687121040455*^9}, {3.993030136394598*^9, 3.993030139788368*^9}},
 CellLabel->
  "In[213]:=",ExpressionUUID->"11996a4f-e9a3-40ba-b8b5-36993bd7d3fb"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s check that ",
 StyleBox["R",
  FontWeight->"Bold"],
 "\[CircleTimes]",
 StyleBox["R",
  FontWeight->"Bold"],
 "\[EqualTilde](",
 StyleBox["R",
  FontWeight->"Bold"],
 "\[Wedge]",
 StyleBox["R",
  FontWeight->"Bold"],
 ")\[CirclePlus](",
 StyleBox["R",
  FontWeight->"Bold"],
 "\[CircleDot]",
 StyleBox["R",
  FontWeight->"Bold"],
 ")",
 StyleBox[" explicitly",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.9902824134329*^9, 3.9902824946944427`*^9}, {
  3.990871003159775*^9, 3.990871009729843*^9}, {3.995017687941383*^9, 
  3.995017692991475*^9}},ExpressionUUID->"4dd428b3-f4e2-4952-8965-\
d87cbb831acd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"spinor2Rep", "[", 
    RowBox[{"d", "[", "5", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fullProductRep", "=", 
   RowBox[{"repPower", "[", 
    RowBox[{"egRep", ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"productParts", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"antiSymPower", "[", 
     RowBox[{"egRep", ",", "2"}], "]"}], ",", 
    RowBox[{"symPower", "[", 
     RowBox[{"egRep", ",", "2"}], "]"}]}], "}"}]}]}], "Input",
 CellChangeTimes->{{3.990441027851595*^9, 3.9904410852385693`*^9}, 
   3.990801478054119*^9},
 CellLabel->
  "In[216]:=",ExpressionUUID->"13a045c4-d81e-4c60-8246-996e8d1739e1"],

Cell[BoxData[
 RowBox[{"similarityTransform", "=", 
  RowBox[{"findSimilarity", "[", 
   RowBox[{
    RowBox[{"repSum", "@@", "productParts"}], ",", "fullProductRep"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.99044109287317*^9, 3.990441118125435*^9}, {
  3.993030149359037*^9, 3.993030157912259*^9}},
 CellLabel->
  "In[219]:=",ExpressionUUID->"f85e2c95-9802-497b-9d9d-e22f9c5c3354"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " the similarity is ",
 StyleBox["not unique\[LongDash]",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "which is why there are undetermined parameters in the ",
 StyleBox["similarityTransform ",
  FontWeight->"Bold"],
 "array. "
}], "Text",
 CellChangeTimes->{{3.990441434588545*^9, 
  3.990441438627146*^9}},ExpressionUUID->"a16c305c-dcdd-44f2-889a-\
9e294bea003d"],

Cell[BoxData[
 RowBox[{"DeleteDuplicates", "@", 
  RowBox[{
  "similarityTransform", "[", "\"\<NonzeroValues\>\"", "]"}]}]], "Input",
 CellChangeTimes->{{3.990871023669362*^9, 3.990871034243394*^9}},
 CellLabel->
  "In[220]:=",ExpressionUUID->"ba18a441-081c-4d7f-93ea-90761134b2ee"],

Cell[TextData[{
 "Nevertheless\[LongDash]and for ",
 StyleBox["any",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " values of the undetermined parameters found above\[LongDash]we can verify \
that the two representations are related by ",
 StyleBox["similarity",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.995017713809833*^9, 
  3.995017754197135*^9}},ExpressionUUID->"1769eab4-fd37-450e-a28d-\
144be8a250d4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"inverse", "[", "similarityTransform", "]"}], ".", 
   RowBox[{"(", 
    RowBox[{"repSum", "@@", "productParts"}], ")"}], ".", 
   "similarityTransform"}], "-", "fullProductRep"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DeleteDuplicates", "[", 
   RowBox[{"%", "[", "\"\<NonzeroValues\>\"", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"DeleteDuplicates", "@", 
  RowBox[{"FullSimplify", "[", "%", "]"}]}]}], "Input",
 CellChangeTimes->{{3.990441138214013*^9, 3.9904411499224873`*^9}},
 CellLabel->
  "In[221]:=",ExpressionUUID->"fee4832d-111a-46cb-964f-a16bc5e19b26"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Decomposition of (",
 StyleBox["Tensor",
  FontWeight->"Bold"],
 "-)",
 StyleBox["Product",
  FontWeight->"Bold"],
 " ",
 StyleBox["Representations",
  FontWeight->"Bold"],
 " into (Quadratic-)",
 StyleBox["Casimir",
  FontWeight->"Bold"],
 "-",
 StyleBox["Eigenspaces",
  FontWeight->"Bold",
  FontSlant->"Italic"]
}], "Subsection",
 CellChangeTimes->{{3.990283334432983*^9, 3.9902833544862127`*^9}, {
  3.9927044875614843`*^9, 3.992704497145618*^9}, {3.995017768517748*^9, 
  3.995017776481946*^9}, {3.9951953645291023`*^9, 
  3.9951953654894114`*^9}},ExpressionUUID->"550a5ff3-9d8b-4517-8419-\
ac3d2a6c2ce7"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["productRepProjectors[",
  FontWeight->"Bold"],
 StyleBox["repR_,repS_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.995018078398439*^9, 3.9950180951041737`*^9}, {
  3.995195374464404*^9, 
  3.995195377339033*^9}},ExpressionUUID->"9c841b36-a654-48db-ab42-\
2340c1487706"],

Cell[TextData[{
 "The function ",
 StyleBox["productRepProjectors",
  FontWeight->"Bold"],
 " constructs for the ",
 StyleBox["productRep",
  FontWeight->"Bold"],
 " a ",
 StyleBox["List",
  FontWeight->"Bold"],
 " of the form \n",
 StyleBox["{",
  FontWeight->"Bold"],
 "{",
 "CasimirEigenspaceWeights},eigenSpaceReps,clebschTensor",
 StyleBox["}",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{
  3.9902833785230637`*^9, {3.990441168533444*^9, 3.990441264451517*^9}, {
   3.9950177909075603`*^9, 
   3.9950178039613123`*^9}},ExpressionUUID->"fbdab695-130c-4f10-98e5-\
6edeeb34b972"],

Cell[BoxData[{
 RowBox[{"egReps", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"adjointRep", "[", 
     RowBox[{"g", "[", "2", "]"}], "]"}], ",", 
    RowBox[{"fundamentalRep", "[", 
     RowBox[{"g", "[", "2", "]"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"egProduct", "=", 
  RowBox[{"productRep", "@@", "egReps"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.993030180399909*^9, 3.9930301951484327`*^9}},
 CellLabel->
  "In[224]:=",ExpressionUUID->"e51b0ece-9c3a-429b-ae30-660b4f7d2d3b"],

Cell[BoxData[{
 RowBox[{"projectionData", "=", 
  RowBox[{"productRepProjectors", "@@", "egReps"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "/@", "%"}]}], "Input",
 CellLabel->
  "In[228]:=",ExpressionUUID->"d6947f19-8a54-4897-83fb-4897f5e7b8e3"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["fromClebschToProjector[",
  FontWeight->"Bold"],
 StyleBox["clebsch_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.995195704696806*^9, 
  3.995195722284984*^9}},ExpressionUUID->"bc4bcbd9-e09c-4b8b-bda8-\
a15a9f5a37d8"],

Cell[TextData[{
 "The \[OpenCurlyDoubleQuote]big\[CloseCurlyDoubleQuote] projectors ",
 StyleBox["P ",
  FontWeight->"Bold"],
 "on the product representation are generated from the Clebsches via ",
 StyleBox["fromClebschToProjector",
  FontWeight->"Bold"],
 " "
}], "Text",
 CellChangeTimes->{
  3.9951957411676903`*^9},ExpressionUUID->"e454dc29-715a-4556-8ef8-\
7bed466fdcfd"],

Cell[BoxData[{
 RowBox[{"fromClebschToProjector", "/@", 
  RowBox[{"projectionData", "[", 
   RowBox[{"[", 
    RowBox[{"All", ",", 
     RowBox[{"-", "1"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Tr", "/@", "%"}]}], "Input",
 CellLabel->
  "In[230]:=",ExpressionUUID->"dae1ee3b-abd3-466a-b472-1d5a4eb439bb"],

Cell[TextData[{
 "So dotting with the \[OpenCurlyDoubleQuote]big ",
 StyleBox["P",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote] projectors on the Left/Right sides gives (large \
generator matrices for representations) isomorphic to eigen-subspace \
representations"
}], "Text",
 CellChangeTimes->{{3.986204238492056*^9, 3.986204293332446*^9}, {
  3.990441296358852*^9, 
  3.9904413099374638`*^9}},ExpressionUUID->"6a318a24-763e-4f4d-a122-\
895a8dab191e"],

Cell[BoxData[{
 RowBox[{"largeProductSubspaces", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"dot", "[", 
     RowBox[{"#", ",", "egProduct", ",", "#"}], "]"}], "&"}], "/@", 
   RowBox[{"fromClebschToProjector", "/@", 
    RowBox[{"projectionData", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", 
       RowBox[{"-", "1"}]}], "]"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"inducedAdjoint", "[", "#", "]"}], "==", 
    RowBox[{"inducedAdjoint", "[", 
     RowBox[{"egReps", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "&"}], "/@", "%"}]}], "Input",
 CellChangeTimes->{{3.986204008938521*^9, 3.986204083229553*^9}, 
   3.986204225184483*^9, {3.990441352698996*^9, 3.990441373380315*^9}},
 CellLabel->
  "In[232]:=",ExpressionUUID->"dc4731eb-4306-4ca1-a122-c940993cf6e6"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["fromClebschToLRprojectors[",
  FontWeight->"Bold"],
 StyleBox["clebsch_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.995195747589972*^9, 
  3.9951957599656057`*^9}},ExpressionUUID->"da4b4432-b20d-4c97-962f-\
679fd328576f"],

Cell[TextData[{
 "To project into the ",
 StyleBox["lower",
  FontWeight->"Bold"],
 "-",
 StyleBox["sized",
  FontWeight->"Bold"],
 " ",
 StyleBox["matrices",
  FontWeight->"Bold"],
 "/representations, we can use ",
 StyleBox["fromClebschToLRprojectors",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{
  3.9951957669670143`*^9},ExpressionUUID->"c5c8f766-ba29-4578-867f-\
e0fa2c700734"],

Cell[BoxData[{
 RowBox[{"fromClebschToLRprojectors", "/@", 
  RowBox[{"projectionData", "[", 
   RowBox[{"[", 
    RowBox[{"All", ",", 
     RowBox[{"-", "1"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"reducedSubspaceRepresentations", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"dot", "[", 
     RowBox[{"#1", ",", "egProduct", ",", "#2"}], "]"}], "&"}], "@@@", 
   "%"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "@", "%"}]}], "Input",
 CellChangeTimes->{{3.986204324954649*^9, 3.9862044040181007`*^9}, {
   3.990441399880105*^9, 3.9904414009916*^9}, 3.993030265789063*^9},
 CellLabel->
  "In[234]:=",ExpressionUUID->"6cd81526-69b2-4f61-9072-223c356f4a6e"],

Cell[TextData[{
 "These reduced subspace representations are exactly those of given in the \
second positions of the output of ",
 StyleBox["productRepProjectors",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.986204410827259*^9, 3.9862044212511063`*^9}, {
  3.9862044937209673`*^9, 
  3.98620451213426*^9}},ExpressionUUID->"a5b3512c-d7a6-4b37-943c-\
dd1d169ff1de"],

Cell[BoxData[
 RowBox[{"SparseArray", "/@", 
  RowBox[{"(", 
   RowBox[{"reducedSubspaceRepresentations", "-", 
    RowBox[{"projectionData", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.986204408556753*^9, 3.986204408718267*^9}},
 CellLabel->
  "In[237]:=",ExpressionUUID->"76a07f56-9bb5-476d-b1b6-d840d05c2a3a"],

Cell[TextData[{
 "We can check that the straight-product is ",
 StyleBox["similar to",
  FontWeight->"Bold"],
 " the ",
 StyleBox["sum",
  FontWeight->"Bold"],
 " of the ",
 StyleBox["eigenspace representations",
  FontWeight->"Bold"],
 " by checking:"
}], "Text",
 CellChangeTimes->{{3.986204715892148*^9, 
  3.986204742692569*^9}},ExpressionUUID->"b2b339b5-3691-432e-bb7b-\
98078d99fb5c"],

Cell[BoxData[{
 RowBox[{"directProdToSubspaceSumSimilarity", "=", 
  RowBox[{"findSimilarity", "[", 
   RowBox[{"egProduct", ",", 
    RowBox[{"repSum", "@@", "reducedSubspaceRepresentations"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nice", "[", "%", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9862046595921507`*^9, 3.986204683406324*^9}, {
  3.9862047473301*^9, 3.986204761863315*^9}, {3.9902834750671053`*^9, 
  3.990283482949263*^9}},
 CellLabel->
  "In[238]:=",ExpressionUUID->"1cf62f98-bd9f-42be-8733-b9cf9d464b39"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " the similarity is ",
 StyleBox["not unique\[LongDash]",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "which is why there are undetermined parameters in the ",
 StyleBox["directProdToSubspaceSumSimilarity ",
  FontWeight->"Bold"],
 "array. "
}], "Text",
 CellChangeTimes->{{3.990283486096838*^9, 
  3.990283515731329*^9}},ExpressionUUID->"5b8290ed-ec5c-427e-85b1-\
3a4a36057ffe"],

Cell[BoxData[
 RowBox[{"DeleteDuplicates", "[", 
  RowBox[{
  "directProdToSubspaceSumSimilarity", "[", "\"\<NonzeroValues\>\"", "]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.995017845528202*^9, 3.9950178529656897`*^9}},
 CellLabel->
  "In[240]:=",ExpressionUUID->"d723bd27-b658-4019-a456-fdd5e3eae3b7"],

Cell[TextData[{
 "Nevertheless\[LongDash]and for ",
 StyleBox["any",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " values of the undetermined parameters found above\[LongDash]we can verify \
that the two representations are related by ",
 StyleBox["similarity",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.995017859389101*^9, 
  3.99501788201223*^9}},ExpressionUUID->"23baecdd-c7a4-4c13-8b39-\
001ec91e48a9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dot", "[", 
    RowBox[{
     RowBox[{"inverse", "[", "#", "]"}], ",", "egProduct", ",", "#"}], "]"}], 
   "&"}], "@", "directProdToSubspaceSumSimilarity"}], "\[IndentingNewLine]", 
 RowBox[{"Equal", "[", 
  RowBox[{"%", ",", 
   RowBox[{"(", 
    RowBox[{"repSum", "@@", "reducedSubspaceRepresentations"}], ")"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.98620477435842*^9, 3.9862048267184877`*^9}},
 CellLabel->
  "In[241]:=",ExpressionUUID->"0b4df6b2-a6b6-4b8a-a9fc-48430b584c02"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " these subspaces need not be ",
 StyleBox["Irreducible representations",
  FontWeight->"Bold"],
 " (and can have arbitrary multiplicity). \n\nFor example appearing in ",
 StyleBox["ad[a[3]]^2",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.9862044613141327`*^9, 3.986204476143298*^9}, {
  3.9904414559898443`*^9, 3.990441470233376*^9}, {3.995017891760853*^9, 
  3.995017966771976*^9}},ExpressionUUID->"87abc73b-2ad4-49f4-9451-\
97a254cbc4d1"],

Cell[BoxData[{
 RowBox[{"tensorPowerDecomposition", "[", 
  RowBox[{
   RowBox[{"ad", "[", 
    RowBox[{"a", "[", "3", "]"}], "]"}], ",", "2"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.995017936180271*^9, 3.995017951774497*^9}},
 CellLabel->
  "In[243]:=",ExpressionUUID->"a7e6f61b-119c-4fd8-b7e8-46bb5122b89b"],

Cell[TextData[{
 "are the (conjugate) pairs of irreps with Dynkin labels w[a][0,1,2] and \
w[a][2,1,0]. These have ",
 StyleBox["identical",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " quadratic-Casimir eigenvalues:"
}], "Text",
 CellChangeTimes->{{3.9950179698549623`*^9, 
  3.9950180050485163`*^9}},ExpressionUUID->"e6117610-b2d9-420d-a151-\
120d0637c531"],

Cell[BoxData[
 RowBox[{"casimirEigenvalue", "/@", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"w", "[", "a", "]"}], "[", 
     RowBox[{"0", ",", "1", ",", "2"}], "]"}], ",", 
    RowBox[{
     RowBox[{"w", "[", "a", "]"}], "[", 
     RowBox[{"2", ",", "1", ",", "0"}], "]"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.995018007147702*^9, 3.995018020721438*^9}},
 CellLabel->
  "In[245]:=",ExpressionUUID->"0a54722c-f875-4756-9ddc-9a05b4c149db"],

Cell[TextData[{
 "As such, the ",
 StyleBox["projectors",
  FontWeight->"Bold"],
 " being constructed as in above cannot differentiate between these \
subspaces, and only can project into the ",
 StyleBox["repSum",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.995018024372335*^9, 
  3.995018051343948*^9}},ExpressionUUID->"e15a6af7-7626-484c-9602-\
986a919120b4"],

Cell[BoxData[{
 RowBox[{"productRepProjectors", "[", 
  RowBox[{
   RowBox[{"adjointRep", "[", 
    RowBox[{"a", "[", "3", "]"}], "]"}], ",", 
   RowBox[{"adjointRep", "[", 
    RowBox[{"a", "[", "3", "]"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "/@", 
  RowBox[{"%", "[", 
   RowBox[{"[", 
    RowBox[{"All", ",", 
     RowBox[{"1", ";;", "2"}]}], "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.986204424954303*^9, 3.986204455214768*^9}},
 CellLabel->
  "In[246]:=",ExpressionUUID->"100a4413-57db-4aca-8c76-218851ac7f47"]
}, Closed]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Assessing",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 0.4238040741588464]],
 " ",
 StyleBox["Aspects",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of Concrete Representations"
}], "Section",
 CellChangeTimes->{{3.990282899856368*^9, 
  3.99028296729239*^9}},ExpressionUUID->"71fb035a-f7ed-4897-a2d3-\
241d03138d91"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Characterizations",
  FontWeight->"Bold"],
 " of Concrete Representations"
}], "Subsection",
 CellChangeTimes->{{3.9902829782057962`*^9, 3.990282982024789*^9}, {
  3.990283086009467*^9, 3.990283103183826*^9}, {3.99078171327562*^9, 
  3.990781724098853*^9}, {3.990801988903645*^9, 
  3.9908019899586163`*^9}},ExpressionUUID->"2447035f-52e2-47af-a3ad-\
fa001e1c18be"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["representationAlgebra[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.995101185716545*^9, 
  3.995101190908329*^9}},ExpressionUUID->"7e99b44d-8df9-402d-9f0e-\
3473bac9c4cc"],

Cell[TextData[{
 "For any representation (generated using this package), the standard name \
for the simple Lie algebra for which it is a representation may be returned \
by ",
 StyleBox["representationAlgebra[]",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.995101194493569*^9, 
  3.995101228446973*^9}},ExpressionUUID->"f13dbac6-e630-4c3a-b3d1-\
9c8458c58f18"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"RandomChoice", "[", 
    RowBox[{"fundamentalRep", "/@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "[", "6", "]"}], ",", 
       RowBox[{"b", "[", "5", "]"}], ",", 
       RowBox[{"d", "[", "8", "]"}], ",", 
       RowBox[{"e", "[", "7", "]"}], ",", 
       RowBox[{"g", "[", "2", "]"}], ",", 
       RowBox[{"f", "[", "4", "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"representationAlgebra", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.995101240533584*^9, 3.995101270910589*^9}},
 CellLabel->
  "In[248]:=",ExpressionUUID->"95f2924f-9023-4eee-9e03-c6cc4b0d3a0a"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["representationDimension[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.995018452429051*^9, 
  3.995018459068287*^9}},ExpressionUUID->"9d272b99-6ae1-4d77-963c-\
5d8e1a702c0b"],

Cell[TextData[{
 "The ",
 StyleBox["dimension ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "of a representation is simply the size of its generators\[LongDash]or the \
extent/range of its ",
 StyleBox["First[Dimensions[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]]:",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.995018462854351*^9, 
  3.995018510588464*^9}},ExpressionUUID->"8f07a08b-13ec-42d4-87f6-\
707f48273b67"],

Cell[BoxData[{
 RowBox[{"productRep", "[", 
  RowBox[{
   RowBox[{"fundamentalRep", "[", 
    RowBox[{"d", "[", "4", "]"}], "]"}], ",", 
   RowBox[{"spinor2Rep", "[", 
    RowBox[{"d", "[", "4", "]"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"representationDimension", "[", "%%", "]"}]}], "Input",
 CellChangeTimes->{{3.9950185159912043`*^9, 3.9950185322556458`*^9}},
 CellLabel->
  "In[250]:=",ExpressionUUID->"0ceee9e8-91e3-4bca-bff3-b0b0825f230e"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["irreducibleRepresentationQ[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.9902831075640297`*^9, 3.990283114700728*^9}, {
  3.9949413141923313`*^9, 
  3.994941314560457*^9}},ExpressionUUID->"a9d9ff1d-bb9d-4536-a0bb-\
292b958afa5f"],

Cell[TextData[{
 "For a representation in the Chevalley basis, the generators of the Cartan \
sub-algebra are diagonal with entries corresponding to the weights of the \
representation\[CloseCurlyQuote]s lattice. The highest weight of this lattice \
is always ",
 StyleBox["a",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " highest weight, and it is easy to check if the dimension of the \
representation (its size) matches that of the irreducible representation \
labelled by this highest weight\[LongDash]thus testing irreducibility. "
}], "Text",
 CellChangeTimes->{{3.994941321164247*^9, 3.994941472873476*^9}, 
   3.995195821229738*^9},ExpressionUUID->"cd56506d-9575-42c7-b810-\
0d65f4744984"],

Cell[BoxData[{
 RowBox[{"egRep", "=", 
  RowBox[{"symPower", "[", 
   RowBox[{
    RowBox[{"fundamentalRep", "[", 
     RowBox[{"f", "[", "4", "]"}], "]"}], ",", "2"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"irreducibleRepresentationQ", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"dynkinLabel", "[", "egRep", "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.9902836995019817`*^9, 3.990283711234057*^9}, {
  3.992687250867482*^9, 3.992687259456246*^9}},
 CellLabel->
  "In[253]:=",ExpressionUUID->"e848b7de-302f-4cf0-8cd9-718feea7dc35"],

Cell[BoxData[{
 RowBox[{"egRep", "=", 
  RowBox[{"antiSymPower", "[", 
   RowBox[{
    RowBox[{"fundamentalRep", "[", 
     RowBox[{"e", "[", "6", "]"}], "]"}], ",", "2"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"irreducibleRepresentationQ", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"dynkinLabel", "[", "egRep", "]"}]}], "Input",
 CellChangeTimes->{{3.99051771667372*^9, 3.9905177366517057`*^9}, {
  3.992687265635634*^9, 3.992687265868025*^9}, {3.994941486097329*^9, 
  3.994941486253789*^9}},
 CellLabel->
  "In[258]:=",ExpressionUUID->"20c6a8cb-d390-4ba6-8cd2-6e3fcb28d5df"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["realRepresentationQ[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.990283129733198*^9, 3.990283136774905*^9}, {
  3.995018636200498*^9, 
  3.995018636709746*^9}},ExpressionUUID->"a8eccb5a-1889-4474-9230-\
6dc4a100eedf"],

Cell["\<\
The reality of a representation in the canonical Chevalley Basis can be \
tested simply by assessing if its weight lattice is self-similar. \
\>", "Text",
 CellChangeTimes->{{3.994941629109078*^9, 
  3.994941672682784*^9}},ExpressionUUID->"d22e1035-8eea-4944-8382-\
cb9a5d100c1b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"repPower", "[", 
    RowBox[{
     RowBox[{"fundamentalRep", "[", 
      RowBox[{"f", "[", "4", "]"}], "]"}], ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"realRepresentationQ", "[", "egRep", "]"}]}], "Input",
 CellChangeTimes->{{3.9902837203675528`*^9, 3.9902837249278393`*^9}, {
  3.990283842661084*^9, 3.9902838432046824`*^9}, {3.990284091139439*^9, 
  3.990284099385417*^9}},
 CellLabel->
  "In[262]:=",ExpressionUUID->"25183e02-c403-44e0-8746-52f0c499134c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Sort", "[", "#", "]"}], "===", 
    RowBox[{"Sort", "[", 
     RowBox[{"-", "#"}], "]"}]}], "&"}], "@", 
  RowBox[{"Normal", "[", 
   RowBox[{"representationRoots", "@", "egRep"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.994941676762129*^9, 3.994941735498611*^9}, {
  3.9957006394899397`*^9, 3.995700640642665*^9}},
 CellLabel->
  "In[265]:=",ExpressionUUID->"0e60dafa-22d0-4a02-892c-cea533c20abd"],

Cell["For another example, ", "Text",
 CellChangeTimes->{{3.9951958347016573`*^9, 
  3.99519583715476*^9}},ExpressionUUID->"70478272-2d35-41c6-a02d-\
ee19814006b8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"repPower", "[", 
    RowBox[{
     RowBox[{"fundamentalRep", "[", 
      RowBox[{"a", "[", "4", "]"}], "]"}], ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"realRepresentationQ", "[", "egRep", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Sort", "[", "#", "]"}], "===", 
    RowBox[{"Sort", "[", 
     RowBox[{"-", "#"}], "]"}]}], "&"}], "@", 
  RowBox[{"Normal", "[", 
   RowBox[{"representationRoots", "@", "egRep"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.995028916988776*^9, 3.995028926627432*^9}, {
  3.995700644409052*^9, 3.9957006456334343`*^9}},
 CellLabel->
  "In[266]:=",ExpressionUUID->"a5f12f14-ae5f-4037-9c45-d0ae0f513c01"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["pseudoRealRepesentationQ[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.990283142850222*^9, 3.990283153350273*^9}, {
  3.995018639158329*^9, 3.995018639678851*^9}},
 FontWeight->"Plain",ExpressionUUID->"61883778-83f9-414a-a9f6-71f8912fe0dc"],

Cell[TextData[{
 "As described above, an irreducible representation is ",
 StyleBox["pseudoReal",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " if it is ",
 StyleBox["real",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " and if the trivial representation, \[LineSeparator]",
 StyleBox["1",
  FontWeight->"Bold"],
 " is contained within the ",
 StyleBox["anti-symmetric second-tensor-power ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "of the representation \[LineSeparator](and ",
 StyleBox["not pseudoReal",
  FontWeight->"Bold"],
 " if it is either ",
 StyleBox["not real ",
  FontWeight->"Bold"],
 StyleBox["or",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " if ",
 StyleBox["1",
  FontWeight->"Bold"],
 " is contained with the ",
 StyleBox["symmetric",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " second-tensor-power of the representation)."
}], "Text",
 CellChangeTimes->{{3.994941746172312*^9, 
  3.994941911717723*^9}},ExpressionUUID->"6d00afef-b6a4-4a1f-8b9a-\
43cfc1ed0394"],

Cell[BoxData[{
 RowBox[{"egReps", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"fundamentalRep", "[", 
     RowBox[{
      RowBox[{"c", "[", "4", "]"}], ",", "#"}], "]"}], "&"}], "/@", 
   RowBox[{"Range", "[", "4", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"pseudoRealRepresentationQ", "/@", "%%"}]}], "Input",
 CellChangeTimes->{{3.990283854096143*^9, 3.990283896614039*^9}, {
  3.99268729273621*^9, 3.992687297324562*^9}, {3.9950289514720716`*^9, 
  3.995028952433936*^9}},
 CellLabel->
  "In[270]:=",ExpressionUUID->"aac9c566-efbe-464e-920b-4cebfe2548da"],

Cell[TextData[{
 "We can verify that this coheres with the definition given above that ",
 StyleBox["pseudoReal",
  FontWeight->"Bold"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "representations are those for which \n",
 StyleBox["R\[Wedge]R\[Superset]1",
  FontWeight->"Bold"],
 " (while ",
 StyleBox["real",
  FontWeight->"Bold"],
 " but ",
 StyleBox["not pseudoReal",
  FontWeight->"Bold"],
 " representations are such that ",
 StyleBox["R\[CircleDot]R\[Superset]1",
  FontWeight->"Bold"],
 ") by checking whether\n the symmetric or anti-symmetric second power of \
these reps contains a trivial representation. \n \n Any (not necessarily \
irreducible) representation which contains at least one copy of the trivial \
representation ",
 StyleBox["1",
  FontWeight->"Bold"],
 " will have 0 as an eigenvalue of its quadratic ",
 StyleBox["Casimir",
  FontWeight->"Bold"],
 "\[LongDash]which is easily checked by taking its determinant:"
}], "Text",
 CellChangeTimes->{{3.990703616049563*^9, 3.9907038510884457`*^9}, 
   3.994942293736828*^9},ExpressionUUID->"3ce73ca8-a47b-4cc4-b79d-\
bb7ec00371b7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"casimirC2", "[", 
     RowBox[{"antiSymPower", "[", 
      RowBox[{"#", ",", "2"}], "]"}], "]"}], "&"}], "/@", "egReps"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Det", "[", "#", "]"}], "==", "0"}], "&"}], "/@", 
  "%%"}]}], "Input",
 CellChangeTimes->{{3.99494237052514*^9, 3.994942399830908*^9}},
 CellLabel->
  "In[273]:=",ExpressionUUID->"a99f85ec-5b78-4e18-a74a-84f2a7b77781"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"casimirC2", "[", 
     RowBox[{"symPower", "[", 
      RowBox[{"#", ",", "2"}], "]"}], "]"}], "&"}], "/@", "egReps"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Det", "[", "#", "]"}], "==", "0"}], "&"}], "/@", 
  "%%"}]}], "Input",
 CellChangeTimes->{3.994942406170109*^9},
 CellLabel->
  "In[276]:=",ExpressionUUID->"3f50528f-ac06-4e72-9994-471735ae4c05"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["dynkinLabel[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.99028298925708*^9, 3.99028300286012*^9}, 
   3.99028316608501*^9, {3.9949302408323717`*^9, 
   3.9949302413508863`*^9}},ExpressionUUID->"a84054dc-1cbc-4de0-9acb-\
e20c57dcaeb8"],

Cell[TextData[{
 "Given any concrete, ",
 StyleBox["not necessarily irreducible ",
  FontSlant->"Italic"],
 "representation constructed using tensor products, sums, etc. as above,\nits \
",
 StyleBox["decomposition into powers of irreducible representations",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " will be returned by the function ",
 StyleBox["dynkinLabel[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.994930227583372*^9, 3.9949302474621363`*^9}, {
  3.994930298822377*^9, 
  3.9949304039681673`*^9}},ExpressionUUID->"e9d687cc-83e9-4bb8-bb79-\
fadeb1877cfc"],

Cell["For example, for any representation of fundamental weight, ", "Text",
 CellChangeTimes->{{3.9949304276988277`*^9, 
  3.9949304515687237`*^9}},ExpressionUUID->"4552b74d-31d2-4117-ad69-\
2a87bd1d2d8c"],

Cell[BoxData[{
 RowBox[{"fundamentalRep", "[", 
  RowBox[{
   RowBox[{"e", "[", "6", "]"}], ",", "3"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"dynkinLabel", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%%", "]"}], ",", 
   RowBox[{"nice", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.994930265769414*^9, 3.994930282581708*^9}, {
  3.994930409354537*^9, 3.9949304112723713`*^9}},
 CellLabel->
  "In[279]:=",ExpressionUUID->"2ad7ebfb-3f23-4c42-9dce-7db363232ed4"],

Cell[BoxData[{
 RowBox[{"antiSymPower", "[", 
  RowBox[{
   RowBox[{"fundamentalRep", "[", 
    RowBox[{"a", "[", "4", "]"}], "]"}], ",", "2"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"dynkinLabel", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%%", "]"}], ",", 
   RowBox[{"nice", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.99493045855849*^9, 3.9949304740863333`*^9}},
 CellLabel->
  "In[282]:=",ExpressionUUID->"f8a438e8-6b7e-4ac6-95c8-27f0eee66c47"],

Cell["\<\
The function also works on irreducible representations, providing the full \
decomposition into irreducible representations:\
\>", "Text",
 CellChangeTimes->{{3.9949304923010798`*^9, 
  3.994930523858136*^9}},ExpressionUUID->"8d826110-11e8-4adf-89f6-\
cf650a2f4d6e"],

Cell[BoxData[{
 RowBox[{"egRep", "=", 
  RowBox[{"productRep", "[", 
   RowBox[{
    RowBox[{"fundamentalRep", "[", 
     RowBox[{"g", "[", "2", "]"}], "]"}], ",", 
    RowBox[{"antiSymPower", "[", 
     RowBox[{
      RowBox[{"adjointRep", "[", 
       RowBox[{"g", "[", "2", "]"}], "]"}], ",", "2"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"dynkinLabel", "[", "egRep", "]"}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.9905176700743437`*^9, 3.990517693764785*^9}, {
  3.9926176367214317`*^9, 3.992617639630331*^9}, {3.995195888715983*^9, 
  3.9951959079029493`*^9}},
 CellLabel->
  "In[285]:=",ExpressionUUID->"1fc986c8-dd50-4f92-b63a-794ccd0d50b4"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["dykinIndex[",
  FontWeight->"Bold"],
 StyleBox["rep_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.990283304259598*^9, 3.990283310071443*^9}, {
  3.9949413046271353`*^9, 
  3.994941304776411*^9}},ExpressionUUID->"1d15226f-fa04-4054-b526-\
f3b0784c8257"],

Cell[TextData[{
 "The ",
 StyleBox["Dynkin index",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 StyleBox["T(R) ",
  FontWeight->"Bold"],
 "of a representation is defined via \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["tr", 
      StyleBox["R",
       FontWeight->"Bold"]], "[", 
     RowBox[{"a", ",", "b"}], "]"}], "=", 
    RowBox[{":", 
     RowBox[{
      RowBox[{
       StyleBox["T",
        FontSlant->"Plain"], "(", 
       StyleBox["R",
        FontWeight->"Bold",
        FontSlant->"Plain"], ")"}], 
      SuperscriptBox["k", "ab"]}]}]}], TraditionalForm]],ExpressionUUID->
  "79438bf3-ed32-458f-bafa-0691ab0aeb79"]
}], "Text",
 CellChangeTimes->{{3.9904448571384*^9, 
  3.990444940653007*^9}},ExpressionUUID->"29928c5b-8f30-49da-9837-\
de1e55c43a61"],

Cell[BoxData[{
 RowBox[{"egRep", "=", 
  RowBox[{"repPower", "[", 
   RowBox[{
    RowBox[{"fundamentalRep", "[", 
     RowBox[{"f", "[", "4", "]"}], "]"}], ",", "2"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"dynkinIndex", "[", "%%", "]"}]}], "Input",
 CellChangeTimes->{{3.990283598685485*^9, 3.990283650464529*^9}},
 CellLabel->
  "In[289]:=",ExpressionUUID->"28226271-3b7f-458e-b305-3e206c11e511"],

Cell[BoxData[
 RowBox[{"Equal", "[", 
  RowBox[{
   RowBox[{"repTrace", "[", 
    RowBox[{"egRep", ",", "2"}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"dynkinIndex", "[", "egRep", "]"}], 
     RowBox[{"killingMetric", "[", 
      RowBox[{"representationAlgebra", "[", "egRep", "]"}], "]"}]}], ")"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9902836537187757`*^9, 3.990283689238783*^9}, {
  3.992617918869639*^9, 3.9926179208410378`*^9}, {3.993309553554885*^9, 
  3.993309565863098*^9}},
 CellLabel->
  "In[292]:=",ExpressionUUID->"9de37edc-39b6-40a0-a5e1-f6bbfd89520b"],

Cell[TextData[{
 "Related to this fact, is that the ",
 StyleBox["Structure Constants ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "may be defined in terms of the ",
 StyleBox["Trace",
  FontWeight->"Bold"],
 " over ",
 StyleBox["any",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " (not necessarily irreducible) representation via the ",
 StyleBox["dynkinIndex",
  FontWeight->"Bold"],
 " as in "
}], "Text",
 CellChangeTimes->{{3.99510113089142*^9, 3.995101158212798*^9}, {
  3.99510389886444*^9, 3.995103917301201*^9}, {3.995104865811804*^9, 
  3.9951049307502003`*^9}},ExpressionUUID->"d083cba6-e951-42f4-a9f1-\
f05dc2a487ad"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"structureConstantIdentity", "=", 
   RowBox[{
    RowBox[{"ddmTensor", "[", 
     RowBox[{"1", ",", "2", ",", "3"}], "]"}], "==", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"dynkinIndex", "[", "R", "]"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"trR", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}], "-", 
       RowBox[{"trR", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1", ",", "3"}], "}"}], "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
