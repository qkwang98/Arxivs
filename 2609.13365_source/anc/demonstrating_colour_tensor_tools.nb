  3.987078792638468*^9}},ExpressionUUID->"25d0b23a-858a-48fb-9e81-\
93e6e532b02f"],

Cell[TextData[{
 "Consider for example the ",
 StyleBox["Fundamental",
  FontWeight->"Bold"],
 " representation of ",
 StyleBox["f[4]",
  FontWeight->"Bold"],
 ":",
 " "
}], "Text",
 CellChangeTimes->{{3.992618827019177*^9, 
  3.99261883898193*^9}},ExpressionUUID->"c0b6238c-c887-460c-9611-\
b9efb72235da"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egRep", "=", 
   RowBox[{"fundamentalRep", "[", 
    RowBox[{"f", "[", "4", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.992618841721179*^9, 3.992618842553273*^9}, {
  3.992686457977139*^9, 3.992686460523823*^9}, {3.992686781155851*^9, 
  3.992686781884631*^9}, {3.99295213360977*^9, 3.9929521540194902`*^9}, {
  3.992952280400655*^9, 3.992952282578302*^9}, {3.995016972488103*^9, 
  3.995016998181118*^9}},
 CellLabel->
  "In[116]:=",ExpressionUUID->"09c1480c-1153-41d4-9910-3eb5c9d3a897"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egInducedAdjoint", "=", 
   RowBox[{"inducedAdjoint", "[", "egRep", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"nice", "[", "%", "]"}], ",", 
   RowBox[{"drawTensors", "[", "%", "]"}]}], "}"}]}], "Input",
