   3.990870254192046*^9}, {3.992618882039336*^9, 3.992618885687488*^9}, 
   3.992683741519128*^9, {3.992686806217417*^9, 3.992686811547379*^9}, {
   3.993309096267324*^9, 3.9933091075701857`*^9}, {3.994846511423255*^9, 
   3.994846511782237*^9}},
 CellLabel->
  "In[125]:=",ExpressionUUID->"a904ec95-2e82-4bce-b3c3-438b5b78839c"],

Cell["\<\
And we may encode all the components of the right-hand-side similarly:\
\>", "Text",
 CellChangeTimes->{{3.990279810550147*^9, 
  3.990279833212228*^9}},ExpressionUUID->"38c4b0aa-2406-4c4e-87d9-\
a907b9412510"],

Cell[BoxData[{
 RowBox[{"dot", "[", 
  RowBox[{
   RowBox[{"inducedAdjoint", "[", "egRep", "]"}], ",", 
   RowBox[{"Transpose", "[", "egRep", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"drawTensors", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.995106052306425*^9, 3.995106055073975*^9}, {
  3.9953763123816757`*^9, 3.9953763137275143`*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"7ff9bf11-94ac-4774-9d6b-36a2c8b6d05d"],

Cell[TextData[{
 "Notice that this has a different ",
 StyleBox["SlotSequence",
  FontWeight->"Bold"],
 " relative to the commutator tensor above"
}], "Text",
 CellChangeTimes->{{3.9951064950492*^9, 
  3.9951065098398457`*^9}},ExpressionUUID->"6bc90518-7388-4e19-8a4e-\
2a18eca6d003"],

Cell[BoxData[{
 RowBox[{"fDotTtensor", "=", 
  RowBox[{"Transpose", "[", 
   RowBox[{
    RowBox[{"dot", "[", 
     RowBox[{"egInducedAdjoint", ",", 
      RowBox[{"Transpose", "[", "egRep", "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3", ",", "1", ",", "4"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
