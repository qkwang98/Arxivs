Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " the function ",
 StyleBox["representationDimension ",
  FontWeight->"Bold"],
 "can also be provided arguments consisting of the ",
 StyleBox["irreducible-representation decomposition",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " of non-irreducible representations."
}], "Text",
 CellChangeTimes->{{3.99070263832314*^9, 
  3.990702698532782*^9}},ExpressionUUID->"18fe60ac-596d-4b3b-9b79-\
045e6bed673c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"egIrrep", "=", 
   RowBox[{"ad", "[", 
    RowBox[{"e", "[", "6", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"egReducibleRep", "=", 
  RowBox[{"tensorPowerDecomposition", "[", 
   RowBox[{"egIrrep", ",", "4"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"nice", "[", "%", "]"}], "\[IndentingNewLine]", 
 RowBox[{"representationDimension", "[", "egReducibleRep", "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "===", 
  RowBox[{"Power", "[", 
   RowBox[{
    RowBox[{"representationDimension", "[", "egIrrep", "]"}], ",", "4"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"egReducibleRep", "/.", 
  RowBox[{
   RowBox[{
    RowBox[{"w", "[", "e_", "]"}], "[", "label__", "]"}], ":>", 
   RowBox[{"representationDimension", "[", 
    RowBox[{
     RowBox[{"w", "[", "e", "]"}], "[", "label", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "/.", 
   RowBox[{"times", "->", "Times"}]}], "/.", 
  RowBox[{"plus", "->", "Plus"}]}]}], "Input",
 CellChangeTimes->{{3.990702714817144*^9, 3.9907028033195963`*^9}, {
  3.9948460104016943`*^9, 3.994846080813855*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"4d55c07d-c6c0-4c0b-b16e-6dd24ea4ec5f"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["conjugateRep[",
  FontWeight->"Bold"],
 StyleBox["dynkinLabel_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
 CellChangeTimes->{{3.990702041931031*^9, 3.990702052877726*^9}, 
   3.993308322816024*^9, 
   3.99501678982716*^9},ExpressionUUID->"5fab641e-7c5f-40cc-9722-\
415a92c3b562"],

Cell[TextData[{
 "Lie algebras ",
 StyleBox["a[",
  FontWeight->"Bold"],
 StyleBox["k_",
  FontSlant->"Italic"],
 StyleBox["] ",
  FontWeight->"Bold"],
 "(with ",
 StyleBox["k",
  FontSlant->"Italic"],
 ">1), ",
 StyleBox["d[",
  FontWeight->"Bold"],
 StyleBox["k_",
  FontSlant->"Italic"],
 StyleBox["] ",
  FontWeight->"Bold"],
 "(for ",
 StyleBox["odd",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "-",
 StyleBox["k",
  FontSlant->"Italic"],
 ") and ",
 StyleBox["e[",
  FontWeight->"Bold"],
 "6",
 StyleBox["]",
  FontWeight->"Bold"],
 " admit a ",
 StyleBox["non-trivial",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " automorphism called \[OpenCurlyDoubleQuote]",
 StyleBox["conjugation",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] \nwhich maps irreducible representations to other \
irreducible representations. "
}], "Text",
