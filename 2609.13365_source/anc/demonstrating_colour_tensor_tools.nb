 StyleBox["representationWeights[",
  FontWeight->"Bold"],
 StyleBox["dynkinLabel_",
  FontSlant->"Italic"],
 StyleBox["] ",
  FontWeight->"Bold"],
 "and ",
 StyleBox["representationRoots[",
  FontWeight->"Bold"],
 StyleBox["dynkinLabel_",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 ":"
}], "Subsubsection",
