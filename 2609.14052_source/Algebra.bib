@InProceedings{XL,
    author="Courtois, Nicolas
    and Klimov, Alexander
    and Patarin, Jacques
    and Shamir, Adi",
    editor="Preneel, Bart",
    title="Efficient Algorithms for Solving Overdefined Systems of Multivariate Polynomial Equations",
    booktitle="Advances in Cryptology --- EUROCRYPT 2000",
    year="2000",
    publisher="Springer Berlin Heidelberg",
    address="Berlin, Heidelberg",
    pages="392--407",
    abstract="The security of many recently proposed cryptosystems is based on the difficulty of solving large systems of quadratic multivariate polynomial equations. This problem is NP-hard over any field. When the number of equations m is the same as the number of unknowns n the best known algorithms are exhaustive search for small fields, and a Gr{\"o}bner base algorithm for large fields. Gr{\"o}bner base algorithms have large exponential complexity and cannot solve in practice systems with n ≥ 15. Kipnis and Shamir [9] have recently introduced a new algorithm called ``relinearization''. The exact complexity of this algorithm is not known, but for sufficiently overdefined systems it was expected to run in polynomial time.",
    % isbn="978-3-540-45539-4",
    doi = "10.1007/3-540-45539-6_27"
}

