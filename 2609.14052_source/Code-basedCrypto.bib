@article{MPSmodels,
    title = "On the equivalence of two post-quantum cryptographic families",
    abstract = "The maximum likelihood decoding problem (MLD) is known to be NP-hard and its complexity is strictly related to the security of some post-quantum cryptosystems, that is, the so-called code-based primitives. Analogously, the multivariate quadratic system problem (MQ) is NP-hard and its complexity is necessary for the security of the so-called multivariate-based primitives. In this paper we present a closed formula for a polynomial-time reduction from any instance of MLD to an instance of MQ, and viceversa. We also show a polynomial-time isomorphism between MQ and MLD, thus demonstrating the direct link between the two post-quantum cryptographic families.",
    keywords = "Code-based cryptography, Maximum likelihood decoding, Multivariate-based cryptography, Polynomial-time reductions, Quadratic multivariate systems",
    author = "Alessio Meneghetti and Alex Pellegrini and Massimiliano Sala",
    year = {2023},
    month = apr,
    doi = "10.1007/s10231-022-01267-x",
    % language = "English",
    volume = "202",
    pages = "967--991",
    journal = "Annali di Matematica Pura ed Applicata",
    % issn = "0373-3114",
    publisher = "Springer Nature",
    number = "2",
}

@InProceedings{caminata2025quadraticmodelingssyndromedecoding,
    author="Caminata, Alessio
    and Cartor, Ryann
    and Meneghetti, Alessio
    and Mora, Rocco
    and Pellegrini, Alex",
    editor="Niederhagen, Ruben
    and Saarinen, Markku-Juhani O.",
    title="Quadratic Modelings of Syndrome Decoding",
    booktitle="Post-Quantum Cryptography",
    year="2025",
    publisher="Springer Nature Switzerland",
    address="Cham",
    pages="35--70",
    abstract="This paper presents enhanced reductions of the bounded-weight and exact-weight Syndrome Decoding Problem (SDP) to a system of quadratic equations. Over {\$}{\$}{\backslash}mathbb {\{}F{\}}{\_}2{\$}{\$}F2, we improve on a previous work and study the degree of regularity of the modeling of the exact weight SDP. Additionally, we introduce a novel technique that transforms SDP instances over {\$}{\$}{\backslash}mathbb {\{}F{\}}{\_}q{\$}{\$}Fqinto systems of polynomial equations and thoroughly investigate the dimension of their varieties. Experimental results are provided to evaluate the complexity of solving SDP instances using our models through Gr{\"o}bner bases techniques.",
    % isbn="978-3-031-86599-2",
    doi = "10.1007/978-3-031-86599-2_2"
}

