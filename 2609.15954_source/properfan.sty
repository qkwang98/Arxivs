\newcommand{\tikzcupcap}{\hackcenter{\begin{tikzpicture}[scale=0.375]
    \draw (0,0) to[out=60,in=120] (2,0);
    \draw (0,2) to[out=-60,in=-120] (2,2);
\end{tikzpicture}}}
\newcommand{\tikzcrossing}{\hackcenter{\begin{tikzpicture}[scale=0.375]
    \draw (0,0)--(2,2);
    \draw (2,0)--(0,2);
    % \fill (0.5,1.5) circle (5pt);
\end{tikzpicture}}}
\newcommand{\tikzdot}{\hackcenter{\begin{tikzpicture}[scale=0.375]
    \draw (1,0)--(1,2);
    \fill (1,1) circle (5pt);
\end{tikzpicture}}}
