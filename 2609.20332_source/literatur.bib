@article{Fubini_Rabinovici,
title = {Superconformal quantum mechanics},
journal = {Nuclear Physics B},
volume = {245},
pages = {17-44},
year = {1984},
issn = {0550-3213},
doi = {https://doi.org/10.1016/0550-3213(84)90422-X},
url = {https://www.sciencedirect.com/science/article/pii/055032138490422X},
author = {S. Fubini and E. Rabinovici},
abstract = {N = 1 and N = 2 superconformal quantum mechanics are formulated and solved. Spontaneous symmetry breaking occurs. A de Sitter subalgebra is used to define new supersymmetric evolution operators. The modified system has a discrete spectrum exhibiting new supersymmetries. The N = 2 extended de Sitter superalgebra is spontaneously broken to N = 1. The relation to the behaviour of finite field theories and Poincaré invariance is discussed.}
}
