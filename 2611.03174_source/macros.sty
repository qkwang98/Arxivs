\ProvidesPackage{macros}
\RequirePackage{mathtools}
\RequirePackage{tikz}


%% Use correct Greek characters by default
\let\oldphi\phi
\let\oldepsilon\epsilon
\let\oldtheta\theta
\let\oldkappa\kappa
\let\oldrho\rho
\renewcommand*{\phi}{\varphi}
\renewcommand*{\epsilon}{\varepsilon}
\renewcommand*{\theta}{\vartheta}
\renewcommand*{\kappa}{\varkappa}
\renewcommand*{\rho}{\varrho}


%morphisms, functors, etc.
\newcommand*{\id}{\mathsf{id}}				%identity morphism
\newcommand*{\Id}{\mathsf{Id}}			%identity functor
\newcommand*{\from}{\colon}
\DeclareMathOperator{\limit}{\mathsf{lim}}
\DeclareMathOperator{\colim}{\mathsf{colim}}
\DeclareMathOperator{\coker}{\operatorname{coker}}			

%Sets
\newcommand*{\Z}{\mathbb{Z}}				%integers
	\newcommand*{\pZ}{\widehat{\Z}_p}		%p-adic integers
	\newcommand*{\Zm}[1]{\Z /{#1}\Z}		%integers modulo #1
\newcommand*{\Q}{\mathbb{Q}}			%rationals
\newcommand*{\R}{\mathbb{R}}			%reals
\newcommand*{\M}{\mathcal{M}}			%sets of monos
\newcommand*{\E}{\mathcal{E}}			%sets of epis		
		


%Operations on groups
\newcommand*{\ds}{\oplus}				%direct sum
\newcommand*{\dprod}{\times}				%binary (direct) product
\newcommand*{\tens}{\otimes}				%direct product


%Categories
\newcommand*{\Cat}[1]{\mathscr{#1}}		%category name given by argument
\newcommand*{\C}{\mathscr{C}}
\newcommand*{\Ab}{\mathbf{Ab}}			%Abelian groups
\newcommand*{\Set}{\mathbf{Set}}			%Set
\DeclareMathOperator{\Mod}{\mathbf{Mod}}	%Modules operator
\newcommand*{\ZMod}{\Mod(\Z)}			%Z-modules
\newcommand*{\RMod}{\Mod(R)}			%R-modules
\DeclareMathOperator{\Tors}{\mathbf{Tors}}
\newcommand*{\RTors}{\Tors{(R)}}
\newcommand*{\ZTors}{\Tors{(\Z)}}
\newcommand*{\Free}{\mathbf{F}}
\newcommand*{\T}{\mathcal T}
\newcommand*{\CC}{\mathcal{C}}



%% General notation (set and category theoretic)
\newcommand*{\term}{\mathbf{1}}					%terminal object
\DeclarePairedDelimiter{\abs}{|}{|}
\DeclarePairedDelimiter{\set}{\{}{\}}
\DeclarePairedDelimiterX{\setDef}[2]{\{}{\}}{#1 \; \delimsize| \; #2}
\DeclarePairedDelimiterX{\setDefC}[2]{\{}{\}}{#1 \; : \; #2}
\newcommand*{\setDefR}[2]{\left\{#1 \; \middle| \; #2\right\}}
\DeclarePairedDelimiter{\sPair}{(}{)}
\newcommand*{\setFam}[2]{\{#1\}_{#2}}
\DeclarePairedDelimiterXPP{\sFam}[2]{}{\{}{\}}{_{#2}}{#1}
\newcommand*{\rk}{\operatorname{rk}}
\newcommand*{\Ann}{\operatorname{Ann}}
\newcommand*{\p}{\mathfrak p}
\newcommand*{\Supp}{\operatorname{Supp}}
\newcommand*{\op}[1]{#1^{\mathrm{op}}}
