@article{mccarthy94,
title = {The cyclic homology of an exact category},
journal = {Journal of Pure and Applied Algebra},
volume = {93},
number = {3},
pages = {251-296},
year = {1994},
issn = {0022-4049},
doi = {https://doi.org/10.1016/0022-4049(94)90091-4},
url = {https://www.sciencedirect.com/science/article/pii/0022404994900914},
author = {Randy McCarthy},
abstract = {We define Hochschild and cyclic homology groups for an exact category which generalize the usual definitions when one considers finitely generated projective modules. They satisfy additivity as well as many of the usual properties one expects from the homology groups of an algebra. The Dennis trace and its lift to negative homology are also (multiplicatively) generalized to this setting. We use the S construction of Waldhausen and a formal generalization of the usual cyclic complex from Hochschild homology for our definition.}
}


