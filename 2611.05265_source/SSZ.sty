\tikzset{
  mmor/.style={angle 45 reversed->},
  backmmor/.style={<-angle 45 reversed},
  emor/.style={->, decoration={markings,%
      mark=at position 2pt with {\node[circle, draw=black, fill=white,%
        inner sep=1.2pt] {};}},%
    postaction=decorate},
  backemor/.style={<-,decoration={markings,%
      mark=at position -2pt with {\node[circle, draw=black, fill=white,%
        inner sep=1.2pt] {};}},%
    postaction=decorate},
  Dmor/.style={decoration={markings,%
      mark=at position 0.5 with {\node[circle, draw=black, fill=black,%
        inner sep=1pt] {};}},%
    postaction=decorate},
  smor/.style={decoration={snake, amplitude=0.8pt,segment length=4pt}, decorate}
}

