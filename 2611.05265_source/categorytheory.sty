% symbols from Papa
\makeatletter
\def\myVCENTER#1{\vcenter{\hbox{$\m@th#1$}}}
\makeatother
\def\mathCHOICEtyped#1#2#3#4#5{#1{\mathchoice
{\myVCENTER{#2}}%
{\myVCENTER{#3}}%
{\myVCENTER{#4}}%
{\myVCENTER{#5}}}}
\def\smallerVERSION#1#2#3{\mathCHOICEtyped#1%
{\scriptstyle #2}%
{\scriptstyle #2}%
{\scriptscriptstyle #2}%
{\scriptscriptstyle #3}}
\def\smallbigstar{\smallerVERSION\mathbin\bigstar\star}
\def\smallBIGwedge{\smallerVERSION\mathbin\bigwedge\bigwedge}
\def\smallBULLET{\smallerVERSION\mathbin\bullet\centerdot}
\def\smallbigstarSIMPLE{\mathbin{\mathchoice
{\scriptstyle \bigstar}%
{\scriptstyle \bigstar}%
{\scriptscriptstyle \bigstar}%
{\star}}}
