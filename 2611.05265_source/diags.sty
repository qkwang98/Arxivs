\matrix (m) [matrix of math nodes, row sep=#1,%
column sep=#2]}{\end{tikzpicture}\end{equation}}


% splitting node names
\newcount\nbofcoords
\makeatletter  
\def\myutil@empty{}
\def\multiwords#1-#2\@nil{% 
 \def\NextArg{#2}%
 \advance\nbofcoords by  1 %   
 \expandafter\edef\csname coord\@alph\nbofcoords\endcsname{#1}% 
 \ifx\myutil@empty\NextArg
     \let\next\@gobble
 \fi
 \next#2\@nil
}%    

\def\GetCoords#1{%
   \let\next\multiwords 
   \nbofcoords=0 %
   \expandafter\next#1-\@nil %
}% 
\makeatother

\newenvironment{inline-diagram}[1][1.8em]{\begin{general-inline-diagram}{1.8em}{#1}}{\end{general-inline-diagram}}
\newenvironment{diagram}[1][2.5em]{\begin{general-diagram}{2.5em}{#1}}{\end{general-diagram}}
\newenvironment{widediagram}{\begin{general-diagram}{1em}{3em}}{\end{general-diagram}}
\newenvironment{squisheddiagram}{\begin{general-diagram}{.9em}{2.25em}}{\end{general-diagram}}
\newenvironment{diagram-fixed}[1][2.5em]{\begin{general-fixed-diagram}{2.5em}{#1}}{\end{general-fixed-diagram}}
\newenvironment{diagram-numbered}[2][2.5em]{\begin{general-numbered-diagram}{2.5em}{#1}{#2}}{\end{general-numbered-diagram}}

% diagram arrow drawing commands
\def\diagDrawArrow#1#2#3#4#5{%
  \GetCoords{#2-#3}%
  \ifthenelse{\coordb=\coorde}%
  {\ifthenelse{\coordc<\coordf}%
    {\path[font=\scriptsize] (#2.mid east) edge[#1] node[#4] {$#5$} (#3.mid west);}%
    {\path[font=\scriptsize] (#2.mid west) edge[#1] node[#4] {$#5$} (#3.mid east);}}%
  {\path[font=\scriptsize] (#2) edge[#1] node[#4] {$#5$} (#3);}}
\def\diagDrawArrowND#1#2#3#4#5{%
  \path[font=\scriptsize] (#2) edge[#1] node[#4] {$#5$} (#3);}
\def\diagDrawWEArrow#1#2#3#4#5{\path[font=\scriptsize] (#2) edge[#1] node[#4]
  {$#5$} node[above=-.7ex,sloped] {$\sim$} (#3);}
\def\diagDrawArrowS#1#2#3#4#5{%
  \path[font=\scriptsize] (#2) edge[#1] node[#4] {$#5$} (#3);}
% for compatibility with old versions
\newcommand{\noHorizArrowDetection}{\def\diagDrawArrow##1##2##3##4##5{\path[font=\scriptsize] (##2) edge[##1] node[##4] {$##5$} (##3);}}

\def\diagArrow#1#2#3{%
    \def\diagDrawArrowHelper{\diagDrawArrow{#1}{m-#2}{m-#3}}  %
    \futurelet\diagArrowLookedAtToken\diagArrowDecide}
\def\diagArrowS#1#2#3{%
    \def\diagDrawArrowHelper{\diagDrawArrowS{#1}{m-#2}{m-#3}}  %
    \futurelet\diagArrowLookedAtToken\diagArrowDecide}			
\def\diagWEArrow#1#2#3{%
    \def\diagDrawArrowHelper{\diagDrawWEArrow{#1}{m-#2}{m-#3}}  %
            \futurelet\diagArrowLookedAtToken\diagArrowDecide}			
\def\diagDrawArrowHelperOther#1#2#3{\diagDrawArrowHelper{#2}{#3}}
\def\diagDrawArrowHelperBlank{\diagDrawArrowHelper{}{}}
\def\diagArrowDecide{%
   \ifx\diagArrowLookedAtToken^%
       \let\next=\diagDrawArrowHelper %
   \else\ifx\diagArrowLookedAtToken_ %
	   \let\next=\diagDrawArrowHelper %
   \else\ifx\diagArrowLookedAtToken! %
       \let\next=\diagDrawArrowHelper %
   \else\ifx\diagArrowLookedAtToken+ %
       \let\next=\diagDrawArrowHelperOther %
   \else %
       \let\next=\diagDrawArrowHelperBlank %
   \fi\fi\fi\fi %
   \next}
