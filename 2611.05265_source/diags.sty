% shortcuts
\newcommand{\num}{\pgfmathprintnumber[int trunc]{\pgfmathresult}}
\newcommand{\diagaddone}[1]{\pgfmathadd{1}{#1}\pgfmathprintnumber[int trunc]{\pgfmathresult}}
\newcommand{\arrowsquare}[5][->]{\diagArrow{#1}{1-1}{1-2}^{#2} \diagArrow{#1}{1-2}{2-2}^{#4} \diagArrow{#1}{2-1}{2-2}^{#5} \diagArrow{#1}{1-1}{2-1}_{#3}}
\newcommand{\largearrowsquare}[4]{%
\foreach \x in {#1,...,#2} %
  \foreach \y in {#3,...,#4} %
  {%
    \ifthenelse{\equal{\x}{#2}}{}{\pgfmathparse{int(1+\x)}%
	    \to{\x-\y}{\pgfmathresult-\y};}%
	\ifthenelse{\equal{\y}{#4}}{}{\pgfmathparse{int(1+\y)}%
	    \to{\x-\y}{\x-\pgfmathresult};}%
  }%
}
