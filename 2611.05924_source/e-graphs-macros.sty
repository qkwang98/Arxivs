\ProvidesPackage{e-graphs-macros}

\RequirePackage{amsmath,amssymb,amsthm,mathtools}

\DeclareRobustCommand\longtwoheadrightarrow{\relbar\joinrel\twoheadrightarrow}
\DeclareRobustCommand\longtwoheadleftarrow{\twoheadleftarrow\joinrel\relbar}

% General mathematics.
\newcommand{\define}[1]{\textbf{#1}}
\renewcommand{\Im}{\operatorname{Im}}

% Category theory.
\newcommand{\from}{\leftarrow}
\newcommand{\xto}[1]{\xrightarrow{#1}}
\newcommand{\initialto}{\twoheadrightarrow}
\newcommand{\initialfrom}{\twoheadleftarrow}
\newcommand{\longinitialto}{\longtwoheadrightarrow}
\newcommand{\longinitialfrom}{\longtwoheadleftarrow}
\newcommand{\dopfto}{\rightarrowtail}
\newcommand{\To}{\Rightarrow}
\newcommand{\op}{\mathrm{op}}
\DeclareMathOperator{\cod}{cod}
\DeclareMathOperator{\id}{id}
\DeclareMathOperator{\Hom}{Hom}
\DeclareMathOperator{\colim}{colim}
\DeclareMathOperator{\Lan}{Lan}
\DeclareMathOperator{\Path}{Path}

% Categories.
\newcommand{\cat}[1]{\mathsf{#1}}
\newcommand{\Set}{\cat{Set}}
\newcommand{\El}{\mathop{\cat{El}}}
\newcommand{\MGraph}{\cat{MGph}}
\newcommand{\ProdComp}{\mathop{\textstyle\prod}}

% 2-categories.
\newcommand{\twocat}[1]{\mathbf{#1}}
\newcommand{\Cat}{\twocat{Cat}}
\newcommand{\Cart}{\twocat{Cart}}

% Lenses.
\newcommand{\lensget}{\mathtt{get}}
\newcommand{\lensput}{\mathtt{put}}
