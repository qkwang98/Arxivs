 \DeclareRobustCommand{\nbinom}[2]
{\mathchoice
  {\raisebox{.25pt}{\fontcommand$\dbinom{#1}{#2}$}}
  {\raisebox{.25pt}{\fontcommand$\dbinom{#1}{#2}$}}
  {\raisebox{-.5pt}{\fontcommand$\tbinom{#1}{#2}$}}
  {\raisebox{-.5pt}{\fontcommand$\tbinom{#1}{#2}$}}}

%\let\binom\nbinom
\newcommand{\mbinom}[2]{\Big(\nbinom{#1}{#2}\Big)}
\let\binom\mbinom

