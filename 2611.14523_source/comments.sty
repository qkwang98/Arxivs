% Usage: \newComments\ME{de Niro}{red}
% creates a comments macro "\ME".
% Writing, say,
% \ME{You talking to me?}
% will create a text
% "[de Niro: You talking to me?]"
% printed in red.
% In the final version of your text all comments will disappear,
% if you write \KillComments macro somewhere before the first comment.
% Macro \ShowComments will restore printing of comments.
%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{comments}[2005/04/30 v1.0 permits to insert vizible comments in drafts]
\RequirePackage{color}[1999/02/16 v1.0i Standard LaTeX Color (DPC)]

\newif\ifcomments

\let\ShowComments\commentstrue
\let\KillComments\commentsfalse
\def\newKibitzer#1#2#3{%
\commentstrue
\long\def#1##1{\ifcomments{\color{#3}\sc[\,#2: ##1\,]}\fi}%
}
\let\newComments\newKibitzer
\let\newCommentator\newKibitzer
