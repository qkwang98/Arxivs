% This date is not strictly necessary, but older dates have not been tested
\NeedsTeXFormat{LaTeX2e}[2024/11/01]
\ProvidesPackage{defaultstyle}[2025/08/07 v0.01 LaTeX package of my defualt style]

% Flags to exclude certain sections (include everything by default)
\newif\ifincludecompilation
\newif\ifincludebibliography
\newif\ifincludegraphics
\newif\ifincludetikz

\includecompilationtrue
\includebibliographytrue
\includegraphicstrue
\includetikztrue

% Define options
\DeclareOption{excludecompilation}{\includecompilationfalse}
\DeclareOption{excludebibliography}{\includebibliographyfalse}
\DeclareOption{excludegraphics}{\includegraphicsfalse}
\DeclareOption{excludetikz}{\includetikzfalse}
\DeclareOption{minimal}{%
    \includecompilationfalse
    \includebibliographyfalse
    \includegraphicsfalse
    \includetikzfalse
}

% Process options
\ProcessOptions\relax


