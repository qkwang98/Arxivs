% Setup options for hyperlinks
\RequirePackage{hyperref}
\hypersetup{
    colorlinks = true,
    breaklinks = true,
    linktoc = all,
    bookmarksnumbered = true,
    urlcolor = brown,
    linkcolor = blue,
    citecolor = green
}

% Referencing package
\RequirePackage{cleveref}
\crefname{section}{\S\!}{\S\S\!}
\Crefname{section}{\S\!}{\S\S\!}

