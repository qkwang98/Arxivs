%---------------------------------------------------------------------
%	THEOREM STYLES
%---------------------------------------------------------------------

% Define a counter to keep count for all sub-environments
% and one for the special lettered ones
\newcounter{userrunningcounter}
\newcounter{userspecialcounter}
\renewcommand{\theuserspecialcounter}{\Alph{userspecialcounter}}


% We reset the counter at every section and ensure that hyperref still
%has unique identifiers even with the reset
\numberwithin{userrunningcounter}{section}
\renewcommand*{\theHuserrunningcounter}{\theHsection.\arabic{userrunningcounter}}


% Define theorem styles here based on the definition style
\theoremstyle{definition}

\newtheorem{definition}[userrunningcounter]{Definition}
\crefname{definition}{definition}{definitions}

\newtheorem{specialdefinition}[userspecialcounter]{Definition}
\crefname{specialdefinition}{definition}{definitions}


\newtheorem{construction}[userrunningcounter]{Construction}
\crefname{construction}{construction}{constructions}

\newtheorem{observation}[userrunningcounter]{Observation}
\crefname{observation}{observation}{observations}

\newtheorem{notation}[userrunningcounter]{Notation}
\crefname{notation}{notation}{notations}

% Define theorem styles here based on the plain style
\theoremstyle{plain}

\newtheorem{theorem}[userrunningcounter]{Theorem}
\crefname{theorem}{theorem}{theorems}

\newtheorem*{theorem*}{Theorem}
\crefname{theorem*}{theorem}{theorems}

\newtheorem{specialtheorem}[userspecialcounter]{Theorem}
\crefname{specialtheorem}{theorem}{theorems}

\newtheorem{corollary}[userrunningcounter]{Corollary}
\crefname{corollary}{corollary}{corollaries}

\newtheorem{lemma}[userrunningcounter]{Lemma}
\crefname{lemma}{lemma}{lemmata}

\newtheorem{proposition}[userrunningcounter]{Proposition}
\crefname{proposition}{proposition}{propositions}

\newtheorem{conjecture}[userrunningcounter]{Conjecture}
\crefname{conjecture}{conjecture}{conjectures}

% Define theorem styles here based on the remark style
\theoremstyle{remark}

\newtheorem{example}[userrunningcounter]{Example}
\crefname{example}{example}{examples}

\newtheorem{counterexample}[userrunningcounter]{Counterexample}
\crefname{counterexample}{counterexample}{counterexamples}

\newtheorem{remark}[userrunningcounter]{Remark}
\crefname{remark}{remark}{remarks}

