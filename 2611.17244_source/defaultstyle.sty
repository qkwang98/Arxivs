% Preset Tikz commands

% tikz half circle arc
\AtBeginDocument{\newcommand{\tkarc}[6]{
    % Usage: tkarc{vertical orientation}{which leg is origin}{leg x coordinate}{leg y coordinate}{width}{height}
    % vertical orientation = +1 for evaluation, -1 for coevaluation
    % which leg is origin = +1 for right leg, -1 for left leg
    \draw[very thick, directedgreen] (#3, #4) .. controls (#3, #4 + 2 / 3 * #1 * #6) and (#3 - #2 * #5, #4 + 2 / 3 * #1 * #6) .. (#3 - #2 * #5, #4);
}}

% tikz trivalent vertex
\AtBeginDocument{\newcommand{\tktrival}[6]{
    % Usage: tktrival{vertical orientation}{which leg is origin}{leg x coordinate}{leg y coordinate}{width}{height}
    % vertical orientation = +1 for multiplication, -1 for comultiplication
    % which leg is origin = +1 for right leg, 0 for middle leg, -1 for left leg
    \ifx 0#2%
        \draw[very thick, color=green!60!black] (#3 - #5 / 2, #4 - #1 * #6) .. controls (#3 - #5 / 2, #4 - #1 * #6 / 3) and (#3 + #5 / 2, #4 - #1 * #6 / 3) .. (#3 + #5 / 2, #4 - #1 * #6);
        \draw[very thick, color=green!60!black] (#3, #4) -- (#3, #4 - #1 * #6 / 2);%
    \else%
        \draw[very thick, color=green!60!black] (#3, #4) .. controls (#3, #4 + 2 / 3 * #1 * #6) and (#3 - #2 * #5, #4 + 2 / 3 * #1 * #6) .. (#3 - #2 * #5, #4);
        \draw[very thick, color=green!60!black] (#3 - #2 * #5 / 2, #4 + #1 * #6 / 2) -- (#3 - #2 * #5 / 2, #4 + #1 * #6);%
    \fi
}}

% tikz trivalent vertex with straight edge
\AtBeginDocument{\newcommand{\tkstrival}[6]{
    % Usage: tkstrival{vertical orientation}{which leg is origin}{leg x coordinate}{leg y coordinate}{width}{height}
    % vertical orientation = +1 for multiplication, -1 for comultiplication
    % which leg is origin = +1 for right leg, 0 for middle leg, -1 for left leg
    \ifx 0#2%
        \draw[very thick, color=green!60!black] (#3 - #5, #4 - #1 * #6) .. controls (#3 - #5, #4 - 2 / 3 * #1 * #6) and (#3 - 3 / 4 * #5, #4 - 1 / 2 * #1 * #6) .. (#3, #4 - 1 / 2 * #1 * #6);
        \draw[very thick, color=blue!60!black] (#3, #4) -- (#3, #4 - #1 * #6);%
    \else%
        \draw[very thick, color=green!60!black] (#3, #4) .. controls (#3, #4 + 1 / 3 * #1 * #6) and (#3 - 1 / 2 * #2 * #5, #4 + 1 / 2 * #1 * #6) .. (#3 - #2 * #5, #4 + 1 / 2 * #1 * #6);
        \draw[very thick, color=blue!60!black] (#3 - #2 * #5, #4) -- (#3 - #2 * #5, #4 + #1 * #6);%
    \fi
}}

