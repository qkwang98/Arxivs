\definecolor{brown}{HTML}{CD853F}
\definecolor{blue}{HTML}{4169E1}
\definecolor{green}{HTML}{2E8B57}
\definecolor{red}{HTML}{D3383B}
\definecolor{softblack}{rgb}{0.1, 0.1, 0.1}
\definecolor{softwhite}{rgb}{0.77, 0.77, 0.77}

