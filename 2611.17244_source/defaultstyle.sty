%---------------------------------------------------------------------
%	FORMATING AND TYPESETTING
%---------------------------------------------------------------------

% Option to change margin size
\RequirePackage[margin=2cm]{geometry}

% Font and encoding settings
\RequirePackage{fontspec} % only works with xetex and luatex

% Footnotes
\RequirePackage[stable]{footmisc}

% Indentation and spacing
\RequirePackage{indentfirst} % indentation
\RequirePackage{enumitem}[leftmargin=0pt,shortlabels] % enumerate spacing
\setlist{nosep}
\setlist[enumerate,1]{label = \textit{(\roman*)}}

% Start numbering sections from zero
\setcounter{section}{-1}

% Formating of titles
\RequirePackage{titlesec}
\titleformat{\section}
{\normalfont\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}
{\normalfont\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}
{\normalfont\small\bfseries}{\thesubsubsection}{1em}{}
\titleformat{\paragraph}[runin]
{\normalfont\small\bfseries}{\theparagraph}{1em}{}
\titleformat{\subparagraph}[runin]
{\normalfont\small\bfseries}{\thesubparagraph}{1em}{}
\RequirePackage[titletoc]{appendix}

% Multi column environment
\RequirePackage{multicol}

% Math typesetting packages
\RequirePackage{amsmath, amssymb, amsthm, mathtools, bbold}
\RequirePackage[mathscr]{euscript} % euler script font

% TIkz-cd for displaying commutative diagrams
\RequirePackage{tikz-cd}

% Cramped style for inline tikzcd diagrams
\tikzcdset{
    cramped*/.style = {
        line cap = round,
        every matrix/.append style = {
            every outer matrix/.append style = {inner sep = +0pt}},
            every cell/.append style = {
                inner sep = +0pt,
                outer sep = 1.25 * width("$\;$")
            },
            column sep/.evaluated = width("${}\to{}$")
    }
}

% Helpful box for seeing the size of tikzcd diagrams and arranging them
\newenvironment{boxedtikzcd}{\begin{lrbox}{\boxedtikzcdbox}\begin{tikzcd}}{\end{tikzcd}\end{lrbox}\fbox{\usebox{\boxedtikzcdbox}}}
\newsavebox{\boxedtikzcdbox}

% Theorem tools, especially the restatable environment, is useful for including theorems in the introduction verbatim. However, it may not work with include from the subfiles package. In restatable, either the definition or the subsequent call has to be starred, and the counter points to the unstarred version
\RequirePackage{thmtools, thm-restate}

