\usepackage[T1]{fontenc}
\usepackage{lmodern}
\usepackage[english]{babel}
\usepackage{microtype}            % better spacing/justification; safe to drop
 
 
%% ---------------------------------------------------------------------------
%% 2. Page layout
%% ---------------------------------------------------------------------------
\usepackage{geometry}
\setlength{\parskip}{\smallskipamount}
\setlength{\parindent}{0pt}
\setcounter{tocdepth}{2}
 
 
%% ---------------------------------------------------------------------------
%% 3. Colour, graphics, floats, diagrams
%% ---------------------------------------------------------------------------
%  Load xcolor once, early, with the options you need *before* anything that
%  loads it silently (todonotes, tikz, ...), otherwise you get option clashes.
%  `dvipsnames' provides OliveGreen (used for the links below).
\usepackage[dvipsnames]{xcolor}
\usepackage{graphicx}
\usepackage{float}
\usepackage{caption}
\usepackage{todonotes}            % loads tikz
\usepackage{quiver}               % loads tikz-cd
\usepackage[all]{xy}
 
 
%% ---------------------------------------------------------------------------
%% 4. Mathematics
%% ---------------------------------------------------------------------------
\usepackage{mathtools}            % loads and fixes amsmath
\usepackage{amssymb}
 
%  stmaryrd + extpfeil: extpfeil does \RequirePackage[only,...]{stmaryrd},
%  which would clash with the full stmaryrd loaded here. Pretending stmaryrd
%  was loaded with those options avoids the clash and keeps every symbol.
\usepackage{stmaryrd}
\expandafter\def\csname opt@stmaryrd.sty\endcsname
  {only,shortleftarrow,shortrightarrow}
\usepackage{extpfeil}
 
%  old-arrows checks at load time whether lmodern, amsmath, mathtools and
%  stmaryrd are loaded and patches their arrows -> it must come after them.
\usepackage[new]{old-arrows}
 
\usepackage{mathrsfs}             % \mathscr
\usepackage{dsfont}               % \mathds
\usepackage{bbm}                  % \mathbbm (bitmap fonts; prefer \mathds)
\usepackage{nicefrac}
\usepackage{yhmath}               % \wideparen etc.; must come after amsmath
\usepackage{cjhebrew}
 
 
%% ---------------------------------------------------------------------------
%% 5. Theorem machinery and miscellaneous tools
%% ---------------------------------------------------------------------------
\usepackage{amsthm}               % after amsmath
\usepackage{thmtools}             % after amsthm; also loads thm-restate
 
%  Fix for LaTeX 2026-06-01 and newer: \newtheorem{lemma}[theorem]{...} now
%  creates the shared counter `lemma' itself (via \newcounteralias). thmtools
%  still does the same, so every shared-counter theorem fails with
%  "Command \c@lemma already defined". Leave that job to LaTeX on new
%  kernels; on older kernels (e.g. arXiv) nothing changes.
\makeatletter
\@ifundefined{newcounteralias}{}{%
  \def\thmt@autorefsetup{%
    \expandafter\def\csname\thmt@envname autorefname\expandafter\endcsname
      \expandafter{\thmt@thmname}}%
}
\makeatother
\usepackage{enumitem}
\usepackage{comment}
\usepackage{twoopt}
 
 
%% ---------------------------------------------------------------------------
%% 6. Hyperlinks -- (almost) last
%% ---------------------------------------------------------------------------
\usepackage[
  pdfusetitle,                    % PDF metadata from \title and \author
  bookmarksnumbered,
  hypertexnames = false,
  colorlinks,
  linkcolor     = OliveGreen,
  citecolor     = OliveGreen,
  urlcolor      = OliveGreen,
]{hyperref}
\usepackage{bookmark}             % after hyperref
\usepackage[nameinlink,capitalise,noabbrev]{cleveref}  % after hyperref & amsthm
 
 
%% ---------------------------------------------------------------------------
%% 7. Theorem environments -- after cleveref, so that \cref knows that a
%%    `lemma' sharing the `theorem' counter is a Lemma, not a Theorem.
%%    `refname' = {singular, plural} sets up \cref for each environment.
%% ---------------------------------------------------------------------------
 
% ---- numbered, sharing the theorem counter (numbered within sections) ------
\declaretheorem[style=definition, name=Theorem, numberwithin=section,
                refname={Theorem,Theorems}]{theorem}
 
\declaretheorem[style=definition, sibling=theorem, name=Definition,
                refname={Definition,Definitions}]{definition}
\declaretheorem[style=definition, sibling=theorem, name=Notation,
                refname={Notation,Notations}]{notation}
\declaretheorem[style=definition, sibling=theorem, name=Convention,
                refname={Convention,Conventions}]{convention}
\declaretheorem[style=definition, sibling=theorem, name=Terminology,
                refname={Terminology,Terminology}]{terminology}
\declaretheorem[style=definition, sibling=theorem, name=Construction,
                refname={Construction,Constructions}]{construction}
\declaretheorem[style=definition, sibling=theorem, name=Solution,
                refname={Solution,Solutions}]{solution}
\declaretheorem[style=definition, sibling=theorem, name=Conjecture,
                refname={Conjecture,Conjectures}]{conjecture}
\declaretheorem[style=definition, sibling=theorem, name=Remark,
                refname={Remark,Remarks}]{remark}
\declaretheorem[style=definition, sibling=theorem, name=Example,
                refname={Example,Examples}]{example}
\declaretheorem[style=definition, sibling=theorem, name=Exercise,
                refname={Exercise,Exercises}]{exercise}
\declaretheorem[style=definition, sibling=theorem, name=Question,
                refname={Question,Questions}]{question}
\declaretheorem[style=definition, sibling=theorem, name=Warning,
                refname={Warning,Warnings}]{warn}
\declaretheorem[style=definition, sibling=theorem, name=Assumption,
                refname={Assumption,Assumptions}]{assumption}
 
\declaretheorem[style=plain, sibling=theorem, name=Proposition,
                refname={Proposition,Propositions}]{proposition}
\declaretheorem[style=plain, sibling=theorem, name=Lemma,
                refname={Lemma,Lemmas}]{lemma}
\declaretheorem[style=plain, sibling=theorem, name=Claim,
                refname={Claim,Claims}]{claim}
\declaretheorem[style=plain, sibling=theorem, name=Corollary,
                refname={Corollary,Corollaries}]{corollary}
 
\declaretheorem[style=remark, sibling=theorem, name=Observation,
                refname={Observation,Observations}]{observation}
\declaretheorem[style=remark, sibling=theorem, name=Fact,
                refname={Fact,Facts}]{fact}
\declaretheorem[style=remark, sibling=theorem, name=Note,
                refname={Note,Notes}]{note}
 
% ---- lettered: Theorem A, Conjecture B, ... ---------------------------------
\declaretheorem[style=definition, name=Theorem,
                refname={Theorem,Theorems}]{alphThm}
\renewcommand{\thealphThm}{\Alph{alphThm}}
\declaretheorem[style=definition, name=Conjecture,
                refname={Conjecture,Conjectures}]{alphConj}
\renewcommand{\thealphConj}{\Alph{alphConj}}
 
% ---- unnumbered -------------------------------------------------------------
\declaretheorem[style=definition, numbered=no, name=Definition]{definition*}
\declaretheorem[style=definition, numbered=no, name=Theorem]{theorem*}
\declaretheorem[style=plain,      numbered=no, name=Corollary]{corollary*}
\declaretheorem[style=plain,      numbered=no, name=Lemma]{lemma*}
\declaretheorem[style=plain,      numbered=no, name=Proposition]{proposition*}
\declaretheorem[style=plain,      numbered=no, name=Remark]{remark*}
 
 
