% Hebrew tsadi in maths. Done via \text (like \Yo below) rather than
% \DeclareSymbolFont: pdfLaTeX only has 16 maths font slots and the packages
% above already use 11 of them, so every slot saved counts.
\DeclareFontFamily{U}{rcjhbltx}{}
\DeclareFontShape{U}{rcjhbltx}{m}{n}{<->s*[1.2]rcjhbltx}{}
\newcommand{\pretsadi}{\text{\usefont{U}{rcjhbltx}{m}{n}\symbol{118}}}
 
% Yoneda embedding symbol (hiragana `yo')
\DeclareFontFamily{U}{min}{}
\DeclareFontShape{U}{min}{m}{n}{<-> dmjhira}{}
\newcommand{\Yo}{\text{\usefont{U}{min}{m}{n}\symbol{'110}}}
 
