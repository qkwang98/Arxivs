\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-2.5, 2.5) {};
		\node [style=none] (1) at (2.5, 2.5) {};
		\node [style=none] (2) at (-2.5, -2.5) {};
		\node [style=none] (3) at (2.5, -2.5) {};
		\node [style=none] (4) at (0, 2.5) {};
		\node [style=none] (5) at (0, -2.5) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=defect patch 2] (0.center)
			 to (1.center)
			 to (3.center)
			 to (2.center)
			 to cycle;
		\draw [style=ts-dashed] (0.center) to (2.center);
		\draw [style=ts-dashed] (2.center) to (3.center);
		\draw [style=ts-dashed] (3.center) to (1.center);
		\draw [style=ts-dashed] (1.center) to (0.center);
		\draw [style=geometric] (4.center) to (5.center);
	\end{pgfonlayer}
\end{tikzpicture}
