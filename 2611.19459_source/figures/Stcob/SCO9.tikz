\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-2.5, 0) {};
		\node [style=none] (1) at (2.5, 0) {};
		\node [style=none] (2) at (0, 0) {};
		\node [style=0 strat] (3) at (0, 0) {};
		\node [style=none] (4) at (-1.975, 1.7) {};
		\node [style=none] (5) at (0, -2.6) {};
		\node [style=none] (6) at (1.8, 1.825) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=defect patch 2] (1.center)
			 to [in=270, out=-90, looseness=1.75] (0.center)
			 to [in=90, out=90, looseness=1.75] cycle;
		\draw [style=ts-dashed, in=90, out=90, looseness=1.75] (0.center) to (1.center);
		\draw [style=ts-dashed, in=270, out=270, looseness=1.75] (1.center) to (0.center);
		\draw [style=geometric] (4.center) to (3);
		\draw [style=geometric] (3) to (6.center);
		\draw [style=geometric] (3) to (5.center);
	\end{pgfonlayer}
