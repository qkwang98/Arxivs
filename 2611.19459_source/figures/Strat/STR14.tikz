\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-3.5, 3.5) {};
		\node [style=none] (1) at (3.5, 3.5) {};
		\node [style=none] (2) at (-3.5, -3.5) {};
		\node [style=none] (3) at (3.5, -3.5) {};
		\node [style=none] (4) at (0, -3.5) {};
		\node [style=none] (5) at (0, 3.5) {};
		\node [style=dot] (6) at (0, 0) {};
		\node [style=none] (7) at (0, 1.75) {};
		\node [style=none] (8) at (-2, 1.75) {};
		\node [style=none] (9) at (0.5, 0.75) {$\gamma_1$};
		\node [style=none] (10) at (-1, 2.5) {$\gamma_2$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=defect patch 2] (1.center)
			 to (0.center)
			 to (2.center)
			 to (3.center)
			 to cycle;
		\draw [style=defect line 3] (5.center) to (4.center);
		\draw [style=dir thick] (6) to (7.center);
		\draw [style=dir thick, in=30, out=-165] (7.center) to (8.center);
	\end{pgfonlayer}
\end{tikzpicture}
