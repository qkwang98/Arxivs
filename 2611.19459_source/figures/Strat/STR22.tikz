\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-5, 5) {};
		\node [style=none] (1) at (5, 5) {};
		\node [style=none] (2) at (-5, -5) {};
		\node [style=none] (3) at (5, -5) {};
		\node [style=dot] (4) at (-5, -5) {};
		\node [style=dot] (5) at (-5, 5) {};
		\node [style=dot] (6) at (5, 5) {};
		\node [style=dot] (7) at (5, -5) {};
		\node [style=none] (9) at (-1.5, 1) {};
		\node [style=none] (10) at (1.5, 1) {};
		\node [style=none] (11) at (-1.5, 5) {};
		\node [style=none] (12) at (1.5, 5) {};
		\node [style=0 strat] (13) at (-1.5, 5) {};
		\node [style=0 strat] (14) at (1.5, 5) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=defect patch b] (0.center)
			 to (2.center)
			 to (3.center)
			 to (1.center)
			 to cycle;
		\draw [style={open_int_blue}] (0.center) to (2.center);
		\draw [style={open_int_blue}] (2.center) to (3.center);
		\draw [style={open_int_blue}] (3.center) to (1.center);
		\draw [style={open_int_blue}] (1.center) to (0.center);
		\draw [style={open_int}, in=-90, out=-90, looseness=1.75] (9.center) to (10.center);
		\draw [style={open_int}] (11.center) to (9.center);
		\draw [style={open_int}] (12.center) to (10.center);
	\end{pgfonlayer}
\end{tikzpicture}
