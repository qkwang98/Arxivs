\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-4, 4) {};
		\node [style=none] (1) at (4, 4) {};
		\node [style=none] (2) at (-4, -4) {};
		\node [style=none] (3) at (4, -4) {};
		\node [style=none] (9) at (-1.5, 0) {};
		\node [style=none] (10) at (1.5, 0) {};
		\node [style=0 strat white] (12) at (-1.5, 4) {};
		\node [style=0 strat white] (13) at (1.5, 4) {};
		\node [style=none] (14) at (1.5, 0) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=defect patch b] (0.center)
			 to (2.center)
			 to (3.center)
			 to (1.center)
			 to cycle;
		\draw [style={open_int}, in=-90, out=-90, looseness=1.75] (9.center) to (10.center);
		\draw [style={open_int_blue_2_dash}] (0.center) to (2.center);
		\draw [style={open_int_blue_2_dash}] (2.center) to (3.center);
		\draw [style={open_int_blue_2_dash}] (1.center) to (3.center);
		\draw [style={open_int_blue_2_dash}] (1.center) to (0.center);
		\draw [style={open_int}] (12) to (9.center);
		\draw [style={open_int}] (13) to (14.center);
	\end{pgfonlayer}
\end{tikzpicture}
