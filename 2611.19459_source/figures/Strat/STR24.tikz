\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=dot] (4) at (-4, -4) {};
		\node [style=dot] (5) at (-4, 4) {};
		\node [style=dot] (6) at (4, 4) {};
		\node [style=dot] (7) at (4, -4) {};
		\node [style=dot] (8) at (-1.5, 4) {};
		\node [style=dot] (9) at (1.5, 4) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style={open_int_blue}] (5) to (4);
