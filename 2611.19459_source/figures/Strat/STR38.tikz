\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=0 strat] (0) at (0, 0) {};
		\node [style=none] (1) at (0, 2.5) {};
		\node [style=none] (2) at (-2, -2) {};
		\node [style=none] (3) at (2, -2) {};
		\node [style=none] (4) at (0, 1.75) {};
		\node [style=none] (5) at (0, 0.75) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (0) to (1.center);
		\draw (2.center) to (0);
		\draw (3.center) to (0);
		\draw [style={open_int_blue}] (4.center) to (5.center);
	\end{pgfonlayer}
