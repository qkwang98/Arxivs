\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-3.5, 0) {};
		\node [style=none] (1) at (3.5, 0) {};
		\node [style=0 strat] (2) at (0, 0) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=defect patch b] (1.center)
			 to [in=270, out=-90, looseness=1.75] (0.center)
			 to [in=90, out=90, looseness=1.75] cycle;
		\draw [style=ts-dashed-grey, in=90, out=90, looseness=1.75] (0.center) to (1.center);
		\draw [style=ts-dashed-grey, in=270, out=270, looseness=1.75] (1.center) to (0.center);
	\end{pgfonlayer}
\end{tikzpicture}
