\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-3, 3) {};
		\node [style=none] (1) at (-3, -3) {};
		\node [style=none] (2) at (-0.5, -3) {};
		\node [style=none] (3) at (-0.5, -0.75) {};
		\node [style=none] (4) at (-0.5, 0.75) {};
		\node [style=none] (5) at (-0.5, 3) {};
		\node [style=none] (6) at (3, -3) {};
		\node [style=none] (7) at (3, 3) {};
		\node [style=none] (8) at (0.5, 3) {};
		\node [style=none] (9) at (0.5, 0.75) {};
		\node [style=none] (10) at (0.5, -0.75) {};
		\node [style=none] (11) at (0.5, -3) {};
		\node [style=0 strat] (12) at (-0.5, -0.75) {};
		\node [style=0 strat] (13) at (-0.5, 0.75) {};
		\node [style=0 strat] (14) at (0.5, 0.75) {};
		\node [style=0 strat] (15) at (0.5, -0.75) {};
		\node [style=none] (16) at (0.5, 3) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=defect patch b] (5.center)
			 to (4.center)
			 to [bend left=270, looseness=1.75] (3.center)
			 to (2.center)
			 to (1.center)
			 to (0.center)
			 to cycle;
		\draw [style=defect patch b] (11.center)
			 to (10.center)
			 to [bend left=270, looseness=1.75] (9.center)
			 to (8.center)
			 to (7.center)
			 to (6.center)
			 to cycle;
		\draw [style=ts-dashed-grey] (2.center) to (1.center);
		\draw [style=ts-dashed-grey] (1.center) to (0.center);
		\draw [style=ts-dashed-grey] (0.center) to (5.center);
		\draw [style=ts-dashed-grey] (16.center) to (7.center);
		\draw [style=ts-dashed-grey] (7.center) to (6.center);
		\draw [style=ts-dashed-grey] (6.center) to (11.center);
		\draw [style={open_int_blue}] (5.center) to (13);
		\draw [style={open_int_blue}] (16.center) to (14);
		\draw [style={open_int_blue}] (15) to (11.center);
		\draw [style={open_int_blue}] (12) to (2.center);
		\draw [style={open_int_blue}, bend left=90, looseness=1.50] (12) to (13);
		\draw [style={open_int_blue}, bend left=90, looseness=1.50] (14) to (15);
	\end{pgfonlayer}
\end{tikzpicture}
