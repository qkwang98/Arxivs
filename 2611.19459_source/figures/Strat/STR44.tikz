\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-3, 3) {};
		\node [style=none] (1) at (-3, -3) {};
		\node [style=none] (2) at (3, 3) {};
		\node [style=none] (3) at (3, -3) {};
		\node [style=none] (5) at (0, 3) {};
		\node [style=none] (6) at (0, -3) {};
		\node [style=none] (7) at (-0.75, 0) {};
		\node [style=none] (8) at (0.75, 0) {};
		\node [style=0 strat] (9) at (0, 0.75) {};
		\node [style=0 strat] (10) at (0, -0.75) {};
		\node [style=none] (11) at (2, 2) {};
		\node [style=none] (13) at (2, -0.75) {};
		\node [style=none] (14) at (0, -1.5) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=defect patch b] (1.center)
			 to (3.center)
			 to (2.center)
			 to (0.center);
		\draw [style=ts-dashed-grey] (0.center) to (1.center);
		\draw [style=ts-dashed-grey] (1.center) to (3.center);
		\draw [style=ts-dashed-grey] (3.center) to (2.center);
		\draw [style=ts-dashed-grey] (2.center) to (0.center);
		\draw [style=white patch] (8.center)
			 to [in=-90, out=-90, looseness=1.75] (7.center)
			 to [in=90, out=90, looseness=1.75] cycle;
		\draw [style={open_int}] (5.center) to (9);
		\draw [style={open_int}] (10) to (6.center);
		\draw [style={open_int_blue}, in=180, out=-180, looseness=1.50] (9) to (10);
		\draw [style={open_int_blue}, in=0, out=0, looseness=1.50] (10) to (9);
		\draw [style={open_int_green}, in=-15, out=-105, looseness=0.75] (11.center) to (13.center);
		\draw [style={open_int_green}, in=0, out=165] (13.center) to (14.center);
	\end{pgfonlayer}
