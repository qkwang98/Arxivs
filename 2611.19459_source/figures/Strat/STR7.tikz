\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-2, 0) {};
		\node [style=none] (1) at (2, 0) {};
		\node [style=none] (2) at (-2, 0) {};
		\node [style=none] (3) at (2, 0) {};
		\node [style=none] (4) at (0, 2.05) {};
		\node [style=none] (5) at (0, -2.05) {};
		\node [style=none] (6) at (-2, 0) {};
		\node [style=none] (7) at (0, -2.05) {};
		\node [style=none] (8) at (0, 2.05) {};
		\node [style=none] (9) at (2, 0) {};
		\node [style=endpoint] (10) at (0, 0) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=ts-dashed-grey, in=90, out=90, looseness=1.75] (0.center) to (1.center);
		\draw [style=ts-dashed-grey, in=-90, out=-90, looseness=1.75] (2.center) to (3.center);
		\draw [style=defect patch 1] (6.center)
			 to [in=-180, out=90] (4.center)
			 to (5.center)
			 to [in=-90, out=180] cycle;
		\draw [style=defect patch 1] (9.center)
			 to [in=0, out=-90] (7.center)
			 to (8.center)
			 to [in=90, out=0] cycle;
		\draw [style={open_int_green}] (8.center) to (7.center);
	\end{pgfonlayer}
\end{tikzpicture}
