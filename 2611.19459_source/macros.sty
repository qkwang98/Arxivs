% this style is applied by default to any tikzpicture included via \tikzfig
\tikzstyle{tikzfig}=[baseline=-0.25em,scale=0.5]
\tikzstyle{mid arrow}=[post={decorate,decoration={
        markings,
        mark=at position .55 with {\arrow[#1]{stealth}}
      }}]
\tikzstyle{mid arrow 0.25}=[postaction={decorate,decoration={
        markings,
        mark=at position .25 with {\arrow[#1]{stealth}}
      }}]
\tikzstyle{mid arrow 0.75}=[postaction={decorate,decoration={
        markings,
        mark=at position .75 with {\arrow[#1]{stealth}}
      }}]
\tikzstyle{rightarrow}=[\Rightarrow]

\newcommand{\nssphere}{%
  \mathord{%
    \tikz[baseline=-0.5ex, scale=0.4]{
      % Circle
      \draw (0,0) circle (0.2);
      % North pole
      \fill (0,0.2) circle (0.03);
      % South pole
      \fill (0,-0.2) circle (0.03);
    }%
  }%
}

\usepackage{tikz}

\usepackage{tikz}

\newcommand{\doubleleftarrow}{%
  \mathrel{%
    \begin{tikzpicture}[baseline=-0.6ex]
      \draw[->] (0, 0.06) -- (-0.6, 0.06);
      \draw[->] (0,-0.06) -- (-0.6,-0.06);
    \end{tikzpicture}%
  }%
}


\newcommand{\tripleleftarrow}{%
  \mathrel{%
    \begin{tikzpicture}[baseline=-0.6ex]
      \draw[->] (0, 0.18) -- (-0.6, 0.18);
      \draw[->] (0, 0.00) -- (-0.6, 0.00);
      \draw[->] (0,-0.18) -- (-0.6,-0.18);
    \end{tikzpicture}%
  }%
}


