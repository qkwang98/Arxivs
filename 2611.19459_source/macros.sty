\usepackage[
  backend=biber,
  style=alphabetic,   % or numeric, etc.
  doi=false,
  isbn=false,
  date=year           % year only
]{biblatex}

\addbibresource{support-files/biblio.bib} 

%-----------------------------
% Global clean-up
%-----------------------------
\AtEveryBibitem{%
  % for books: drop all links/eprints
  \ifentrytype{book}{%
    \clearfield{url}%
    \clearfield{eprint}%
    \clearfield{eprinttype}%
    \clearfield{eprintclass}%
  }{}%
  % never show these at all
  \clearfield{issn}%
  \clearfield{url}
  \clearfield{isbn}%
  \clearfield{urldate}%
  \clearfield{abstract}%
  \clearfield{file}%
  \clearlist{language}%
}

%-----------------------------
% Titles, journals, volumes
%-----------------------------
% article / preprint titles upright, no quotes
\DeclareFieldFormat[article,unpublished,online,misc]{title}{#1}

% book(-like) titles italic
\DeclareFieldFormat[book,inbook,collection,incollection,
                    proceedings,inproceedings,thesis,manual]{title}{\mkbibemph{#1}}

% journal names italic
\DeclareFieldFormat{journaltitle}{\mkbibemph{#1}}

% journal volume bold; drop issue number; no "pp."
\DeclareFieldFormat{volume}{\mkbibbold{#1}}
\DeclareFieldFormat[article]{number}{}      % no issue number
\DeclareFieldFormat[article]{pages}{#1}     % no "pp."

%-----------------------------
% "In:" only for genuine collections
%-----------------------------
\renewbibmacro*{in:}{%
  \ifboolexpr{
    test {\ifentrytype{inbook}} or
    test {\ifentrytype{incollection}} or
    test {\ifentrytype{inproceedings}}
  }
    {\printtext{\bibstring{in}\intitlepunct}}
    {}%
}

%-----------------------------
% arXiv / URL at the very end (non-books)
%-----------------------------
% use your macro \arxiv{<number>}
\DeclareFieldFormat{eprint:arxiv}{\arxiv{#1}}

\renewbibmacro*{doi+eprint+url}{%
  \iftoggle{bbx:eprint}{%
    \iffieldundef{eprint}
      {\iffieldundef{url}{}{\setunit{\addspace}\printfield{url}}}
      {\setunit{\addspace}\printfield[eprint:arxiv]{eprint}}%
  }{}%
}

%-----------------------------
% Books: series + bold volume, Publisher, City, Year
%-----------------------------
% volume/number in a series printed bold for book-like things
\DeclareFieldFormat[book,inbook,incollection,inproceedings]{number}{\mkbibbold{#1}}

% series followed by bold volume number, e.g. "Math. Surveys Monogr. 99"
\renewbibmacro*{series+number}{%
  \iffieldundef{series}
    {}
    {\printfield{series}%
     \setunit{\space}%
     \printfield{number}}%
}

% Publisher, City, Year (global – matches what you want for books)
\renewbibmacro*{publisher+location+date}{%
  \printlist{publisher}%
  \setunit*{\addcomma\space}%
  \printlist{location}%
  \setunit*{\addcomma\space}%
  \usebibmacro{date}%
}


% Preserve the headline-style capitalization supplied by the bibliography.
\DeclareFieldFormat{titlecase}{#1}

% Book / collection / proceedings titles: italic, with capitalization preserved.
\DeclareFieldFormat[book,collection,proceedings]{titlecase}
  {\mkbibemph{#1}}


