@article{MaRFmod,
 author               = {Ma, Linquan},
 title                = {Finiteness properties of local cohomology for {$F$}-pure local rings},
 year                 = {2013},
 doi = {10.1093/imrn/rnt130}, 
abstract ={In this paper, we show that for an F-pure local ring , all local cohomology modules  have finitely many Frobenius compatible submodules. This answers positively the open question raised by Enescu and Hochster [3] (see also [2], where it was stated as a conjecture when R is Cohen–Macaulay). We also prove that when  is excellent and F-pure on the punctured spectrum, all local cohomology modules  have finite length in the category of R-modules with Frobenius action. Finally, we show that the property that all  have finitely many Frobenius compatible submodules passes to localizations.}, 
URL = {http://imrn.oxfordjournals.org/content/early/2013/06/28/imrn.rnt130.abstract}, 
eprint = {http://imrn.oxfordjournals.org/content/early/2013/06/28/imrn.rnt130.full.pdf+html}, 
journal = {International Mathematics Research Notices} 
 }

