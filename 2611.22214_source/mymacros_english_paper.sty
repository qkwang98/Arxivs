% Make \cites behave like \cite and support the trailing-postnote syntax
%   \cite{key}*{postnote}
% without swallowing an ordinary interword space after \cite{key}.
\makeatletter

% Unlike \@ifnextchar, this look-ahead test does not skip spaces.
% Thus an immediately following `*' selects the extended syntax,
% while an ordinary space is left untouched.
\long\def\mep@ifnextchar@noskip#1#2#3{%
  \let\mep@reserved@d=#1%
  \def\mep@reserved@a{#2}%
  \def\mep@reserved@b{#3}%
  \futurelet\mep@let@token\mep@ifnch@noskip
}
\def\mep@ifnch@noskip{%
  \ifx\mep@let@token\mep@reserved@d
    \let\mep@reserved@c\mep@reserved@a
  \else
    \let\mep@reserved@c\mep@reserved@b
  \fi
  \mep@reserved@c
}

\AtBeginDocument{%
  \let\mep@origcite\cite
  \renewcommand{\cite}[2][]{%
    \mep@ifnextchar@noskip*%
      {\mep@cite@withpostnote{#1}{#2}}%
      {\mep@cite@base{#1}{#2}}%
  }%
  \@ifundefined{cites}%
    {\newcommand{\cites}{\cite}}%
    {\renewcommand{\cites}{\cite}}%
}

\newcommand{\mep@cite@base}[2]{%
  \if\relax\detokenize{#1}\relax
    \mep@origcite{#2}%
  \else
    \mep@origcite[#1]{#2}%
  \fi
}

\def\mep@cite@withpostnote#1#2*#3{%
  \if\relax\detokenize{#1}\relax
    \mep@cite@base{#3}{#2}%
  \else
    \mep@origcite[#1, #3]{#2}%
  \fi
}

\makeatother

