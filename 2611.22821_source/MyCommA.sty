% \MakeLinkTarget is a recent LaTeX kernel command (2023-11).  It is missing in
% converters such as LaTeXML (the ar5iv/arXiv HTML pipeline), where every use
% raises an error; with one use per \index, i.e. per \mdef and \tdef, that alone
% exceeds LaTeXML's 100-error limit and aborts the conversion.  Make it a no-op
% when it is absent; under pdfLaTeX this changes nothing.
\makeatletter
\@ifundefined{MakeLinkTarget}{%
  \newcommand\MakeLinkTarget{\@ifstar\@gobble\@gobble}%
}{}
\makeatother

% An index entry drops an anchor at the place it is made and encapsulates its
% page number in a link to that anchor, so that clicking the page number in the
% index jumps to the notation itself and not to the top of the page.  This
% replaces hyperref's \hyperpage, which is why hyperref is loaded with
% hyperindex=false above.
\newcounter{idxanchor}
\newcommand{\idxlink}[2]{\hyperlink{idx.#1}{#2}}
\newcommand{\idxlinkbf}[2]{\textbf{\hyperlink{idx.#1}{#2}}}
\let\plainindex\index
\renewcommand{\index}[2][idxlink]{%
  \stepcounter{idxanchor}%
  \MakeLinkTarget*{idx.\theidxanchor}%
  \plainindex{#2|#1{\theidxanchor}}%
}



\definecolor{DefColor}{rgb}{0.6,0.15,0.25}
%emphasis defs



\newcommand{\gendef}[1]{\textcolor{DefColor}{#1}}
% \mdef[<index entry>]{<text>} and \tdef likewise.  Written with \@ifnextchar
% rather than \NewDocumentCommand: LaTeXML (the arXiv/ar5iv HTML pipeline) has
% no \NewDocumentCommand, so there both macros were left undefined and every
% \mdef in the paper dropped its argument into the surrounding math.  The
% behaviour under pdfLaTeX is unchanged -- an optional argument in brackets,
% skipping spaces before it, exactly as the "o m" signature specified.
\makeatletter
\def\mdef{\@ifnextchar[\mdef@opt\mdef@plain}
\def\mdef@opt[#1]#2{\textcolor{DefColor}{#2}\index{$#1$}}
\def\mdef@plain#1{\textcolor{DefColor}{#1}\index{$#1$}}

\def\tdef{\@ifnextchar[\tdef@opt\tdef@plain}
\def\tdef@opt[#1]#2{\textcolor{DefColor}{#2}\index{#1}}
\def\tdef@plain#1{\textcolor{DefColor}{#1}\index{#1}}
\makeatother
