        RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "]"}]}], ";", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"lam", "=", 
          RowBox[{"2", "mu"}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"3", "mu", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"mu", "+", "1"}], ")"}], "/", "2"}]}], "<=", "n"}], ",", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"s", "=", 
               RowBox[{"one", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"-", "1"}], ")"}], "^", "mu"}], ",", 
