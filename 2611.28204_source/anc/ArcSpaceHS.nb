                 RowBox[{"m", "-", "mu"}]}], "]"}]}], ";", 
              RowBox[{"s", "=", 
               RowBox[{"Fold", "[", 
                RowBox[{"mul", ",", "s", ",", 
                 RowBox[{"Join", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", 
                    RowBox[{"1", "+", "lam"}], ",", "1", ",", "0"}], "}"}], 
                    "}"}], ",", 
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"1", ",", 
                    RowBox[{"2", "+", "lam", "+", "i"}], ",", "2", ",", "0"}],
                     "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", 
                    RowBox[{"n", "-", "2", "-", "lam"}]}], "}"}]}], "]"}], ",", 
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"1", ",", 
                    RowBox[{"1", "+", "i"}], ",", "1", ",", "0"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", 
                    RowBox[{"mu", "-", "1"}]}], "}"}]}], "]"}], ",", 
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"1", ",", 
                    RowBox[{"lam", "-", "m", "+", "i"}], ",", "0", ",", "0"}],
                     "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "1", ",", "m"}], "}"}]}], "]"}], ",", 
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"1", ",", 
                    RowBox[{"1", "+", "i"}], ",", "1", ",", "0"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", 
                    RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", 
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"1", ",", 
                    RowBox[{"1", "+", "i"}], ",", "1", ",", "0"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", 
                    RowBox[{"lam", "-", "m", "-", "1"}]}], "}"}]}], "]"}]}], 
                  "]"}]}], "]"}]}], ";", 
              RowBox[{"s", "=", 
