Notebook[{

Cell[CellGroupData[{
Cell["Macdonald Indices", "Section",
 CellChangeTimes->{{4.002870676630019*^9, 
  4.002870681742147*^9}},ExpressionUUID->"a19b5c86-4680-454b-87c0-\
6534e68ce9c6"],

Cell["\<\
These are the 4d N=2 Macdonald indices as worked out from a previously-known \
physics approach.\
\>", "Text",
 CellChangeTimes->{{4.002870919008976*^9, 
  4.002870949813422*^9}},ExpressionUUID->"ebd83cd0-26c7-4fef-bba7-\
35d435ff5a46"],

Cell[CellGroupData[{

Cell["N=4 SYM w/ g = su(2)", "Subsection",
 CellChangeTimes->{{4.0028706941208973`*^9, 
  4.002870701426405*^9}},ExpressionUUID->"772062bb-fa53-4bf6-a75d-\
9b51653a438f"],

Cell["\<\
The following cell evaluates the gauge integral exactly, up to and including \
order q^MacdonaldZ2qMax; for MacdonaldZ2qMax = 21 it takes about two minutes. \
The fugacity a is that of the su(2) flavor symmetry, and setting T = 1 gives \
the Schur index.\
\>", "Text",ExpressionUUID->"1cb2b4ba-3ca3-475b-bab9-43ba9c6b1e33"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"MacdonaldZ2qMax", "=", "21"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MacdonaldZ2", "[", 
    RowBox[{"q_", ",", "T_", ",", "a_"}], "]"}], "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"2", "MacdonaldZ2qMax"}]}], ",", "f", ",", "t", ",", "b", ",",
        "z", ",", "haar"}], "}"}], ",", 
     RowBox[{
      RowBox[{"f", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"n", "+", "1"}]}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", "1"}], ";", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1"}], "]"}], "]"}], "=", 
           RowBox[{"Expand", "[", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"[", 
               RowBox[{"k", "+", "1"}], "]"}], "]"}], "-", 
             RowBox[{"c", 
              RowBox[{"f", "[", 
               RowBox[{"[", 
                RowBox[{"k", "+", "1", "-", 
                 RowBox[{"2", "m"}]}], "]"}], "]"}]}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "n", ",", 
            RowBox[{"2", "m"}], ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "1", ",", 
          RowBox[{"Floor", "[", 
           RowBox[{"n", "/", "2"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"w", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"z", "^", "2"}], ",", "1", ",", 
            RowBox[{"z", "^", 
             RowBox[{"-", "2"}]}]}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"c", ",", 
          RowBox[{"{", 
           RowBox[{"w", ",", 
            RowBox[{
             RowBox[{"t", "^", "2"}], "w"}]}], "}"}]}], "}"}]}], "]"}], ";", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1"}], "]"}], "]"}], "=", 
           RowBox[{"Expand", "[", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"[", 
               RowBox[{"k", "+", "1"}], "]"}], "]"}], "+", 
             RowBox[{"c", 
              RowBox[{"f", "[", 
               RowBox[{"[", 
                RowBox[{"k", "-", 
                 RowBox[{"2", "m"}]}], "]"}], "]"}]}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{
             RowBox[{"2", "m"}], "+", "1"}], ",", "n"}], "}"}]}], "]"}], ",", 
        
        RowBox[{"{", 
         RowBox[{"m", ",", "0", ",", 
          RowBox[{"Floor", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}], "/", "2"}], "]"}]}], "}"}], ",", 
        
        RowBox[{"{", 
         RowBox[{"w", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"z", "^", "2"}], ",", "1", ",", 
            RowBox[{"z", "^", 
             RowBox[{"-", "2"}]}]}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"c", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"t", "b", "w"}], ",", 
            RowBox[{"t", 
             RowBox[{"w", "/", "b"}]}]}], "}"}]}], "}"}]}], "]"}], ";", 
      RowBox[{"haar", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"z", "^", "2"}]}], ")"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"z", "^", 
            RowBox[{"-", "2"}]}]}], ")"}], "/", "2"}]}]}], ";", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{"Expand", "[", 
              RowBox[{"haar", 
               RowBox[{"f", "[", 
                RowBox[{"[", 
                 RowBox[{"k", "+", "1"}], "]"}], "]"}]}], "]"}], ",", "z", ",",
              "0"}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"t", "->", 
              RowBox[{"Sqrt", "[", "T", "]"}]}], ",", 
             RowBox[{"b", "->", "a"}]}], "}"}]}], ")"}], 
         RowBox[{"q", "^", 
          RowBox[{"(", 
           RowBox[{"k", "/", "2"}], ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "n"}], "}"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[131]:=",ExpressionUUID->"f1f4d62f-fcb1-4cad-b45a-e289757ac7d3"]
}, Closed]],

Cell[CellGroupData[{

Cell["N=4 SYM w/ g = su(3)", "Subsection",ExpressionUUID->"38891d3c-726e-4d13-a99a-a58c8e31283c"],

Cell["\<\
The following cell evaluates the gauge integral exactly, up to and including \
order q^MacdonaldSU3qMax, working with truncated arrays of coefficients of \
q^(k/2), each of which is stored as an association from the exponents of the \
fugacities of the two simple roots of su(3) to a polynomial in T and a; terms \
that are too far from the origin to contribute to the constant term are \
dropped along the way. For MacdonaldSU3qMax = 12 it takes about a minute. As \
for su(2), the fugacity a is that of the su(2) flavor symmetry, and setting T \
= 1 gives the Schur index.\
\>", "Text",ExpressionUUID->"ed7a7c64-e1ca-4d4d-8462-5d9b049293c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MacdonaldSU3qMax", " ", "=", " ", "12"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MacdonaldSU3", "[", 
    RowBox[{"q_", ",", " ", "T_", ",", " ", "a_"}], "]"}], " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"2", "*", "MacdonaldSU3qMax"}]}], ",", " ", "roots", ",", " ",
        "f", ",", " ", "add", ",", " ", "haar", ",", " ", "t", ",", " ", 
       "b"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"roots", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "0"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"-", "1"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";", "\n", "   ", 
      RowBox[{"f", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"<|", "|>"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", " ", "+", " ", "1"}], "}"}]}], "]"}]}], ";", " ", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", "1"}], 
        "|>"}]}], ";", "\n", "   ", 
      RowBox[{
       RowBox[{"add", "[", 
        RowBox[{"k_", ",", " ", "c_", ",", " ", "w_", ",", " ", "j_"}], "]"}],
        " ", ":=", " ", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"[", 
          RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"KeySelect", "[", 
           RowBox[{
            RowBox[{"Merge", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"f", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                RowBox[{"KeyMap", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"#", " ", "+", " ", "w"}], " ", "&"}], ",", " ", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Expand", "[", 
                    RowBox[{"c", "*", "#"}], "]"}], " ", "&"}], " ", "/@", 
                   " ", 
                   RowBox[{"f", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", " ", "+", " ", "1", " ", "-", " ", "j"}], 
                    "]"}], "]"}]}]}], "]"}]}], "}"}], ",", " ", 
              RowBox[{"Expand", "@*", "Total"}]}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{"Abs", "[", "#", "]"}], "]"}], " ", "<=", " ", 
              RowBox[{
               RowBox[{"2", "*", 
                RowBox[{"(", 
                 RowBox[{"n", " ", "-", " ", "k"}], ")"}]}], " ", "+", " ", 
               "4"}]}], " ", "&"}]}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"#", " ", "=!=", " ", "0"}], " ", "&"}]}], "]"}]}]}], ";", 
      "\n", "   ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"add", "[", 
           RowBox[{"k", ",", " ", 
            RowBox[{"-", "c"}], ",", " ", "w", ",", " ", 
            RowBox[{"2", "*", "m"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "n", ",", " ", 
            RowBox[{"2", "*", "m"}], ",", " ", 
            RowBox[{"-", "1"}]}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "1", ",", " ", 
          RowBox[{"Floor", "[", 
           RowBox[{"n", "/", "2"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"w", ",", " ", 
          RowBox[{"Join", "[", 
           RowBox[{"roots", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], "]"}]}], "}"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"t", "^", "2"}]}], "}"}]}], "}"}]}], "]"}], ";", "\n", 
      "   ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"add", "[", 
           RowBox[{"k", ",", " ", "c", ",", " ", "w", ",", " ", 
            RowBox[{
             RowBox[{"2", "*", "m"}], " ", "+", " ", "1"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", 
            RowBox[{
             RowBox[{"2", "*", "m"}], " ", "+", " ", "1"}], ",", " ", "n"}], 
           "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "0", ",", " ", 
          RowBox[{"Floor", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", " ", "-", " ", "1"}], ")"}], "/", "2"}], "]"}]}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"w", ",", " ", 
          RowBox[{"Join", "[", 
           RowBox[{"roots", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], "]"}]}], "}"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"t", "*", "b"}], ",", " ", 
            RowBox[{"t", "/", "b"}]}], "}"}]}], "}"}]}], "]"}], ";", "\n", 
      "   ", 
      RowBox[{"haar", " ", "=", " ", 
       RowBox[{
        RowBox[{"Merge", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Association", "[", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{"Keys", "[", "#", "]"}], "]"}], " ", "->", " ", 
              RowBox[{"Times", " ", "@@", " ", 
               RowBox[{"Values", "[", "#", "]"}]}]}], "]"}], " ", "&"}], " ", 
           "/@", " ", 
           RowBox[{"Tuples", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", " ", "0"}], "}"}], " ", "->", " ", "1"}], 
                ",", " ", 
                RowBox[{"#", " ", "->", " ", 
                 RowBox[{"-", "1"}]}]}], "}"}], " ", "&"}], " ", "/@", " ", 
             "roots"}], "]"}]}], ",", " ", "Total"}], "]"}], "/", "6"}]}], ";",
       "\n", "   ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Expand", "[", 
            RowBox[{"Total", "[", 
             RowBox[{"KeyValueMap", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#2", "*", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{
                   RowBox[{"f", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                   RowBox[{"Key", "[", 
                    RowBox[{"-", "#1"}], "]"}], ",", " ", "0"}], "]"}]}], " ",
                 "&"}], ",", " ", "haar"}], "]"}], "]"}], "]"}], " ", "/.", 
           " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"t", " ", "->", " ", 
              RowBox[{"Sqrt", "[", "T", "]"}]}], ",", " ", 
             RowBox[{"b", " ", "->", " ", "a"}]}], "}"}]}], ")"}], "*", 
         RowBox[{"q", "^", 
          RowBox[{"(", 
           RowBox[{"k", "/", "2"}], ")"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}]}]}], 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"30249d3f-d8dd-469b-ac23-\
b8cf511920bc"]
}, Closed]],

Cell[CellGroupData[{

Cell["N = 3 SCFTs", "Subsection",
 CellChangeTimes->{{3.990180096281466*^9, 3.990180096708599*^9}, {
  4.002870743869996*^9, 4.002870795186692*^9}, {4.002872420783939*^9, 
  4.0028724220675793`*^9}},ExpressionUUID->"a6986c1c-c415-4f37-afd9-\
3810f9a81d2e"],

Cell["\<\
Here, we have written the Macdonald indices of the Z3, Z4, and Z6 rank-one \
N=3 SCFTs using the Mathematica notebook null_states.nb from 2103.00985.\
\>", "Text",
 CellChangeTimes->{{3.990180198688553*^9, 
  3.990180286974204*^9}},ExpressionUUID->"1ef3f2b4-3bc0-4c6c-8dc7-\
db1f69bce66d"],

Cell[CellGroupData[{

Cell["Z3", "Subsubsection",
 CellChangeTimes->{{4.0028708027989397`*^9, 
  4.002870803089017*^9}},ExpressionUUID->"2f158ad8-1aaf-4965-8620-\
c8da786182ce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"MacdonaldZ3qMax", " ", "=", " ", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MacdonaldZ3", "[", 
    RowBox[{"q_", ",", " ", "T_"}], "]"}], " ", ":=", " ", 
   RowBox[{"1", " ", "+", " ", 
    RowBox[{"q", " ", "T"}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["q", 
      RowBox[{"3", "/", "2"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SqrtBox["T"]}], "+", 
       SuperscriptBox["T", 
        RowBox[{"3", "/", "2"}]]}], ")"}]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["q", "2"], 
     RowBox[{"(", "T", ")"}]}], "+", " ", 
    RowBox[{
     SuperscriptBox["q", 
      RowBox[{"5", "/", "2"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SqrtBox["T"]}], "+", 
       SuperscriptBox["T", 
        RowBox[{"5", "/", "2"}]]}], ")"}]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["q", "3"], 
     RowBox[{"(", 
      RowBox[{"T", "+", 
       SuperscriptBox["T", "3"]}], ")"}]}], "+", " ", 
    RowBox[{
     SuperscriptBox["q", 
      RowBox[{"7", "/", "2"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SqrtBox["T"]}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["T", 
         RowBox[{"3", "/", "2"}]]}], "+", 
       SuperscriptBox["T", 
        RowBox[{"5", "/", "2"}]]}], ")"}]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["q", "4"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "T"}], "+", 
       SuperscriptBox["T", "2"], "-", 
       SuperscriptBox["T", "3"], "+", 
       SuperscriptBox["T", "4"]}], ")"}]}], "+", " ", 
    RowBox[{
     SuperscriptBox["q", 
      RowBox[{"9", "/", "2"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SqrtBox["T"]}], "-", 
       RowBox[{"3", " ", 
        SuperscriptBox["T", 
         RowBox[{"3", "/", "2"}]]}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["T", 
         RowBox[{"5", "/", "2"}]]}], "-", 
       SuperscriptBox["T", 
        RowBox[{"7", "/", "2"}]], "+", 
       SuperscriptBox["T", 
        RowBox[{"9", "/", "2"}]]}], ")"}]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["q", "5"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "T"}], "+", 
       SuperscriptBox["T", "2"], "-", 
       SuperscriptBox["T", "3"], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["T", "4"]}]}], ")"}]}], "+", " ", 
    RowBox[{
     SuperscriptBox["q", 
      RowBox[{"11", "/", "2"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SqrtBox["T"]}], "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["T", 
         RowBox[{"3", "/", "2"}]]}], "+", 
       SuperscriptBox["T", 
        RowBox[{"5", "/", "2"}]], "-", 
       SuperscriptBox["T", 
        RowBox[{"9", "/", "2"}]], "+", 
       SuperscriptBox["T", 
        RowBox[{"11", "/", "2"}]]}], ")"}]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["q", "6"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", "T"}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["T", "2"]}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["T", "3"]}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["T", "4"]}], "-", 
       SuperscriptBox["T", "5"], "+", 
       SuperscriptBox["T", "6"]}], ")"}]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["q", 
      RowBox[{"13", "/", "2"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SqrtBox["T"]}], "-", 
       RowBox[{"5", " ", 
        SuperscriptBox["T", 
         RowBox[{"3", "/", "2"}]]}], "-", 
       SuperscriptBox["T", 
        RowBox[{"5", "/", "2"}]], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["T", 
         RowBox[{"7", "/", "2"}]]}], "-", 
       RowBox[{"3", " ", 
        SuperscriptBox["T", 
         RowBox[{"9", "/", "2"}]]}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["T", 
         RowBox[{"11", "/", "2"}]]}]}], ")"}]}], " ", "+", " ", 
    RowBox[{
     SuperscriptBox["q", "7"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", "T"}], "+", 
       RowBox[{"5", " ", 
        SuperscriptBox["T", "2"]}], "-", 
       RowBox[{"3", " ", 
        SuperscriptBox["T", "3"]}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["T", "4"]}], "-", 
       SuperscriptBox["T", "6"], "+", 
