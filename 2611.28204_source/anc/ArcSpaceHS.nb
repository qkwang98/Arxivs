Cell[CellGroupData[{

Cell["\[CapitalEHat]6(SU(2)) SCFT", "Subsection",
 CellChangeTimes->{{4.00287111340938*^9, 
  4.0028711182870197`*^9}},ExpressionUUID->"f7b8757f-b2d7-4ba3-99a0-\
7782eb751997"],

Cell["\<\
The \[CapitalEHat]6(SU(2)) SCFT is the diagonal SU(2) gauging of three copies \
of the D3(SU(2)) Argyres\[Dash]Douglas theory. The Macdonald index of \
D3(SU(2)) is the TQFT expression of Song (1509.06194). The following cell \
evaluates the gauge integral exactly, up to and including order \
q^MacdonaldA6qMax, working with truncated arrays of coefficients of q^k T^j \
z^(2e); for MacdonaldA6qMax = 51 it takes about two minutes. Setting T = 1 \
gives the Schur index.\
\>", "Text",
 CellChangeTimes->{{4.002872370953742*^9, 4.002872387554596*^9}, {
  4.002875608134862*^9, 
  4.002875611161192*^9}},ExpressionUUID->"5ed75e37-4f10-4995-8b31-\
3c34083ab257"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"MacdonaldA6qMax", "=", "51"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MacdonaldA6", "[", 
    RowBox[{"q_", ",", "T_"}], "]"}], "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", "MacdonaldA6qMax"}], ",", "one", ",", "lin", ",", 
       "mul", ",", "div", ",", "prod", ",", "d3", ",", "f", ",", "e", ",", 
       "s", ",", "lam"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"one", "[", 
        RowBox[{"c_", ",", "a_", ",", "b_", ",", "d_"}], "]"}], ":=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"k", "==", "a"}], ",", 
           RowBox[{"ReplacePart", "[", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"k", "+", "1"}], ",", 
                 RowBox[{
                  RowBox[{"2", "k"}], "+", "1"}]}], "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"b", "+", "1"}], ",", 
                RowBox[{"d", "+", "k", "+", "1"}]}], "}"}], "->", "c"}]}], 
            "]"}], ",", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"k", "+", "1"}], ",", 
               RowBox[{
                RowBox[{"2", "k"}], "+", "1"}]}], "}"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"lin", "[", 
        RowBox[{"g_", ",", "a_", ",", "b_", ",", "d_"}], "]"}], ":=", 
       RowBox[{"ArrayPad", "[", 
        RowBox[{"g", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"b", ",", 
             RowBox[{"a", "-", "b"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "+", "d"}], ",", 
             RowBox[{"a", "-", "d"}]}], "}"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"mul", "[", 
        RowBox[{"f_", ",", 
         RowBox[{"{", 
          RowBox[{"c_", ",", "a_", ",", "b_", ",", "d_"}], "}"}]}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", "=", "f"}], "}"}], ",", 
         RowBox[{
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{"k", "+", "1"}], "]"}], "]"}], "-=", 
             RowBox[{"c", 
              RowBox[{"lin", "[", 
               RowBox[{
                RowBox[{"g", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", "-", "a", "+", "1"}], "]"}], "]"}], ",", "a", ",",
                 "b", ",", "d"}], "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "n", ",", "a", ",", 
              RowBox[{"-", "1"}]}], "}"}]}], "]"}], ";", "g"}]}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"div", "[", 
        RowBox[{"f_", ",", 
         RowBox[{"{", 
          RowBox[{"c_", ",", "a_", ",", "b_", ",", "d_"}], "}"}]}], "]"}], ":=", 
       RowBox[{"Module", "[", 
