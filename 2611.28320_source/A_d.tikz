% Reusable picture. Requires TikZ and \usetikzlibrary{arrows.meta}.
\begin{tikzpicture}[x=1.4cm,y=1.4cm,font=\small]
  \definecolor{latticegray}{gray}{0.75}
  % Exact drawing bounds; no visible frame.
  \path[use as bounding box] (-2.5,-0.5) rectangle (2.5,2.5);
  \clip (-2.5,-0.5) rectangle (2.5,2.5);

  % Integer grid, including the vertical line x=0 (no separate y-axis).
  \foreach \x in {-2,...,2}
    \draw[latticegray,line width=0.4pt,dash pattern=on 2pt off 2pt]
      (\x,-0.5) -- (\x,2.5);
  \foreach \y in {0,...,2}
    \draw[latticegray,line width=0.4pt,dash pattern=on 2pt off 2pt]
      (-2.5,\y) -- (2.5,\y);

  % Remaining lattice points strictly above the x-axis.
  \foreach \x in {-2,...,2} {
    \foreach \y in {1,2} {
      \ifnum\x=0
        \ifnum\y=1\else
          \fill[latticegray] (\x,\y) circle[radius=1.1pt];
        \fi
      \else
        \fill[latticegray] (\x,\y) circle[radius=1.1pt];
      \fi
    }
  }

  % Draw gray dots behind the black x-axis.
  \foreach \x in {-2,0,2}
    \fill[latticegray] (\x,0) circle[radius=1.3pt];
  \draw[black,line width=0.6pt,-{Stealth[length=5pt,width=4pt]}]
    (-2.5,0) -- (2.5,0);
  \foreach \p in {(-1,0),(0,1),(1,0)}
    \fill[black] \p circle[radius=2.2pt];

  \node[anchor=north,inner sep=0pt,outer sep=0pt] at (-1,-0.12) {$(\ell\!-\!1,0)$};
  \node[anchor=south,inner sep=0pt,outer sep=0pt] at (0,1.12) {$(\ell,1)$};
  \node[anchor=north,inner sep=0pt,outer sep=0pt] at (1,-0.12) {$(\ell\!+\!1,0)$};
\end{tikzpicture}
