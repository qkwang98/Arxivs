% Reusable second picture. Requires TikZ and arrows.meta.
\begin{tikzpicture}[x=1.4cm,y=1.4cm,font=\small]
  \definecolor{latticegray}{gray}{0.75}
  \path[use as bounding box] (-2.5,-0.5) rectangle (2.5,2.5);
  \clip (-2.5,-0.5) rectangle (2.5,2.5);

  \foreach \x in {-2,...,2}
    \draw[latticegray,line width=0.4pt,dash pattern=on 2pt off 2pt]
      (\x,-0.5) -- (\x,2.5);
  \foreach \y in {0,...,2}
    \draw[latticegray,line width=0.4pt,dash pattern=on 2pt off 2pt]
      (-2.5,\y) -- (2.5,\y);

  % Remaining lattice points strictly above the x-axis.
  \foreach \x in {-2,...,2} {
    \fill[latticegray] (\x,2) circle[radius=1.1pt];
  }
  \foreach \x in {-2,2}
    \fill[latticegray] (\x,1) circle[radius=1.1pt];

  \foreach \x in {-2,-1,1,2}
    \fill[latticegray] (\x,0) circle[radius=1.3pt];
  \draw[black,line width=0.6pt,-{Stealth[length=5pt,width=4pt]}]
    (-2.5,0) -- (2.5,0);
  \foreach \p in {(0,0),(-1,1),(0,1),(1,1)}
    \fill[black] \p circle[radius=2.2pt];

  \node[anchor=north,inner sep=0pt,outer sep=0pt] at (0,-0.12) {$(\ell,0)$};
  \node[anchor=south,inner sep=0pt,outer sep=0pt] at (-1,1.12) {$(\ell\!-\!1,1)$};
  \node[anchor=south,inner sep=0pt,outer sep=0pt] at (0,1.12) {$(\ell,1)$};
  \node[anchor=south,inner sep=0pt,outer sep=0pt] at (1,1.12) {$(\ell\!+\!1,1)$};
\end{tikzpicture}
