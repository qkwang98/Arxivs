% Reusable third picture. Requires TikZ and arrows.meta.
\begin{tikzpicture}[x=1.4cm,y=1.4cm,font=\small]
  \definecolor{latticegray}{gray}{0.75}
  \path[use as bounding box] (-2.5,-0.5) rectangle (2.5,2.5);
  \clip (-2.5,-0.5) rectangle (2.5,2.5);

  \foreach \x in {-2,...,2}
    \draw[latticegray,line width=0.4pt,dash pattern=on 2pt off 2pt]
      (\x,-0.5) -- (\x,2.5);
  \foreach \y in {0,...,2}
    \draw[latticegray,line width=0.4pt,dash pattern=on 2pt off 2pt]
      (-2.5,\y) -- (2.5,\y);

  % Remaining lattice points on or above the x-axis.
  \foreach \x in {-2,0,2}
    \fill[latticegray] (\x,0) circle[radius=1.3pt];
  \foreach \x in {-2,0,2}
    \fill[latticegray] (\x,2) circle[radius=1.1pt];

  % The black axis passes over the gray dots.
  \draw[black,line width=0.6pt,-{Stealth[length=5pt,width=4pt]}]
    (-2.5,0) -- (2.5,0);

  % Multiplicity two at (\ell,1): 0.5pt stroke and 0.5pt clear gap.
  % Inner edge of ring: 2.95pt - 0.25pt = 2.70pt; dot radius: 2.20pt.
  \draw[black,fill=white,line width=0.6pt] (0,1) circle[radius=3.1pt];
  \foreach \p in {(-1,0),(1,0),(-2,1),(-1,1),(0,1),(1,1),(2,1),(-1,2),(0,2),(1,2)}
    \fill[black] \p circle[radius=2.2pt];

  \node[anchor=north,inner sep=0pt,outer sep=0pt] at (-1,-0.12) {$(\ell\!-\!1,0)$};
  \node[anchor=north,inner sep=0pt,outer sep=0pt] at (1,-0.12) {$(\ell\!+\!1,0)$};
  \node[anchor=south,inner sep=0pt,outer sep=0pt] at (-2,1.12) {$(\ell\!-\!2,1)$};
  \node[anchor=south,inner sep=0pt,outer sep=0pt] at (-1,1.12) {$(\ell\!-\!1,1)$};
  \node[anchor=south,inner sep=0pt,outer sep=0pt] at (0,1.12) {$(\ell,1)$};
  \node[anchor=south,inner sep=0pt,outer sep=0pt] at (1,1.12) {$(\ell\!+\!1,1)$};
  \node[anchor=south,inner sep=0pt,outer sep=0pt] at (2,1.12) {$(\ell\!+\!2,1)$};
  \node[anchor=south,inner sep=0pt,outer sep=0pt] at (-1,2.12) {$(\ell\!-\!1,2)$};
  \node[anchor=south,inner sep=0pt,outer sep=0pt] at (0,2.12) {$(\ell,2)$};
  \node[anchor=south,inner sep=0pt,outer sep=0pt] at (1,2.12) {$(\ell\!+\!1,2)$};
\end{tikzpicture}
