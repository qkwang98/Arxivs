Cell[BoxData[{
 RowBox[{
  RowBox[{"diffSigma", "[", 
   RowBox[{"j_", ",", "k_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"A", "[", 
    RowBox[{"k", ",", "j"}], "]"}], "-", 
   RowBox[{"A", "[", 
    RowBox[{"j", ",", "k"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xSigma", "[", 
   RowBox[{"j_", ",", "k_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"j", ",", "1"}], "]"}], "*", 
    RowBox[{"sigma", "[", 
     RowBox[{"[", "k", "]"}], "]"}]}], "-", 
   RowBox[{
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"k", ",", "1"}], "]"}], "*", 
    RowBox[{"sigma", "[", 
     RowBox[{"[", "j", "]"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"comm", "[", 
    RowBox[{"j_", ",", "k_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"sigma", "[", 
      RowBox[{"[", "j", "]"}], "]"}], ".", 
     RowBox[{"sigma", "[", 
      RowBox[{"[", "k", "]"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"sigma", "[", 
      RowBox[{"[", "k", "]"}], "]"}], ".", 
     RowBox[{"sigma", "[", 
      RowBox[{"[", "j", "]"}], "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0022038770209026`*^9, 4.002203878889244*^9}, {
