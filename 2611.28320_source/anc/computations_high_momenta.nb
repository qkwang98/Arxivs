Cell[TextData[{
 "In the following, we define a scalar potential bounding the potential of \
the operator ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         StyleBox["L", FontSlant -> "Bold"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "-\\mathbf L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8940e82-c61a-5549-b62e-249b6d6b1c76"],
 " of interest, as in Section 5 of the accompanying paper. It depends on the \
degree l and an accompanying weight ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Mu]", "\[Element]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["l", "TI"], ",", "0"}], ")"}], "+", 
         RowBox[{"{", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{"-1", ",", "1"}], ")"}], ",", 
             RowBox[{"(", 
               RowBox[{"0", ",", "0"}], ")"}], ",", 
             RowBox[{"(", 
               RowBox[{"0", ",", "1"}], ")"}], ",", 
             RowBox[{"(", 
               RowBox[{"1", ",", "1"}], ")"}]}], "}"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mu \\in (l,0)+\\{(-1,1),(0,0),(0,1),(1,1)\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c7a0c3de-b3c9-7440-9bda-8fc2a455f075"],
 ". The argument of the function below are the degree, the offset of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Mu]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ed303324-3a6d-134d-84c9-942ea143ba99"],
 " from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{"\[ScriptL]", ",", "0"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(\\ell,0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "556ac3d1-72f5-ff42-9220-69851becc0e6"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["r", "TI"], TraditionalForm], "errors" -> {}, "input" -> "r", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bc9eecb9-7a97-c044-a722-b4f994db1635"],
 "."
}], "Text",
 CellChangeTimes->{{4.004171815685713*^9, 4.004171915162468*^9}, {
  4.0041725932346478`*^9, 4.0041725935208244`*^9}, {4.004172815915695*^9, 
  4.004172985423975*^9}},ExpressionUUID->"aea4ff70-a809-8f46-bc03-\
4de795fa3517"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", 
    RowBox[{"deg_", ",", "off_", ",", "r_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "+", 
       RowBox[{"deg", "*", 
        RowBox[{"(", 
         RowBox[{"deg", "+", "3"}], ")"}]}]}], ")"}], "/", 
     RowBox[{"r", "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{"1", "/", "16"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"r", "^", "2"}], "-", "12"}], ")"}]}], "-", 
    RowBox[{"2", "*", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"deg", "+", "3"}], ",", 
          RowBox[{"off", "==", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", 
          RowBox[{"off", "==", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", 
          RowBox[{"off", "==", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "deg"}], ",", 
          RowBox[{"off", "==", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}]}]}], "}"}]}], "}"}], "]"}], "*", 
     RowBox[{"f", "[", 
      RowBox[{"r", "^", "2"}], "]"}]}], "+", 
    RowBox[{"2", "*", 
     RowBox[{"r", "^", "2"}], "*", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"r", "^", "2"}], "]"}], "^", "2"}]}], "-", 
    RowBox[{"2", "*", 
     RowBox[{"MCheap", "[", "r", "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002223464149065*^9, 4.0022235060893364`*^9}, {
   4.0022236261897545`*^9, 4.0022236824004765`*^9}, {4.0022237701944923`*^9, 
   4.0022237863064823`*^9}, {4.0022238415989017`*^9, 
   4.0022238450507984`*^9}, {4.0022239550345535`*^9, 4.002224013295912*^9}, {
   4.0041719286525383`*^9, 4.004171955702961*^9}, {4.0041720214816055`*^9, 
   4.0041722031810837`*^9}, {4.0041725983260727`*^9, 4.0041726791515026`*^9}, 
   4.0041727170396786`*^9, {4.004172795238394*^9, 4.0041727970799656`*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"21f1d8c7-6442-4d46-9364-f01be0c93152"],

