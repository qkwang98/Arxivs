Cell[TextData[{
 "Numerical determination of the lowest eigenvalue of the operator ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         SubsuperscriptBox["\[PartialD]", 
          StyleBox["r", "TI"], "2"], "+", 
         StyleBox["V", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "-\\partial_r^2 + V", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "69632d22-4f62-ac4e-ad1c-4e1c7deb7d55"],
 ". This is not used in the paper\[CloseCurlyQuote]s arguments, but provides \
a quick justification for the list of low modes analyzed in greater detail in \
Section 4 of the accompanying paper."
}], "Text",
 CellChangeTimes->{{4.004173042753399*^9, 4.004173134827404*^9}, 
   4.0041860166178875`*^9},ExpressionUUID->"16a0a6f4-af43-6746-a124-\
50469823842a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"d0", "=", "6"}], ";", 
  RowBox[{"off0", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      RowBox[{"u", "''"}], "[", "x", "]"}]}], "+", 
    RowBox[{
     RowBox[{"V", "[", 
      RowBox[{"d0", ",", "off0", ",", "x"}], "]"}], "*", 
     RowBox[{"u", "[", "x", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"vals", ",", "funs"}], "}"}], "=", 
   RowBox[{"NDEigensystem", "[", 
    RowBox[{"P", ",", 
     RowBox[{"u", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", "10"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Lowest approximate eigenvalue:\>\"", ",", 
   RowBox[{"vals", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"vals", "+", "funs"}], ",", 
     RowBox[{"V", "[", 
      RowBox[{"d0", ",", "off0", ",", "x"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Gray"}], "}"}]}], ",", 
