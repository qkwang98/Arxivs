Cell["\<\
Here we provide a numeric check of the estimates on the potential V_{6,(5,1)} \
in Lemma 5.1\
\>", "Text",ExpressionUUID->"a787f916-ae55-4a0d-af87-ecdd3040f3c8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Gam", "[", 
     RowBox[{"x_", ",", "p_"}], "]"}], "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", "x"}], "+", "1"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "p"}], "-", "1"}], ")"}], "/", "2"}], ")"}]}], 
     RowBox[{"p", "^", "p"}], " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Gamma", "[", "p", "]"}], "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"p", "-", "1"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"p", "-", "1"}], ")"}]}], 
        RowBox[{"Gamma", "[", 
         RowBox[{"2", "p"}], "]"}]}], ")"}]}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V65eff", "[", "r_", "]"}], "=", 
   RowBox[{
    RowBox[{"V", "[", 
     RowBox[{"6", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "r"}], "]"}], "-", " ", 
    RowBox[{"56", "/", 
     RowBox[{"r", "^", "2"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.004186337483713*^9, 4.004186339097208*^9}},
 CellLabel->"In[92]:=",ExpressionUUID->"65a54ed8-aaa2-4e20-8b4a-8fd8e44d675d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"V65eff", "[", "r", "]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0", ",", "10"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "10"}], ",", "25"}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", "Black"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"FindRoot", "[", 
  RowBox[{
   RowBox[{"V65eff", "[", "r", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0.1"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.004186223432724*^9, 4.00418623931386*^9}},
 CellLabel->"In[94]:=",ExpressionUUID->"9d59f9fe-8277-4a2e-908d-2c99e41904fe"],

