Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", "6", "]"}], "/", "4"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"9", "-", 
    RowBox[{"7", "*", 
     RowBox[{
      RowBox[{"Sqrt", "[", "6", "]"}], "/", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "s_", "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a", "*", "s"}], "+", "b"}], ")"}], "^", 
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.002222048258772*^9, 4.0022220639655266`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"e134f2db-9125-804e-8436-5fcfa4fabfa9"],

Cell["\<\
We define a basis of so(5) and then take the tensor product with the standard \
basis to obtain a basis of the space of so(5)-valued 1-forms at a point.\
\>", "Text",
 CellChangeTimes->{{4.004171080982273*^9, 4.0041711124424553`*^9}, {
  4.0041711831961174`*^9, 
  4.0041712810658493`*^9}},ExpressionUUID->"5b0dbb7a-afc6-3a41-92a5-\
4a3eb531605f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"A", "[", 
    RowBox[{"j_", ",", "k_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j1", ",", "k"}], "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"k1", ",", "j"}], "]"}]}], "-", 
      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j1", ",", "j"}], "]"}], "*", 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"k1", ",", "k"}], "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j1", ",", "1", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k1", ",", "1", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"matrixBasis", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}], "*", 
        RowBox[{"A", "[", 
         RowBox[{"j", ",", "k"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", 
         RowBox[{"j", "-", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"basis", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"TensorProduct", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "5", "]"}], "[", 
            RowBox[{"[", "j", "]"}], "]"}], ",", 
           RowBox[{"matrixBasis", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{"Length", "[", "matrixBasis", "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "5"}], "}"}]}], "]"}], ",", "1"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"innerProduct", "[", 
    RowBox[{"Psi1_", ",", "Psi2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Flatten", "[", "Psi1", "]"}], ".", 
    RowBox[{"Flatten", "[", "Psi2", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.998841520811901*^9, 3.9988415886415367`*^9}, {
  4.0022034681160393`*^9, 4.0022035162806206`*^9}, {4.0022035915606422`*^9, 
  4.002203612388836*^9}, {4.002203645052122*^9, 4.0022036681494217`*^9}, {
  4.002203737544039*^9, 4.0022038112349625`*^9}, {4.002205252325367*^9, 
  4.0022052896681023`*^9}, {4.0022053460753593`*^9, 4.0022053550802937`*^9}, {
  4.0022054489507294`*^9, 4.0022055128938103`*^9}, {4.002221326791832*^9, 
  4.0022213362369194`*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"bb5891a0-f523-2449-b66a-7f9eb7695582"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sigma", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"A", "[", 
      RowBox[{"1", ",", "j"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "5"}], "}"}]}], "]"}]}], ";"}]], "Input",
