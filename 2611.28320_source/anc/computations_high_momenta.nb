Cell[TextData[{
 "We estimate the three operators coming from curvature terms of the Weinkove \
solution: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "1"], 
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox["\[PartialD]", 
              StyleBox["j", "TI"]], 
             SubscriptBox["\[Sigma]", 
              StyleBox["k", "TI"]], "-", 
             SubscriptBox["\[PartialD]", 
              StyleBox["k", "TI"]], 
             SubscriptBox["\[Sigma]", 
              StyleBox["j", "TI"]], ",", 
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["j", "TI"]]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "T_1 \\Psi_k =[\\partial_j \\sigma_k - \\partial_k \\sigma_j,\\Psi_j]", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "36e2c3b0-6c02-e243-8604-386df011c1a7"],
 ",",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "2"], 
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["j", "TI"]], 
             SubscriptBox["\[Sigma]", 
              StyleBox["k", "TI"]], "-", 
             SubscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["k", "TI"]], 
             SubscriptBox["\[Sigma]", 
              StyleBox["j", "TI"]], ",", 
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["j", "TI"]]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "T_2 \\Psi_k = [x_j \\sigma_k - x_k \\sigma_j, \\Psi_j]", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2e0847db-5e08-c44c-aa99-32fefa3a22c2"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "3"], 
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         RowBox[{"[", 
           RowBox[{
             RowBox[{"[", 
               RowBox[{
                 SubscriptBox["\[Sigma]", 
                  StyleBox["j", "TI"]], ",", 
                 SubscriptBox["\[Sigma]", 
                  StyleBox["k", "TI"]]}], "]"}], ",", 
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["k", "TI"]]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "T_3 \\Psi_k = [[\\sigma_j, \\sigma_k],\\Psi_k]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6674dca1-d937-074c-8276-d6fdcc486989"],
 ".\[LineSeparator]At ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["r", "TI"], ",", "0", ",", "0", ",", "0", ",", "0"}], 
           ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "x = (r,0,0,0,0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9830c04c-2179-e147-8f18-0c729dc39d9a"],
 ", the matrices occurring in these expressions take the form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["j", "TI"]], 
         SubscriptBox["\[Sigma]", 
          StyleBox["k", "TI"]], "\[LongEqual]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\partial_j \\sigma_k  =", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a69c81ee-a2a3-6444-926e-efff133ad405"],
 " A[k,j], ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["j", "TI"]], 
         SubscriptBox["\[Sigma]", 
          StyleBox["k", "TI"]], "\[LongEqual]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "x_j\\sigma_k =", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5f7c689c-08c7-da4c-859d-61f58642a8b0"],
 " r^2 A[1,k] if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["j", "TI"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "j=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "afd67885-1888-bb40-8d5c-67293f9ea78a"],
 ", else ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["0", TraditionalForm], "errors" -> {}, "input" -> "0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "69573ef6-1572-f94e-9564-ec5b9e29d1f4"],
 "."
}], "Text",
 CellChangeTimes->{{4.002220984760111*^9, 4.00222103182255*^9}, {
