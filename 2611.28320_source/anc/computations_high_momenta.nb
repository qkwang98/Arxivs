Cell[TextData[{
 "We can bound the operators ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["T", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "T_1,T_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5cb28db-e720-6c4c-90b4-09c00afb5e8e"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], "3"], TraditionalForm], "errors" -> {}, "input" -> 
     "T_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bd2d700a-d702-104d-84bf-c40ca2680f64"],
 " from above by their highest eigenvalue, respectively ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"6", ",", 
         SqrtBox["3"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "6,\\sqrt{3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "581275ea-5ec8-9b46-a14c-74cb9cae9a28"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1", TraditionalForm], "errors" -> {}, "input" -> "1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8c37d811-1c88-0c42-914b-e3eacc2e9ff6"],
 ". In the two cells below, we introduce the matrix ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "(", 
         StyleBox["r", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "M(r)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d88819e5-e5a0-d545-b583-5433ed22e204"],
 " which represents the action of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           RowBox[{
             SubscriptBox["\[PartialD]", 
              StyleBox["j", "TI"]], 
             SubscriptBox[
              StyleBox["W", "TI"], 
              StyleBox["i", "TI"]], "-", 
             SubscriptBox["\[PartialD]", 
              StyleBox["i", "TI"]], 
             SubscriptBox[
              StyleBox["W", "TI"], 
              StyleBox["j", "TI"]], "+", 
             RowBox[{"[", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["W", "TI"], 
                  StyleBox["j", "TI"]], ",", 
                 SubscriptBox[
                  StyleBox["W", "TI"], 
                  StyleBox["i", "TI"]]}], "]"}]}], "]"}], ",", 
         SubscriptBox[
          StyleBox["W", "TI"], 
          StyleBox["j", "TI"]], "]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "[\\partial_j W_i - \\partial_i W_j + [W_j,W_i]],W_j]", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ca1f6095-d53c-1746-8eef-47d44098aa41"],
 ", where $W$ is the Weinkove solution ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["r", "TI"], "2"], ")"}], "\[Sigma]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "f(r^2)\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "75541396-1403-424b-9222-55a83efc7f3d"],
 ", on the space of so(5)-valued 1-forms at a point x with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["x", "TI"], "|", "\[LongEqual]", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "|x|=r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3f569e5c-fe89-e14e-ae3a-40a5909f7700"],
 ". Secondly, we cheaply estimate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "(", 
         StyleBox["r", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "M(r)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b13e8569-431a-9345-aa9d-228e1b9e2959"],
 " by pointwise bounding each coefficient matrix by its highest eigenvalues. \
This is followed by a plot of the resulting bound ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          RowBox[{
            StyleBox["c", "TI"], 
            StyleBox["h", "TI"], 
            StyleBox["e", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["p", "TI"]}]], "(", 
         StyleBox["r", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "M_{cheap}(r)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c5957347-da31-7546-b161-f0686a871197"],
 ", in red, and the highest eigenvalue of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "(", 
         StyleBox["r", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "M(r)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "10df5509-a111-3f49-be93-a09c52af5c57"],
 ", which would be the best pointwise upper bound for this operator. One can \
see that the cheap estimate is quite sharp already."
}], "Text",
 CellChangeTimes->{{4.004171348056679*^9, 
  4.0041717906804085`*^9}},ExpressionUUID->"1879f3da-c681-5245-a735-\
330b9b1c5d5b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"M", "[", "r_", "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"r", "^", "2"}], "]"}], "^", "2"}], "*", 
     RowBox[{"r", "^", "2"}], "*", "t3"}], "+", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"r", "^", "2"}], "]"}], "*", "t1"}], "+", 
    RowBox[{"2", "*", 
     RowBox[{"r", "^", "2"}], "*", 
     RowBox[{
      RowBox[{"f", "'"}], "[", 
      RowBox[{"r", "^", "2"}], "]"}], "*", "t2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MCheap", "[", "r_", "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"r", "^", "2"}], "]"}], "^", "2"}], "*", 
     RowBox[{"r", "^", "2"}], "*", "1"}], "+", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"r", "^", "2"}], "]"}], "*", "6"}], "-", 
    RowBox[{"2", "*", 
     RowBox[{"r", "^", "2"}], "*", 
     RowBox[{
      RowBox[{"f", "'"}], "[", 
      RowBox[{"r", "^", "2"}], "]"}], "*", 
     RowBox[{"Sqrt", "[", "3", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"max", "[", "r_", "]"}], "=", 
   RowBox[{"Max", "[", 
    RowBox[{"Eigenvalues", "[", 
     RowBox[{"M", "[", "r", "]"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0022221475812798`*^9, 4.002222206814205*^9}, {
  4.0022222503013496`*^9, 4.0022222794963474`*^9}, {4.0022230034338284`*^9, 
  4.0022230295613747`*^9}, {4.00222306066959*^9, 4.002223103944063*^9}, {
  4.002223143833042*^9, 4.002223144736624*^9}, {4.00222366897505*^9, 
  4.0022236718828087`*^9}, {4.003322966151247*^9, 4.0033229842409077`*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"b6d2099c-3912-f041-93c8-7b55d36576b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"max", "[", "r", "]"}], ",", 
     RowBox[{"MCheap", "[", "r", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0", ",", "10"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "Full"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Black", ",", "Red"}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{4.00222228171406*^9, 4.00222234242902*^9}, {
  4.0022230360245037`*^9, 4.0022230516456413`*^9}, {4.002223110755436*^9, 
  4.002223116460556*^9}, {4.003447378868185*^9, 4.003447383463936*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"34cec79a-1b6b-40d4-b521-e84b5086f472"],

