@article{ArtinZhang,
title = {Noncommutative Projective Schemes},
journal = {Advances in Mathematics},
volume = {109},
number = {2},
pages = {228-287},
year = {1994},
issn = {0001-8708},
doi = {https://doi.org/10.1006/aima.1994.1087},
url = {https://www.sciencedirect.com/science/article/pii/S0001870884710875},
author = {M. Artin and J.J. Zhang},
abstract = {An analogue of the concept of projective scheme is defined for noncommutative N-graded algebras using the quotient category C of graded right A-modules modulo its full subcategory of torsion modules. We define proj A = (C, A, s), where A is the object corresponding to the module AA, and s is the autoequivalence defined by the shift of degrees. The triples equivalent to proj A for a right noetherian graded algebra A are characterized in terms of a condition χ on extensions.}
}

