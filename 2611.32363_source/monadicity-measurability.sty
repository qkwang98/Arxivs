%% cleveref resolution (Nov 2024 update fix)
% EMS supplies its own shared-counter compatibility patch and theorem spacing.
\ifjems\else
\makeatletter
\def\cref@thmoptarg[#1]#2#3#4{%
    \ifhmode\unskip\unskip\par\fi%
    \normalfont%
    \trivlist%
    \let\thmheadnl\relax%
    \let\thm@swap\@gobble%
    \thm@notefont{\fontseries\mddefault\upshape}%
    \thm@headpunct{.}%
    \thm@headsep 5\p@ plus\p@ minus\p@\relax%
    \thm@space@setup%
    #2%
    \@topsep \thm@preskip%
    \@topsepadd \thm@postskip%
    \def\@tempa{#3}\ifx\@empty\@tempa%
      \def\@tempa{\@oparg{\@begintheorem{#4}{}}[]}%
    \else%
      \refstepcounter[#1]{#3}%
      \@namedef{cref@#3@alias}{#1}%
      \def\@tempa{\@oparg{\@begintheorem{#4}{\csname the#3\endcsname}}[]}%
    \fi%
    \@tempa}
\makeatother

\renewcommand*{\backref}[1]{$\uparrow$\,#1}
\fi

