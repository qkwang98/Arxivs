@article{lewis,
title = {Is there a convenient category of spectra?},
journal = {Journal of Pure and Applied Algebra},
volume = {73},
number = {3},
pages = {233-246},
year = {1991},
issn = {0022-4049},
author = {L.Gaunce Lewis},
abstract = {The construction of the smash product of two spectra is one of the most unsatisfactory aspects of every available treatment of the stable category. Increased interest in enriched ring and module spectra has made the misbehavior of smash products a source of growing frustration. This paper conveys the unhappy message that this frustration is unavoidable. Five simple, obviously desirable axioms for a good category of spectra with a well-behaved smash product are listed. Then it is shown that no category can satisfy all five of these minimal axioms.}
}

